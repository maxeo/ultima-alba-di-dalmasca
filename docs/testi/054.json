[{"h":1,"c":[[1.46,"Capitolo cinquantaquattresimo: L'ostaggio.",[1.46,2.48,4.31]]]},{"c":[[8.59,"I Garif diedero agli stranieri una casa vuota sul fianco della collina, con il pavimento di tavole che scricchiolava a ogni passo e un focolare in mezzo,",[8.59,8.73,9.13,9.67,9.89,10.41,10.65,10.91,11.27,11.49,11.83,12.03,12.94,13.21,13.33,13.73,13.89,14.17,14.33,14.95,15.09,15.23,15.95,16.09,16.21,16.67,16.85]],[17.99," sotto un buco nel tetto da cui il fumo usciva solo quando il vento era d'accordo.",[17.99,17.99,18.15,18.35,18.53,18.83,18.97,19.15,19.31,19.53,19.91,20.17,20.45,20.59,20.93,21.27]],[22.18," Larsa ci entrò per ultimo.",[22.18,22.75,22.98,23.55,23.77]],[25.03," Si tolse il mantello infangato, lo piegò con cura, lo appoggiò su una panca, e si sedette accanto al fuoco con le mani in grembo,",[25.03,25.03,25.31,25.41,25.93,27.28,27.49,27.75,28.07,28.7,28.91,29.31,29.45,29.63,30.75,30.89,31.03,31.45,31.87,31.99,32.35,32.57,32.71,32.91,33.05]],[34.21," con l'aria di un ospite in una casa di campagna che aspetta che gli servano il tè.",[34.21,34.31,34.49,34.65,34.79,35.11,35.25,35.39,35.61,35.73,36.25,36.41,36.85,36.97,37.09,37.47,37.64]],[38.28," Aveva dodici anni.",[38.28,38.68,39.15]],[39.89," Guardandolo, a nessuno sarebbe venuto in mente di chiedersi dove fosse la sua scorta.",[39.89,41.04,41.19,41.55,41.93,42.21,42.39,42.61,42.77,43.29,43.51,43.81,43.87,43.97]],[45.43," Veniva da chiedersi, piuttosto, dove fosse la sua governante.",[45.43,45.43,45.55,46.09,47.13,47.47,47.79,47.93,48.09]]]},{"c":[[51.11,"«Sono solo» disse, prima che qualcuno glielo chiedesse.",[51.11,51.49,52.14,52.84,53.25,53.43,53.97,54.23]],[55," «Per adesso.",[55,55.27]],[56.46," I miei uomini mi raggiungeranno fra qualche giorno, sulla strada per il nord.",[56.46,56.61,56.79,57.3,57.51,58.21,58.47,58.83,59.47,59.85,60.23,60.41,60.53]],[61.1," Ho preferito precederli.",[61.1,61.31,61.79]],[63.43," Una scorta imperiale che attraversa Ozmone si nota da molto lontano, e io non volevo essere notato da molto lontano.»",[63.43,63.43,63.81,64.43,64.53,65.09,65.43,65.63,65.85,65.99,66.25,67.27,67.41,67.61,67.77,68.11,68.35,68.81,68.97,69.19]]]},{"c":[[71.25,"«Solo» ripeté Basch.",[71.25,71.59,71.91]]]},{"c":[[73.74,"«Ho dodici anni, capitano, non sei.",[73.74,73.95,74.37,74.81,75.63,75.97]],[76.84," So badare a me stesso per qualche giorno.»",[76.84,77.05,77.43,77.57,77.71,78.01,78.23,78.49]],[79.33," Larsa sorrise.",[79.33,79.71]],[80.87," «E ho avuto fortuna.",[80.87,81.01,81.15,81.52]],[82.6," Un nomade di Giza mi ha venduto un chocobo.",[82.6,82.81,83.19,83.39,83.78,83.99,84.07,84.43,84.77]],[85.95," Mi ha detto che era il più docile del suo branco.",[85.95,85.95,86.07,86.31,86.47,86.61,86.71,86.89,87.35,87.53,87.74]],[88.93," Mi ha morso due volte.»",[88.93,89.33,89.45,89.95,90.3]]]},{"c":[[92.38,"Vaan rise.",[92.38,92.75]],[93.84," Penelo gli diede una gomitata e poi rise anche lei.",[93.84,94.31,94.47,94.77,94.91,95.98,96.13,96.37,96.71,96.99]]]},{"c":[[97.87,"Ashe no.",[97.87,99.04]],[100.06," Era rimasta in piedi vicino alla porta, con il frammento avvolto nel panno sotto il braccio,",[100.06,100.23,100.71,100.87,101.19,101.51,101.65,102.47,102.75,102.91,103.45,103.81,103.97,104.33,104.59,104.71]],[105.95," e guardava il principe di Archadia con l'attenzione che si riserva a un serpente addormentato nel proprio letto: molta, e senza nessuna fretta di toccarlo.",[105.95,105.95,106.35,106.49,106.85,107.05,107.83,108.03,108.75,109.03,109.17,109.54,109.59,109.73,110.27,110.97,111.15,111.47,112.43,113.2,113.35,113.61,114.01,114.37,114.49]]]},{"c":[[116.46,"«Perché siete qui?»",[116.46,116.93,117.21]],[117.76," chiese.",[117.76]]]},{"c":[[119.27,"Larsa smise di sorridere.",[119.27,119.91,120.31,120.47]],[122.15," Non si alzò; ma si mise dritto, e con quel solo gesto diventò un'altra persona, più vecchia, più stanca, più simile al fratello di quanto chiunque in quella stanza avrebbe voluto ammettere.",[122.15,122.15,122.45,123.22,123.48,123.69,123.94,125.19,125.33,125.61,125.85,126.16,126.57,127.06,127.56,128.28,128.56,129.29,129.66,130.56,130.86,131.33,131.51,131.97,132.11,132.61,133.6,133.81,134.09,134.51,134.87,135.27]]]},{"c":[[144.89,"«Vado al Bur-Omisace» disse.",[144.89,145.28,145.44,146.25]],[147.42," «Il monte sacro, a nord, oltre la Giungla di Golmore.",[147.42,147.63,148.03,148.8,148.97,149.75,150.15,150.29,150.63,150.89]],[151.82," Lì vive il Gran Kiltias Anastasis.",[151.82,152.11,152.46,152.67,153.1,153.84]],[154.84," Ho bisogno della sua parola.",[154.84,155.05,155.51,155.81,156.01]],[157.59," E, altezza, a essere del tutto sincero, adesso che vi ho trovata, ho bisogno anche della vostra.»",[157.59,157.59,158.38,158.53,158.87,159.11,159.52,160.19,160.57,160.75,160.89,160.99,161.7,161.91,162.45,162.75,162.99]]]},{"c":[[164.93,"«Della mia.»",[164.93,165.39]]]},{"c":[[166.91,"«Della vostra presenza.",[166.91,167.45,167.99]],[169.72," Lassù.",[169.72]],[171.07," Con me.»",[171.07,171.35]]]},{"c":[[172.82,"Il fuoco crepitò.",[172.82,173.03,173.46]],[174.58," Balthier, che si era sistemato su una pila di pelli nell'angolo più comodo della casa con una prontezza che rivelava anni di pratica, aprì un occhio.",[174.58,175.47,175.75,175.87,175.99,176.53,176.67,176.81,177.07,177.17,177.46,178.03,178.23,178.69,178.97,179.75,180.03,180.25,181.13,181.41,181.89,182.11,182.27,183.33,183.57,183.75]]]},{"c":[[187.25,"«Il marchese Ondore arma navi» disse Larsa.",[187.25,187.46,188.01,188.42,188.7,189.56,190.72]]],"st":1},{"c":[[191.88,"Ashe si scostò dalla porta.",[191.88,192.81,193.02,193.4,193.57]],[194.5," «Mio zio è neutrale.»",[194.5,194.82,195.1,195.2]]]},{"c":[[197.22,"«Nei documenti.",[197.22,197.5]],[198.47," Nei suoi porti si raccolgono esuli di Dalmasca, superstiti di Nabradia, mercenari.",[198.47,198.74,198.94,199.3,199.46,200.14,200.48,200.66,201.76,202.44,202.56,203.58]],[204.78," Adesso li sta riunendo.",[204.78,205.71,205.92,206]],[207.24," Dopo la perdita dell'Ottava Flotta crede di poter colpire l'Impero.»",[207.24,207.58,207.81,208.26,208.9,209.88,210.28,210.36,210.64,211.14]]]},{"c":[[213.38,"Ashe si avvicinò al fuoco.",[213.38,213.97,214.18,214.64,214.74]],[215.54," Larsa restò seduto, seguendola con gli occhi.",[215.54,215.9,216.22,216.98,217.36,217.5,217.64]]]},{"c":[[219.09,"«E a occidente» disse Larsa «c'è Rozarria.»",[219.09,219.24,219.38,219.97,221.03,221.97,222.34]]]},{"c":[[223.83,"Lo disse a voce normale, la stessa con cui avrebbe nominato il tempo.",[223.83,224.04,224.31,224.46,224.68,226.19,226.4,226.74,226.98,227.12,227.48,228,228.29]],[229.7," Gli altri tacquero.",[229.7,229.7,230.1]]]},{"c":[[231.85,"«Rozarria aspetta.",[231.85,233.6]],[234.91," Aspetta da trent'anni.",[234.91,235.44,235.66]],[236.66," Non vuole Dalmasca, altezza, e non vuole Bhujerba.",[236.66,236.94,237.38,238.09,239.39,239.54,239.66,240.07]],[240.73," Vuole una ragione.",[240.73,241.14,241.3]],[242.58," Se la Resistenza attacca, Rozarria la sosterrà, e il giorno dopo la sosterrà con le sue flotte, e il giorno dopo ancora mio fratello avrà la guerra che cerca da quando aveva la mia età.",[242.58,242.58,242.74,243.32,244.04,244.87,245.08,245.89,246.04,246.16,246.38,247.11,247.32,247.86,248.04,248.16,248.3,249.53,249.68,249.82,250.16,250.51,250.98,251.18,251.84,252.18,252.3,252.81,253.08,253.38,253.52,253.78,254.1,254.22,254.44]],[255.4," Le due grandi potenze di Ivalice si scontreranno.»",[255.4,255.4,255.54,255.88,256.38,256.63,257.49,257.7]],[259.42," Larsa si fermò, e guardò la principessa negli occhi.",[259.42,259.82,260,261.08,261.22,261.62,261.74,262.3,262.58]],[263.5," «E sapete dove.»",[263.5,263.64,264.06]]]},{"c":[[265.83,"Ashe non rispose.",[265.83,266.33,266.6]]]},{"c":[[268.21,"«In mezzo» disse Larsa.",[268.21,268.42,268.76,268.96]],[269.73," «Si scontreranno in mezzo.",[269.73,269.94,270.54,270.72]],[271.76," Sopra Giza, sopra Nalbina, sopra il deserto orientale.",[271.76,272.39,272.9,273.13,274.02,274.26,274.4,274.86]],[275.96," Sopra Rabanastre.",[275.96,276.23]],[277.72," Dalmasca è la strada più corta fra Archades e il mare d'occidente.",[277.72,278.44,278.58,278.7,278.96,279.12,279.5,279.88,280.9,281.04,281.18,281.63]],[282.75," È sempre stata la strada.",[282.75,282.9,283.24,283.52,283.7]],[284.44," È per questo che…»",[284.44,284.58,284.78,285.49]],[286.04," Esitò, solo un istante.",[286.04,286.78,287.12,287.26]],[288.22," «È per questo che è stata presa.»",[288.22,288.36,288.54,288.86,289.02,289.14,289.38]]]},{"c":[[291.97,"«Lo so perché è stata presa» disse Ashe.",[291.97,292.27,292.61,293.1,293.24,293.58,294.22,295.2]]]},{"c":[[295.99,"«Lo so che lo sapete.»",[295.99,296.2,296.4,296.56,296.71]]]},{"c":[[297.95,"«Allora non spiegatemelo.»",[297.95,298.91,299.18]],[300.51," La voce di lei era fredda come l'acqua della visione.",[300.51,300.72,300.96,301.08,301.34,301.61,302.3,302.6,303.04,303.36]],[304.23," «Ditemi cosa volete.»",[304.23,304.7,304.96]]]},{"c":[[306.84,"Larsa annuì, come se gli avessero fatto un favore.",[306.84,307.5,308.16,308.5,308.66,308.76,309.1,309.36,309.51]]]},{"c":[[310.67,"«Che andiate al Bur-Omisace e chiediate ad Anastasis la sua benedizione.",[310.67,310.94,311.26,311.47,312.54,312.68,313.08,313.22,313.81,314.02,314.22]],[315.98," Il Gran Kiltias è l'unica voce di Ivalice che parla sopra gli imperi, e quando parla, le flotte ascoltano.",[315.98,315.98,316.4,317.42,317.48,317.84,318.16,318.33,318.95,319.22,319.58,319.86,320,321.06,321.2,321.42,321.97,322.18,322.5]],[323.79," Se lui vi riconosce come regina di Dalmasca, voi siete regina di Dalmasca.",[323.79,324,324.16,324.32,324.82,325.04,325.4,325.54,326.36,326.58,326.88,327.32,327.46]],[329.15," Non una ribelle, non una fuggiasca che dicono morta.",[329.15,329.15,329.42,330.53,330.83,331.1,331.74,332,332.46]],[333.49," Una regina.",[333.49,333.76]],[335.02," E una regina può fare quello che una ribelle non può.»",[335.02,335.16,335.32,335.66,335.84,336.16,336.44,336.58,336.76,337.14,337.43]],[338.64," Larsa respirò.",[338.64,339.1]],[340.21," «Può chiedere la pace.»",[340.21,340.48,340.92,341.08]]]},{"c":[[342.69,"Per un momento nessuno capì.",[342.69,342.96,343.06,343.52,344.06]],[345.13," Poi capirono tutti, e il silenzio cambiò peso.",[345.13,345.5,346.1,347.19,347.34,347.46,348.03,348.5]]]},{"c":[[349.77,"«La pace» disse Ashe.",[349.77,350.02,350.66,351.65]]]},{"c":[[352.45,"«Con Archadia.",[352.45,352.78]],[353.67," Se la legittima sovrana di Dalmasca tratta, Ondore non ha più una causa per cui combattere.",[353.67,353.88,354.02,354.6,355.08,355.26,355.81,356.38,356.95,357.24,357.32,357.46,357.7,358.08,358.34,358.48]],[360.76," Senza una causa, la Resistenza è soltanto un esercito di uomini senza paga.",[360.76,360.76,360.92,361.83,362.04,362.62,362.72,363.1,363.22,363.72,363.86,364.24,364.58]],[365.4," Senza la Resistenza, Rozarria non ha nessuna ragione per muoversi.",[365.4,365.8,365.99,367.03,367.86,368.04,368.22,368.56,368.96,369.14]],[370.15," La guerra non avviene.»",[370.15,370.36,370.7,370.92]],[372.19," Il ragazzo parlava più in fretta, adesso, e per la prima volta si sentiva che aveva dodici anni.",[372.19,372.19,372.72,373.41,373.68,373.93,375.13,376.34,376.48,376.66,376.8,377.1,377.93,378.14,378.68,378.86,379.33,379.92]],[380.81," «Non vi chiedo di amare il mio paese, altezza.",[380.81,381.08,381.24,381.58,381.78,382.18,382.36,382.62,383.54]],[384.53," Non ve lo chiederei mai.",[384.53,384.8,384.96,385.08,385.85]],[386.55," Vi chiedo di salvare il vostro.»",[386.55,386.76,387,387.16,387.64,387.76]]]},{"c":[[389.64,"Ashe si mosse.",[389.64,390.04,390.28]],[391.42," Fece due passi verso il fuoco, e la luce le prese la faccia dal basso, e la faccia era bianca.",[391.42,391.62,391.76,392.16,392.38,392.52,393.31,393.46,393.58,393.78,393.88,394.12,394.24,394.5,394.68,395.52,395.66,395.76,396.02,396.16]]]},{"c":[[398.06,"«Salvare il mio paese» disse.",[398.06,398.54,398.64,398.72,399.04]],[399.81," «Trattando con voi.»",[399.81,400.48,400.69]]]},{"c":[[401.91,"«Con mio padre.",[401.91,402.18,402.36]],[403.23," Con il Senato.»",[403.23,403.5,403.68]]]},{"c":[[405.15,"«Con vostro fratello.»",[405.15,405.42,405.74]]]},{"c":[[407.24,"Larsa non distolse lo sguardo.",[407.24,407.67,407.85,408.34,408.48]],[409.34," «Anche con lui, se necessario.»",[409.34,409.74,409.95,410.73,410.94]]]},{"c":[[412.53,"«Vostro fratello ha fatto uccidere mio padre il giorno in cui doveva firmare la pace.»",[412.53,413,413.4,413.54,413.74,414.16,414.32,415.05,415.26,415.52,415.72,415.92,416.36,416.84,417]],[417.82," Ashe non alzò la voce.",[417.82,418.65,418.92,419.24,419.38]],[420.12," Non ne aveva bisogno: la casa era piccola, e ogni parola arrivava intera in ogni angolo.",[420.12,420.32,420.44,420.66,421.53,421.74,422.02,422.16,423.22,423.36,423.6,424.26,424.87,425.34,425.52,425.82]],[427.08," «Lo ha fatto uccidere con la faccia di un uomo che è seduto in questa stanza.",[427.08,427.08,427.18,427.36,427.86,428.02,428.14,428.44,428.56,428.66,428.96,429.14,429.26,429.68,429.82,430.11]],[431.29," Il vostro impero ha bruciato Nabudis per una pietra e ha lasciato morire nel deserto i soldati di Nalbina.",[431.29,431.5,431.87,432.65,432.86,433.22,433.72,433.88,434.07,434.72,434.86,434.94,435.3,435.72,435.92,436.34,436.44,436.84,436.98]],[438.3," Mio marito è morto su quelle mura con una freccia nel petto.",[438.3,438.3,438.68,438.84,439.24,439.42,439.72,440.69,440.96,441.14,441.52,441.8]],[442.78," E voi venite fin qui, a piedi, con un chocobo che morde, a chiedermi di firmare un trattato con la stessa famiglia che ha scritto il primo con il sangue.",[442.78,442.78,442.96,443.34,443.59,444.42,444.62,445.44,445.58,445.69,446.08,446.28,447.31,447.46,447.88,447.98,448.42,448.56,449.16,449.34,449.46,449.76,450.26,450.4,450.5,450.82,450.98,451.32,451.56,451.73]],[452.63," Perché?",[452.63]],[453.69," Per proteggere l'Impero?",[453.69,453.96,454.57]],[455.83," Volete che la regina di Dalmasca si inginocchi per salvare Archades da quello che le sta per succedere?»",[455.83,456.3,456.48,456.6,456.96,457.1,458.23,458.44,459.06,459.26,459.96,460.77,460.98,461.26,461.42,461.54,461.7,461.9]]]},{"c":[[463.89,"«Voglio che non vi inginocchiate affatto.",[463.89,464.36,464.52,464.77,464.98,465.54]],[467.17," Ma se la guerra comincia…»",[467.17,467.38,467.52,467.62,467.9]]]},{"c":[[469.49,"«Se la guerra comincia, Archadia perde.»",[469.49,469.7,469.82,470,470.72,471.44]]]},{"c":[[473.03,"«No» disse Larsa.",[473.03,473.5,473.9]],[474.89," «Se la guerra comincia, perde Rabanastre.»",[474.89,475.1,475.22,475.48,476.26,476.66]]]},{"c":[[478.37,"Lo disse piano.",[478.37,478.58,478.84]],[479.52," Ashe si fermò.",[479.52,480.07,480.3]]]},{"c":[[481.68,"«Avete visto il Leviatano» disse il ragazzo.",[481.68,482.08,482.4,482.52,483,483.27,483.48]],[484.49," «Io no.",[484.49,484.71]],[485.67," Io ho visto i rapporti.",[485.67,485.88,486.08,486.28,486.42]],[487.49," Ho letto i numeri.",[487.49,487.7,488.13,488.28]],[489.01," Le navi, i nomi degli equipaggi.»",[489.01,489.24,489.98,490.12,490.38,490.58]],[491.55," Si guardò le mani.",[491.55,491.76,492.1,492.26]],[493.3," «E ho letto i rapporti su Nabudis, che a palazzo non si leggono ad alta voce.",[493.3,493.3,493.38,493.66,493.8,494.28,494.42,495.45,495.72,495.86,496.3,496.48,496.64,497.02,497.2,497.48]],[498.35," Mio fratello non ha più l'Ottava Flotta, ma ha altre pietre.",[498.35,498.62,499.06,499.24,499.38,499.54,499.92,500.89,501.1,501.26,501.57]],[502.6," Quelle di Draklor.",[502.6,502.88,503.15]],[504.09," Ne fanno ancora, mentre noi parliamo.",[504.09,504.3,504.66,505.27,505.77,506.04]],[507.42," Se una flotta rozarriana arriva sopra Dalmasca e mio fratello ha una di quelle pietre in mano, e deve scegliere fra perdere una battaglia e perdere una città che non è sua…»",[507.42,507.42,507.58,508.01,508.74,509.14,509.7,510.6,510.74,510.9,511.36,511.5,511.7,511.82,512.06,512.49,512.7,513.65,513.8,514,514.4,514.58,514.98,515.2,515.72,515.86,516.1,516.24,516.64,516.8,516.94,517.13]],[518.59," Non finì la frase.",[518.59,518.86,519.18,519.34]],[521.76," Alzò gli occhi sulla principessa.",[521.76,522.1,522.26,522.48,522.72]],[523.83," «Lo conosco, altezza.",[523.83,524.13,525.04]],[525.78," Gli voglio bene.",[525.78,526.1,526.38]],[527.13," È per questo che lo conosco.",[527.13,527.28,527.46,527.78,527.96,528.1]],[529.02," Non so cosa sceglierebbe.",[529.02,529.25,529.46,529.78]],[531.18," E non sapere cosa sceglierebbe mio fratello è la cosa più spaventosa che mi sia mai successa.»",[531.18,531.18,531.32,531.76,531.98,532.54,532.72,533.7,533.84,533.96,534.18,534.38,535.1,535.26,535.4,535.6,536]]]},{"c":[[538.31,"Ashe lo guardò a lungo.",[538.31,538.93,539.14,539.53,539.68]]]},{"c":[[541.07,"«Non vi credo» disse.",[541.07,541.34,541.54,542.62]]]},{"c":[[543.61,"Larsa abbassò la testa.",[543.61,544.6,544.94,545.13]]]},{"c":[[546.39,"«Lo capisco.»",[546.39,546.63]]]},{"c":[[548.11,"«Non credo a una parola che esca dalla bocca di un Solidor.",[548.11,548.39,548.8,548.9,549.04,549.46,549.66,550,550.28,550.64,550.8,550.97]],[552.02," Non credo che siate qui da solo.",[552.02,552.3,552.6,552.7,553,553.2,553.36]],[555.44," Non credo che vostro fratello non sappia dove siete.",[555.44,555.44,555.84,556,556.36,556.94,557.16,557.54,557.74]],[559.25," Non credo che una principessa che entra al Bur-Omisace al vostro fianco ne esca regina.",[559.25,559.6,560,560.14,560.3,560.98,561.22,561.6,561.78,562.66,562.86,563.19,564.07,564.3,564.71]],[565.88," Ne esce prigioniera, oppure ne esce un pezzo di carta firmato, e la firma è la mia e la penna è vostra.»",[565.88,565.88,566.14,567.71,568.18,568.38,568.72,568.86,569.24,569.38,569.83,571.27,571.42,571.6,572.58,572.72,572.82,573.56,573.7,573.92,574.74,574.97]]]},{"c":[[576.54,"«Avete ragione a non credermi» disse Larsa.",[576.54,576.94,577.32,577.42,577.5,578.1,578.5]],[579.89," «Vi chiedo scusa.",[579.89,580.1,580.3]],[580.93," Non avrei dovuto chiedervi di fidarvi.",[580.93,581.2,581.44,581.72,582.16,582.3]],[582.99," Non ne avete nessuna ragione, e ne avete molte per fare il contrario.»",[582.99,583.26,583.36,583.56,583.94,584.91,585.06,585.14,585.38,585.78,585.96,586.18,586.28]],[587.24," Alzò la testa.",[587.24,587.58,587.75]],[589.73," «Allora non fidatevi di me.",[589.73,589.73,590,590.52,590.65]],[591.58," Tenetemi.»",[591.58]]]},{"c":[[594.3,"«Cosa?»",[594.3]]]},{"c":[[596.26,"«Tenetemi.",[596.26]],[597.28," Come ostaggio.»",[597.28,597.62]],[598.82," Larsa si alzò.",[598.82,599.49,599.72]],[600.74," Era più basso di Penelo, e le sue scarpe erano infangate fino alla caviglia, e lo disse con una semplicità che fece più impressione di qualsiasi giuramento.",[600.74,600.74,600.92,601.26,601.39,602.65,602.8,602.92,603.08,603.5,603.8,604.36,604.62,604.84,605.89,606.04,606.16,606.95,607.22,607.42,608.06,608.66,609,609.16,609.78,609.9,610.5]],[612.24," «Sono il quarto figlio dell'imperatore Gramis.",[612.24,612.24,612.4,612.68,613.05,613.91]],[614.89," Il fratello di Vayne.",[614.89,615.1,615.48,615.73]],[616.37," Se viaggio con voi, viaggio sotto la vostra spada.",[616.37,616.58,616.9,617.1,617.47,618,618.22,618.36,618.66]],[619.76," Se al Bur-Omisace succede qualcosa che non vi piace, se le mie parole risultano false, se mio fratello vi tende una trappola, avrete in mano l'unica cosa che lui non può permettersi di perdere.",[619.76,619.76,619.93,620.81,621.34,621.7,621.88,622,622.12,623.05,623.26,623.36,623.48,623.84,624.39,625.25,625.46,625.6,626.04,626.2,626.46,626.6,627.35,627.82,627.98,628.21,628.56,628.86,629.04,629.26,629.44,629.62,630.32,630.44]],[631.78," Non vi chiedo fiducia, altezza.",[631.78,631.78,631.92,632.24,633.69]],[634.77," Vi offro una garanzia.»",[634.77,634.98,635.34,635.56]]]},{"c":[[637.56,"Basch si era alzato.",[637.56,637.91,638.12,638.29]],[639.55," Penelo aveva la bocca aperta.",[639.55,640.02,640.34,640.46,640.68]],[641.33," Balthier aveva aperto anche l'altro occhio e si era messo a sedere sulle pelli, con un interesse che non provò a nascondere.",[641.33,642.2,642.46,642.78,643,643.26,644.32,644.46,644.6,644.7,644.98,645.1,645.36,645.6,646.49,646.76,646.9,647.34,647.5,647.66,648,648.14]]]},{"c":[[650.24,"Ashe non disse niente.",[650.24,650.61,650.88,651.21]],[652.28," Guardò il ragazzo in piedi davanti al fuoco, il colletto bianco, le mani ferme lungo i fianchi, e per un istante a Vaan parve che lei cercasse qualcosa da colpire e non lo trovasse.",[652.28,652.68,652.86,653.34,653.54,653.8,654.12,654.26,655.09,655.3,655.73,656.63,656.84,657.1,657.46,657.76,657.8,659.12,659.26,659.42,659.56,660,660.06,660.32,660.72,660.88,661.04,661.56,662.02,662.18,663.08,663.22,663.4,663.6]],[665.08," Poi la principessa si voltò, aprì la porta di pelle e uscì nella notte senza una parola.",[665.08,665.08,665.28,665.8,665.98,666.84,667,667.12,667.32,667.46,668.12,668.26,668.58,668.72,669.04,669.32,669.5]]]},{"c":[[671.09,"La porta ricadde dietro di lei.",[671.09,671.3,671.58,672.02,672.34,672.49]],[673.27," Larsa restò in piedi.",[673.27,673.68,674.02,674.18]]]},{"c":[[675.27,"«Le ho chiesto troppo» disse.",[675.27,675.48,675.6,675.9,676.96]]]},{"c":[[678.31,"«Le hai chiesto troppo» confermò Balthier, sdraiandosi di nuovo.",[678.31,678.52,678.68,679.19,680.18,680.93,681.69,682.48,682.62]],[683.47," «Ma lo hai chiesto bene.",[683.47,683.68,683.88,684,684.34]],[685.34," È già qualcosa.",[685.34,685.48,685.72]],[687.96," Molti chiedono troppo e lo chiedono male.»",[687.96,687.96,688.63,689.68,689.82,689.96,690.5]]]},{"c":[[692.42,"Basch guardò la porta, poi Larsa.",[692.42,692.81,693.28,693.38,694.13,694.44]],[695.06," L'ultima volta che aveva visto il principe, sul Leviatano, lo aveva lasciato tornare verso i suoi soldati.",[695.06,695.94,696.26,696.46,696.78,697.08,697.24,697.97,698.24,699.19,699.4,699.68,700.06,700.56,700.88,700.98,701.17]],[702.47," Ora era stato lui a mettersi nelle loro mani.",[702.47,703.02,703.3,703.59,703.86,704,704.46,704.68,704.92]]]},{"c":[[706.46,"«Siete coraggioso, altezza» disse il cavaliere.",[706.46,707.11,708.67,709.42,709.82,710]]]},{"c":[[711.37,"«No, capitano.",[711.37,711.76]],[712.88," Sono spaventato.",[712.88,713.27]],[714.47," Mi hanno insegnato che fra le due cose da fuori non si vede la differenza.»",[714.47,714.68,714.82,715.32,715.48,715.64,715.76,715.88,716.14,716.28,716.58,716.84,717,717.22,717.36]],[718.5," Larsa si rimise a sedere vicino al fuoco.",[718.5,718.9,719.1,719.42,719.56,719.86,720.26,720.36]],[722.4," Si tolse le scarpe infangate, con cura, e le mise ad asciugare.",[722.4,722.4,722.74,722.88,723.22,724.13,724.44,725,725.14,725.22,725.5,725.68]],[726.44," «Signorina Penelo.",[726.44,727.11]],[728.15," Avete ancora la pietra?»",[728.15,728.56,728.86,729.02]]]},{"c":[[730.79,"Penelo si portò la mano al collo.",[730.79,731.77,731.98,732.32,732.44,732.64,732.94]]]},{"c":[[734.47,"«Sì.»",[734.47]]]},{"c":[[736.28,"«Bene.»",[736.28]],[737.47," Lui sorrise, e il sorriso questa volta era quello di un ragazzo di dodici anni.",[737.47,737.76,738.88,739.02,739.14,739.6,739.86,740.76,741.04,741.38,741.52,741.6,742.04,742.25,742.8]],[743.78," «Tenetela.",[743.78]],[745.05," Mi fa piacere saperla con voi.»",[745.05,745.26,745.44,745.84,746.26,746.52]]]},{"c":[[749.58,"Fuori la notte era chiara.",[749.58,749.98,750.12,750.4,750.56]],[751.92," Le nuvole se n'erano andate verso est e sopra Kerwon il cielo era pieno di stelle, così tante e così vicine che sembravano appese ai pali della Collina degli Antichi insieme alle pietre.",[751.92,751.92,752.28,752.4,752.76,753.08,753.49,754.72,754.86,755.18,755.63,755.84,756.08,756.24,756.58,756.68,757.56,758.01,758.47,758.56,758.66,759.43,759.7,760.26,760.66,760.84,761.18,761.36,761.74,761.94,762.72,763.16,763.34]],[764.42," I fuochi di Jahara bruciavano bassi davanti alle case.",[764.42,764.42,764.76,764.88,765.26,765.8,766.16,766.48,766.64]],[767.42," Da qualche parte un Garif cantava, piano, una canzone di tre note che tornava sempre uguale.",[767.42,767.56,767.78,768.14,768.41,769.09,769.86,770.67,770.94,771.34,771.52,771.7,772.04,772.24,772.62,772.99]]],"st":1},{"c":[[774.99,"Ashe camminava.",[774.99,775.62]],[776.73," Non sapeva dove andava.",[776.73,777.11,777.58,777.89]],[779.48," Aveva lasciato la casa perché dentro c'era un ragazzo che le aveva offerto se stesso come si offre una moneta, e lei non aveva saputo cosa rispondere,",[779.48,779.48,779.9,780.08,780.83,781.3,782.12,782.67,782.88,783.38,783.54,783.68,784.02,784.59,784.8,785.14,785.42,785.6,785.96,786.2,787.38,787.55,788.02,788.3,788.6,789,789.3]],[790.84," e una principessa che non sa cosa rispondere deve almeno avere la decenza di non farsi vedere.",[790.84,790.84,791,791.64,791.86,792.03,792.24,792.48,793.5,793.84,794.18,794.52,794.7,795.14,795.3,795.42,795.74]],[796.99," Attraversò un ponte.",[796.99,797.72,797.9]],[798.94," I suoi passi facevano oscillare le tavole.",[798.94,799.08,799.28,799.64,800.25,800.92,801.1]],[802.3," Si fermò al centro, con le mani sulle corde, e guardò giù, verso la pianura nera, dove l'erba di Ozmone si muoveva sotto il vento senza luce.",[802.3,802.3,802.62,802.74,803.59,803.86,803.98,804.24,804.58,805.48,805.62,806.09,806.7,807.1,807.3,807.76,808.42,808.72,809.1,809.31,809.95,810.16,810.62,810.9,811.06,811.44,811.82]]]},{"c":[[813.67,"La vendetta era una cosa semplice.",[813.67,813.88,814.93,815.2,815.42,815.68]],[816.72," Questa era la cosa che nessuno le aveva mai detto e che lei aveva scoperto da sola, in due anni di nascondigli e di cantine: la vendetta era una cosa semplice e calda,",[816.72,817.13,817.4,817.58,817.86,818.07,818.6,818.74,819.02,819.24,820.46,820.6,820.83,821.32,821.72,822.22,822.44,823.33,823.54,823.7,824.04,824.18,824.98,825.12,825.22,826.71,826.92,827.44,827.7,827.88,828.14,828.74,828.92]],[830," e stava in mano come una pietra levigata, e la sera, quando ci si sdraiava al buio, era l'unica cosa che non pungeva.",[830,830,830.22,830.36,830.5,830.72,830.9,831.24,832.18,832.32,832.44,832.91,833.38,833.56,833.74,834.14,834.28,834.99,835.2,835.62,835.9,836.06,836.23]],[837.17," Ci si poteva dormire sopra.",[837.17,837.38,837.48,837.78,838.2]],[838.89," Si sapeva dove stava.",[838.89,839.1,839.46,839.68]],[840.94," La pace che il ragazzo le offriva non aveva forma.",[840.94,840.94,841.22,841.36,841.5,841.8,841.92,842.34,842.5,842.8]],[843.59," Non si poteva stringere.",[843.59,843.86,844,844.32]],[845.45," Le sfuggiva tra le dita.",[845.45,845.66,846.14,846.3,846.44]]]},{"c":[[848.05,"Sollevò la testa.",[848.05,848.58,848.8]]]},{"c":[[849.72,"C'era qualcuno in fondo al ponte.",[849.72,850.46,850.96,851.12,851.34,851.48]],[852.76," Stava fermo all'imbocco opposto, in piedi, nella luce di un fuoco che lo prendeva di fianco, e portava un'armatura leggera dal taglio nabradiano, e aveva i capelli chiari della gente del nord-est.",[852.76,852.76,853.03,853.58,854.55,854.8,855.32,855.72,856.02,856.14,856.24,856.56,856.7,856.82,857.2,857.35,858.41,858.56,858.97,859.56,860.06,860.2,860.58,861.82,861.96,862.26,862.4,862.76,863.12,863.34,863.62,863.84]],[865.23," Ashe sentì il cuore fermarsi e ripartire, tutto in un colpo, così forte che le corde del ponte vibrarono sotto le sue mani.",[865.23,866.46,866.86,867.06,867.48,868.1,868.24,869.58,869.98,870.16,870.42,871.4,871.84,872.59,872.86,872.98,873.3,873.46,873.8,874.42,874.66,874.8,875]]]},{"c":[[877.33,"«Rasler.»",[877.33]]]},{"c":[[878.35,"Lo disse a voce alta.",[878.35,878.56,878.91,879.06,879.32]],[880.43," Lo disse prima di poterlo trattenere.",[880.43,880.64,881.44,881.84,882,882.44]]]},{"c":[[883.95,"La figura si mosse.",[883.95,884.16,884.5,884.74]],[885.76," Fece un passo avanti, nella luce, e non era Rasler.",[885.76,886.1,886.2,886.51,887.15,887.62,888.72,888.86,889,889.33]],[890.37," Era Vaan.",[890.37,890.99]],[891.82," Aveva la giubba aperta, la fascia rossa allentata in vita e un pezzo di focaccia in mano, e i capelli chiari, sotto le stelle, avevano ingannato una vedova per il tempo di un battito.",[891.82,891.82,891.92,892.23,892.87,893.08,893.44,893.74,894.16,894.32,894.89,895.04,895.14,895.44,895.56,896.02,896.14,897.12,897.19,897.26,897.68,898.27,898.68,898.86,899.5,900.04,900.57,900.72,901.02,901.18,901.32,901.54,901.68,901.8]],[902.88," Si fermò sull'imbocco del ponte e la guardò.",[902.88,902.88,903.16,903.78,903.94,904.8,904.94,905.02]],[905.83," Non con la faccia di chi ha sentito pronunciare un nome che non è il suo, e si imbarazza, e finge di non avere sentito.",[905.83,906.1,906.34,906.5,906.8,906.9,907.04,907.14,907.52,908.1,908.22,908.42,908.64,908.8,908.94,909.19,909.89,910.04,910.18,911.22,911.38,911.78,911.9,912.02,912.33]],[913.09," Con un'altra faccia.",[913.09,913.32,913.87]]]},{"c":[[915.65,"«Anche tu» disse Vaan.",[915.65,916.06,916.26,917.32]]]},{"c":[[918.17,"Ashe strinse le corde.",[918.17,919.02,919.56,919.86]]]},{"c":[[921.34,"«Cosa?»",[921.34]]]},{"c":[[922.54,"«L'hai visto anche tu.»",[922.54,923.74,924.08,924.35]],[924.67," Vaan si avvicinò lungo il ponte, adagio, perché le tavole oscillavano.",[924.67,925.3,925.48,925.94,926.24,926.36,927.1,927.99,928.46,928.6,928.96]],[930.11," «Adesso.",[930.11]],[931.11," Laggiù, vicino al fuoco.",[931.11,931.59,932.06,932.2]],[932.68," Prima di me.",[932.68,933.08,933.24]],[934.08," C'era qualcuno.»",[934.08,934.18]],[935.03," Si fermò a tre passi da lei.",[935.03,935.24,935.65,935.8,936,936.4,936.5]],[936.94," «Come nella tomba.",[936.94,937.28,937.54]],[938.05," Ti ricordi?",[938.05,938.26]],[938.99," Quando eravamo là sotto.",[938.99,939.46,939.84,940.01]],[940.81," Ti sei fermata e guardavi in fondo alla sala, e io ho guardato anche io, e c'era uno.",[940.81,941.02,941.18,941.68,941.82,942.2,942.4,942.62,942.78,943.72,943.86,944.02,944.14,944.64,944.95,945.46,945.57,946]],[946.77," Un soldato.»",[946.77,947.02]]]},{"c":[[949.21,"Ashe non si muoveva più.",[949.21,950.02,950.31,950.52,950.92]]]},{"c":[[952.78,"«Non l'ho detto a nessuno» disse Vaan.",[952.78,953.03,953.28,953.51,953.69,954.46,955.32]],[956," «Pensavo di essermelo immaginato.",[956,956.54,956.66,957.06]],[958.43," Pensavo che fosse la tomba, il buio, quelle cose.",[958.43,958.96,959.1,959.4,959.68,960.51,960.84,961.6,961.8]],[963.18," Poi tu hai allungato la mano, e la mano gli è passata attraverso.",[963.18,963.18,963.3,963.5,963.96,964.1,965.32,965.46,965.6,965.92,966.06,966.14,966.48]],[967.74," L'ho visto.",[967.74,968.12]],[969.11," Gli è passata attraverso come attraverso il fumo.»",[969.11,969.38,969.46,969.88,970.38,970.68,971.24,971.44]]]},{"c":[[973.19,"Il canto del Garif, da qualche parte sulla collina, si era fermato.",[973.19,973.4,973.74,974,974.79,975,975.26,975.62,975.9,977.07,977.28,977.5]]]},{"c":[[979.14,"«Era Rasler» disse Ashe.",[979.14,979.57,980.42,981.38]],[982.15," Lo disse a fatica, come se la parola dovesse attraversare qualcosa di stretto.",[982.15,982.36,982.6,982.74,983.58,984.59,984.8,984.94,985.22,985.56,986.1,986.48,986.66]],[986.86," «Mio marito.»",[986.86,986.95]]]},{"c":[[988.85,"«Lo so.»",[988.85,989.65]],[989.86," Vaan si grattò la nuca.",[989.86,990.28,990.48,990.76,990.86]],[991.36," «L'ho capito là sotto.",[991.36,991.74,992.06,992.18]],[992.99," Era quello della carrozza, il giorno delle nozze.",[992.99,993.26,993.58,993.82,994.87,995.08,995.48,995.77]],[996.51," Me lo sono ricordato dalla carrozza.»",[996.51,996.72,996.82,997,997.52,997.72]],[998.66," Fece una pausa.",[998.66,999,999.14]],[1000.12," «Ma io l'ho visto una volta sola, da lontano, per il tempo di una pesca.",[1000.12,1000.35,1000.5,1000.72,1001,1001.16,1001.46,1002.23,1002.5,1003.52,1003.8,1003.94,1004.22,1004.36,1004.5]],[1005.37," Non lo conoscevo.",[1005.37,1005.64,1005.76]],[1006.72," E l'ho visto là sotto, e adesso.",[1006.72,1006.78,1006.98,1007.22,1007.39,1008.32,1008.46]],[1009.57," Io.»",[1009.57]]]},{"c":[[1011.14,"«Non è possibile.»",[1011.14,1011.42,1011.54]]]},{"c":[[1013.25,"«Lo so che non è possibile.»",[1013.25,1013.46,1013.62,1013.78,1013.9,1014]]]},{"c":[[1015.43,"Ashe lo guardò come non lo aveva mai guardato.",[1015.43,1016.07,1016.28,1016.98,1017.32,1017.5,1017.6,1017.86,1018.02]],[1019.58," Fino a quel momento Vaan era stato per lei un ladro, un ragazzo fastidioso, una bocca che faceva domande inopportune a tavola;",[1019.58,1019.58,1019.7,1019.8,1020.49,1020.88,1021.16,1021.38,1021.54,1021.74,1021.94,1022.69,1022.9,1023.28,1024.37,1024.64,1024.98,1025.16,1025.48,1025.88,1026.54,1026.68]],[1027.66," qualcuno che era capitato nella sua storia per sbaglio e che ci restava per ostinazione.",[1027.66,1028.1,1028.22,1028.34,1028.84,1029.06,1029.26,1029.66,1029.84,1030.67,1030.82,1030.98,1031.16,1031.6,1031.82]],[1033.31," Adesso stava sullo stesso ponte, davanti allo stesso fuoco, e aveva visto lo stesso morto.",[1033.31,1034.13,1034.54,1034.84,1035.41,1036.06,1036.58,1036.84,1037.13,1038.02,1038.16,1038.44,1038.8,1038.98,1039.5]]]},{"c":[[1041.13,"«Allora cos'hai visto?»",[1041.13,1041.69,1042.26]],[1043.04," chiese lei.",[1043.04,1043.38]],[1044.33," La voce le era uscita più dura di come voleva.",[1044.33,1044.54,1044.84,1044.98,1045.14,1045.5,1045.72,1046,1046.12,1046.32]],[1047.17," «Se non lo conoscevi.",[1047.17,1047.38,1047.52,1047.64]],[1048.4," Cos'hai visto davvero, Vaan?»",[1048.4,1048.9,1049.14,1049.61]]]},{"c":[[1050.98,"Vaan ci pensò.",[1050.98,1051.26,1051.5]],[1052.63," Si guardò la focaccia in mano, come se ci fosse scritta sopra la risposta, e non c'era.",[1052.63,1052.84,1053.16,1053.28,1053.66,1053.82,1054.76,1055.13,1055.34,1055.48,1055.74,1056.14,1056.48,1056.6,1058.1,1058.24,1058.5]]]},{"c":[[1060.32,"«Non lo so» disse.",[1060.32,1060.6,1060.76,1060.92]],[1061.91," «Forse non era lui.",[1061.91,1062.68,1062.96,1063.2]],[1063.84," Forse io vedevo un altro.»",[1063.84,1064.75,1064.96,1065.3,1065.44]]]},{"c":[[1066.64,"«Chi?»",[1066.64]]]},{"c":[[1068.42,"Lui alzò le spalle.",[1068.42,1068.72,1069.06,1069.18]],[1070.66," Era un gesto da ragazzo, da Città Bassa, il gesto che si fa per dire che una cosa non è importante, e non gli riuscì.",[1070.66,1070.66,1070.82,1071.87,1072.22,1073.29,1073.52,1074.04,1075.19,1075.5,1076.08,1076.36,1076.48,1076.64,1076.88,1077.06,1077.26,1077.5,1077.84,1078.12,1078.26,1079.45,1079.6,1079.8,1079.93]],[1081.13," Le spalle gli ricaddero a metà.",[1081.13,1081.34,1082.28,1082.5,1083.16,1083.28]]]},{"c":[[1085.18,"«Reks» disse.",[1085.18,1085.46]]]}]