[{"h":1,"c":[[1.5,"Capitolo sedicesimo: Tre sconosciuti nelle fogne.",[1.5,2.65,4.58,5.16,6.08,6.54]]]},{"c":[[9.81,"Vaan tornò in sé tossendo acqua,",[9.81,10.33,10.73,10.88,11.04,11.65]],[12.8," a pancia in giù su una lastra di pietra bagnata,",[12.8,12.95,13.29,13.47,13.65,13.85,14.03,14.45,14.61,15.05]],[16.33," con la sensazione precisa di aver bevuto mezza Rabanastre e la sensazione meno precisa,",[16.33,16.33,16.47,17.09,17.62,17.83,18.01,18.37,18.67,19.84,19.99,20.09,20.65,20.93]],[22.41," ma più urgente, di avere ancora la pietra.",[22.41,22.41,22.77,23.78,23.99,24.17,24.45,24.6]],[25.56," Ce l'aveva.",[25.56,25.83]],[26.66," Era sotto di lui,",[26.66,26.93,27.23,27.38]],[28.25," schiacciata fra il petto e la lastra,",[28.25,29.05,29.27,29.64,30.84,30.99,31.14]],[32.23," e gli premeva contro lo sterno come un pugno tiepido.",[32.23,32.23,32.37,32.89,33.28,33.49,33.89,34.11,34.27,34.64]],[36.13," La toccò attraverso la camicia fradicia.",[36.13,36.13,36.54,37.27,37.43,38.26]],[39.24," Poi si girò sulla schiena e guardò in alto.",[39.24,39.24,39.45,39.71,39.99,40.37,40.47,40.79,40.95]]]},{"c":[[43.06,"In alto c'era una volta di pietra,",[43.06,43.29,43.82,44.35,44.55,44.81,44.97]],[46.22," lontana, e un buco nella volta, frastagliato, attraverso cui si vedeva un pezzo di cielo rosso.",[46.22,47.56,47.71,47.87,48.21,48.46,49.45,50.43,51.11,51.31,51.49,51.81,51.93,52.25,52.39,52.63]],[53.91," Dal buco cadeva ancora qualcosa ogni tanto:",[53.91,53.91,54.23,54.59,54.87,55.27,55.51]],[56.82," un sasso, una manciata di terra, una tegola, che arrivava giù con un rumore secco e finiva nell'acqua.",[56.82,56.82,57.77,58.05,58.47,58.63,59.41,59.64,60.3,60.57,61.01,61.23,61.41,61.51,61.98,62.88,63.03,63.73]],[64.79," Il fragore del cortile, lassù, era diventato un brontolio lontano.",[64.79,64.79,65.11,65.29,65.75,66.45,66.73,67.23,67.36,68.31]],[69.49," Qualcuno, sopra la città, gridava ancora.",[69.49,69.95,70.33,70.5,71.16,71.69]]]},{"c":[[75.28,"«Ah.",[75.28]],[76.48," Il nostro personaggio secondario è sveglio.»",[76.48,76.48,76.8,77.36,77.98,78.12]]]},{"c":[[80.67,"L'uomo era seduto su un gradino di pietra a due passi da lui, a strizzarsi una manica.",[80.67,81.06,81.24,81.64,81.8,81.9,82.28,82.42,82.88,83.02,83.16,83.52,83.64,84.5,84.56,85.24,85.42]],[86.72," Lo faceva con cura,",[86.72,86.72,87.08,87.42]],[88.44," attorcigliando la stoffa bianca dal polso al gomito,",[88.44,89.12,89.28,89.71,90.18,90.45,90.87,91.08]],[92.4," e l'acqua gocciolava per terra in un filo sottile.",[92.4,92.45,92.74,93.26,93.5,93.8,93.98,94.12,94.39]],[95.72," Si era tolto il panciotto e l'aveva steso su una sporgenza del muro,",[95.72,95.72,95.84,96.12,96.22,97.4,97.46,97.86,98.2,98.36,98.5,99.04,99.2]],[100.45," ben aperto, perché asciugasse senza pieghe.",[100.45,100.45,101.37,101.84,102.36,102.67]],[103.64," I capelli gli si erano incollati alla fronte.",[103.64,103.78,104.48,104.76,104.92,105.14,105.62,105.77]],[107.05," Il ciuffo, notò Vaan con un'oscura soddisfazione, non c'era più.",[107.05,107.05,107.76,108.18,108.6,108.82,109.38,110.66,110.9,111.22]]]},{"c":[[113.98,"Poco più in là, mezzo dentro e mezzo fuori dall'acqua, c'era la barca volante,",[113.98,114.32,114.52,114.72,115.38,115.78,116.12,116.26,116.56,117.01,117.82,118.18,118.32,118.64]],[120.56," inclinata su un fianco come un pesce morto,",[120.56,120.56,120.72,120.82,121.2,121.42,121.54,121.97]],[123.28," con un'ala piegata.",[123.28,123.39,123.59]],[125.14," La viera ci stava sopra.",[125.14,125.14,125.53,125.74,126.02]],[127.82," Aveva aperto un pannello sulla coda e frugava dentro con le dita lunghe,",[127.82,127.82,128.14,128.26,128.64,128.86,129.63,129.78,130.24,130.6,130.82,130.94,131.1]],[132.4," e ogni tanto avvicinava l'orecchio al motore e ascoltava,",[132.4,132.4,132.56,132.8,133.32,133.78,133.88,134.83,134.98]],[137.6," immobile, come si ascolta il petto di un ammalato.",[137.6,137.6,137.94,138.12,138.54,138.7,139.02,139.14,139.28]]]},{"c":[[141.43,"«Allora?»",[141.43]],[142.44," disse l'uomo, senza smettere di strizzare.",[142.44,142.94,143.44,143.84,144.34,144.48]]]},{"c":[[146.65,"«Niente di rotto» disse la viera.",[146.65,147.12,147.35,147.94,148.34,148.5]],[149.88," «Niente che manca.»",[149.88,149.88,150.06]],[150.72," Richiuse il pannello.",[150.72,151.32,151.42]],[152.37," «Ha smesso e basta.»",[152.37,152.58,153.22,153.36]]]},{"c":[[155.47,"«Le cose non smettono e basta, Fran.",[155.47,155.68,155.9,156.06,156.48,156.56,157.46]],[158.18," Non quelle che ho pagato io.»",[158.18,158.18,158.5,158.62,158.75,159.31]]]},{"c":[[162.03,"«Questa sì.»",[162.03,162.53]]]},{"c":[[163.07,"L'uomo sospirò.",[163.07,164.41]],[165.2," Poi guardò Vaan, e la manica che strizzava, e di nuovo Vaan.",[165.2,165.48,166.35,166.94,167.08,167.2,167.58,167.74,168.88,169.02,169.12,169.48]]]},{"c":[[171.44,"«Comunque non la rimetteremmo in aria.",[171.44,172.47,172.74,172.88,173.52,173.66]],[175.51," Lassù c'è una nave da guerra che spara a tutto quello che si muove,",[175.51,175.66,175.72,175.86,176.12,176.26,176.62,176.86,177.26,177.34,177.74,178.1,178.26,178.44]],[179.5," e io mi muovo con molta grazia,",[179.5,179.5,179.66,179.8,180.1,180.3,180.71]],[181.96," il che mi rende un bersaglio eccellente.",[181.96,181.96,182.45,182.68,183.08,183.22,184.15]],[185.68," Si va a piedi.»",[185.68,185.68,185.85,186]],[186.87," Lasciò andare la manica.",[186.87,187.34,187.56,187.72]],[188.59," «Ti sei rotto qualcosa, ragazzo?»",[188.59,188.8,188.96,189.2,189.72]]]},{"c":[[191.23,"Vaan si mise a sedere.",[191.23,192.09,192.3,192.57,192.72]],[193.78," Gli faceva male tutto,",[193.78,193.78,194.12,194.32]],[195.68," in quel modo uniforme e vago che vuol dire che non si è rotto niente di preciso.",[195.68,195.68,196,196.92,197.67,197.96,198.6,198.88,199.14,199.6,199.88,200.08,200.26,200.32,200.58,200.92,201.08]]]},{"c":[[203.17,"«No.»",[203.17]]]},{"c":[[206.94,"«Peccato.",[206.94]],[206.94," Avrei avuto un buon motivo per lasciarti qui.»",[206.94,207.34,207.62,207.74,207.9,208.28,208.48,208.9]]]},{"c":[[211.91,"Ci volle un po' prima che Vaan riuscisse a smettere di guardare la viera.",[211.91,211.91,212.25,212.41,212.47,212.73,212.94,213.22,213.89,213.99,214.39,214.53,214.99,215.11]],[216.37," Lei se ne accorse subito, naturalmente; doveva essere abituata, perché non si voltò e non disse niente,",[216.37,216.37,216.53,216.61,216.95,217.41,218.92,219.39,219.67,220.27,220.53,220.77,221.06,221.63,221.77,221.93,222.28]],[223.89," continuò a sistemare la barca volante tirandola fuori dall'acqua per la coda,",[223.89,223.89,224.01,224.47,224.59,224.93,225.41,225.89,226.13,226.55,226.71,226.81]],[227.95," da sola, con una forza che una cosa così magra non avrebbe dovuto avere.",[227.95,227.95,228.72,228.99,229.21,229.91,230.19,230.39,230.75,231.21,231.95,232.23,232.61,232.97]],[234.08," Fu l'uomo, alla fine, a dirlo.",[234.08,234.28,234.77,235.11,235.76,235.91]]],"st":1},{"c":[[237.51,"«Non ne avevi mai vista una.»",[237.51,237.79,237.91,238.21,238.45,238.91]]]},{"c":[[240.73,"Vaan arrossì.",[240.73,241.56]],[242.56," Era la terza volta in una settimana, e cominciava a pensare che fosse una malattia.",[242.56,242.83,242.99,243.29,243.55,243.71,243.87,244.76,244.91,245.33,245.45,245.77,245.91,246.19,246.35]]]},{"c":[[248.8,"«No.",[248.8]],[249.41," Scusa.",[249.41]],[250.93," Non volevo...»",[250.93,250.93]]]},{"c":[[253.19,"«Non scusarti con me.",[253.19,253.46,254.02,254.26]],[254.81," Io ci sono abituato.",[254.81,255.02,255.18,255.42]],[256.78," La gente la guarda e io guardo la gente che la guarda, ed è uno dei piaceri della vita.»",[256.78,256.78,257,257.19,257.94,258.08,258.22,258.58,258.68,258.94,259.12,259.31,260.01,260.22,260.34,260.44,260.62,261.04,261.2]],[262.36," L'uomo si alzò, si stirò la schiena,",[262.36,262.54,262.72,263.39,263.6,263.84,263.98]],[265.62," riprese il panciotto dalla sporgenza e lo esaminò controluce con aria critica.",[265.62,265.62,265.78,266.24,266.46,267.48,267.62,267.72,268.19,268.87,269.14,269.36]],[270.72," «Le viere non escono dai loro boschi.",[270.72,270.72,271.02,271.2,271.6,271.8,272]],[273.47," Lo sai, no?",[273.47,273.47,273.79]],[274.65," Stanno là dentro da secoli, con i loro alberi e i loro silenzi,",[274.65,275.12,275.26,275.56,275.72,276.35,276.62,276.72,276.92,277.34,277.42,277.48,277.64]],[278.9," e guardano il mondo degli uomini come si guarda un formicaio:",[278.9,278.9,279.28,279.4,279.6,279.85,280.6,280.94,281.14,281.46,281.63]],[283.12," con interesse e da lontano.",[283.12,283.12,284.19,284.34,284.58]],[285.92," Una viera che viaggia è una cosa rara.",[285.92,285.92,286.22,286.38,287.25,287.4,287.58,287.96]],[289.28," Una viera che viaggia con un Huma, poi...»",[289.28,289.28,289.6,289.8,290.22,290.42,290.7,291.27]]]},{"c":[[294.02,"«È una cosa che non si spiega» disse Fran, dalla barca.",[294.02,294.16,294.32,294.56,294.76,294.96,295.17,296.02,296.6,297.08,297.56]],[298.81," «Come un aviopirata che entra in un palazzo dalle fogne.»",[298.81,298.81,298.95,299.68,299.88,300.14,300.28,300.4,300.88,301.14]]]},{"c":[[303.17,"Lo disse con la stessa voce con cui aveva detto beve,",[303.17,303.38,303.66,303.88,304,304.32,304.66,304.88,305.02,305.34,306.3]],[307.58," sulla barca volante,",[307.58,307.58,308.04]],[310.38," piatta e un po' roca,",[310.38,310.38,310.52,310.99,311.45]],[312.38," senza alzare la testa.",[312.38,312.38,312.8,313.04]],[314.27," Ma Vaan non la sentì così.",[314.27,314.51,315,315.28,315.5,315.96]],[318.28," Vaan sentì soltanto due parole,",[318.28,318.28,318.68,319.21,319.48]],[320.8," e le due parole gli entrarono dentro come l'acqua del canale gli era entrata in bocca,",[320.8,320.8,320.92,321.11,321.89,322.16,322.7,323.36,323.64,324.06,324.25,324.91,325.18,325.3,325.66,325.78]],[327.55," tutte in una volta.",[327.55,327.55,327.76,328.08]]]},{"c":[[329.91,"«Pirata» disse.",[329.91,330.38]],[331.23," «Pirata del cielo.",[331.23,331.7,331.88]],[332.48," Siete pirati del cielo?»",[332.48,332.89,333.36,333.54]]]},{"c":[[335.22,"L'uomo si girò verso Fran con un'espressione di rimprovero.",[335.22,336.23,336.44,336.68,336.94,337.28,337.44,338.12,338.22]]]},{"c":[[340,"«Fran.»",[340]]]},{"c":[[342.84,"«Mm.»",[342.84]]]},{"c":[[344.26,"«Avevamo deciso di non dirlo.»",[344.26,344.8,345.26,345.36,345.52]]]},{"c":[[347.45,"«Tu avevi deciso.»",[347.45,347.66,348.21]]]},{"c":[[350.08,"«Siete pirati» ripeté Vaan.",[350.08,350.51,351.34,352.29]],[352.92," Si era alzato in piedi senza accorgersene,",[352.92,352.92,353.04,353.42,353.56,353.86,354.14]],[356.23," gocciolando, con le mani strette a pugno sul petto, sopra la pietra.",[356.23,357.27,357.54,357.68,357.92,358.42,358.56,358.86,359.18,359.96,360.34,360.5]],[361.49," Il dolore uniforme e vago era sparito.",[361.49,361.7,362.12,362.72,362.86,363.43,363.74]],[364.94," «Avete una nave.",[364.94,365.28,365.46]],[366.49," Una nave vostra.",[366.49,366.76,367]],[367.91," Volate dove volete.",[367.91,368.38,368.58]],[369.45," Non chiedete il permesso a nessuno.",[369.45,369.72,370.14,370.26,370.7,370.84]],[371.75," È così?",[371.75,371.9]],[372.72," È così?»",[372.72,372.86]]]},{"c":[[375.16,"L'uomo lo guardò a lungo.",[375.16,375.5,375.66,376,376.12]],[378.62," Sulla sua faccia, per un istante, passò qualcosa che Vaan non seppe leggere, e che forse era tenerezza,",[378.62,378.62,378.84,379.47,379.74,379.86,380.68,381.08,381.54,381.72,381.96,382.14,382.54,383.4,383.54,383.7,384.29,384.56]],[386.02," o forse era il fastidio di chi si vede davanti,",[386.02,386.02,386.83,387.1,387.24,387.8,387.92,388.06,388.22,388.6]],[390.1," all'improvviso, una versione di se stesso più giovane e più ingenua e non sa se esserne lusingato.",[390.1,390.78,390.98,391.54,391.66,391.84,392.22,392.46,393,393.14,393.28,394.44,394.58,394.77,394.99,395.2,395.77]]]},{"c":[[398.13,"«Più o meno» disse.",[398.13,398.44,398.58,398.76]],[399.59," «Il permesso, in effetti, non lo chiediamo.",[399.59,399.8,400.69,400.9,401.49,401.76,401.88]],[403.05," Ma ci viene negato lo stesso, molto spesso, e con le armi.",[403.05,403.05,403.26,403.48,403.88,404.06,404.74,405.25,407,407.14,407.34,407.56]],[408.72," È un dettaglio che nei racconti si omette.»",[408.72,408.72,408.84,409.4,409.64,409.8,410.3,410.48]]]},{"c":[[414.81,"«E l'aeronave?",[414.81,414.89]],[415.53," Dov'è?",[415.53]],[415.82," Com'è?",[415.82]],[416.11," Quanto è veloce?»",[416.11,416.58,416.71]]]},{"c":[[418.54,"«Calma.",[418.54]],[419.6," Calma, per carità.»",[419.6,420.08,420.22]],[421.15," L'uomo alzò le mani.",[421.15,421.92,422.26,422.4]],[423.52," «Una cosa alla volta.",[423.52,423.52,423.84,424]],[425.1," Prima ci presentiamo, come la gente educata.",[425.1,425.38,425.54,426.56,426.9,427.08,427.4]],[428.51," Poi usciamo da questa fogna.",[428.51,428.72,429.1,429.26,429.54]],[432.27," Poi, se sarai molto fortunato e molto zitto, forse ti dirò di che colore è.»",[432.27,432.27,432.48,432.82,433.12,433.78,433.92,434.2,435.16,435.65,435.86,436.1,436.22,436.34,436.81]],[437.92," Si mise una mano sul petto e fece un piccolo inchino,",[437.92,437.92,438.2,438.44,438.64,438.86,439.75,439.9,440.2,440.38,440.82]],[441.88," perfetto, da sala da ballo, che in quella galleria piena d'acqua e di muschio fece uno strano effetto.",[441.88,442.99,443.2,443.44,443.58,444.45,444.72,444.86,445.12,445.74,446.1,446.54,446.66,446.8,447.82,448.16,448.38,448.9]],[450.58," «Balthier.",[450.58]],[451.43," Aviopirata, come la mia socia ha voluto rivelare.",[451.43,452.5,452.84,452.96,453.1,453.4,453.56,453.76]],[454.63," Lei è Fran.»",[454.63,454.9,456.12]]]},{"c":[[457,"«Fran» disse Vaan.",[457,457.55,458.23]]]},{"c":[[460.27,"La viera alzò gli occhi rossi su di lui, e chinò la testa, appena.",[460.27,460.48,460.68,460.94,461.08,461.26,461.62,461.74,461.85,462.81,462.96,463.16,463.48,464.31]],[465.68," Fu tutta la sua presentazione.",[465.68,465.68,466.04,466.16,466.3]]]},{"c":[[469.23,"«E tu?»",[469.23,469.23]],[469.73," chiese Balthier.",[469.73,470.57]]]},{"c":[[471.69,"Vaan pensò a tutte le cose che avrebbe potuto dire.",[471.69,472.26,472.66,472.8,473.02,473.16,473.4,473.54,473.89,474.36]],[475.31," Vaan della bottega di Migelo.",[475.31,476.26,476.78,477.32,477.53]],[479.7," Vaan della Città Bassa.",[479.7,479.7,479.94,480.7]],[482.16," Il fratello di Reks.",[482.16,482.16,482.72,483.39]],[484.74," Nessuna gli sembrò all'altezza di un inchino da sala da ballo.",[484.74,484.74,484.9,485.25,485.84,485.98,486.08,486.44,486.58,486.88,488.21]]]},{"c":[[489.03,"«Vaan» disse.",[489.03,489.3]],[490.22," E poi, perché la cosa gli sembrava ancora troppo poco: «Lo sterminatore di topi.",[490.22,490.49,491.05,491.52,491.68,491.94,492.08,492.46,492.78,493.12,493.85,494.06,494.74,494.96]],[496.08," Del condotto dei Calderai.»",[496.08,496.08,496.54,496.72]]]},{"c":[[498.81,"Ci fu un silenzio.",[498.81,499.02,499.2,499.38]],[500.34," Balthier lo fissò.",[500.34,501.29,501.6]],[502.6," Fran lo fissò.",[502.6,503.41,503.62]],[504.76," In fondo alla galleria una goccia cadde nell'acqua con un rumore minuscolo e definitivo.",[504.76,504.76,505.08,505.22,505.64,505.88,506.22,506.49,506.98,507.2,507.34,507.7,508.34,508.51]]]},{"c":[[510.59,"«Ma guarda» disse Balthier, lentamente.",[510.59,510.99,511.65,512.16,512.97]],[514.56," «Un titolo.",[514.56,514.56]],[515.03," Finalmente qualcuno che si presenta come si deve.»",[515.03,515.76,516.3,516.42,516.56,517,517.2,517.34]],[518.01," Si voltò verso Fran.",[518.01,518.22,518.5,518.96]],[519.33," «Hai sentito?",[519.33,519.6]],[521.04," Lo sterminatore di topi.»",[521.04,521.04,521.87,522.22]]]},{"c":[[524.11,"«Ho sentito.»",[524.11,524.33]]]},{"c":[[526.13,"«Questo sì che è un nome da secondo atto.»",[526.13,526.71,527.25,527.52,527.66,527.76,528,528.18,528.76]],[530.46," Balthier si rimise il panciotto, ancora umido, e se lo abbottonò con gesti precisi.",[530.46,531.19,531.4,531.72,531.84,532.87,533.42,534.32,534.46,534.58,534.68,535.43,535.72,536.5]],[537.8," «Bene, sterminatore.",[537.8,539.1]],[541.54," Visto che sei uno del mestiere, ti nomino nostra guida.",[541.54,541.54,541.7,541.9,542.12,542.32,543.23,543.44,543.82,544.27]],[546.02," Tu conosci le fogne,",[546.02,546.02,546.56,546.72]],[547.72," noi conosciamo tutto il resto,",[547.72,547.88,548.3,548.54,548.7]],[549.73," e insieme usciamo di qui prima che quelli là sopra si ricordino che sotto il cortile ci sono dei canali.",[549.73,549.73,550.16,550.52,550.68,551.12,551.52,551.66,551.88,552.04,552.34,552.5,552.98,553.14,553.38,553.48,553.84,554.02,554.22,554.4]],[555.66," D'accordo?»",[555.66]]]},{"c":[[557.35,"«D'accordo.»",[557.35]],[559.04," Vaan si fermò.",[559.04,559.88,560.08]],[560.93," «Ma la pietra resta a me.»",[560.93,561.14,561.3,561.89,562.3,562.42]]]},{"c":[[564.58,"«Naturalmente.»",[564.58]]]},{"c":[[566.74,"«Dico sul serio.",[566.74,567.08,567.3]],[568.17," La tengo io.",[568.17,568.38,568.77]],[569.57," Non la tocchi.",[569.57,569.87,570.17]],[571.31," Non ci pensi neanche.»",[571.31,571.58,571.72,572.12]]]},{"c":[[573.53,"Balthier si portò una mano al petto, ferito.",[573.53,575.15,575.36,575.72,575.92,576.14,576.36,577.31]],[578.23," «Ragazzo.",[578.23]],[580.02," Ma per chi mi hai preso?",[580.02,580.02,580.3,580.44,580.6,580.88]],[582.64," Il pensiero non mi ha mai sfiorato.»",[582.64,582.64,583.12,583.3,583.4,583.5,583.72]]]},{"c":[[585.5,"Dalla barca volante, Fran fece un piccolo rumore con il naso.",[585.5,585.9,586.29,587.38,588.02,588.36,588.5,588.91,589.55,589.82,590.46]]]},{"c":[[592.25,"«Mai?»",[592.25]],[593.06," disse.",[593.06]]]},{"c":[[594.85,"«Mai, Fran.",[594.85,595.16]],[596.06," Sono un uomo nuovo.",[596.06,596.4,596.58,596.76]],[597.34," L'acqua mi ha purificato.»",[597.34,598.04,598.18,598.26]]]},{"c":[[598.83,"«Mm.»",[598.83]]]},{"c":[[603.33,"Vaan guardò lei, poi lui, e capì che non aveva capito niente e che, in compenso, aveva capito l'essenziale.",[603.33,603.6,604.17,604.93,605.26,606.01,606.16,606.46,606.62,606.76,607.04,607.45,608.27,608.42,608.58,608.86,609.89,610.3,611.06]],[612.46," Si strinse la pietra sotto la camicia e decise che avrebbe dormito con un occhio aperto,",[612.46,612.46,612.78,612.92,613.28,613.56,613.72,614.75,614.9,615.22,615.34,615.64,616.14,616.36,616.48,616.91]],[618.2," se mai avesse dormito,",[618.2,618.2,618.36,618.69]],[619.9," e che non si sarebbe fatto prendere alle spalle.",[619.9,619.9,620.17,620.44,620.6,620.9,621.2,621.74,621.94]],[623.4," Poi indicò una galleria a sinistra, quella dove l'acqua correva più svelta.",[623.4,623.4,623.86,624.08,624.58,624.72,625.49,625.96,626.19,626.54,626.94,627.15]]]},{"c":[[630.12,"«Da quella parte» disse.",[630.12,630.12,630.34,630.72]],[632.26," «Controcorrente si va verso il palazzo.",[632.26,633,633.18,633.3,633.62,633.76]],[635.18," A favore di corrente si va verso le cisterne,",[635.18,635.18,635.56,635.72,636.91,637.12,637.26,637.56,637.74]],[639.22," e dalle cisterne ci sono le scale che salgono al quartiere nord.»",[639.22,639.22,639.46,640.49,640.7,641,641.18,641.42,641.6,642.06,642.2,642.7]]]},{"c":[[644.63,"«Lo sai o lo dici?»",[644.63,644.85,645.62,645.76,645.88]]]},{"c":[[647.69,"«Lo dico.»",[647.69,647.92]]]},{"c":[[650.07,"«Mi piace la tua onestà.»",[650.07,650.28,650.66,650.82,650.95]],[651.69," Balthier si avviò.",[651.69,652.68,652.86]],[654.76," «È una qualità rara nei personaggi secondari.»",[654.76,654.76,654.92,655.5,655.84,656.08,656.75]]]},{"c":[[662.04,"Camminarono a favore di corrente.",[662.04,662.83,662.95,663.25,663.37]],[664.71," Le gallerie erano diverse da quelle che Vaan aveva percorso all'andata:",[664.71,664.71,665.11,665.41,665.83,665.99,666.23,666.57,667.02,667.43,668.26]],[669.35," più basse, più vecchie, e in molti punti segnate dal bombardamento.",[669.35,669.35,670.13,670.36,671.71,671.85,671.99,672.35,673.08,673.61,673.79]],[675.52," Il colpo dell'Ifrit, sopra,",[675.52,675.73,676.21,677.09]],[678.2," aveva fatto tremare tutto;",[678.2,678.57,678.91,679.45]],[680.63," c'erano tratti di volta crollati,",[680.63,680.87,681.21,681.37,681.61]],[682.87," mucchi di pietre in mezzo alle passerelle,",[682.87,683.09,683.21,683.63,683.79,683.95,684.09]],[685.53," crepe nuove nei muri da cui l'acqua usciva a spruzzi,",[685.53,685.79,686.19,686.39,686.67,686.77,686.92,687.23,687.58,687.63]],[689.83," come da una botte forata.",[689.83,689.83,689.97,690.13,690.46]],[692.17," In un punto la passerella era sparita del tutto,",[692.17,692.17,692.29,693.22,693.43,693.84,694.11,694.55,694.77]],[695.75," e dovettero passare uno alla volta su una trave di ferro che attraversava il canale,",[695.75,695.75,696.21,696.63,696.87,697.15,697.62,697.83,697.99,698.25,698.47,699.06,699.33,699.87,699.97]],[701.25," e Balthier passò per primo con le braccia larghe,",[701.25,701.34,702.02,702.43,702.59,702.81,703.01,703.09,703.43]],[704.7," come un funambolo in piazza,",[704.7,704.7,704.91,705.51,705.72]],[707.13," e Fran passò per ultima senza guardare dove metteva i piedi,",[707.13,707.13,707.81,708.21,708.43,708.79,709.17,710.01,710.35,710.79,711.05]],[712.23," e Vaan passò in mezzo,",[712.23,712.26,712.39,712.73,712.85]],[714.29," guardando dove metteva i piedi con tutta l'attenzione di cui era capace.",[714.29,714.29,714.49,714.87,714.99,715.39,715.57,715.84,716.43,716.63,716.83,717.06]]],"st":1},{"c":[[719.25,"Balthier parlava.",[719.25,719.88]],[720.74," Parlava quasi sempre, con quella sua voce di uno che racconta una storia a tavola,",[720.74,721.27,721.53,722.44,722.71,722.99,723.17,723.49,723.65,724.12,724.39,724.93,725.15,725.66,725.81]],[726.81," e diceva cose di cui la metà erano vere e l'altra metà erano più divertenti.",[726.81,726.81,727.27,727.61,727.79,727.95,728.11,728.79,729.21,730.07,730.14,730.57,731.29,731.69,732]],[733.57," Disse che le fogne di Rabanastre erano le più eleganti che avesse mai visitato, e ne aveva visitate molte.",[733.57,733.83,733.93,734.07,734.33,734.45,735.26,735.67,735.83,735.99,736.51,736.65,736.95,737.17,738.28,738.43,738.55,738.81,739.31]],[740.43," Disse che a Bhujerba le fogne non c'erano,",[740.43,740.83,741.09,741.16,741.75,741.93,742.15,742.65]],[743.65," perché la città stava sospesa nel cielo e quello che si buttava cadeva in testa a qualcun altro,",[743.65,743.65,743.83,744.19,744.56,745.09,745.31,746.28,746.43,746.75,746.9,747.25,748.18,748.65,748.83,749.23,749.37,749.71]],[750.89," molto più in basso,",[750.89,750.89,751.07,751.21]],[752.27," che di solito non si lamentava perché era un mercante archadiano.",[752.27,752.27,752.39,752.79,752.95,753.07,753.57,753.88,754.15,754.35,755.41]],[756.73," Disse che a Balfonheim, la città degli aviopirati, le fogne erano la parte più pulita del porto.",[756.73,756.73,757.05,757.19,758.68,758.89,759.29,759.81,760.84,761.05,761.93,762.33,762.47,762.75,762.93,763.35,763.75]],[764.89," Vaan ascoltava tutto,",[764.89,765.33,765.99]],[767.11," con la bocca mezza aperta,",[767.11,767.11,767.33,767.75,768.28]],[769.47," e ogni nome di città gli si accendeva dentro come una lanterna.",[769.47,769.47,769.71,769.97,770.23,770.94,771.21,771.31,771.75,772.09,772.41,772.65]]]},{"c":[[774.36,"Fran non parlava.",[774.36,775.21,775.37]],[776.26," Camminava, e ascoltava,",[776.26,777.43,777.57]],[778.79," e ogni tanto si fermava e girava le orecchie verso un punto del buio,",[778.79,778.79,778.95,779.23,779.54,780.61,780.75,781.13,781.25,781.63,781.89,782.07,782.41,782.69]],[783.75," e allora si fermavano anche gli altri;",[783.75,783.75,784.78,784.99,785.53,785.75,785.93]],[787.13," una volta dal buio uscì una bestia,",[787.13,787.25,787.47,787.67,788.35,788.69,788.85]],[790.23," una specie di rospo grosso come un cane con la pelle che luccicava di muco,",[790.23,790.23,790.57,790.73,791.4,792.09,792.43,792.63,792.97,793.15,793.27,793.59,793.75,794.21,794.35]],[795.39," e Fran la abbatté con una freccia sola prima che Vaan avesse finito di tirare fuori la spada.",[795.39,795.39,795.86,796.07,796.49,796.67,796.87,797.67,798.13,798.27,798.42,798.61,799.01,799.33,799.47,799.81,800.13,800.33]],[801.61," L'arco lo portava sulla schiena.",[801.61,801.79,801.89,802.25,802.49]],[804.21," Vaan non l'aveva visto prenderlo.",[804.21,804.21,804.4,804.77,805.07]]]},{"c":[[806.99,"«Come hai fatto?»",[806.99,807.33,807.49]],[808.23," chiese.",[808.23]]]},{"c":[[810.32,"«Era lì» disse Fran.",[810.32,810.84,811.09,811.49]]]},{"c":[[813.22,"«Il rospo?»",[813.22,813.57]]]},{"c":[[815.27,"«L'arco.»",[815.27]]]},{"c":[[818.63,"Era il genere di risposta che Fran dava, Vaan avrebbe imparato.",[818.63,818.9,819.04,819.28,819.48,819.96,820.12,820.46,821.04,821.63,822.16]],[823.31," Risposte che non spiegavano niente e che, a pensarci dopo, spiegavano tutto quello che c'era da spiegare.",[823.31,824.17,824.44,824.56,825.06,825.91,826.06,826.39,826.54,827.04,827.9,828.46,828.8,829.2,829.38,829.62,829.76]]]},{"c":[[832.88,"I morti li trovarono in una camera rotonda,",[832.88,833.02,833.4,833.48,834.04,834.14,834.32,834.75]],[836.24," dove tre canali si incontravano e l'acqua girava in un vortice lento prima di proseguire.",[836.24,836.24,836.49,836.96,837.14,838.44,838.51,838.94,839.38,839.56,839.7,840.25,840.68,841.08,841.24]]],"st":1},{"c":[[843.18,"Erano sette.",[843.18,843.7]],[844.62," Erano sulla passerella che correva lungo il muro, dove erano caduti,",[844.62,845.02,845.22,845.66,845.92,846.28,846.54,846.62,847.16,847.5,847.76]],[849.04," e nell'acqua sotto la passerella,",[849.04,849.14,850.01,850.42,850.54]],[851.65," dove il vortice li aveva portati e li faceva girare piano,",[851.65,851.9,852.02,852.44,852.56,852.85,853.38,853.52,853.62,853.98,854.36]],[855.8," uno dopo l'altro, con le facce in giù.",[855.8,855.8,856.14,856.64,856.82,856.94,857.24,857.36]],[857.8," Avevano corazze di cuoio e di maglia.",[857.8,858.16,858.62,858.88,859.28,859.38,859.46]],[860.51," Avevano spade corte, e due di loro le tenevano ancora in mano.",[860.51,860.98,861.51,862.91,863.06,863.24,863.4,864.07,864.28,864.76,865.12,865.3]],[866.56," Erano morti combattendo, si vedeva, e combattendo contro qualcuno che era arrivato dall'alto,",[866.56,866.56,867.05,868.39,868.67,869.75,869.9,870.56,870.92,871.46,871.6,871.72,872.26]],[873.41," perché sulla passerella c'erano dardi di balestra conficcati nel legno,",[873.41,873.64,873.92,874.5,874.84,875.22,875.34,875.74,876.42,876.58]],[877.58," a decine, tutti inclinati nello stesso verso.",[877.58,877.75,878.94,879.14,879.74,880.06,880.48]]]},{"c":[[881.7,"Balthier smise di parlare.",[881.7,883.65,884.06,884.25]],[885.61," Fu la prima cosa che Vaan notò,",[885.61,885.82,885.96,886.26,886.6,886.82,887.12]],[888.12," e la notò perché il silenzio,",[888.12,888.12,888.32,888.66,888.98,889.3]],[890.88," dopo tanto chiacchierare,",[890.88,890.88,891.28]],[892.62," fu improvviso come una porta chiusa.",[892.62,892.76,893.4,893.64,893.8,894.19]]]},{"c":[[895.88,"L'uomo si avvicinò al primo dei corpi sulla passerella.",[895.88,896.59,896.8,897.26,897.46,897.72,897.92,898.32,898.6]],[900," Si accovacciò.",[900,900]],[900.75," Guardò la ferita, senza toccarla.",[900.75,901.22,901.32,901.92,902.32]],[903.05," Guardò i dardi nel legno.",[903.05,903.52,903.64,903.88,904.08]],[904.77," Guardò, per un lungo momento,",[904.77,905.28,905.56,905.7,906.06]],[907.34," il soffitto della camera,",[907.34,907.34,907.84,908.09]],[909.63," dove c'era una galleria più alta che correva tutto intorno,",[909.63,909.8,909.96,910.14,910.6,910.82,911.16,911.36,911.7,911.95]],[913.22," una specie di balcone di pietra nell'ombra.",[913.22,913.22,913.54,913.66,914.02,914.23,915.14]],[916.5," Poi si rialzò.",[916.5,916.5,916.67]]]},{"c":[[918.73,"«Li aspettavano» disse.",[918.73,918.94,919.58]]]},{"c":[[921.73,"Non lo disse a nessuno in particolare.",[921.73,922,922.14,922.32,922.46,922.74,922.86]],[924.46," Fran annuì, una volta.",[924.46,925.04,925.67,925.94]]]},{"c":[[927.83,"«Là sopra» continuò Balthier, indicando il balcone con il mento.",[927.83,928.06,928.68,929.49,930.3,930.7,930.8,931.2,931.36,931.54]],[932.5," «Venti balestrieri, forse trenta.",[932.5,932.82,934.24,934.56]],[935.64," Messi lì prima.",[935.64,936.04,936.2]],[937.13," Chi arrivava dai canali verso il palazzo doveva passare da questa camera, e chi passava da questa camera...»",[937.13,937.24,937.66,937.8,938.14,938.4,938.52,939.21,939.68,940.08,940.2,940.46,941.18,941.32,941.44,941.92,942.04,942.32]],[943.88," Non finì la frase.",[943.88,943.88,944.22,944.34]],[945.63," Non serviva.",[945.63,946.14]],[947.28," «Non è stata una battaglia.",[947.28,947.63,947.78,948.11,948.51]],[950.01," È stata una conta.»",[950.01,950.16,950.5,950.84]]]},{"c":[[952.17,"Vaan non lo ascoltava più.",[952.17,953.25,953.48,953.64,954]],[954.96," Si era fermato davanti al terzo corpo sulla passerella, quello più vicino al vortice, e lo guardava.",[954.96,954.96,955.08,955.42,955.7,955.82,956.06,956.32,956.54,957.53,958,958.14,958.46,958.62,959.34,959.48,959.58]],[960.7," Era un uomo giovane, forse vent'anni, con la barba rada e i capelli corti.",[960.7,960.7,960.84,961,961.74,962.27,963.13,963.4,963.52,963.84,964.18,964.32,964.38,964.8]],[966.02," Aveva gli occhi aperti.",[966.02,966.02,966.16,966.43]],[968.3," Aveva sulla spalla sinistra,",[968.3,968.7,968.96,969.52]],[970.84," fermato con una fibbia di ferro,",[970.84,971.36,971.58,971.76,972.06,972.27]],[973.54," un pezzo di mantello azzurro,",[973.54,973.54,973.86,974,974.57]],[975.74," sbiadito dal sole e dai lavaggi fino a diventare quasi grigio.",[975.74,976.14,976.4,977.32,977.46,977.62,978.08,978.32,978.44,978.92,979.33]]]},{"c":[[981.1,"Vaan lo aveva visto quella stessa mattina,",[981.1,981.31,981.52,981.82,982.12,982.42,982.78]],[984.68," o forse il giorno prima;",[984.68,984.68,985.89,986.1,986.36]],[987.46," non sapeva più quanto tempo fosse passato.",[987.46,987.54,987.96,988.16,988.46,988.72,989.07]],[990.52," Lo aveva visto sulla piattaforma della vasca,",[990.52,990.52,990.82,991.14,991.42,992.06,992.32]],[993.86," nella luce della lanterna coperta,",[993.86,993.86,994.2,994.44,994.99]],[996.32," fare rapporto al capitano con i capelli lunghi.",[996.32,996.32,996.86,996.96,997.87,998.14,998.24,998.62]],[1000.22," Le squadre del nord e del pozzo vecchio sono in posizione.",[1000.22,1000.22,1000.6,1000.78,1001.53,1001.68,1001.84,1002.2,1003.12,1003.46,1003.62]],[1005.22," Nessuna pattuglia sotto il terzo ponte.",[1005.22,1005.22,1005.72,1005.92,1006.06,1006.34]],[1007.82," Abbiamo visto solo topi.",[1007.82,1007.82,1008.14,1008.72]],[1009.94," Lo aveva visto fare il saluto dei soldati del re,",[1009.94,1009.94,1010.2,1010.42,1010.64,1010.78,1011.1,1011.28,1011.74,1011.93]],[1013," il pugno sul cuore e poi giù,",[1013,1013,1013.3,1013.54,1013.96,1014.1,1014.35]],[1015.26," e andarsene di corsa lungo la passerella.",[1015.26,1015.26,1015.7,1015.84,1016.18,1016.48,1016.58]]]},{"c":[[1018.85,"Si inginocchiò.",[1018.85,1019.06]],[1020.02," Non sapeva perché.",[1020.02,1020.43,1020.9]],[1022.38," Allungò una mano verso il mantello azzurro e la fermò a mezz'aria, e la tenne lì.",[1022.38,1022.38,1022.54,1022.76,1023.02,1023.14,1023.58,1024.63,1024.78,1024.86,1025.16,1025.32,1026.62,1026.76,1026.9,1027.19]]]},{"c":[[1028.59,"«Lo conoscevi?»",[1028.59,1028.8]],[1029.73," chiese Balthier, piano.",[1029.73,1030.29,1031.04]]]},{"c":[[1033.09,"«No.»",[1033.09]],[1033.66," Vaan ritirò la mano.",[1033.66,1034.79,1035.26,1035.38]],[1035.99," «L'ho visto.",[1035.99,1036.44]],[1037.24," Una volta.",[1037.24,1037.54]],[1038.44," Era...»",[1038.44]],[1039.37," Non finì.",[1039.37,1039.66]],[1040.7," Non sapeva come dire che era vivo,",[1040.7,1040.7,1041.1,1041.32,1041.62,1041.82,1041.96]],[1043.18," e che diceva abbiamo visto solo topi,",[1043.18,1043.18,1043.63,1044.32,1044.89,1045.42,1046.06]],[1047.3," e che aveva ragione,",[1047.3,1047.3,1047.48,1047.82]],[1049.16," e che proprio per questo era morto.",[1049.16,1049.16,1049.28,1049.6,1049.82,1050.61,1051.02]]]},{"c":[[1052.72,"Nessuno disse niente per un po'.",[1052.72,1053.26,1053.48,1053.82,1054.02,1054.1]],[1055.04," Il vortice girava.",[1055.04,1055.04,1055.63]],[1056.98," Uno dei corpi nell'acqua passò sotto la passerella,",[1056.98,1056.98,1057.16,1057.66,1058.56,1058.96,1059.32,1059.46]],[1062.06," lento, e poi tornò fuori dall'altra parte, e continuò a girare.",[1062.06,1062.06,1062.2,1062.36,1062.7,1062.95,1063.39,1064.6,1064.74,1065.16,1065.29]]]},{"c":[[1067.21,"«Ha parlato di pace» disse Vaan.",[1067.21,1067.42,1067.8,1067.94,1068.65,1069.51]],[1070.2," Lo disse al pavimento.",[1070.2,1070.2,1070.4,1070.54]],[1072.02," «In piazza.",[1072.02,1072.02]],[1073.21," Cinque giorni fa.",[1073.21,1073.68,1074.02]],[1074.91," Ha detto che non voleva che lo amassimo.",[1074.91,1075.12,1075.32,1075.48,1075.64,1076,1076.14,1076.4]],[1077.43," Ha detto dateci una stagione di pace.",[1077.43,1077.64,1077.92,1078.36,1078.56,1078.98,1079.18]],[1080.5," Ha detto che serviva Dalmasca come se fosse sua.»",[1080.5,1080.5,1080.74,1080.88,1081.51,1082.22,1082.56,1082.72,1083.08]],[1085.08," Alzò la testa.",[1085.08,1085.08,1085.34]],[1086.24," «E la gente ha applaudito.",[1086.24,1086.38,1086.48,1086.78,1086.98]],[1088.15," Io c'ero.",[1088.15,1088.48]],[1089.13," Hanno applaudito.»",[1089.13,1089.54]]]},{"c":[[1091.77,"«Lo so» disse Balthier.",[1091.77,1092.09,1092.8,1093.47]],[1094.56," «È un bravo oratore.",[1094.56,1094.56,1094.64,1094.86]],[1096.08," I bravi oratori fanno applaudire la gente, è il loro mestiere.",[1096.08,1096.08,1096.4,1097.13,1097.54,1098.14,1098.3,1099.02,1099.16,1099.28,1099.46]],[1100.78," Poi qualcun altro fa il resto, con le balestre, in un posto dove la gente non guarda.»",[1100.78,1100.78,1101.22,1101.43,1101.64,1101.84,1102.72,1103,1103.14,1104.37,1104.58,1104.72,1105.12,1105.3,1105.44,1105.74,1106.07]],[1107.24," Si voltò verso l'uscita della camera.",[1107.24,1107.24,1107.6,1107.89,1108.3,1108.5]],[1109.72," «Ad Archades lo chiamano governare.»",[1109.72,1109.93,1110.75,1110.96,1111.95]]]},{"c":[[1114.16,"«Bisogna dirlo.»",[1114.16,1114.78]],[1115.41," Vaan si alzò.",[1115.41,1115.92,1116.08]],[1116.93," Aveva la voce rotta e non gli importava.",[1116.93,1117.34,1117.46,1117.74,1118.32,1118.46,1118.62,1118.76]],[1119.87," «Bisogna dirlo a tutti.",[1119.87,1120.4,1120.69,1120.84]],[1122.04," Andare in piazza e dirlo.",[1122.04,1122.04,1122.22,1123.12,1123.26]],[1124.54," Che li ha fatti ammazzare come topi.",[1124.54,1124.54,1124.64,1124.8,1125.02,1125.68,1126.72]],[1127.92," Che era tutto preparato.",[1127.92,1127.92,1128.15,1128.56]],[1130.34," Che...»",[1130.34]]]},{"c":[[1131.93,"«E chi ti crede?»",[1131.93,1133.5,1133.78,1134.08]]]},{"c":[[1135.55,"Vaan si fermò.",[1135.55,1136.73,1137]]]},{"c":[[1138.78,"«Pensaci, sterminatore.»",[1138.78,1139.32]],[1140.4," Balthier non lo diceva con cattiveria.",[1140.4,1141.13,1141.4,1141.54,1141.94,1142.14]],[1143.46," Lo diceva con una specie di stanchezza, come una cosa che aveva già pensato molte volte.",[1143.46,1143.46,1143.9,1144.08,1144.26,1144.62,1144.77,1146.06,1146.4,1146.68,1147.02,1147.24,1147.52,1147.7,1148.24,1148.74]],[1150.14," «Domani mattina, in piazza,",[1150.14,1150.14,1151.11,1151.32]],[1152.7," il console annuncerà che un manipolo di terroristi ha cercato di assassinarlo durante una cena in onore",[1152.7,1152.7,1153.19,1153.86,1154.04,1154.22,1154.7,1154.86,1155.48,1155.68,1156.18,1156.32,1157.22,1157.8,1158.08,1158.79,1159.02]],[1159.49," della nobiltà dalmasca,",[1159.49,1159.76,1160.76]],[1161.9," e che grazie al cielo e ai suoi soldati la nobiltà dalmasca è salva.",[1161.9,1161.9,1162.04,1162.46,1162.63,1163.34,1163.48,1163.62,1163.84,1164.95,1165.16,1165.6,1166.1,1166.26]],[1167.32," Ringrazierà gli dèi.",[1167.32,1168.14,1168.52]],[1170.59," Forse si commuoverà.",[1170.59,1170.59,1170.8]],[1172.08," La piazza applaudirà,",[1172.08,1172.08,1172.81]],[1174.46," perché la piazza ha avuto paura stanotte,",[1174.46,1174.46,1174.62,1174.98,1175.14,1175.38,1175.76]],[1177.26," ha sentito i cannoni,",[1177.26,1177.26,1178.56,1178.78]],[1180.16," e la gente che ha paura applaude chi la fa smettere.",[1180.16,1180.16,1180.28,1180.6,1180.78,1180.94,1181.28,1181.87,1182.14,1182.32,1182.48]],[1183.71," E poi arrivi tu.",[1183.71,1183.86,1184.1,1184.48]],[1185.11," Un ragazzo della Città Bassa,",[1185.11,1185.32,1185.82,1186.06,1186.43]],[1187.48," che ha passato la notte nelle fogne a rubare un tesoro dal palazzo,",[1187.48,1187.48,1187.56,1187.96,1188.08,1188.4,1188.6,1188.94,1189.06,1189.34,1189.46,1189.82,1190.02]],[1191.36," e che dice che è tutto falso.»",[1191.36,1191.36,1191.48,1191.72,1191.86,1191.98,1192.21]],[1194.2," Si strinse nelle spalle.",[1194.2,1194.2,1194.64,1194.94]],[1196.18," «Io non ti crederei.",[1196.18,1196.18,1196.34,1196.46]],[1197.85," E io, a differenza della piazza, so che hai ragione.»",[1197.85,1197.85,1198.45,1198.6,1199.1,1199.35,1200.27,1200.66,1200.94,1201.08]]]},{"c":[[1203.82,"Vaan non rispose.",[1203.82,1204.42,1204.74]],[1205.61," Strinse i pugni.",[1205.61,1206.19,1206.34]],[1207.1," Sotto la camicia la pietra era calda, più calda di prima.",[1207.1,1207.5,1207.66,1208.06,1208.24,1208.64,1208.95,1209.48,1209.82,1210.22,1210.34]]]},{"c":[[1211.99,"«Allora non serve a niente» disse.",[1211.99,1212.46,1212.66,1213.02,1213.16,1213.65]]]},{"c":[[1216.28,"«Questo non l'ho detto.»",[1216.28,1216.89,1217.11,1217.33]]]},{"c":[[1218.35,"«L'hai detto.»",[1218.35,1219.17]]]},{"c":[[1221.06,"«Ho detto che non serve andare in piazza.",[1221.06,1221.27,1221.51,1221.71,1221.93,1222.21,1222.39,1222.55]],[1223.68," È diverso.»",[1223.68,1223.83]],[1224.5," Balthier lo guardò,",[1224.5,1225.27,1225.39]],[1226.51," e per un attimo i suoi occhi ebbero la stessa durezza di quando aveva detto non guardare,",[1226.51,1226.51,1226.69,1226.81,1227.09,1227.21,1227.43,1227.69,1228.01,1228.17,1228.55,1229.01,1229.17,1229.39,1229.69,1230.41,1230.75]],[1232.37," sulla terrazza.",[1232.37,1232.37]],[1234.08," «Ci sono cose che non servono a niente e si fanno lo stesso.",[1234.08,1234.29,1234.47,1234.77,1234.89,1235.05,1235.47,1235.61,1236.42,1236.57,1236.71,1236.97,1237.15]],[1238.36," Ma bisogna essere vivi, per farle.",[1238.36,1238.36,1238.9,1239.55,1240.29,1240.64]],[1242.73," E per essere vivi, adesso, bisogna uscire di qui.»",[1242.73,1242.73,1242.89,1243.27,1243.76,1244.63,1245.17,1245.57,1245.69]]]},{"c":[[1247.59,"Fran si era avvicinata al bordo della passerella.",[1247.59,1248.36,1248.57,1248.73,1249.35,1249.53,1249.83,1250.03]],[1251.81," Stava guardando l'acqua del vortice,",[1251.81,1251.81,1252.3,1252.63,1252.83]],[1254.79," i corpi che giravano,",[1254.79,1254.79,1255.15,1255.39]],[1256.75," e aveva le orecchie basse,",[1256.75,1256.75,1257.2,1257.41,1257.87]],[1259.43," piegate all'indietro,",[1259.43,1260.03]],[1260.97," in un modo che Vaan non le aveva ancora visto.",[1260.97,1260.97,1261.11,1261.31,1261.77,1262.39,1262.67,1262.79,1263.07,1263.37]],[1264.59," Poi fece una cosa piccola.",[1264.59,1264.59,1264.87,1265.01,1265.27]],[1266.65," Si chinò, raccolse da terra uno dei dardi di balestra caduti, lo spezzò in due fra le dita lunghe,",[1266.65,1266.65,1267.41,1268.01,1268.13,1268.45,1268.73,1268.96,1269.37,1269.51,1270,1270.88,1271.09,1271.52,1271.73,1272.47,1272.75,1272.91,1273.09]],[1274.19," e lo lasciò cadere nell'acqua.",[1274.19,1274.19,1274.33,1274.65,1275.03]]]},{"c":[[1276.77,"Non spiegò perché.",[1276.77,1277.05,1277.45]],[1279.81," Nessuno glielo chiese.",[1279.81,1279.81,1280.13]]]},{"c":[[1282.03,"Ripresero il cammino.",[1282.03,1282.84,1283.05]],[1283.8," Lasciarono la camera rotonda da una galleria che saliva,",[1283.8,1284.41,1284.53,1284.87,1285.33,1285.47,1285.65,1286.09,1286.27]],[1288.29," piano, verso un rumore che all'inizio sembrava l'acqua di una chiusa e che poi,",[1288.29,1288.29,1288.69,1288.86,1289.33,1289.62,1290.49,1291.02,1291.41,1291.53,1291.7,1292.66,1292.81,1292.99]],[1294.25," a mano a mano che si avvicinavano,",[1294.25,1294.25,1294.41,1294.55,1294.67,1294.81,1294.95]],[1296.93," diventava un'altra cosa:",[1296.93,1297.12,1297.27]],[1298.75," metallo contro metallo, colpi, passi su una passerella di ferro, e grida in archadiano.",[1298.75,1299.29,1299.71,1300.31,1301.27,1301.67,1301.79,1301.95,1302.46,1302.73,1303.64,1303.79,1304.32,1304.63]],[1306.38," Qualcuno, più avanti, stava ancora combattendo.",[1306.38,1306.38,1306.76,1307.61,1308.01,1308.6]]]},{"c":[[1310.88,"E sopra tutte quelle voci, nitida, una voce di donna, giovane, che non chiedeva niente a nessuno.",[1310.88,1311.03,1311.43,1311.71,1312.15,1313.08,1314.01,1314.29,1314.59,1314.77,1315.55,1316.36,1316.63,1316.79,1317.24,1317.71,1317.81]]]},{"c":[[1319.71,"«Chi è il prossimo?»",[1319.71,1320.03,1320.17,1320.37]]]}]