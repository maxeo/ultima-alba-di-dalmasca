[{"h":1,"c":[[1.52,"Capitolo sedicesimo: Tre sconosciuti nelle fogne.",[1.52,2.63,4.55,5.13,6.08,6.55]]]},{"c":[[9.81,"Vaan tornò in sé tossendo acqua,",[9.81,10.33,10.73,10.89,11.05,11.69]],[12.95," a pancia in giù su una lastra di pietra bagnata,",[12.95,12.95,13.29,13.49,13.65,13.85,14.03,14.45,14.61,15.05]],[16.33," con la sensazione precisa di aver bevuto mezza Rabanastre e la sensazione meno precisa,",[16.33,16.33,16.45,17.11,17.65,17.83,18.01,18.35,18.67,19.84,19.99,20.09,20.65,20.93]],[22.41," ma più urgente, di avere ancora la pietra.",[22.41,22.41,22.77,23.78,23.99,24.19,24.45,24.61]],[25.56," Ce l'aveva.",[25.56,25.83]],[26.66," Era sotto di lui,",[26.66,26.93,27.23,27.4]],[28.23," schiacciata fra il petto e la lastra,",[28.23,29.03,29.27,29.64,30.84,30.99,31.14]],[32.23," e gli premeva contro lo sterno come un pugno tiepido.",[32.23,32.23,32.37,32.89,33.27,33.47,33.89,34.11,34.27,34.64]],[36.13," La toccò attraverso la camicia fradicia.",[36.13,36.13,36.54,37.27,37.43,37.84]],[38.97," Poi si girò sulla schiena e guardò in alto.",[38.97,39.24,39.45,39.73,39.99,40.35,40.47,40.79,40.95]]]},{"c":[[43.06,"In alto c'era una volta di pietra,",[43.06,43.27,43.81,44.35,44.55,44.81,44.97]],[46.56," lontana, e un buco nella volta, frastagliato, attraverso cui si vedeva un pezzo di cielo rosso.",[46.56,47.58,47.73,47.87,48.21,48.46,49.45,50.45,51.11,51.31,51.49,51.81,51.93,52.25,52.39,52.63]],[53.89," Dal buco cadeva ancora qualcosa ogni tanto:",[53.89,53.89,54.23,54.59,54.85,55.27,55.51]],[56.82," un sasso, una manciata di terra, una tegola, che arrivava giù con un rumore secco e finiva nell'acqua.",[56.82,56.82,57.77,58.05,58.47,58.63,59.36,59.63,60.32,60.59,61.01,61.23,61.41,61.51,61.98,62.88,63.03,63.73]],[64.79," Il fragore del cortile, lassù, era diventato un brontolio lontano.",[64.79,64.79,65.11,65.29,65.75,66.47,66.75,67.23,67.39,68.31]],[69.95," Qualcuno, sopra la città, gridava ancora.",[69.95,69.95,70.31,70.5,71.14,71.68]]]},{"c":[[75.27,"«Ah.",[75.27]],[76.46," Il nostro personaggio secondario è sveglio.»",[76.46,76.46,76.8,77.36,77.98,78.12]]]},{"c":[[80.82,"L'uomo era seduto su un gradino di pietra a due passi da lui, a strizzarsi una manica.",[80.82,81.04,81.24,81.62,81.8,81.9,82.28,82.42,82.9,83.04,83.16,83.52,83.64,84.52,84.58,85.24,85.42]],[86.72," Lo faceva con cura,",[86.72,86.72,87.06,87.42]],[88.42," attorcigliando la stoffa bianca dal polso al gomito,",[88.42,89.12,89.28,89.71,90.18,90.45,90.86,91.04]],[92.42," e l'acqua gocciolava per terra in un filo sottile.",[92.42,92.47,92.74,93.26,93.5,93.82,93.98,94.12,94.4]],[95.72," Si era tolto il panciotto e l'aveva steso su una sporgenza del muro,",[95.72,95.72,95.84,96.12,96.22,97.4,97.46,97.86,98.2,98.36,98.5,99.04,99.2]],[100.28," ben aperto, perché asciugasse senza pieghe.",[100.28,100.45,101.36,101.82,102.36,102.67]],[103.64," I capelli gli si erano incollati alla fronte.",[103.64,103.78,104.48,104.76,104.92,105.16,105.62,105.79]],[107.03," Il ciuffo, notò Vaan con un'oscura soddisfazione, non c'era più.",[107.03,107.03,107.78,108.18,108.58,108.8,109.38,110.66,110.9,111.22]]]},{"c":[[114,"Poco più in là, mezzo dentro e mezzo fuori dall'acqua, c'era la barca volante,",[114,114.34,114.52,114.7,115.38,115.78,116.08,116.22,116.56,117.01,117.82,118.18,118.32,118.64]],[120.56," inclinata su un fianco come un pesce morto,",[120.56,120.56,120.72,120.82,121.2,121.42,121.54,121.95]],[123.28," con un'ala piegata.",[123.28,123.4,123.61]],[125.14," La viera ci stava sopra.",[125.14,125.14,125.53,125.74,126.03]],[127.82," Aveva aperto un pannello sulla coda e frugava dentro con le dita lunghe,",[127.82,127.82,128.14,128.26,128.64,128.88,129.66,129.8,130.24,130.6,130.82,130.94,131.1]],[132.4," e ogni tanto avvicinava l'orecchio al motore e ascoltava,",[132.4,132.4,132.56,132.8,133.33,133.8,133.88,134.83,134.98]],[136.7," immobile, come si ascolta il petto di un ammalato.",[136.7,137.6,137.94,138.12,138.54,138.7,139.02,139.14,139.28]]]},{"c":[[141.43,"«Allora?»",[141.43]],[142.44," disse l'uomo, senza smettere di strizzare.",[142.44,142.94,143.44,143.84,144.34,144.48]]]},{"c":[[146.65,"«Niente di rotto» disse la viera.",[146.65,147.12,147.35,148.16,148.34,148.52]],[149.54," «Niente che manca.»",[149.54,149.88,150.04]],[150.98," Richiuse il pannello.",[150.98,151.32,151.42]],[152.46," «Ha smesso e basta.»",[152.46,152.58,153.22,153.36]]]},{"c":[[155.47,"«Le cose non smettono e basta, Fran.",[155.47,155.68,155.9,156.08,156.52,156.6,157.02]],[157.94," Non quelle che ho pagato io.»",[157.94,158.18,158.5,158.62,158.75,159.29]]]},{"c":[[162.03,"«Questa sì.»",[162.03,162.5]]]},{"c":[[163.04,"L'uomo sospirò.",[163.04,164.38]],[165.3," Poi guardò Vaan, e la manica che strizzava, e di nuovo Vaan.",[165.3,165.48,166.35,166.94,167.08,167.2,167.58,167.74,168.88,169.02,169.14,169.46]]]},{"c":[[171.5,"«Comunque non la rimetteremmo in aria.",[171.5,172.44,172.72,172.88,173.5,173.66]],[175.51," Lassù c'è una nave da guerra che spara a tutto quello che si muove,",[175.51,175.66,175.72,175.86,176.12,176.26,176.62,176.86,177.26,177.34,177.74,178.1,178.26,178.44]],[179.5," e io mi muovo con molta grazia,",[179.5,179.5,179.64,179.8,180.1,180.32,180.71]],[181.96," il che mi rende un bersaglio eccellente.",[181.96,181.96,182.45,182.68,183.08,183.22,184.15]],[185.68," Si va a piedi.»",[185.68,185.68,185.88,186.02]],[186.87," Lasciò andare la manica.",[186.87,187.34,187.56,187.72]],[188.59," «Ti sei rotto qualcosa, ragazzo?»",[188.59,188.8,188.96,189.2,189.72]]]},{"c":[[191.23,"Vaan si mise a sedere.",[191.23,192.09,192.3,192.57,192.72]],[193.78," Gli faceva male tutto,",[193.78,193.78,194.12,194.32]],[195.68," in quel modo uniforme e vago che vuol dire che non si è rotto niente di preciso.",[195.68,195.68,196,196.94,197.69,197.96,198.6,198.88,199.12,199.6,199.88,200.08,200.26,200.36,200.58,200.92,201.08]]]},{"c":[[203.17,"«No.»",[203.17]]]},{"c":[[206.94,"«Peccato.",[206.94]],[206.94," Avrei avuto un buon motivo per lasciarti qui.»",[206.94,207.34,207.62,207.74,207.9,208.24,208.48,208.9]]]},{"c":[[211.93,"Ci volle un po' prima che Vaan riuscisse a smettere di guardare la viera.",[211.93,211.93,212.25,212.41,212.47,212.73,212.95,213.25,213.91,213.99,214.39,214.53,214.97,215.11]],[216.37," Lei se ne accorse subito, naturalmente; doveva essere abituata, perché non si voltò e non disse niente,",[216.37,216.37,216.53,216.61,216.95,217.41,218.92,219.39,219.67,220.27,220.53,220.77,221.06,221.63,221.77,221.93,222.28]],[223.89," continuò a sistemare la barca volante tirandola fuori dall'acqua per la coda,",[223.89,223.89,224.01,224.47,224.61,224.93,225.41,225.89,226.13,226.55,226.71,226.81]],[227.95," da sola, con una forza che una cosa così magra non avrebbe dovuto avere.",[227.95,227.95,228.69,228.97,229.21,229.91,230.19,230.39,230.73,231.21,231.94,232.21,232.61,232.97]],[234.08," Fu l'uomo, alla fine, a dirlo.",[234.08,234.35,235.01,235.11,235.74,235.89]]]},{"c":[[237.51,"«Non ne avevi mai vista una.»",[237.51,237.79,237.91,238.21,238.45,238.91]]]},{"c":[[240.73,"Vaan arrossì.",[240.73,241.56]],[242.56," Era la terza volta in una settimana, e cominciava a pensare che fosse una malattia.",[242.56,242.83,242.99,243.29,243.57,243.71,243.87,244.74,244.89,245.33,245.45,245.77,245.91,246.19,246.35]]]},{"c":[[248.85,"«No.",[248.85]],[249.47," Scusa.",[249.47]],[250.59," Non volevo...»",[250.59,250.93]]]},{"c":[[253.16,"«Non scusarti con me.",[253.16,253.44,254.04,254.26]],[254.84," Io ci sono abituato.",[254.84,255.02,255.18,255.4]],[256.78," La gente la guarda e io guardo la gente che la guarda, ed è uno dei piaceri della vita.»",[256.78,256.78,257,257.19,257.92,258.06,258.2,258.56,258.68,258.94,259.12,259.25,260.01,260.22,260.3,260.44,260.6,261.04,261.18]],[262.34," L'uomo si alzò, si stirò la schiena,",[262.34,262.54,262.72,263.46,263.6,263.84,263.98]],[265.13," riprese il panciotto dalla sporgenza e lo esaminò controluce con aria critica.",[265.13,265.62,265.78,266.24,266.46,267.48,267.62,267.72,268.18,268.85,269.12,269.36]],[270.72," «Le viere non escono dai loro boschi.",[270.72,270.72,271.02,271.2,271.6,271.8,272]],[273.49," Lo sai, no?",[273.49,273.49,273.92]],[274.65," Stanno là dentro da secoli, con i loro alberi e i loro silenzi,",[274.65,275.12,275.26,275.56,275.72,276.35,276.62,276.72,276.92,277.32,277.4,277.5,277.64]],[278.9," e guardano il mondo degli uomini come si guarda un formicaio:",[278.9,278.9,279.28,279.4,279.6,279.87,280.58,280.93,281.14,281.46,281.63]],[283.14," con interesse e da lontano.",[283.14,283.14,284.19,284.34,284.56]],[285.9," Una viera che viaggia è una cosa rara.",[285.9,285.9,286.22,286.38,287.25,287.4,287.58,287.96]],[289.28," Una viera che viaggia con un Huma, poi...»",[289.28,289.28,289.62,289.8,290.22,290.42,290.7,291.27]]]},{"c":[[294.02,"«È una cosa che non si spiega» disse Fran, dalla barca.",[294.02,294.16,294.32,294.56,294.76,294.96,295.17,296.02,296.6,297.08,297.56]],[298.8," «Come un pirata dei cieli che entra in un palazzo dalle fogne.»",[298.8,298.8,299,299.4,299.6,300.55,300.82,301.1,301.24,301.36,301.82,302.08]]]},{"c":[[303.79,"Lo disse con la stessa voce con cui aveva detto beve,",[303.79,304,304.28,304.52,304.64,304.94,305.28,305.5,305.64,305.96,306.92]],[308.2," sulla barca volante,",[308.2,308.2,308.69]],[311.02," piatta e un po' roca,",[311.02,311.02,311.16,311.62,312.08]],[313," senza alzare la testa.",[313,313,313.42,313.66]],[314.91," Ma Vaan non la sentì così.",[314.91,315.15,315.63,315.9,316.12,316.58]],[318.9," Vaan sentì soltanto due parole,",[318.9,318.9,319.3,319.83,320.1]],[321.42," e le due parole gli entrarono dentro come l'acqua del canale gli era entrata in bocca,",[321.42,321.42,321.54,321.73,322.5,322.78,323.32,323.98,324.26,324.68,324.87,325.53,325.8,325.92,326.28,326.4]],[327.66," tutte in una volta.",[327.66,327.66,327.84,327.98]]]},{"c":[[329.91,"«Pirata» disse.",[329.91,330.38]],[331.61," «Pirata dei cieli.",[331.61,332.08,332.26]],[333.66," Siete pirati dei cieli?»",[333.66,334.15,334.62,334.82]]]},{"c":[[336.34,"L'uomo si girò verso Fran con un'espressione di rimprovero.",[336.34,337.35,337.56,337.8,338.04,338.38,338.54,339.24,339.32]]]},{"c":[[341.16,"«Fran.»",[341.16]]]},{"c":[[343.99,"«Mm.»",[343.99]]]},{"c":[[345.4,"«Avevamo deciso di non dirlo.»",[345.4,345.94,346.4,346.5,346.64]]]},{"c":[[348.57,"«Tu avevi deciso.»",[348.57,348.8,350.03]]]},{"c":[[351.2,"«Siete pirati» ripeté Vaan.",[351.2,351.63,352.54,353.45]],[354.06," Si era alzato in piedi senza accorgersene,",[354.06,354.06,354.16,354.54,354.68,354.98,355.28]],[358.41," gocciolando, con le mani strette a pugno sul petto, sopra la pietra.",[358.41,358.41,358.68,358.8,359.04,359.56,359.7,359.98,360.3,361.06,361.46,361.64]],[362.61," Il dolore uniforme e vago era sparito.",[362.61,362.82,363.24,363.84,363.92,364.55,364.86]],[366.36," «Avete una nave.",[366.36,366.36,366.58]],[367.63," Una nave vostra.",[367.63,367.9,368.14]],[369.01," Volate dove volete.",[369.01,369.48,369.72]],[370.56," Non chiedete il permesso a nessuno.",[370.56,370.84,371.28,371.4,371.82,371.94]],[372.88," È così?",[372.88,373.02]],[373.86," È così?»",[373.86,374]]]},{"c":[[376.28,"L'uomo lo guardò a lungo.",[376.28,376.62,376.78,377.12,377.24]],[379.76," Sulla sua faccia, per un istante, passò qualcosa che Vaan non seppe leggere, e che forse era tenerezza,",[379.76,379.76,379.96,380.59,380.86,381,381.8,382.2,382.66,382.84,383.09,383.28,383.68,384.52,384.66,384.82,385.41,385.68]],[387.14," o forse era il fastidio di chi si vede davanti,",[387.14,387.14,387.95,388.22,388.36,388.92,389.04,389.18,389.34,389.72]],[391.24," all'improvviso, una versione di se stesso più giovane e più ingenua e non sa se esserne lusingato.",[391.24,391.9,392.1,392.66,392.8,392.96,393.36,393.6,394.12,394.41,394.74,395.54,395.68,395.89,396.13,396.34,396.91]]]},{"c":[[399.25,"«Più o meno» disse.",[399.25,399.56,399.7,399.9]],[400.71," «Il permesso, in effetti, non lo chiediamo.",[400.71,400.92,401.81,402.02,402.61,402.88,403]],[404.17," Ma ci viene negato lo stesso, molto spesso, e con le armi.",[404.17,404.17,404.38,404.6,405,405.18,405.86,406.37,408.12,408.26,408.46,408.68]],[409.84," È un dettaglio che nei racconti si omette.»",[409.84,409.84,409.96,410.52,410.76,410.92,411.42,411.58]]]},{"c":[[414.46,"«E l'aeronave?",[414.46,414.61]],[415.99," Dov'è?",[415.99]],[416.6," Com'è?",[416.6]],[417.21," Quanto è veloce?»",[417.21,417.68,417.85]]]},{"c":[[419.68,"«Calma.",[419.68]],[420.74," Calma, per carità.»",[420.74,421.14,421.34]],[422.27," L'uomo alzò le mani.",[422.27,423.04,423.38,423.5]],[424.62," «Una cosa alla volta.",[424.62,424.62,424.96,425.12]],[426.45," Prima ci presentiamo, come la gente educata.",[426.45,426.45,426.66,427.7,428.04,428.18,428.54]],[429.84," Poi usciamo da questa fogna.",[429.84,429.84,430.22,430.38,430.66]],[432.65," Poi, se sarai molto fortunato e molto zitto, forse ti dirò di che colore è.»",[432.65,433.39,433.6,433.94,434.24,434.92,435.06,435.32,436.22,436.77,436.98,437.24,437.34,437.48,437.96]],[439.06," Si mise una mano sul petto e fece un piccolo inchino,",[439.06,439.06,439.32,439.58,439.78,440,440.9,441.04,441.32,441.5,441.94]],[442.99," perfetto, da sala da ballo, che in quella galleria piena d'acqua e di muschio fece uno strano effetto.",[442.99,444.11,444.32,444.56,444.72,445.59,445.86,445.98,446.24,446.86,447.22,447.66,447.8,447.94,448.94,449.28,449.5,450.02]],[452.37," «Balthier.",[452.37]],[452.37," Pirata dei cieli, come la mia socia ha voluto rivelare.",[452.37,452.84,453.02,454.24,454.58,454.72,454.92,455.63,455.84,456.2]],[457.21," Lei è Fran.»",[457.21,457.5,457.74]]]},{"c":[[459.72,"«Fran» disse Vaan.",[459.72,460.06,460.95]]]},{"c":[[463.15,"La viera alzò gli occhi rossi su di lui, e chinò la testa, appena.",[463.15,463.36,463.6,463.86,463.98,464.18,464.52,464.64,464.75,465.69,465.84,466.08,466.34,467.21]],[468.56," Fu tutta la sua presentazione.",[468.56,468.56,468.96,469.06,469.22]]]},{"c":[[472.15,"«E tu?»",[472.15,472.15]],[472.63," chiese Balthier.",[472.63,473.47]]]},{"c":[[474.59,"Vaan pensò a tutte le cose che avrebbe potuto dire.",[474.59,475.16,475.58,475.72,475.92,476.06,476.3,476.44,476.81,477.28]],[478.21," Vaan della bottega di Migelo.",[478.21,479.14,479.69,480.22,480.43]],[482.62," Vaan della Città Bassa.",[482.62,482.62,482.86,483.36]],[485.06," Il fratello di Reks.",[485.06,485.06,485.64,486.31]],[487.64," Nessuna gli sembrò all'altezza di un inchino da sala da ballo.",[487.64,487.64,487.8,488.15,488.74,488.88,488.98,489.34,489.5,489.78,491.04]]]},{"c":[[491.93,"«Vaan» disse.",[491.93,492.22]],[493.12," E poi, perché la cosa gli sembrava ancora troppo poco: «Lo sterminatore di topi.",[493.12,493.39,493.95,494.42,494.58,494.84,495,495.38,495.68,496.04,496.79,497,497.64,497.88]],[499," Del condotto dei Calderai.»",[499,499,499.46,499.62]]]},{"c":[[501.73,"Ci fu un silenzio.",[501.73,501.94,502.1,502.28]],[503.24," Balthier lo fissò.",[503.24,504.19,504.52]],[505.5," Fran lo fissò.",[505.5,506.29,506.52]],[507.68," In fondo alla galleria una goccia cadde nell'acqua con un rumore minuscolo e definitivo.",[507.68,507.68,507.98,508.14,508.56,508.78,509.12,509.39,509.88,510.1,510.24,510.6,511.24,511.41]]]},{"c":[[513.49,"«Ma guarda» disse Balthier, lentamente.",[513.49,513.87,514.58,515.07,515.87]],[517.46," «Un titolo.",[517.46,517.46]],[517.93," Finalmente qualcuno che si presenta come si deve.»",[517.93,518.66,519.2,519.34,519.46,519.9,520.1,520.24]],[520.91," Si voltò verso Fran.",[520.91,521.12,521.4,521.86]],[522.23," «Hai sentito?",[522.23,522.5]],[523.98," Lo sterminatore di topi.»",[523.98,523.98,524.78,525.14]]]},{"c":[[527.01,"«Ho sentito.»",[527.01,527.25]]]},{"c":[[529.07,"«Questo sì che è un nome da secondo atto.»",[529.07,529.61,530.17,530.44,530.56,530.66,530.92,531.08,531.64]],[533.36," Balthier si rimise il panciotto, ancora umido, e se lo abbottonò con gesti precisi.",[533.36,534.09,534.3,534.62,534.74,535.85,536.32,537.22,537.36,537.48,537.6,538.28,538.62,539.37]],[540.58," «Bene, sterminatore.",[540.58,542.02]],[544.46," Visto che sei uno del mestiere, ti nomino nostra guida.",[544.46,544.46,544.6,544.82,545.04,545.24,546.26,546.36,546.72,547.18]],[548.93," Tu conosci le fogne,",[548.93,548.93,549.46,549.6]],[550.86," noi conosciamo tutto il resto,",[550.86,550.86,551.22,551.46,551.6]],[552.63," e insieme usciamo di qui prima che quelli là sopra si ricordino che sotto il cortile ci sono dei canali.",[552.63,552.63,553.08,553.42,553.58,554.04,554.42,554.56,554.8,554.94,555.24,555.4,555.9,556.06,556.28,556.38,556.74,556.92,557.12,557.3]],[558.64," D'accordo?»",[558.64]]]},{"c":[[560.31,"«D'accordo.»",[560.31]],[561.97," Vaan si fermò.",[561.97,562.8,562.98]],[563.83," «Ma la pietra resta a me.»",[563.83,564.04,564.2,564.82,565.22,565.36]]]},{"c":[[567.34,"«Naturalmente.»",[567.34]]]},{"c":[[569.64,"«Dico sul serio.",[569.64,569.98,570.22]],[571.13," La tengo io.",[571.13,571.34,571.69]],[572.64," Non la tocchi.",[572.64,572.8,572.9]],[573.71," Non ci pensi neanche.»",[573.71,573.98,574.12,574.45]]]},{"c":[[576.24,"Balthier si portò una mano al petto, ferito.",[576.24,578.29,578.5,578.84,579,579.22,579.5,580.45]],[581.67," «Ragazzo.",[581.67]],[583.35," Ma per chi mi hai preso?",[583.35,583.35,583.62,583.76,583.92,584.18]],[585.96," Il pensiero non mi ha mai sfiorato.»",[585.96,585.96,586.44,586.6,586.72,586.82,587.04]]]},{"c":[[588.82,"Dalla barca volante, Fran fece un piccolo rumore con il naso.",[588.82,589.22,589.61,590.72,591.34,591.68,591.82,592.23,592.87,593.14,593.48]]]},{"c":[[595.59,"«Mai?»",[595.59]],[596.38," disse.",[596.38]]]},{"c":[[598.17,"«Mai, Fran.",[598.17,598.48]],[599.38," Sono un uomo nuovo.",[599.38,599.72,599.92,600.08]],[600.66," L'acqua mi ha purificato.»",[600.66,601.36,601.5,601.58]]]},{"c":[[602.15,"«Mm.»",[602.15]]]},{"c":[[606.67,"Vaan guardò lei, poi lui, e capì che non aveva capito niente e che, in compenso, aveva capito l'essenziale.",[606.67,606.94,607.49,608.25,608.59,609.34,609.48,609.78,609.94,610.06,610.34,610.74,611.58,611.72,611.9,612.18,613.22,613.62,614.36]],[615.72," Si strinse la pietra sotto la camicia e decise che avrebbe dormito con un occhio aperto,",[615.72,615.72,616.1,616.24,616.58,616.88,617.04,618.08,618.22,618.52,618.66,618.94,619.44,619.66,619.8,620.21]],[621.48," se mai avesse dormito,",[621.48,621.48,621.68,622]],[623.22," e che non si sarebbe fatto prendere alle spalle.",[623.22,623.22,623.48,623.74,623.9,624.22,624.52,625.06,625.26]],[626.72," Poi indicò una galleria a sinistra, quella dove l'acqua correva più svelta.",[626.72,626.72,627.16,627.4,627.91,628.06,628.81,629.28,629.5,629.84,630.24,630.47]]]},{"c":[[633.43,"«Da quella parte» disse.",[633.43,633.43,633.67,634.05]],[636.31," «Controcorrente si va verso il palazzo.",[636.31,636.31,636.51,636.63,636.95,637.09]],[638.49," A favore di corrente si va verso le cisterne,",[638.49,638.49,638.87,639.03,640.24,640.45,640.59,640.87,641.05]],[642.55," e dalle cisterne ci sono le scale che salgono al quartiere nord.»",[642.55,642.55,642.79,643.82,644.03,644.31,644.51,644.75,644.93,645.37,645.53,646.01]]]},{"c":[[647.96,"«Lo sai o lo dici?»",[647.96,648.17,648.95,649.09,649.21]]]},{"c":[[651.02,"«Lo dico.»",[651.02,651.25]]]},{"c":[[653.4,"«Mi piace la tua onestà.»",[653.4,653.61,653.99,654.15,654.3]],[655.03," Balthier si avviò.",[655.03,656.01,656.19]],[658.09," «È una qualità rara nei personaggi secondari.»",[658.09,658.09,658.25,658.83,659.17,659.41,660.09]]]},{"c":[[665.35,"Camminarono a favore di corrente.",[665.35,666.18,666.32,666.56,666.68]],[668.04," Le gallerie erano diverse da quelle che Vaan aveva percorso all'andata:",[668.04,668.04,668.42,668.72,669.14,669.3,669.54,669.88,670.34,670.74,671.56]],[672.68," più basse, più vecchie, e in molti punti segnate dal bombardamento.",[672.68,672.68,673.33,673.69,675.03,675.18,675.3,675.65,676.38,676.92,677.1]],[678.83," Il colpo dell'Ifrit, sopra,",[678.83,679.04,679.53,680.42]],[681.9," aveva fatto tremare tutto;",[681.9,681.9,682.22,682.75]],[683.94," c'erano tratti di volta crollati,",[683.94,684.18,684.52,684.68,684.94]],[686.4," mucchi di pietre in mezzo alle passerelle,",[686.4,686.4,686.52,686.94,687.12,687.28,687.42]],[689.1," crepe nuove nei muri da cui l'acqua usciva a spruzzi,",[689.1,689.1,689.5,689.7,689.98,690.08,690.24,690.56,690.89,690.95]],[693.16," come da una botte forata.",[693.16,693.16,693.3,693.44,693.77]],[695.5," In un punto la passerella era sparita del tutto,",[695.5,695.5,695.6,696.55,696.76,697.18,697.44,697.86,698.08]],[699.1," e dovettero passare uno alla volta su una trave di ferro che attraversava il canale,",[699.1,699.1,699.54,699.94,700.2,700.46,700.93,701.14,701.32,701.56,701.77,702.37,702.64,703.18,703.3]],[704.52," e Balthier passò per primo con le braccia larghe,",[704.52,704.62,705.34,705.74,705.92,706.14,706.32,706.42,706.74]],[708.02," come un funambolo in piazza,",[708.02,708.02,708.22,708.84,709.05]],[710.42," e Fran passò per ultima senza guardare dove metteva i piedi,",[710.42,710.42,711.12,711.52,711.74,712.12,712.48,713.32,713.66,714.1,714.36]],[715.52," e Vaan passò in mezzo,",[715.52,715.56,715.7,716.04,716.18]],[717.6," guardando dove metteva i piedi con tutta l'attenzione di cui era capace.",[717.6,717.6,717.82,718.18,718.3,718.7,718.88,719.15,719.76,719.94,720.14,720.37]]]},{"c":[[722.57,"Balthier parlava.",[722.57,723.19]],[724.07," Parlava quasi sempre, con quella sua voce di uno che racconta una storia a tavola,",[724.07,724.6,724.84,725.76,726.04,726.3,726.48,726.82,726.98,727.45,727.72,728.24,728.46,728.98,729.12]],[730.12," e diceva cose di cui la metà erano vere e l'altra metà erano più divertenti.",[730.12,730.12,730.58,730.92,731.12,731.26,731.44,732.1,732.52,733.39,733.46,733.88,734.6,735,735.33]],[736.9," Disse che le fogne di Rabanastre erano le più eleganti che avesse mai visitato, e ne aveva visitate molte.",[736.9,737.14,737.26,737.42,737.64,737.76,738.6,739,739.14,739.3,739.84,739.96,740.28,740.48,741.62,741.76,741.86,742.12,742.62]],[743.74," Disse che a Bhujerba le fogne non c'erano,",[743.74,744.14,744.4,744.47,745.06,745.24,745.46,745.97]],[746.98," perché la città stava sospesa nel cielo e quello che si buttava cadeva in testa a qualcun altro,",[746.98,746.98,747.14,747.52,747.87,748.4,748.63,749.6,749.74,750.08,750.23,750.59,751.49,751.96,752.16,752.52,752.66,753.02]],[754.22," molto più in basso,",[754.22,754.22,754.38,754.52]],[755.58," che di solito non si lamentava perché era un mercante archadiano.",[755.58,755.58,755.7,756.1,756.26,756.38,756.88,757.21,757.48,757.66,758.66]],[759.97," Disse che a Balfonheim, la città dei pirati, le fogne erano la parte più pulita del porto.",[759.97,759.97,760.96,761.09,762.41,762.62,762.94,763.09,764.07,764.28,764.62,765.02,765.16,765.4,765.58,765.92,766.25]],[767.84," Vaan ascoltava tutto,",[767.84,767.84,768.51]],[769.66," con la bocca mezza aperta,",[769.66,769.66,769.84,770.27,770.81]],[772.02," e ogni nome di città gli si accendeva dentro come una lanterna.",[772.02,772.02,772.24,772.5,772.75,773.47,773.74,773.84,774.28,774.6,774.94,775.22]]]},{"c":[[776.89,"Fran non parlava.",[776.89,777.72,777.9]],[778.78," Camminava, e ascoltava,",[778.78,779.96,780.1]],[781.32," e ogni tanto si fermava e girava le orecchie verso un punto del buio,",[781.32,781.32,781.48,781.76,782.05,783.13,783.28,783.66,783.78,784.16,784.42,784.6,784.92,785.2]],[786.28," e allora si fermavano anche gli altri;",[786.28,786.28,787.31,787.52,788.06,788.28,788.46]],[789.68," una volta dal buio uscì una bestia,",[789.68,789.78,790,790.2,790.88,791.22,791.36]],[792.62," una specie di rospo grosso come un cane con la pelle che luccicava di muco,",[792.62,792.74,793.1,793.25,793.93,794.62,794.96,795.16,795.5,795.68,795.8,796.1,796.26,796.74,796.88]],[797.92," e Fran la abbatté con una freccia sola prima che Vaan avesse finito di tirare fuori la spada.",[797.92,797.92,798.39,798.6,799.04,799.22,799.4,800.02,800.38,800.78,800.93,801.14,801.54,801.86,802,802.34,802.66,802.86]],[804," L'arco lo portava sulla schiena.",[804,804.32,804.42,804.78,805.02]],[806.5," Vaan non l'aveva visto prenderlo.",[806.5,806.72,806.91,807.28,807.6]]]},{"c":[[809.52,"«Come hai fatto?»",[809.52,809.86,810]],[810.78," chiese.",[810.78]]]},{"c":[[812.85,"«Era lì» disse Fran.",[812.85,813.37,813.62,814.02]]]},{"c":[[815.77,"«Il rospo?»",[815.77,816.65]]]},{"c":[[817.37,"«L'arco.»",[817.37]]]},{"c":[[821.41,"Era il genere di risposta che Fran dava, Vaan avrebbe imparato.",[821.41,821.41,821.55,821.83,822.01,822.49,822.65,822.97,823.56,824.16,824.69]],[825.85," Risposte che non spiegavano niente e che, a pensarci dopo, spiegavano tutto quello che c'era da spiegare.",[825.85,826.68,826.95,827.09,827.59,828.45,828.59,828.97,829.11,829.57,830.26,830.99,831.35,831.73,831.91,832.15,832.29]]]},{"c":[[835.4,"I morti li trovarono in una camera rotonda,",[835.4,835.55,835.93,836.03,836.59,836.69,836.87,837.27]],[838.77," dove tre canali si incontravano e l'acqua girava in un vortice lento prima di proseguire.",[838.77,838.77,839.02,839.49,839.69,841,841.07,841.47,841.93,842.09,842.23,842.81,843.21,843.61,843.77]]]},{"c":[[845.73,"Erano sette.",[845.73,846.23]],[847.17," Erano sulla passerella che correva lungo il muro, dove erano caduti,",[847.17,847.57,847.77,848.19,848.45,848.81,849.07,849.17,849.71,850.05,850.29]],[851.59," e nell'acqua sotto la passerella,",[851.59,851.69,852.55,852.95,853.09]],[854.43," dove il vortice li aveva portati e li faceva girare piano,",[854.43,854.43,854.57,854.97,855.11,855.39,855.93,856.07,856.15,856.53,856.9]],[858.33," uno dopo l'altro, con le facce in giù.",[858.33,858.33,858.64,859.1,859.37,859.47,859.77,859.91]],[860.16," Avevano corazze di cuoio e di maglia.",[860.16,860.69,861.15,861.4,861.81,861.93,862.01]],[863.51," Avevano spade corte, e due di loro le tenevano ancora in mano.",[863.51,863.51,864.07,865.47,865.61,865.79,865.93,866.6,866.81,867.29,867.65,867.81]],[869.09," Erano morti combattendo, si vedeva, e combattendo contro qualcuno che era arrivato dall'alto,",[869.09,869.09,869.6,870.94,871.2,872.28,872.43,873.11,873.49,874.01,874.15,874.27,875.23]],[876.19," perché sulla passerella c'erano dardi di balestra conficcati nel legno,",[876.19,876.19,876.45,877.02,877.37,877.77,877.89,878.29,878.95,879.13]],[880.28," a decine, tutti inclinati nello stesso verso.",[880.28,880.28,881.26,881.67,882.29,882.59,883.13]]]},{"c":[[884.3,"Balthier smise di parlare.",[884.3,886.19,886.59,886.8]],[888.16," Fu la prima cosa che Vaan notò,",[888.16,888.37,888.51,888.77,889.11,889.37,889.71]],[890.69," e la notò perché il silenzio,",[890.69,890.69,890.85,891.19,891.51,891.83]],[893.43," dopo tanto chiacchierare,",[893.43,893.43,893.83]],[895.31," fu improvviso come una porta chiusa.",[895.31,895.31,895.93,896.17,896.35,896.74]]]},{"c":[[898.43,"L'uomo si avvicinò al primo dei corpi sulla passerella.",[898.43,899.12,899.33,899.81,900.01,900.27,900.47,900.87,901.13]],[902.55," Si accovacciò.",[902.55,902.55]],[903.3," Guardò la ferita, senza toccarla.",[903.3,903.77,903.87,904.47,904.87]],[905.58," Guardò i dardi nel legno.",[905.58,906.05,906.19,906.43,906.63]],[907.3," Guardò, per un lungo momento,",[907.3,907.82,908.09,908.25,908.59]],[909.87," il soffitto della camera,",[909.87,909.87,910.37,910.63]],[912.19," dove c'era una galleria più alta che correva tutto intorno,",[912.19,912.34,912.49,912.69,913.13,913.37,913.71,913.89,914.25,914.5]],[915.75," una specie di balcone di pietra nell'ombra.",[915.75,915.75,916.07,916.19,916.57,916.78,917.69]],[919.05," Poi si rialzò.",[919.05,919.05,919.21]]]},{"c":[[921.28,"«Li aspettavano» disse.",[921.28,921.49,922.25]]]},{"c":[[924.27,"Non lo disse a nessuno in particolare.",[924.27,924.55,924.67,924.88,925.03,925.29,925.41]],[927.01," Fran annuì, una volta.",[927.01,927.57,928.22,928.49]]]},{"c":[[930.38,"«Là sopra» continuò Balthier, indicando il balcone con il mento.",[930.38,930.61,931.41,932.11,932.81,933.23,933.33,933.73,933.89,934.07]],[935.05," «Venti balestrieri, forse trenta.",[935.05,935.37,936.69,937.1]],[938.13," Messi lì prima.",[938.13,938.52,938.73]],[939.66," Chi arrivava dai canali verso il palazzo doveva passare da questa camera, e chi passava da questa camera...»",[939.66,939.77,940.19,940.33,940.69,940.93,941.05,941.74,942.21,942.63,942.75,943.01,943.73,943.87,943.99,944.45,944.57,944.85]],[946.41," Non finì la frase.",[946.41,946.41,946.75,946.88]],[948.18," Non serviva.",[948.18,948.7]],[949.84," «Non è stata una battaglia.",[949.84,950.19,950.33,950.63,951.07]],[952.57," È stata una conta.»",[952.57,952.71,953.03,953.38]]]},{"c":[[954.71,"Vaan non lo ascoltava più.",[954.71,955.77,956.01,956.17,956.56]],[957.51," Si era fermato davanti al terzo corpo sulla passerella, quello più vicino al vortice, e lo guardava.",[957.51,957.51,957.61,957.95,958.25,958.35,958.61,958.85,959.07,960.06,960.53,960.69,961.01,961.13,961.87,962.01,962.09]],[963.23," Era un uomo giovane, forse vent'anni, con la barba rada e i capelli corti.",[963.23,963.23,963.37,963.55,964.29,964.83,965.7,965.97,966.1,966.44,966.71,967.05,967.08,967.33]],[968.55," Aveva gli occhi aperti.",[968.55,968.55,968.69,968.98]],[971.23," Aveva sulla spalla sinistra,",[971.23,971.23,971.51,972.05]],[973.91," fermato con una fibbia di ferro,",[973.91,973.91,974.13,974.29,974.61,974.83]],[976.07," un pezzo di mantello azzurro,",[976.07,976.07,976.41,976.53,977.13]],[978.16," sbiadito dal sole e dai lavaggi fino a diventare quasi grigio.",[978.16,978.67,978.93,979.87,980.01,980.15,980.61,980.87,980.97,981.45,981.9]]]},{"c":[[983.56,"Vaan lo aveva visto quella stessa mattina,",[983.56,983.86,984.07,984.35,984.67,984.95,985.31]],[987.23," o forse il giorno prima;",[987.23,987.23,988.44,988.65,988.91]],[990.11," non sapeva più quanto tempo fosse passato.",[990.11,990.11,990.49,990.69,990.99,991.25,991.62]],[993.05," Lo aveva visto sulla piattaforma della vasca,",[993.05,993.05,993.35,993.69,993.97,994.59,994.85]],[996.39," nella luce della lanterna coperta,",[996.39,996.39,996.73,996.99,997.51]],[998.85," fare rapporto al capitano con i capelli lunghi.",[998.85,998.85,999.41,999.51,1000.39,1000.67,1000.79,1001.15]],[1002.75," Le squadre del nord e del pozzo vecchio sono in posizione.",[1002.75,1002.75,1003.15,1003.31,1004.09,1004.23,1004.39,1004.73,1005.65,1005.99,1006.17]],[1007.75," Nessuna pattuglia sotto il terzo ponte.",[1007.75,1007.75,1008.27,1008.47,1008.59,1008.87]],[1010.35," Abbiamo visto solo topi.",[1010.35,1010.35,1010.69,1011.27]],[1012.47," Lo aveva visto fare il saluto dei soldati del re,",[1012.47,1012.47,1012.73,1012.97,1013.19,1013.33,1013.63,1013.81,1014.27,1014.48]],[1015.53," il pugno sul cuore e poi giù,",[1015.53,1015.53,1015.85,1016.07,1016.49,1016.63,1016.88]],[1017.81," e andarsene di corsa lungo la passerella.",[1017.81,1017.81,1018.25,1018.37,1018.73,1019.01,1019.11]]]},{"c":[[1021.38,"Si inginocchiò.",[1021.38,1021.59]],[1022.56," Non sapeva perché.",[1022.56,1022.96,1023.43]],[1024.93," Allungò una mano verso il mantello azzurro e la fermò a mezz'aria, e la tenne lì.",[1024.93,1024.93,1025.09,1025.31,1025.57,1025.69,1026.13,1027.16,1027.31,1027.41,1027.71,1027.87,1029.16,1029.31,1029.41,1029.7]]]},{"c":[[1031.14,"«Lo conoscevi?»",[1031.14,1031.35]],[1032.26," chiese Balthier, piano.",[1032.26,1032.83,1033.59]]]},{"c":[[1035.6,"«No.»",[1035.6]],[1036.17," Vaan ritirò la mano.",[1036.17,1037.32,1037.79,1037.91]],[1038.52," «L'ho visto.",[1038.52,1038.97]],[1039.79," Una volta.",[1039.79,1040.07]],[1040.97," Era...»",[1040.97]],[1041.91," Non finì.",[1041.91,1042.19]],[1043.25," Non sapeva come dire che era vivo,",[1043.25,1043.25,1043.65,1043.85,1044.17,1044.35,1044.51]],[1045.71," e che diceva abbiamo visto solo topi,",[1045.71,1045.71,1046.18,1046.86,1047.42,1047.97,1048.59]],[1049.83," e che aveva ragione,",[1049.83,1049.83,1050.01,1050.37]],[1051.71," e che proprio per questo era morto.",[1051.71,1051.71,1051.81,1052.13,1052.39,1053.13,1053.57]]]},{"c":[[1055.27,"Nessuno disse niente per un po'.",[1055.27,1055.81,1056.03,1056.37,1056.55,1056.67]],[1057.59," Il vortice girava.",[1057.59,1057.59,1058.18]],[1059.53," Uno dei corpi nell'acqua passò sotto la passerella,",[1059.53,1059.53,1059.69,1060.2,1061.11,1061.51,1061.85,1062.01]],[1064.61," lento, e poi tornò fuori dall'altra parte, e continuò a girare.",[1064.61,1064.61,1064.75,1064.89,1065.23,1065.48,1065.92,1067.13,1067.27,1067.71,1067.82]]]},{"c":[[1069.74,"«Ha parlato di pace» disse Vaan.",[1069.74,1069.95,1070.35,1070.47,1071.18,1072.03]],[1072.71," Lo disse al pavimento.",[1072.71,1072.71,1072.93,1073.09]],[1074.57," «In piazza.",[1074.57,1074.57]],[1075.76," Cinque giorni fa.",[1075.76,1076.23,1076.55]],[1077.44," Ha detto che non voleva che lo amassimo.",[1077.44,1077.65,1077.85,1078.01,1078.17,1078.55,1078.67,1078.94]],[1080," Ha detto dateci una stagione di pace.",[1080,1080.21,1080.45,1080.91,1081.09,1081.51,1081.71]],[1083.03," Ha detto che serviva Dalmasca come se fosse sua.»",[1083.03,1083.03,1083.27,1083.43,1084.06,1084.77,1085.11,1085.25,1085.62]],[1087.63," Alzò la testa.",[1087.63,1087.63,1087.87]],[1088.77," «E la gente ha applaudito.",[1088.77,1088.91,1089.03,1089.33,1089.51]],[1090.7," Io c'ero.",[1090.7,1091.03]],[1091.68," Hanno applaudito.»",[1091.68,1092.09]]]},{"c":[[1094.3,"«Lo so» disse Balthier.",[1094.3,1094.62,1095.33,1096]],[1097.09," «È un bravo oratore.",[1097.09,1097.09,1097.21,1097.39]],[1098.61," I bravi oratori fanno applaudire la gente, è il loro mestiere.",[1098.61,1098.61,1098.93,1099.68,1100.09,1100.69,1100.85,1101.57,1101.71,1101.83,1101.99]],[1103.33," Poi qualcun altro fa il resto, con le balestre, in un posto dove la gente non guarda.»",[1103.33,1103.33,1103.75,1103.96,1104.18,1104.39,1105.25,1105.53,1105.67,1106.92,1107.13,1107.27,1107.67,1107.85,1107.99,1108.29,1108.6]],[1109.77," Si voltò verso l'uscita della camera.",[1109.77,1109.77,1110.13,1110.43,1110.85,1111.05]],[1112.23," «Ad Archades lo chiamano governare.»",[1112.23,1112.45,1113.3,1113.51,1114.49]]]},{"c":[[1116.69,"«Bisogna dirlo.»",[1116.69,1117.31]],[1117.94," Vaan si alzò.",[1117.94,1118.45,1118.61]],[1119.49," Aveva la voce rotta e non gli importava.",[1119.49,1119.89,1119.99,1120.27,1120.87,1121.01,1121.15,1121.29]],[1122.41," «Bisogna dirlo a tutti.",[1122.41,1122.95,1123.23,1123.37]],[1124.59," Andare in piazza e dirlo.",[1124.59,1124.59,1124.79,1125.64,1125.79]],[1127.07," Che li ha fatti ammazzare come topi.",[1127.07,1127.07,1127.19,1127.35,1127.57,1128.21,1129.25]],[1130.47," Che era tutto preparato.",[1130.47,1130.47,1130.81,1131.35]],[1133.15," Che...»",[1133.15]]]},{"c":[[1136.22,"«E chi ti crede?»",[1136.22,1136.37,1136.57,1137.63]]]},{"c":[[1138.68,"Vaan si fermò.",[1138.68,1139.52,1139.81]]]},{"c":[[1141.57,"«Pensaci, sterminatore.»",[1141.57,1142.11]],[1143.25," Balthier non lo diceva con cattiveria.",[1143.25,1144.01,1144.19,1144.33,1144.75,1144.93]],[1146.25," Lo diceva con una specie di stanchezza, come una cosa che aveva già pensato molte volte.",[1146.25,1146.25,1146.69,1146.87,1147.07,1147.43,1147.58,1148.87,1149.21,1149.49,1149.83,1150.03,1150.31,1150.49,1151.03,1151.55]],[1152.95," «Domani mattina, in piazza,",[1152.95,1152.95,1153.9,1154.11]],[1155.51," il console annuncerà che un manipolo di terroristi ha cercato di assassinarlo durante una cena in onore",[1155.51,1155.51,1156.01,1156.67,1156.83,1157.01,1157.51,1157.65,1158.29,1158.47,1158.99,1159.11,1160.03,1160.59,1160.89,1161.6,1161.83]],[1162.28," della nobiltà dalmasca,",[1162.28,1162.55,1163.17]],[1164.69," e che grazie al cielo e ai suoi soldati la nobiltà dalmasca è salva.",[1164.69,1164.69,1164.83,1165.25,1165.42,1166.14,1166.29,1166.41,1166.63,1167.74,1167.95,1168.35,1168.9,1169.05]],[1170.1," Ringrazierà gli dèi.",[1170.1,1170.93,1171.31]],[1173.4," Forse si commuoverà.",[1173.4,1173.4,1173.61]],[1174.87," La piazza applaudirà,",[1174.87,1174.87,1175.62]],[1177.27," perché la piazza ha avuto paura stanotte,",[1177.27,1177.27,1177.43,1177.77,1177.93,1178.19,1178.57]],[1180.07," ha sentito i cannoni,",[1180.07,1180.07,1181.35,1181.6]],[1182.97," e la gente che ha paura applaude chi la fa smettere.",[1182.97,1182.97,1183.07,1183.41,1183.59,1183.73,1184.09,1184.65,1184.93,1185.11,1185.27]],[1186.51," E poi arrivi tu.",[1186.51,1186.65,1186.91,1187.27]],[1187.92," Un ragazzo della Città Bassa,",[1187.92,1188.13,1188.63,1188.85,1189.23]],[1190.27," che ha passato la notte nelle fogne a rubare un tesoro dal palazzo,",[1190.27,1190.27,1190.37,1190.77,1190.89,1191.19,1191.41,1191.75,1191.85,1192.15,1192.25,1192.61,1192.81]],[1194.15," e che dice che è tutto falso.»",[1194.15,1194.15,1194.27,1194.51,1194.65,1194.75,1195.03]],[1196.99," Si strinse nelle spalle.",[1196.99,1196.99,1197.45,1197.73]],[1198.97," «Io non ti crederei.",[1198.97,1198.97,1199.13,1199.27]],[1200.64," E io, a differenza della piazza, so che hai ragione.»",[1200.64,1200.64,1201.25,1201.39,1201.89,1202.14,1203.08,1203.45,1203.73,1203.89]]]},{"c":[[1206.57,"Vaan non rispose.",[1206.57,1207.23,1207.55]],[1208.39," Strinse i pugni.",[1208.39,1208.99,1209.13]],[1209.88," Sotto la camicia la pietra era calda, più calda di prima.",[1209.88,1210.29,1210.45,1210.85,1211.01,1211.43,1211.75,1212.27,1212.61,1213.01,1213.13]]]},{"c":[[1214.78,"«Allora non serve a niente» disse.",[1214.78,1215.25,1215.45,1215.81,1215.95,1216.42]]]},{"c":[[1219.07,"«Questo non l'ho detto.»",[1219.07,1219.68,1219.9,1220.12]]]},{"c":[[1221.14,"«L'hai detto.»",[1221.14,1221.96]]]},{"c":[[1223.85,"«Ho detto che non serve andare in piazza.",[1223.85,1224.06,1224.3,1224.5,1224.72,1225,1225.2,1225.34]],[1226.47," È diverso.»",[1226.47,1226.64]],[1227.31," Balthier lo guardò,",[1227.31,1228.06,1228.18]],[1229.3," e per un attimo i suoi occhi ebbero la stessa durezza di quando aveva detto non guardare,",[1229.3,1229.3,1229.48,1229.6,1229.88,1230,1230.24,1230.48,1230.8,1230.96,1231.32,1231.82,1231.96,1232.18,1232.48,1233.24,1233.54]],[1235.2," sulla terrazza.",[1235.2,1235.2]],[1236.87," «Ci sono cose che non servono a niente e si fanno lo stesso.",[1236.87,1237.08,1237.28,1237.56,1237.7,1237.84,1238.28,1238.42,1239.21,1239.36,1239.5,1239.76,1239.92]],[1241.14," Ma bisogna essere vivi, per farle.",[1241.14,1241.14,1241.71,1242.34,1243.08,1243.43]],[1245.52," E per essere vivi, adesso, bisogna uscire di qui.»",[1245.52,1245.52,1245.7,1246.08,1246.57,1247.42,1247.96,1248.36,1248.48]]]},{"c":[[1250.3,"Fran si era avvicinata al bordo della passerella.",[1250.3,1251.15,1251.36,1251.52,1252.14,1252.32,1252.62,1252.84]],[1254.28," Stava guardando l'acqua del vortice,",[1254.28,1254.6,1255.09,1255.42,1255.64]],[1257.58," i corpi che giravano,",[1257.58,1257.58,1257.94,1258.18]],[1259.52," e aveva le orecchie basse,",[1259.52,1259.52,1259.99,1260.2,1260.67]],[1262.24," piegate all'indietro,",[1262.24,1262.83]],[1263.76," in un modo che Vaan non le aveva ancora visto.",[1263.76,1263.76,1263.92,1264.12,1264.58,1265.18,1265.46,1265.58,1265.86,1266.16]],[1267.38," Poi fece una cosa piccola.",[1267.38,1267.38,1267.66,1267.8,1268.06]],[1269.44," Si chinò, raccolse da terra uno dei dardi di balestra caduti, lo spezzò in due fra le dita lunghe,",[1269.44,1269.44,1270.2,1270.8,1270.94,1271.26,1271.52,1271.76,1272.16,1272.3,1272.79,1273.67,1273.88,1274.3,1274.5,1275.26,1275.54,1275.7,1275.88]],[1276.98," e lo lasciò cadere nell'acqua.",[1276.98,1276.98,1277.12,1277.44,1277.82]]]},{"c":[[1279.56,"Non spiegò perché.",[1279.56,1279.84,1280.26]],[1282.6," Nessuno glielo chiese.",[1282.6,1282.6,1282.92]]]},{"c":[[1284.82,"Ripresero il cammino.",[1284.82,1285.48,1285.58]],[1286.59," Lasciarono la camera rotonda da una galleria che saliva,",[1286.59,1287.2,1287.32,1287.66,1288.12,1288.28,1288.44,1288.88,1289.06]],[1291.06," piano, verso un rumore che all'inizio sembrava l'acqua di una chiusa e che poi,",[1291.06,1291.06,1291.46,1291.65,1292.12,1292.41,1293.28,1293.81,1294.2,1294.32,1294.51,1295.45,1295.6,1295.78]],[1297.04," a mano a mano che si avvicinavano,",[1297.04,1297.04,1297.22,1297.34,1297.46,1297.62,1297.76]],[1299.72," diventava un'altra cosa:",[1299.72,1299.91,1300.06]],[1301.54," metallo contro metallo, colpi, passi su una passerella di ferro, e grida in archadiano.",[1301.54,1302.08,1302.5,1303.1,1304.06,1304.46,1304.6,1304.74,1305.25,1305.52,1306.45,1306.6,1306.98,1307.11]],[1308.36," Qualcuno, più avanti, stava ancora combattendo.",[1308.36,1309.16,1309.55,1310.41,1310.82,1311.38]]]},{"c":[[1313.69,"E sopra tutte quelle voci, nitida, una voce di donna, giovane, che non chiedeva niente a nessuno.",[1313.69,1313.84,1314.24,1314.48,1314.92,1315.89,1316.96,1317.08,1317.4,1317.54,1318.4,1319.16,1319.44,1319.6,1320.03,1320.5,1320.6]]]},{"c":[[1322.5,"«Chi è il prossimo?»",[1322.5,1322.84,1322.98,1323.16]]]}]