[{"h":1,"c":[[1.5,"Capitolo sedicesimo: Tre sconosciuti nelle fogne.",[1.5,2.65,4.58,5.16,6.08,6.54]]]},{"c":[[9.81,"Vaan tornò in sé tossendo acqua,",[9.81,10.33,10.73,10.88,11.04,11.65]],[12.8," a pancia in giù su una lastra di pietra bagnata,",[12.8,12.95,13.29,13.47,13.65,13.85,14.03,14.45,14.61,15.05]],[16.33," con la sensazione precisa di aver bevuto mezza Rabanastre e la sensazione meno precisa,",[16.33,16.33,16.47,17.09,17.62,17.83,18.01,18.37,18.67,19.84,19.99,20.09,20.65,20.93]],[22.41," ma più urgente, di avere ancora la pietra.",[22.41,22.41,22.77,23.78,23.99,24.17,24.45,24.6]],[25.56," Ce l'aveva.",[25.56,25.83]],[26.66," Era sotto di lui,",[26.66,26.93,27.23,27.38]],[28.25," schiacciata fra il petto e la lastra,",[28.25,29.05,29.27,29.64,30.84,30.99,31.14]],[32.23," e gli premeva contro lo sterno come un pugno tiepido.",[32.23,32.23,32.37,32.89,33.28,33.49,33.89,34.11,34.27,34.64]],[36.13," La toccò attraverso la camicia fradicia.",[36.13,36.13,36.54,37.27,37.43,38.26]],[39.24," Poi si girò sulla schiena e guardò in alto.",[39.24,39.24,39.45,39.71,39.99,40.37,40.47,40.79,40.95]]]},{"c":[[43.06,"In alto c'era una volta di pietra,",[43.06,43.29,43.82,44.35,44.55,44.81,44.97]],[46.22," lontana, e un buco nella volta, frastagliato, attraverso cui si vedeva un pezzo di cielo rosso.",[46.22,47.56,47.71,47.87,48.21,48.46,49.45,50.43,51.11,51.31,51.49,51.81,51.93,52.25,52.39,52.63]],[53.91," Dal buco cadeva ancora qualcosa ogni tanto:",[53.91,53.91,54.23,54.59,54.87,55.27,55.51]],[56.82," un sasso, una manciata di terra, una tegola, che arrivava giù con un rumore secco e finiva nell'acqua.",[56.82,56.82,57.77,58.05,58.47,58.63,59.41,59.64,60.3,60.57,61.01,61.23,61.41,61.51,61.98,62.88,63.03,63.73]],[64.79," Il fragore del cortile, lassù, era diventato un brontolio lontano.",[64.79,64.79,65.11,65.29,65.75,66.45,66.73,67.23,67.36,68.31]],[69.49," Qualcuno, sopra la città, gridava ancora.",[69.49,69.95,70.33,70.5,71.16,71.69]]]},{"c":[[75.28,"«Ah.",[75.28]],[76.48," Il nostro personaggio secondario è sveglio.»",[76.48,76.48,76.8,77.36,77.98,78.12]]]},{"c":[[80.67,"L'uomo era seduto su un gradino di pietra a due passi da lui, a strizzarsi una manica.",[80.67,81.06,81.24,81.64,81.8,81.9,82.28,82.42,82.88,83.02,83.16,83.52,83.64,84.5,84.56,85.24,85.42]],[86.72," Lo faceva con cura,",[86.72,86.72,87.08,87.42]],[88.44," attorcigliando la stoffa bianca dal polso al gomito,",[88.44,89.12,89.28,89.71,90.18,90.45,90.87,91.08]],[92.4," e l'acqua gocciolava per terra in un filo sottile.",[92.4,92.45,92.74,93.26,93.5,93.8,93.98,94.12,94.39]],[95.72," Si era tolto il panciotto e l'aveva steso su una sporgenza del muro,",[95.72,95.72,95.84,96.12,96.22,97.4,97.46,97.86,98.2,98.36,98.5,99.04,99.2]],[100.45," ben aperto, perché asciugasse senza pieghe.",[100.45,100.45,101.37,101.84,102.36,102.67]],[103.64," I capelli gli si erano incollati alla fronte.",[103.64,103.78,104.48,104.76,104.92,105.14,105.62,105.77]],[107.05," Il ciuffo, notò Vaan con un'oscura soddisfazione, non c'era più.",[107.05,107.05,107.76,108.18,108.6,108.82,109.38,110.66,110.9,111.22]]]},{"c":[[113.98,"Poco più in là, mezzo dentro e mezzo fuori dall'acqua, c'era la barca volante,",[113.98,114.32,114.52,114.72,115.38,115.78,116.12,116.26,116.56,117.01,117.82,118.18,118.32,118.64]],[120.56," inclinata su un fianco come un pesce morto,",[120.56,120.56,120.72,120.82,121.2,121.42,121.54,121.97]],[123.28," con un'ala piegata.",[123.28,123.39,123.59]],[125.14," La viera ci stava sopra.",[125.14,125.14,125.53,125.74,126.02]],[127.82," Aveva aperto un pannello sulla coda e frugava dentro con le dita lunghe,",[127.82,127.82,128.14,128.26,128.64,128.86,129.63,129.78,130.24,130.6,130.82,130.94,131.1]],[132.4," e ogni tanto avvicinava l'orecchio al motore e ascoltava,",[132.4,132.4,132.56,132.8,133.32,133.78,133.88,134.83,134.98]],[137.6," immobile, come si ascolta il petto di un ammalato.",[137.6,137.6,137.94,138.12,138.54,138.7,139.02,139.14,139.28]]]},{"c":[[141.43,"«Allora?»",[141.43]],[142.44," disse l'uomo, senza smettere di strizzare.",[142.44,142.94,143.44,143.84,144.34,144.48]]]},{"c":[[146.65,"«Niente di rotto» disse la viera.",[146.65,147.12,147.35,147.94,148.34,148.5]],[149.88," «Niente che manca.»",[149.88,149.88,150.06]],[150.72," Richiuse il pannello.",[150.72,151.32,151.42]],[152.37," «Ha smesso e basta.»",[152.37,152.58,153.22,153.36]]]},{"c":[[155.47,"«Le cose non smettono e basta, Fran.",[155.47,155.68,155.9,156.06,156.48,156.56,157.46]],[158.18," Non quelle che ho pagato io.»",[158.18,158.18,158.5,158.62,158.75,159.31]]]},{"c":[[162.03,"«Questa sì.»",[162.03,162.53]]]},{"c":[[163.07,"L'uomo sospirò.",[163.07,164.41]],[165.2," Poi guardò Vaan, e la manica che strizzava, e di nuovo Vaan.",[165.2,165.48,166.35,166.94,167.08,167.2,167.58,167.74,168.88,169.02,169.12,169.48]]]},{"c":[[171.44,"«Comunque non la rimetteremmo in aria.",[171.44,172.47,172.74,172.88,173.52,173.66]],[175.51," Lassù c'è una nave da guerra che spara a tutto quello che si muove,",[175.51,175.66,175.72,175.86,176.12,176.26,176.62,176.86,177.26,177.34,177.74,178.1,178.26,178.44]],[179.5," e io mi muovo con molta grazia,",[179.5,179.5,179.66,179.8,180.1,180.3,180.71]],[181.96," il che mi rende un bersaglio eccellente.",[181.96,181.96,182.45,182.68,183.08,183.22,184.15]],[185.68," Si va a piedi.»",[185.68,185.68,185.85,186]],[186.87," Lasciò andare la manica.",[186.87,187.34,187.56,187.72]],[188.59," «Ti sei rotto qualcosa, ragazzo?»",[188.59,188.8,188.96,189.2,189.72]]]},{"c":[[191.23,"Vaan si mise a sedere.",[191.23,192.09,192.3,192.57,192.72]],[193.78," Gli faceva male tutto,",[193.78,193.78,194.12,194.32]],[195.68," in quel modo uniforme e vago che vuol dire che non si è rotto niente di preciso.",[195.68,195.68,196,196.92,197.67,197.96,198.6,198.88,199.14,199.6,199.88,200.08,200.26,200.32,200.58,200.92,201.08]]]},{"c":[[203.17,"«No.»",[203.17]]]},{"c":[[206.94,"«Peccato.",[206.94]],[206.94," Avrei avuto un buon motivo per lasciarti qui.»",[206.94,207.34,207.62,207.74,207.9,208.28,208.48,208.9]]]},{"c":[[211.91,"Ci volle un po' prima che Vaan riuscisse a smettere di guardare la viera.",[211.91,211.91,212.25,212.41,212.47,212.73,212.94,213.22,213.89,213.99,214.39,214.53,214.99,215.11]],[216.37," Lei se ne accorse subito, naturalmente; doveva essere abituata, perché non si voltò e non disse niente,",[216.37,216.37,216.53,216.61,216.95,217.41,218.92,219.39,219.67,220.27,220.53,220.77,221.06,221.63,221.77,221.93,222.28]],[223.89," continuò a sistemare la barca volante tirandola fuori dall'acqua per la coda,",[223.89,223.89,224.01,224.47,224.59,224.93,225.41,225.89,226.13,226.55,226.71,226.81]],[227.95," da sola, con una forza che una cosa così magra non avrebbe dovuto avere.",[227.95,227.95,228.72,228.99,229.21,229.91,230.19,230.39,230.75,231.21,231.95,232.23,232.61,232.97]],[234.08," Fu l'uomo, alla fine, a dirlo.",[234.08,234.28,234.77,235.11,235.76,235.91]]],"st":1},{"c":[[237.51,"«Non ne avevi mai vista una.»",[237.51,237.79,237.91,238.21,238.45,238.91]]]},{"c":[[240.73,"Vaan arrossì.",[240.73,241.56]],[242.56," Era la terza volta in una settimana, e cominciava a pensare che fosse una malattia.",[242.56,242.83,242.99,243.29,243.55,243.71,243.87,244.76,244.91,245.33,245.45,245.77,245.91,246.19,246.35]]]},{"c":[[248.8,"«No.",[248.8]],[249.41," Scusa.",[249.41]],[250.93," Non volevo...»",[250.93,250.93]]]},{"c":[[253.19,"«Non scusarti con me.",[253.19,253.46,254.02,254.26]],[254.81," Io ci sono abituato.",[254.81,255.02,255.18,255.42]],[256.78," La gente la guarda e io guardo la gente che la guarda, ed è uno dei piaceri della vita.»",[256.78,256.78,257,257.19,257.94,258.08,258.22,258.58,258.68,258.94,259.12,259.31,260.01,260.22,260.34,260.44,260.62,261.04,261.2]],[262.36," L'uomo si alzò, si stirò la schiena,",[262.36,262.54,262.72,263.39,263.6,263.84,263.98]],[265.62," riprese il panciotto dalla sporgenza e lo esaminò controluce con aria critica.",[265.62,265.62,265.78,266.24,266.46,267.48,267.62,267.72,268.19,268.87,269.14,269.36]],[270.72," «Le viere non escono dai loro boschi.",[270.72,270.72,271.02,271.2,271.6,271.8,272]],[273.47," Lo sai, no?",[273.47,273.47,273.79]],[274.65," Stanno là dentro da secoli, con i loro alberi e i loro silenzi,",[274.65,275.12,275.26,275.56,275.72,276.35,276.62,276.72,276.92,277.34,277.42,277.48,277.64]],[278.9," e guardano il mondo degli uomini come si guarda un formicaio:",[278.9,278.9,279.28,279.4,279.6,279.85,280.6,280.94,281.14,281.46,281.63]],[283.12," con interesse e da lontano.",[283.12,283.12,284.19,284.34,284.58]],[285.92," Una viera che viaggia è una cosa rara.",[285.92,285.92,286.22,286.38,287.25,287.4,287.58,287.96]],[289.28," Una viera che viaggia con un Huma, poi...»",[289.28,289.28,289.6,289.8,290.22,290.42,290.7,291.27]]]},{"c":[[294.02,"«È una cosa che non si spiega» disse Fran, dalla barca.",[294.02,294.16,294.32,294.56,294.76,294.96,295.17,296.02,296.6,297.08,297.56]],[298.81," «Come un aviopirata che entra in un palazzo dalle fogne.»",[298.81,298.81,298.95,299.68,299.88,300.14,300.28,300.4,300.88,301.14]]]},{"c":[[303.17,"Lo disse con la stessa voce con cui aveva detto beve,",[303.17,303.38,303.66,303.88,304,304.32,304.66,304.88,305.02,305.34,306.3]],[307.58," sulla barca volante,",[307.58,307.58,308.04]],[310.38," piatta e un po' roca,",[310.38,310.38,310.52,310.99,311.45]],[312.38," senza alzare la testa.",[312.38,312.38,312.8,313.04]],[314.27," Ma Vaan non la sentì così.",[314.27,314.51,315,315.28,315.5,315.96]],[318.28," Vaan sentì soltanto due parole,",[318.28,318.28,318.68,319.21,319.48]],[320.8," e le due parole gli entrarono dentro come l'acqua del canale gli era entrata in bocca,",[320.8,320.8,320.92,321.11,321.89,322.16,322.7,323.36,323.64,324.06,324.25,324.91,325.18,325.3,325.66,325.78]],[327.55," tutte in una volta.",[327.55,327.55,327.76,328.08]]]},{"c":[[329.91,"«Pirata» disse.",[329.91,330.38]],[331.23," «Pirata del cielo.",[331.23,331.7,331.88]],[332.48," Siete pirati del cielo?»",[332.48,332.89,333.36,333.54]]]},{"c":[[335.22,"L'uomo si girò verso Fran con un'espressione di rimprovero.",[335.22,336.23,336.44,336.68,336.94,337.28,337.44,338.12,338.22]]]},{"c":[[340,"«Fran.»",[340]]]},{"c":[[342.84,"«Mm.»",[342.84]]]},{"c":[[344.26,"«Avevamo deciso di non dirlo.»",[344.26,344.8,345.26,345.36,345.52]]]},{"c":[[347.45,"«Tu avevi deciso.»",[347.45,347.66,348.21]]]},{"c":[[350.08,"«Siete pirati» ripeté Vaan.",[350.08,350.51,351.34,352.29]],[352.92," Si era alzato in piedi senza accorgersene,",[352.92,352.92,353.04,353.42,353.56,353.86,354.14]],[356.23," gocciolando, con le mani strette a pugno sul petto, sopra la pietra.",[356.23,357.27,357.54,357.68,357.92,358.42,358.56,358.86,359.18,359.96,360.34,360.5]],[361.49," Il dolore uniforme e vago era sparito.",[361.49,361.7,362.12,362.72,362.86,363.43,363.74]],[364.94," «Avete una nave.",[364.94,365.28,365.46]],[366.49," Una nave vostra.",[366.49,366.76,367]],[367.91," Volate dove volete.",[367.91,368.38,368.58]],[369.45," Non chiedete il permesso a nessuno.",[369.45,369.72,370.14,370.26,370.7,370.84]],[371.75," È così?",[371.75,371.9]],[372.72," È così?»",[372.72,372.86]]]},{"c":[[375.16,"L'uomo lo guardò a lungo.",[375.16,375.5,375.66,376,376.12]],[378.62," Sulla sua faccia, per un istante, passò qualcosa che Vaan non seppe leggere, e che forse era tenerezza,",[378.62,378.62,378.84,379.47,379.74,379.86,380.68,381.08,381.54,381.72,381.96,382.14,382.54,383.4,383.54,383.7,384.29,384.56]],[386.02," o forse era il fastidio di chi si vede davanti,",[386.02,386.02,386.83,387.1,387.24,387.8,387.92,388.06,388.22,388.6]],[390.1," all'improvviso, una versione di se stesso più giovane e più ingenua e non sa se esserne lusingato.",[390.1,390.78,390.98,391.54,391.66,391.84,392.22,392.46,393,393.14,393.28,394.44,394.58,394.77,394.99,395.2,395.77]]]},{"c":[[398.13,"«Più o meno» disse.",[398.13,398.44,398.58,398.76]],[399.59," «Il permesso, in effetti, non lo chiediamo.",[399.59,399.8,400.69,400.9,401.49,401.76,401.88]],[403.05," Ma ci viene negato lo stesso, molto spesso, e con le armi.",[403.05,403.05,403.26,403.48,403.88,404.06,404.74,405.25,407,407.14,407.34,407.56]],[408.72," È un dettaglio che nei racconti si omette.»",[408.72,408.72,408.84,409.4,409.64,409.8,410.3,410.48]]]},{"c":[[414.81,"«E l'aeronave?",[414.81,414.89]],[415.53," Dov'è?",[415.53]],[415.82," Com'è?",[415.82]],[416.11," Quanto è veloce?»",[416.11,416.58,416.71]]]},{"c":[[418.54,"«Calma.",[418.54]],[419.6," Calma, per carità.»",[419.6,420.08,420.22]],[421.15," L'uomo alzò le mani.",[421.15,421.92,422.26,422.4]],[423.52," «Una cosa alla volta.",[423.52,423.52,423.84,424]],[425.1," Prima ci presentiamo, come la gente educata.",[425.1,425.38,425.54,426.56,426.9,427.08,427.4]],[428.51," Poi usciamo da questa fogna.",[428.51,428.72,429.1,429.26,429.54]],[432.27," Poi, se sarai molto fortunato e molto zitto, forse ti dirò di che colore è.»",[432.27,432.27,432.48,432.82,433.12,433.78,433.92,434.2,435.16,435.65,435.86,436.1,436.22,436.34,436.81]],[437.92," Si mise una mano sul petto e fece un piccolo inchino,",[437.92,437.92,438.2,438.44,438.64,438.86,439.75,439.9,440.2,440.38,440.82]],[441.88," perfetto, da sala da ballo, che in quella galleria piena d'acqua e di muschio fece uno strano effetto.",[441.88,442.99,443.2,443.44,443.58,444.45,444.72,444.86,445.12,445.74,446.1,446.54,446.66,446.8,447.82,448.16,448.38,448.9]],[450.58," «Balthier.",[450.58]],[451.43," Aviopirata, come la mia socia ha voluto rivelare.",[451.43,452.5,452.84,452.96,453.1,453.4,453.56,453.76]],[454.63," Lei è Fran.»",[454.63,454.9,456.12]]]},{"c":[[457,"«Fran» disse Vaan.",[457,457.55,458.23]]]},{"c":[[460.27,"La viera alzò gli occhi rossi su di lui, e chinò la testa, appena.",[460.27,460.48,460.68,460.94,461.08,461.26,461.62,461.74,461.85,462.81,462.96,463.16,463.48,464.31]],[465.68," Fu tutta la sua presentazione.",[465.68,465.68,466.04,466.16,466.3]]]},{"c":[[469.23,"«E tu?»",[469.23,469.23]],[469.73," chiese Balthier.",[469.73,470.57]]]},{"c":[[471.69,"Vaan pensò a tutte le cose che avrebbe potuto dire.",[471.69,472.26,472.66,472.8,473.02,473.16,473.4,473.54,473.89,474.36]],[475.31," Vaan della bottega di Migelo.",[475.31,476.26,476.78,477.32,477.53]],[479.7," Vaan della Città Bassa.",[479.7,479.7,479.94,480.7]],[482.16," Il fratello di Reks.",[482.16,482.16,482.72,483.39]],[484.74," Nessuna gli sembrò all'altezza di un inchino da sala da ballo.",[484.74,484.74,484.9,485.25,485.84,485.98,486.08,486.44,486.58,486.88,488.21]]]},{"c":[[489.03,"«Vaan» disse.",[489.03,489.3]],[490.22," E poi, perché la cosa gli sembrava ancora troppo poco: «Lo sterminatore di topi.",[490.22,490.49,491.05,491.52,491.68,491.94,492.08,492.46,492.78,493.12,493.85,494.06,494.74,494.96]],[496.08," Del condotto dei Calderai.»",[496.08,496.08,496.54,496.72]]]},{"c":[[498.81,"Ci fu un silenzio.",[498.81,499.02,499.2,499.38]],[500.34," Balthier lo fissò.",[500.34,501.29,501.6]],[502.6," Fran lo fissò.",[502.6,503.41,503.62]],[504.76," In fondo alla galleria una goccia cadde nell'acqua con un rumore minuscolo e definitivo.",[504.76,504.76,505.08,505.22,505.64,505.88,506.22,506.49,506.98,507.2,507.34,507.7,508.34,508.51]]]},{"c":[[510.59,"«Ma guarda» disse Balthier, lentamente.",[510.59,510.99,511.65,512.16,512.97]],[514.56," «Un titolo.",[514.56,514.56]],[515.03," Finalmente qualcuno che si presenta come si deve.»",[515.03,515.76,516.3,516.42,516.56,517,517.2,517.34]],[518.01," Si voltò verso Fran.",[518.01,518.22,518.5,518.96]],[519.33," «Hai sentito?",[519.33,519.6]],[521.04," Lo sterminatore di topi.»",[521.04,521.04,521.87,522.22]]]},{"c":[[524.11,"«Ho sentito.»",[524.11,524.33]]]},{"c":[[526.13,"«Questo sì che è un nome da secondo atto.»",[526.13,526.71,527.25,527.52,527.66,527.76,528,528.18,528.76]],[530.46," Balthier si rimise il panciotto, ancora umido, e se lo abbottonò con gesti precisi.",[530.46,531.19,531.4,531.72,531.84,532.87,533.42,534.32,534.46,534.58,534.68,535.43,535.72,536.5]],[537.8," «Bene, sterminatore.",[537.8,539.1]],[541.54," Visto che sei uno del mestiere, ti nomino nostra guida.",[541.54,541.54,541.7,541.9,542.12,542.32,543.23,543.44,543.82,544.27]],[546.02," Tu conosci le fogne,",[546.02,546.02,546.56,546.72]],[547.72," noi conosciamo tutto il resto,",[547.72,547.88,548.3,548.54,548.7]],[549.73," e insieme usciamo di qui prima che quelli là sopra si ricordino che sotto il cortile ci sono dei canali.",[549.73,549.73,550.16,550.52,550.66,551.12,551.52,551.66,551.88,552.02,552.34,552.5,552.98,553.14,553.38,553.48,553.84,554.02,554.22,554.4]],[555.67," D'accordo?»",[555.67]]]},{"c":[[557.36,"«D'accordo.»",[557.36]],[559.05," Vaan si fermò.",[559.05,559.9,560.06]],[560.93," «Ma la pietra resta a me.»",[560.93,561.14,561.3,561.89,562.3,562.42]]]},{"c":[[564.64,"«Naturalmente.»",[564.64]]]},{"c":[[566.74,"«Dico sul serio.",[566.74,567.08,567.3]],[568.17," La tengo io.",[568.17,568.38,568.77]],[569.72," Non la tocchi.",[569.72,570.04,570.25]],[570.88," Non ci pensi neanche.»",[570.88,571.06,571.22,571.54]]]},{"c":[[573.34,"Balthier si portò una mano al petto, ferito.",[573.34,575.4,575.61,575.95,576.11,576.33,576.61,577.56]],[578.77," «Ragazzo.",[578.77]],[580.46," Ma per chi mi hai preso?",[580.46,580.46,580.73,580.87,581.03,581.31]],[583.07," Il pensiero non mi ha mai sfiorato.»",[583.07,583.07,583.55,583.71,583.83,583.93,584.15]]]},{"c":[[585.93,"Dalla barca volante, Fran fece un piccolo rumore con il naso.",[585.93,586.33,586.72,587.81,588.45,588.79,588.91,589.32,589.98,590.25,590.57]]]},{"c":[[592.68,"«Mai?»",[592.68]],[593.49," disse.",[593.49]]]},{"c":[[595.27,"«Mai, Fran.",[595.27,595.59]],[596.47," Sono un uomo nuovo.",[596.47,596.81,597.01,597.19]],[597.77," L'acqua mi ha purificato.»",[597.77,598.47,598.61,598.69]]]},{"c":[[599.24,"«Mm.»",[599.24]]]},{"c":[[603.75,"Vaan guardò lei, poi lui, e capì che non aveva capito niente e che, in compenso, aveva capito l'essenziale.",[603.75,604.03,604.6,605.36,605.7,606.43,606.57,606.87,607.05,607.17,607.45,607.9,608.69,608.83,609,609.29,610.33,610.73,611.47]],[612.83," Si strinse la pietra sotto la camicia e decise che avrebbe dormito con un occhio aperto,",[612.83,612.83,613.21,613.35,613.69,613.97,614.15,615.16,615.31,615.63,615.77,616.05,616.55,616.77,616.91,617.32]],[618.59," se mai avesse dormito,",[618.59,618.59,618.77,619.1]],[620.33," e che non si sarebbe fatto prendere alle spalle.",[620.33,620.33,620.58,620.85,621.01,621.33,621.63,622.15,622.36]],[623.83," Poi indicò una galleria a sinistra, quella dove l'acqua correva più svelta.",[623.83,623.83,624.27,624.51,625,625.15,626.15,626.39,626.61,626.95,627.35,627.56]]]},{"c":[[630.32,"«Da quella parte» disse.",[630.32,630.53,630.77,631.15]],[633.41," «Controcorrente si va verso il palazzo.",[633.41,633.41,633.61,633.73,634.05,634.19]],[635.59," A favore di corrente si va verso le cisterne,",[635.59,635.59,635.99,636.13,637.36,637.57,637.69,637.99,638.17]],[639.65," e dalle cisterne ci sono le scale che salgono al quartiere nord.»",[639.65,639.65,639.89,640.92,641.13,641.41,641.59,641.85,642.03,642.49,642.63,643.15]]]},{"c":[[645.08,"«Lo sai o lo dici?»",[645.08,645.29,646.07,646.21,646.29]]]},{"c":[[648.12,"«Lo dico.»",[648.12,648.37]]]},{"c":[[650.5,"«Mi piace la tua onestà.»",[650.5,650.71,651.09,651.25,651.42]],[652.14," Balthier si avviò.",[652.14,653.11,653.29]],[655.19," «È una qualità rara nei personaggi secondari.»",[655.19,655.19,655.35,655.93,656.27,656.49,657.19]]]},{"c":[[662.46,"Camminarono a favore di corrente.",[662.46,663.25,663.37,663.67,663.79]],[665.13," Le gallerie erano diverse da quelle che Vaan aveva percorso all'andata:",[665.13,665.13,665.53,665.83,666.25,666.41,666.65,666.99,667.45,667.85,668.68]],[669.79," più basse, più vecchie, e in molti punti segnate dal bombardamento.",[669.79,669.79,670.55,670.8,672.14,672.29,672.41,672.76,673.5,674.03,674.21]],[675.94," Il colpo dell'Ifrit, sopra,",[675.94,676.15,676.64,677.52]],[678.62," aveva fatto tremare tutto;",[678.62,679.01,679.33,679.87]],[681.05," c'erano tratti di volta crollati,",[681.05,681.29,681.63,681.79,682.03]],[683.2," mucchi di pietre in mezzo alle passerelle,",[683.2,683.51,683.63,684.05,684.23,684.39,684.53]],[685.95," crepe nuove nei muri da cui l'acqua usciva a spruzzi,",[685.95,686.21,686.61,686.81,687.09,687.19,687.34,687.65,688,688.06]],[690.27," come da una botte forata.",[690.27,690.27,690.41,690.55,690.88]],[692.59," In un punto la passerella era sparita del tutto,",[692.59,692.59,692.71,693.64,693.85,694.27,694.55,694.97,695.17]],[696.17," e dovettero passare uno alla volta su una trave di ferro che attraversava il canale,",[696.17,696.17,696.65,697.05,697.31,697.57,698.04,698.25,698.41,698.67,698.88,699.48,699.75,700.29,700.41]],[701.67," e Balthier passò per primo con le braccia larghe,",[701.67,701.76,702.45,702.85,703.01,703.25,703.43,703.53,703.85]],[705.13," come un funambolo in piazza,",[705.13,705.13,705.33,705.95,706.16]],[707.55," e Fran passò per ultima senza guardare dove metteva i piedi,",[707.55,707.55,708.23,708.63,708.85,709.23,709.59,710.43,710.77,711.21,711.49]],[712.63," e Vaan passò in mezzo,",[712.63,712.67,712.81,713.15,713.29]],[714.71," guardando dove metteva i piedi con tutta l'attenzione di cui era capace.",[714.71,714.71,714.91,715.29,715.4,715.81,715.97,716.25,716.87,717.05,717.25,717.48]]],"st":1},{"c":[[719.66,"Balthier parlava.",[719.66,720.3]],[721.18," Parlava quasi sempre, con quella sua voce di uno che racconta una storia a tavola,",[721.18,721.71,721.95,722.88,723.15,723.41,723.59,723.93,724.09,724.56,724.83,725.35,725.57,726.09,726.23]],[727.23," e diceva cose di cui la metà erano vere e l'altra metà erano più divertenti.",[727.23,727.23,727.69,728.03,728.23,728.37,728.55,729.21,729.63,730.5,730.57,730.99,731.71,732.11,732.44]],[733.86," Disse che le fogne di Rabanastre erano le più eleganti che avesse mai visitato, e ne aveva visitate molte.",[733.86,734.25,734.37,734.49,734.75,734.87,735.71,736.11,736.25,736.41,736.95,737.07,737.39,737.59,738.73,738.87,738.97,739.23,739.73]],[740.93," Disse che a Bhujerba le fogne non c'erano,",[740.93,741.25,741.51,741.58,742.17,742.35,742.57,743.08]],[744.09," perché la città stava sospesa nel cielo e quello che si buttava cadeva in testa a qualcun altro,",[744.09,744.09,744.25,744.61,744.98,745.51,745.75,746.71,746.85,747.19,747.34,747.7,748.6,749.07,749.25,749.66,749.81,750.13]],[751.31," molto più in basso,",[751.31,751.31,751.49,751.63]],[752.69," che di solito non si lamentava perché era un mercante archadiano.",[752.69,752.69,752.83,753.21,753.37,753.49,754.01,754.3,754.57,754.77,755.84]],[757.17," Disse che a Balfonheim, la città degli aviopirati, le fogne erano la parte più pulita del porto.",[757.17,757.17,757.47,757.61,759.1,759.31,759.71,760.23,761.26,761.47,762.35,762.75,762.91,763.17,763.37,763.77,764.38]],[765.03," Vaan ascoltava tutto,",[765.03,765.75,766.43]],[767.55," con la bocca mezza aperta,",[767.55,767.55,767.75,768.17,768.7]],[769.91," e ogni nome di città gli si accendeva dentro come una lanterna.",[769.91,769.91,770.15,770.4,770.64,771.36,771.63,771.73,772.19,772.51,772.83,773.07]]]},{"c":[[774.83,"Fran non parlava.",[774.83,775.71,775.85]],[776.71," Camminava, e ascoltava,",[776.71,777.85,777.99]],[779.21," e ogni tanto si fermava e girava le orecchie verso un punto del buio,",[779.21,779.21,779.37,779.67,779.98,781.02,781.17,781.55,781.67,782.05,782.33,782.49,782.83,783.13]],[784.17," e allora si fermavano anche gli altri;",[784.17,784.17,785.2,785.41,785.95,786.17,786.35]],[787.67," una volta dal buio uscì una bestia,",[787.67,787.67,787.89,788.09,788.77,789.11,789.27]],[790.46," una specie di rospo grosso come un cane con la pelle che luccicava di muco,",[790.46,790.65,791.01,791.17,791.82,792.51,792.85,793.05,793.39,793.57,793.69,794.01,794.16,794.63,794.77]],[795.85," e Fran la abbatté con una freccia sola prima che Vaan avesse finito di tirare fuori la spada.",[795.85,795.85,796.3,796.44,796.93,797.11,797.29,798,798.41,798.69,798.84,799.03,799.43,799.75,799.89,800.23,800.57,800.73]],[802.03," L'arco lo portava sulla schiena.",[802.03,802.21,802.33,802.67,802.91]],[804.63," Vaan non l'aveva visto prenderlo.",[804.63,804.63,804.82,805.19,805.49]]]},{"c":[[807.41,"«Come hai fatto?»",[807.41,807.75,807.89]],[808.63," chiese.",[808.63]]]},{"c":[[810.74,"«Era lì» disse Fran.",[810.74,811.28,811.5,811.91]]]},{"c":[[813.66,"«Il rospo?»",[813.66,815.31]]]},{"c":[[816.36,"«L'arco.»",[816.36]]]},{"c":[[819.06,"Era il genere di risposta che Fran dava, Vaan avrebbe imparato.",[819.06,819.33,819.47,819.71,819.89,820.37,820.53,820.87,821.45,822.04,822.57]],[824.58," Risposte che non spiegavano niente e che, a pensarci dopo, spiegavano tutto quello che c'era da spiegare.",[824.58,824.58,824.85,824.99,825.47,826.35,826.49,826.85,826.99,827.47,828.16,828.89,829.23,829.63,829.81,830.05,830.17]]]},{"c":[[833.46,"I morti li trovarono in una camera rotonda,",[833.46,833.46,833.82,833.92,834.48,834.58,834.78,835.14]],[836.68," dove tre canali si incontravano e l'acqua girava in un vortice lento prima di proseguire.",[836.68,836.68,836.92,837.38,837.58,838.89,838.96,839.36,839.82,840,840.16,840.7,841.12,841.52,841.66]]],"st":1},{"c":[[843.62,"Erano sette.",[843.62,844.13]],[845.06," Erano sulla passerella che correva lungo il muro, dove erano caduti,",[845.06,845.46,845.66,846.1,846.34,846.72,846.96,847.06,847.6,847.94,848.19]],[849.48," e nell'acqua sotto la passerella,",[849.48,849.57,850.42,850.82,850.98]],[852.32," dove il vortice li aveva portati e li faceva girare piano,",[852.32,852.32,852.46,852.86,853,853.29,853.82,853.96,854.06,854.42,854.8]],[856.22," uno dopo l'altro, con le facce in giù.",[856.22,856.22,856.53,857,857.28,857.36,857.68,857.8]],[858.07," Avevano corazze di cuoio e di maglia.",[858.07,858.6,859.06,859.3,859.7,859.82,859.9]],[861.42," Avevano spade corte, e due di loro le tenevano ancora in mano.",[861.42,861.42,861.94,863.36,863.5,863.68,863.84,864.51,864.72,865.2,865.54,865.7]],[866.98," Erano morti combattendo, si vedeva, e combattendo contro qualcuno che era arrivato dall'alto,",[866.98,866.98,867.47,868.83,869.11,870.18,870.32,871,871.36,871.9,872.04,872.16,873.12]],[874.08," perché sulla passerella c'erano dardi di balestra conficcati nel legno,",[874.08,874.08,874.34,874.91,875.26,875.66,875.8,876.18,876.84,877.02]],[878.02," a decine, tutti inclinati nello stesso verso.",[878.02,878.19,879.18,879.58,880.18,880.5,880.92]]]},{"c":[[882.13,"Balthier smise di parlare.",[882.13,884.08,884.48,884.69]],[886.05," Fu la prima cosa che Vaan notò,",[886.05,886.26,886.4,886.68,887.02,887.25,887.56]],[888.58," e la notò perché il silenzio,",[888.58,888.58,888.74,889.08,889.41,889.72]],[891.03," dopo tanto chiacchierare,",[891.03,891.32,891.72]],[893.05," fu improvviso come una porta chiusa.",[893.05,893.2,893.84,894.06,894.24,894.61]]]},{"c":[[896.32,"L'uomo si avvicinò al primo dei corpi sulla passerella.",[896.32,897.01,897.22,897.7,897.9,898.16,898.36,898.76,899.02]],[900.26," Si accovacciò.",[900.26,900.46]],[901.36," Guardò la ferita, senza toccarla.",[901.36,901.66,901.76,902.34,902.74]],[903.72," Guardò i dardi nel legno.",[903.72,903.94,904.08,904.34,904.52]],[905.21," Guardò, per un lungo momento,",[905.21,905.76,906,906.14,906.48]],[907.76," il soffitto della camera,",[907.76,907.76,908.28,908.53]],[909.68," dove c'era una galleria più alta che correva tutto intorno,",[909.68,910.04,910.4,910.58,911.02,911.26,911.6,911.78,912.14,912.38]],[913.64," una specie di balcone di pietra nell'ombra.",[913.64,913.64,913.98,914.1,914.46,914.67,915.58]],[916.94," Poi si rialzò.",[916.94,916.94,917.1]]]},{"c":[[919.17,"«Li aspettavano» disse.",[919.17,919.38,920.14]]]},{"c":[[922.17,"Non lo disse a nessuno in particolare.",[922.17,922.44,922.56,922.8,922.94,923.18,923.3]],[924.9," Fran annuì, una volta.",[924.9,925.48,926.11,926.38]]]},{"c":[[928.27,"«Là sopra» continuò Balthier, indicando il balcone con il mento.",[928.27,928.5,929.3,929.94,930.58,931.12,931.24,931.62,931.78,931.98]],[932.98," «Venti balestrieri, forse trenta.",[932.98,933.26,934.58,935.01]],[936.06," Messi lì prima.",[936.06,936.46,936.62]],[937.55," Chi arrivava dai canali verso il palazzo doveva passare da questa camera, e chi passava da questa camera...»",[937.55,937.68,938.08,938.24,938.58,938.82,938.96,939.65,940.12,940.52,940.64,940.9,941.62,941.76,941.88,942.34,942.48,942.74]],[944.3," Non finì la frase.",[944.3,944.3,944.64,944.8]],[946.11," Non serviva.",[946.11,946.61]],[947.73," «Non è stata una battaglia.",[947.73,948.06,948.2,948.55,948.94]],[950.46," È stata una conta.»",[950.46,950.6,950.94,951.24]]]},{"c":[[952.59,"Vaan non lo ascoltava più.",[952.59,953.68,953.9,954.04,954.44]],[955.4," Si era fermato davanti al terzo corpo sulla passerella, quello più vicino al vortice, e lo guardava.",[955.4,955.4,955.5,955.84,956.14,956.24,956.5,956.74,956.96,957.98,958.42,958.58,958.9,959.02,959.74,959.88,960]],[960.93," Era un uomo giovane, forse vent'anni, con la barba rada e i capelli corti.",[960.93,961.14,961.28,961.44,962.34,962.86,963.7,963.84,963.98,964.32,964.6,964.74,964.8,965.22]],[966.06," Aveva gli occhi aperti.",[966.06,966.44,966.58,966.87]],[968.72," Aveva sulla spalla sinistra,",[968.72,969.12,969.42,969.94]],[971.27," fermato con una fibbia di ferro,",[971.27,971.8,972.02,972.2,972.5,972.72]],[973.98," un pezzo di mantello azzurro,",[973.98,973.98,974.3,974.42,974.97]],[976.18," sbiadito dal sole e dai lavaggi fino a diventare quasi grigio.",[976.18,976.58,976.84,977.75,977.9,978.04,978.52,978.76,978.86,979.34,979.77]]]},{"c":[[981.52,"Vaan lo aveva visto quella stessa mattina,",[981.52,981.75,981.96,982.24,982.56,982.86,983.22]],[985.12," o forse il giorno prima;",[985.12,985.12,986.31,986.52,986.78]],[987.98," non sapeva più quanto tempo fosse passato.",[987.98,987.98,988.38,988.6,988.88,989.14,989.5]],[990.94," Lo aveva visto sulla piattaforma della vasca,",[990.94,990.94,991.24,991.58,991.86,992.5,992.74]],[994.3," nella luce della lanterna coperta,",[994.3,994.3,994.64,994.88,995.41]],[996.76," fare rapporto al capitano con i capelli lunghi.",[996.76,996.76,997.3,997.42,998.28,998.56,998.68,999.04]],[1000.66," Le squadre del nord e del pozzo vecchio sono in posizione.",[1000.66,1000.66,1001.04,1001.2,1001.98,1002.12,1002.28,1002.64,1003.56,1003.9,1004.06]],[1005.66," Nessuna pattuglia sotto il terzo ponte.",[1005.66,1005.66,1006.16,1006.36,1006.48,1006.78]],[1008.26," Abbiamo visto solo topi.",[1008.26,1008.26,1008.58,1009.16]],[1010.38," Lo aveva visto fare il saluto dei soldati del re,",[1010.38,1010.38,1010.62,1010.86,1011.08,1011.22,1011.52,1011.72,1012.16,1012.36]],[1013.44," il pugno sul cuore e poi giù,",[1013.44,1013.44,1013.74,1013.96,1014.38,1014.52,1014.75]],[1015.7," e andarsene di corsa lungo la passerella.",[1015.7,1015.7,1016.14,1016.28,1016.62,1016.9,1017]]]},{"c":[[1019.23,"Si inginocchiò.",[1019.23,1019.44]],[1020.47," Non sapeva perché.",[1020.47,1020.87,1021.34]],[1022.82," Allungò una mano verso il mantello azzurro e la fermò a mezz'aria, e la tenne lì.",[1022.82,1022.82,1022.98,1023.2,1023.46,1023.58,1024.04,1025.08,1025.22,1025.3,1025.6,1025.76,1027.06,1027.2,1027.3,1027.6]]]},{"c":[[1029.03,"«Lo conoscevi?»",[1029.03,1029.24]],[1030.15," chiese Balthier, piano.",[1030.15,1030.72,1031.48]]]},{"c":[[1033.53,"«No.»",[1033.53]],[1034.09," Vaan ritirò la mano.",[1034.09,1035.21,1035.68,1035.8]],[1036.39," «L'ho visto.",[1036.39,1036.84]],[1037.68," Una volta.",[1037.68,1037.98]],[1038.88," Era...»",[1038.88]],[1039.8," Non finì.",[1039.8,1040.1]],[1041.14," Non sapeva come dire che era vivo,",[1041.14,1041.14,1041.54,1041.74,1042.06,1042.26,1042.4]],[1043.63," e che diceva abbiamo visto solo topi,",[1043.63,1043.63,1044.07,1044.72,1045.32,1045.86,1046.46]],[1047.72," e che aveva ragione,",[1047.72,1047.72,1047.9,1048.26]],[1049.6," e che proprio per questo era morto.",[1049.6,1049.6,1049.72,1050.04,1050.28,1051.04,1051.5]]]},{"c":[[1053.16,"Nessuno disse niente per un po'.",[1053.16,1053.7,1053.92,1054.26,1054.44,1054.56]],[1055.48," Il vortice girava.",[1055.48,1055.48,1056.05]],[1057.42," Uno dei corpi nell'acqua passò sotto la passerella,",[1057.42,1057.42,1057.6,1058.1,1059,1059.4,1059.76,1059.9]],[1062.5," lento, e poi tornò fuori dall'altra parte, e continuò a girare.",[1062.5,1062.5,1062.64,1062.78,1063.12,1063.37,1063.82,1065.02,1065.16,1065.6,1065.73]]]},{"c":[[1067.63,"«Ha parlato di pace» disse Vaan.",[1067.63,1067.84,1068.24,1068.38,1069.12,1069.94]],[1070.6," Lo disse al pavimento.",[1070.6,1070.6,1070.82,1070.98]],[1072.46," «In piazza.",[1072.46,1072.46]],[1073.65," Cinque giorni fa.",[1073.65,1074.12,1074.44]],[1075.29," Ha detto che non voleva che lo amassimo.",[1075.29,1075.5,1075.74,1075.9,1076.06,1076.44,1076.58,1076.7]],[1077.87," Ha detto dateci una stagione di pace.",[1077.87,1078.08,1078.36,1078.8,1078.98,1079.42,1079.62]],[1080.94," Ha detto che serviva Dalmasca come se fosse sua.»",[1080.94,1080.94,1081.16,1081.32,1081.95,1082.66,1083,1083.14,1083.5]],[1085.18," Alzò la testa.",[1085.18,1085.52,1085.76]],[1086.65," «E la gente ha applaudito.",[1086.65,1086.8,1086.92,1087.22,1087.42]],[1088.59," Io c'ero.",[1088.59,1088.99]],[1089.8," Hanno applaudito.»",[1089.8,1090]]]},{"c":[[1092.21,"«Lo so» disse Balthier.",[1092.21,1092.51,1093.4,1094.01]],[1094.98," «È un bravo oratore.",[1094.98,1094.98,1095.08,1095.3]],[1096.5," I bravi oratori fanno applaudire la gente, è il loro mestiere.",[1096.5,1096.5,1096.82,1097.58,1097.98,1098.58,1098.74,1099.45,1099.6,1099.72,1099.88]],[1101.22," Poi qualcun altro fa il resto, con le balestre, in un posto dove la gente non guarda.»",[1101.22,1101.22,1101.64,1101.87,1102.08,1102.28,1103.16,1103.44,1103.58,1104.81,1105.02,1105.18,1105.58,1105.74,1105.88,1106.18,1106.51]],[1107.66," Si voltò verso l'uscita della camera.",[1107.66,1107.66,1108.04,1108.33,1108.74,1108.94]],[1110.13," «Ad Archades lo chiamano governare.»",[1110.13,1110.34,1111.19,1111.4,1112.39]]]},{"c":[[1114.58,"«Bisogna dirlo.»",[1114.58,1115.19]],[1115.84," Vaan si alzò.",[1115.84,1116.36,1116.52]],[1117.38," Aveva la voce rotta e non gli importava.",[1117.38,1117.78,1117.88,1118.15,1118.76,1118.9,1119.06,1119.18]],[1120.32," «Bisogna dirlo a tutti.",[1120.32,1120.86,1121.12,1121.26]],[1122.46," Andare in piazza e dirlo.",[1122.46,1122.46,1122.66,1123.54,1123.69]],[1124.98," Che li ha fatti ammazzare come topi.",[1124.98,1124.98,1125.08,1125.24,1125.46,1126.08,1127.14]],[1128.36," Che era tutto preparato.",[1128.36,1128.36,1128.69,1129.26]],[1131.06," Che...»",[1131.06]]]},{"c":[[1132.62,"«E chi ti crede?»",[1132.62,1134.18,1134.46,1134.78]]]},{"c":[[1136.24,"Vaan si fermò.",[1136.24,1137.41,1137.71]]]},{"c":[[1139.48,"«Pensaci, sterminatore.»",[1139.48,1140.02]],[1141.15," Balthier non lo diceva con cattiveria.",[1141.15,1141.9,1142.1,1142.24,1142.64,1142.84]],[1144.14," Lo diceva con una specie di stanchezza, come una cosa che aveva già pensato molte volte.",[1144.14,1144.14,1144.58,1144.78,1144.96,1145.32,1145.47,1146.76,1147.1,1147.38,1147.72,1147.92,1148.22,1148.38,1148.92,1149.39]],[1150.84," «Domani mattina, in piazza,",[1150.84,1150.84,1151.81,1152.02]],[1153.38," il console annuncerà che un manipolo di terroristi ha cercato di assassinarlo durante una cena in onore",[1153.38,1153.38,1153.89,1154.56,1154.72,1154.9,1155.4,1155.54,1156.19,1156.4,1156.88,1157,1157.98,1158.52,1158.78,1159.49,1159.71]],[1160.17," della nobiltà dalmasca,",[1160.17,1160.46,1161.46]],[1162.6," e che grazie al cielo e ai suoi soldati la nobiltà dalmasca è salva.",[1162.6,1162.6,1162.72,1163.14,1163.32,1164.04,1164.18,1164.32,1164.52,1165.65,1165.86,1166.3,1166.8,1166.95]],[1168," Ringrazierà gli dèi.",[1168,1168.82,1169.22]],[1171.29," Forse si commuoverà.",[1171.29,1171.29,1171.54]],[1172.78," La piazza applaudirà,",[1172.78,1172.78,1173.49]],[1175.16," perché la piazza ha avuto paura stanotte,",[1175.16,1175.16,1175.32,1175.68,1175.82,1176.08,1176.46]],[1177.94," ha sentito i cannoni,",[1177.94,1177.94,1179.26,1179.48]],[1180.86," e la gente che ha paura applaude chi la fa smettere.",[1180.86,1180.86,1180.98,1181.3,1181.48,1181.62,1181.98,1182.54,1182.82,1183,1183.16]],[1184.41," E poi arrivi tu.",[1184.41,1184.56,1184.8,1185.16]],[1185.81," Un ragazzo della Città Bassa,",[1185.81,1186.02,1186.52,1186.74,1187.13]],[1188.18," che ha passato la notte nelle fogne a rubare un tesoro dal palazzo,",[1188.18,1188.18,1188.26,1188.66,1188.78,1189.1,1189.3,1189.64,1189.74,1190.04,1190.14,1190.5,1190.72]],[1192.06," e che dice che è tutto falso.»",[1192.06,1192.06,1192.16,1192.4,1192.54,1192.66,1192.91]],[1194.94," Si strinse nelle spalle.",[1194.94,1194.94,1195.34,1195.62]],[1196.86," «Io non ti crederei.",[1196.86,1196.86,1197.04,1197.16]],[1198.55," E io, a differenza della piazza, so che hai ragione.»",[1198.55,1198.55,1199.13,1199.28,1199.78,1200.03,1200.95,1201.34,1201.62,1201.78]]]},{"c":[[1204.43,"Vaan non rispose.",[1204.43,1205.12,1205.45]],[1206.29," Strinse i pugni.",[1206.29,1206.88,1207.03]],[1207.79," Sotto la camicia la pietra era calda, più calda di prima.",[1207.79,1208.19,1208.35,1208.75,1208.93,1209.33,1209.64,1210.17,1210.51,1210.91,1211.03]]]},{"c":[[1212.68,"«Allora non serve a niente» disse.",[1212.68,1213.15,1213.35,1213.7,1213.85,1214.33]]]},{"c":[[1216.98,"«Questo non l'ho detto.»",[1216.98,1217.57,1217.78,1217.99]]]},{"c":[[1219.02,"«L'hai detto.»",[1219.02,1219.85]]]},{"c":[[1221.74,"«Ho detto che non serve andare in piazza.",[1221.74,1221.95,1222.19,1222.39,1222.61,1222.89,1223.07,1223.23]],[1224.38," È diverso.»",[1224.38,1224.53]],[1225.19," Balthier lo guardò,",[1225.19,1225.95,1226.09]],[1227.19," e per un attimo i suoi occhi ebbero la stessa durezza di quando aveva detto non guardare,",[1227.19,1227.19,1227.37,1227.49,1227.77,1227.89,1228.11,1228.37,1228.69,1228.85,1229.21,1229.71,1229.85,1230.07,1230.37,1231.12,1231.43]],[1233.07," sulla terrazza.",[1233.07,1233.07]],[1234.77," «Ci sono cose che non servono a niente e si fanno lo stesso.",[1234.77,1234.97,1235.17,1235.45,1235.57,1235.73,1236.16,1236.31,1237.11,1237.25,1237.39,1237.65,1237.83]],[1239.05," Ma bisogna essere vivi, per farle.",[1239.05,1239.05,1239.59,1240.23,1240.97,1241.33]],[1243.39," E per essere vivi, adesso, bisogna uscire di qui.»",[1243.39,1243.39,1243.57,1243.95,1244.44,1245.31,1245.85,1246.25,1246.37]]]},{"c":[[1248.29,"Fran si era avvicinata al bordo della passerella.",[1248.29,1249.04,1249.25,1249.41,1250.03,1250.21,1250.49,1250.71]],[1252.49," Stava guardando l'acqua del vortice,",[1252.49,1252.49,1252.98,1253.31,1253.51]],[1255.47," i corpi che giravano,",[1255.47,1255.47,1255.83,1256.07]],[1257.41," e aveva le orecchie basse,",[1257.41,1257.41,1257.86,1258.07,1258.55]],[1260.11," piegate all'indietro,",[1260.11,1260.71]],[1261.65," in un modo che Vaan non le aveva ancora visto.",[1261.65,1261.65,1261.81,1261.99,1262.45,1263.07,1263.35,1263.47,1263.75,1264.03]],[1265.27," Poi fece una cosa piccola.",[1265.27,1265.27,1265.55,1265.69,1265.95]],[1267.33," Si chinò, raccolse da terra uno dei dardi di balestra caduti, lo spezzò in due fra le dita lunghe,",[1267.33,1267.33,1268.09,1268.69,1268.81,1269.13,1269.41,1269.64,1270.05,1270.19,1270.68,1271.56,1271.77,1272.2,1272.41,1273.15,1273.43,1273.59,1273.77]],[1274.87," e lo lasciò cadere nell'acqua.",[1274.87,1274.87,1275.01,1275.33,1275.7]]]},{"c":[[1277.43,"Non spiegò perché.",[1277.43,1277.71,1278.13]],[1280.49," Nessuno glielo chiese.",[1280.49,1280.49,1280.81]]]},{"c":[[1282.7,"Ripresero il cammino.",[1282.7,1283.37,1283.47]],[1284.49," Lasciarono la camera rotonda da una galleria che saliva,",[1284.49,1285.09,1285.21,1285.53,1286.01,1286.17,1286.33,1286.77,1286.95]],[1288.96," piano, verso un rumore che all'inizio sembrava l'acqua di una chiusa e che poi,",[1288.96,1288.96,1289.37,1289.54,1290.01,1290.3,1291.17,1291.7,1292.09,1292.21,1292.4,1293.35,1293.49,1293.67]],[1294.93," a mano a mano che si avvicinavano,",[1294.93,1294.93,1295.09,1295.23,1295.35,1295.49,1295.63]],[1297.61," diventava un'altra cosa:",[1297.61,1297.8,1297.95]],[1299.97," metallo contro metallo, colpi, passi su una passerella di ferro, e grida in archadiano.",[1299.97,1299.97,1300.39,1300.99,1301.94,1302.35,1302.47,1302.61,1303.12,1303.42,1304.33,1304.47,1304.87,1305]],[1306.23," Qualcuno, più avanti, stava ancora combattendo.",[1306.23,1307.05,1307.44,1308.29,1308.69,1309.29]]]},{"c":[[1311.57,"E sopra tutte quelle voci, nitida, una voce di donna, giovane, che non chiedeva niente a nessuno.",[1311.57,1311.71,1312.11,1312.39,1312.83,1313.76,1314.67,1314.95,1315.27,1315.44,1316.23,1317.03,1317.31,1317.47,1317.92,1318.39,1318.49]]]},{"c":[[1320.39,"«Chi è il prossimo?»",[1320.39,1320.72,1320.87,1321.05]]]}]