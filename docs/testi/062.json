[{"h":1,"c":[[2.1,"Capitolo sessantaduesimo: Il segreto di Draklor.",[2.1,3.23,5.35,5.58,6.29,6.48]]]},{"c":[[10.54,"Mjrn si svegliò all'aperto, sotto le stelle, sullo spiazzo davanti alla miniera, dove gli altri l'avevano portata perché nessuno di loro voleva passare una notte in più sotto quelle travi.",[10.54,10.95,11.16,11.8,12.62,13.02,13.2,14.14,14.34,14.76,15.1,15.22,16.04,16.34,16.5,16.79,17.27,17.8,18.08,18.58,18.7,18.92,19.3,19.74,19.94,20.24,20.36,20.48,20.74,21]],[22.1," Avevano spostato i corpi.",[22.1,22.5,22.98,23.08]],[24.28," Basch e Balthier li avevano allineati dietro una delle baracche e li avevano coperti con dei teli trovati accanto all'argano, e Larsa aveva chiesto di poter restare un momento solo con loro,",[24.28,24.73,24.87,25.97,26.18,26.56,27.1,27.48,27.7,27.88,29.16,29.3,29.42,29.76,30.22,30.4,30.58,30.76,31.18,31.56,32.61,32.73,33.3,33.7,34.06,34.2,34.5,34.86,34.98,35.64,35.98,36.2]],[37.39," e nessuno gli aveva chiesto perché.",[37.39,37.39,38.13,38.4,38.62,38.98]],[41.22," Quando era tornato al fuoco aveva gli occhi asciutti e la faccia molto composta, la faccia di un ragazzo a cui hanno insegnato che un principe non piange davanti ai sudditi,",[41.22,41.22,41.4,41.82,41.94,42.75,43.16,43.28,43.46,44.39,44.54,44.64,44.92,45.2,46.43,46.64,46.9,47,47.08,47.51,47.66,47.76,47.96,48.91,49.18,49.34,49.78,50.02,50.34,50.76,50.9]],[52.1," e che non sa ancora se quelli che ha davanti siano sudditi o no.",[52.1,52.1,52.22,52.38,52.58,52.99,53.2,53.5,53.6,53.72,54.04,54.36,54.84,54.98]]]},{"c":[[56.57,"Il fuoco era piccolo, fatto con le assi di una cassa.",[56.57,56.78,57.08,57.22,58.12,58.3,58.48,58.58,58.8,58.88,59.02]],[60.06," Mjrn si mise a sedere adagio, con la schiena contro un sasso, avvolta nel mantello di Fran.",[60.06,60.89,61.1,61.33,61.48,62.02,62.57,62.84,62.96,63.26,63.52,63.8,64.48,65.02,65.18,65.56,65.68]],[66.37," Guardò le facce intorno a sé una per una.",[66.37,66.84,66.96,67.26,67.62,67.74,67.9,68.16,68.38]],[70.19," Poi guardò la sorella, che le sedeva accanto, e non distolse più gli occhi.",[70.19,70.19,70.66,70.8,71.52,71.8,71.94,72.26,73.3,73.44,73.56,74.04,74.2,74.36]]]},{"c":[[76.02,"«Sei vera» disse.",[76.02,76.42,77.09]]]},{"c":[[78.73,"«Sì.»",[78.73]]]},{"c":[[80.33,"«Ti credevo morta.",[80.33,80.54,81.14]],[81.92," A Eruyt dicono che sei morta.»",[81.92,81.98,82.32,82.72,82.86,83.22]],[84.6," Mjrn ci pensò.",[84.6,85.71,86.08]],[87.05," «No.",[87.05]],[87.48," Non lo dicono.",[87.48,87.76,87.93]],[88.63," Non dicono niente.",[88.63,88.9,89.29]],[90.52," È peggio.»",[90.52,90.85]]]},{"c":[[92.88,"Fran non rispose.",[92.88,93.09,93.25]],[94.99," Le passò una ciotola d'acqua, e Mjrn bevve.",[94.99,95.2,95.52,95.7,96.53,97.23,97.33,97.7]]]},{"c":[[101.01,"Raccontò quello che ricordava, e non era molto.",[101.01,101.86,102.33,102.5,103.59,103.73,103.83,104.01]],[105.09," Lo raccontò con la voce di una ragazza giovane, che salta da una cosa all'altra e torna indietro, che si interrompe per dire che aveva freddo, o che si ricordava l'odore.",[105.09,105.09,105.55,105.71,105.79,106.05,106.17,106.29,106.71,107.59,107.87,108.19,108.31,108.47,108.73,109.25,109.39,109.73,110.55,110.83,110.97,111.49,111.69,111.91,112.13,112.44,113.37,113.51,113.63,113.79,114.28]],[115.4," Penelo la ascoltava con la bocca aperta.",[115.4,115.7,115.81,116.31,116.45,116.57,116.84]],[117.56," Vaan la ascoltava con le ginocchia strette fra le braccia.",[117.56,118.03,118.27,119.05,119.33,119.45,119.83,120.21,120.35,120.49]],[121.46," Ashe ascoltava in piedi, un poco discosta, come chi assiste a un processo.",[121.46,122.01,122.55,122.69,123.47,123.55,123.75,124.75,125.05,125.19,125.65,125.75,125.83]]],"st":1},{"c":[[127.97,"Aveva visto i soldati, disse Mjrn.",[127.97,128.37,128.59,128.94,129.63,130.47]],[131.15," Molte lune prima.",[131.15,131.51,131.69]],[132.73," Uomini con il ferro addosso, che camminavano ai margini della giungla, che passavano per i sentieri vecchi, che si fermavano a guardare gli alberi come se li stessero misurando.",[132.73,133.17,133.41,133.57,134,135.06,135.33,135.87,136.05,136.53,136.73,137.61,137.89,138.41,138.57,138.69,139.01,139.81,140.09,140.21,140.69,140.81,141.19,141.33,141.69,141.91,142.07,142.19,142.72]],[144.39," All'inizio erano pochi.",[144.39,145.15,145.6]],[146.44," Poi di più.",[146.44,146.71,146.87]],[147.69," Lei lo aveva detto a Jote, e Jote aveva detto che le cose degli Huma erano degli Huma, e che il Bosco li avrebbe respinti come aveva sempre fatto.",[147.69,147.97,148.15,148.41,148.72,148.9,149.6,149.71,150.13,150.53,151.13,151.41,151.51,151.83,152.15,152.41,152.77,153.37,153.84,153.99,154.09,154.19,154.82,155.07,155.33,155.87,156.07,156.35,156.63]],[157.97," Lo aveva detto alle sorelle sui rami, e le sorelle sui rami avevano detto lo stesso.",[157.97,157.97,158.25,158.49,158.69,159.13,159.41,160.22,160.37,160.51,160.88,161.15,161.66,162.19,162.49,162.67]],[164.02," Nessuno si preoccupava.",[164.02,164.58,164.79]]]},{"c":[[167.44,"«Ma io mi preoccupavo» disse Mjrn.",[167.44,167.65,167.81,168.64,169.55,170.19]],[170.71," «Non so perché.",[170.71,170.9,171.11]],[171.88," Il Bosco era inquieto.",[171.88,172.09,172.41,172.55]],[173.55," Io lo sentivo.",[173.55,173.67,173.77]],[174.72," Il Bosco diceva una cosa e Jote ne sentiva un'altra, o faceva finta.»",[174.72,174.93,175.27,175.65,175.79,176.6,176.7,177.09,177.27,177.96,178.64,178.79,179.21]],[180.02," Si strinse nel mantello.",[180.02,180.23,180.61,180.79]],[182," «Allora una notte sono andata.",[182,182.66,182.93,183.21,183.4]],[184.41," Volevo solo vedere cosa cercavano.",[184.41,184.71,185.01,185.39,185.83]],[187.12," Li ho seguiti fuori dalla giungla, fino alla pianura, e poi fin qui.",[187.12,187.41,187.53,187.93,188.19,188.41,189.25,189.59,189.73,190.64,190.79,191.03,191.25]],[191.72," Volevo solo vedere.»",[191.72,192.19,192.39]]]},{"c":[[194.38,"«E hai visto» disse Balthier.",[194.38,194.53,194.67,195.13,195.8]]]},{"c":[[196.88,"«Mi hanno vista loro.»",[196.88,197.09,197.21,197.49]],[198.14," Mjrn abbassò gli occhi.",[198.14,198.79,199.13,199.29]],[199.87," «Prima che io vedessi qualcosa.»",[199.87,200.27,200.43,200.57,201.33]]]},{"c":[[202.28,"Balthier si voltò verso Fran con un mezzo sorriso.",[202.28,203.22,203.43,203.73,204.01,204.23,204.45,204.61,204.97]],[206.41," «Una ragazza che lascia il villaggio di notte senza dirlo a nessuno, per andare a vedere cosa fanno gli Huma.",[206.41,206.41,206.93,207.09,207.39,207.49,207.89,208.03,208.43,208.69,209.01,209.09,209.73,210.01,210.25,210.37,210.61,210.91,211.23,211.74]],[212.42," Mi ricorda qualcuno.»",[212.42,212.63,213.09]]]},{"c":[[215.05,"Fran non rispose.",[215.05,215.84,216.11]],[217.25," Non lo guardò nemmeno.",[217.25,217.53,217.63,217.94]],[219.19," Ma Mjrn, che non conosceva Balthier e non sapeva come prendere le sue frasi, guardò prima l'uno e poi l'altra, e capì qualcosa che nessuno le aveva detto, e per un istante sorrise.",[219.19,219.47,220.03,220.31,220.47,221.24,221.92,222.07,222.23,222.65,222.85,223.27,223.41,223.56,224.51,224.87,225.52,226.04,226.22,226.67,227.58,227.73,228.01,228.45,228.69,229.19,229.33,229.59,230.34,230.49,230.67,230.81,231.4]]]},{"c":[[233.5,"Poi il sorriso le passò.",[233.5,233.96,234.17,234.53,234.63]]]},{"c":[[236.06,"«Mi hanno portata giù» disse.",[236.06,236.27,236.53,237.22,237.69]],[238.41," «Nelle gallerie.",[238.41,238.81]],[239.79," C'erano i soldati e c'erano gli altri, quelli con le vesti lunghe.",[239.79,240.53,240.78,241.58,241.65,242.07,242.25,242.9,243.37,243.57,243.69,244.03]],[244.55," Parlavano fra loro come se io non ci fossi.",[244.55,245.21,245.41,245.67,245.91,246.07,246.25,246.39,246.56]],[247.75," Uno scriveva su un quaderno.",[247.75,247.75,248.34,248.55,248.69]],[249.82," Mi hanno messa in una stanza con una sedia di ferro, e mi hanno legata alla sedia, e poi hanno portato una pietra.»",[249.82,250.03,250.27,250.51,250.63,250.83,251.17,251.37,251.57,251.83,251.97,252.86,253.01,253.11,253.25,253.61,253.82,254.74,254.91,255.28,255.69,256.11,256.27]],[257.18," Si fermò.",[257.18,257.39]],[258.16," «Era piccola.",[258.16,258.43]],[259.49," Scura.",[259.49]],[260.65," Come quella che avevo in mano.»",[260.65,260.65,260.89,261.03,261.29,261.43]]]},{"c":[[263.21,"Nessuno disse niente.",[263.21,263.75,264.02]],[264.86," Il fuoco crepitò.",[264.86,265.07,265.45]]]},{"c":[[266.41,"«L'hanno messa su un tavolo accanto a me.",[266.41,267.23,267.49,267.65,267.71,268.01,268.37,268.49]],[269.13," Uno di loro, il più vecchio, mi ha spiegato cosa sarebbe successo.",[269.13,269.35,269.49,269.98,270.19,270.33,271.14,271.35,271.41,272.07,272.41,272.87]],[273.7," Lo ha fatto con molta gentilezza.",[273.7,273.9,274.11,274.37,274.59,274.89]],[276.31," Ha detto che la pietra conteneva il Mystes, molto Mystes, e che il Mystes sarebbe uscito dalla pietra e sarebbe entrato in me.",[276.31,276.31,276.53,276.67,276.77,277.13,277.65,277.99,279.03,279.75,280.63,280.77,280.87,281.1,281.77,282.34,282.81,283.22,284.21,284.35,284.73,285.66,285.87]],[286.84," Ha detto che noi viere siamo…",[286.84,287.05,287.64,287.91,288.17,288.53]],[289.54," adatte.",[289.54]],[290.63," È la parola che ha usato.",[290.63,290.77,290.89,291.31,291.49,291.67]],[292.66," Adatte.",[292.66]],[293.72," Perché il Mystes noi lo sentiamo meglio degli Huma, e quindi lo prendiamo meglio.»",[293.72,293.97,294.11,294.53,294.79,294.95,295.35,295.63,296.31,296.85,296.99,297.23,297.39,297.77]],[298.73," Mjrn deglutì.",[298.73,299.38]],[300.6," «Ha detto che non avrei sentito dolore.",[300.6,300.81,301.07,301.23,301.35,301.61,302.05]],[302.96," Poi ha fatto un cenno, e la pietra si è accesa.»",[302.96,303.23,303.35,303.61,303.79,304.63,304.77,304.91,305.25,305.45,305.66]]]},{"c":[[307.81,"«E poi?»",[307.81,308]],[308.72," chiese Penelo, piano.",[308.72,309.2,309.67]]]},{"c":[[311.09,"«E poi niente.",[311.09,311.31,312.06]],[313.04," Una luce.",[313.04,313.37]],[314.07," Tanta luce.",[314.07,314.63]],[315.71," Viola.",[315.71]],[316.59," E poi niente.»",[316.59,316.73,317.02]],[317.78," Mjrn guardò il fuoco.",[317.78,318.28,318.75,318.91]],[319.88," «Non mi ricordo niente dopo.",[319.88,320.15,320.27,320.67,321.11]],[322.3," Non mi ricordo di voi.",[322.3,322.57,322.71,323.25,323.5]],[324.64," Non mi ricordo di…",[324.64,325.84,326.13,326.67]],[330.65," di quello che ho detto.",[330.65,330.65,330.93,331.07,331.19]],[332.24," Mi hanno detto che ho detto delle cose.»",[332.24,332.45,332.61,332.87,333.09,333.27,333.57,333.97]],[334.92," Si voltò verso Ashe, e la guardò per la prima volta davvero, con gli occhi suoi.",[334.92,335.13,335.43,336,336.47,336.61,336.71,337.01,337.19,337.31,337.51,337.81,338.46,338.73,338.87,339.13]],[339.91," «A te.",[339.91,340.05]],[340.56," Ho detto delle cose a te?»",[340.56,340.77,341.03,341.27,341.63,341.77]]]},{"c":[[343.7,"Ashe restò ferma un momento.",[343.7,343.94,344.24,344.55,344.67]]]},{"c":[[346.98,"«Niente che io non mi sia già detta da sola» rispose.",[346.98,347.45,347.65,347.81,348.01,348.15,348.33,348.51,348.85,349.03,349.88]]]},{"c":[[353.42,"Fran si alzò.",[353.42,353.42,353.7]],[354.54," Andò fino al bordo della luce del fuoco, dove sul terreno, accanto alla borsa di Basch, c'erano i due pezzi della pietra spaccata che lei aveva raccolto nella sala.",[354.54,354.88,355.04,355.2,355.46,355.72,355.96,356.16,356.96,357.3,357.54,358.02,358.42,358.6,358.9,359.12,359.69,360.36,360.46,360.64,361.04,361.24,361.7,362.31,362.58,362.76,363.04,363.46,363.7]],[364.47," Li prese.",[364.47,364.74]],[366," Li tenne nella mano aperta e li guardò, e poi si voltò verso Larsa.",[366,366,366.34,366.52,366.72,367.24,367.38,367.48,368.63,368.81,369.47,369.68,370,370.36]]],"st":1},{"c":[[372.25,"«Non è del Re Dinasta» disse.",[372.25,372.56,372.71,372.98,373.14,373.72]]]},{"c":[[374.96,"Larsa non rispose subito.",[374.96,375.36,375.52,375.95]],[376.8," Aveva già capito.",[376.8,377.2,377.35]],[378.27," Lo avevano capito tutti, in realtà, ma c'era una differenza fra capire una cosa e sentirla dire, e la viera la disse.",[378.27,378.48,378.82,379.2,379.56,379.7,380.37,380.53,380.86,381.04,381.72,381.92,382.26,382.46,383.22,383.36,383.82,384.46,384.6,384.68,384.92,385.06]]]},{"c":[[387.02,"«È fatta dagli uomini» disse Fran.",[387.02,387.16,387.44,387.68,388.24,389.05]],[389.7," «Come quella che ha bevuto la magia del Giudice, sul Leviatano.",[389.7,390.04,390.34,390.48,390.58,390.92,391.08,391.44,391.64,392.37,392.64]],[393.64," Viene dallo stesso posto.»",[393.64,393.94,394.24,395.2]]]},{"c":[[396.08,"«Negalite artificiale» disse Larsa.",[396.08,396.68,397.94,398.52]],[399.09," La voce gli uscì più sottile di quanto volesse.",[399.09,399.3,399.54,399.66,399.86,400.04,400.48,400.62,400.9]],[401.87," «Draklor la produce.",[401.87,402.84,403.02]],[403.99," Lo so.",[403.99,404.23]],[404.91," Lo sapevo.",[404.91,405.12]],[405.75," Ne avevo letto i rapporti.",[405.75,405.96,406.2,406.42,406.5]],[407.74," Si parlava di applicazioni, di energia, di navi più veloci.",[407.74,407.74,408.12,408.3,409.45,409.72,410.87,411.08,411.34,411.53]],[412.5," Non si parlava di…»",[412.5,412.78,412.92,413.87]],[414.51," Guardò Mjrn.",[414.51,415.47]],[416.11," «Non si parlava di sedie di ferro.»",[416.11,416.38,416.54,416.97,417.4,417.8,418.04]]]},{"c":[[419.68,"«I rapporti non ne parlano mai» disse Balthier.",[419.68,419.82,420.3,420.46,420.56,420.93,421.6,422.34]]]},{"c":[[423.54,"Larsa si voltò verso di lui.",[423.54,423.94,424.12,424.44,424.76,424.92]],[426.31," Balthier stava seduto a un passo dal fuoco, con un gomito sul ginocchio e la faccia mezza in ombra, e non aveva il tono di chi fa una battuta.",[426.31,426.78,427.16,427.52,427.62,427.7,427.96,428.24,428.99,429.26,429.4,429.64,429.86,430.32,430.44,430.52,430.8,431.1,431.26,432.04,432.18,432.34,432.62,432.78,433.04,433.14,433.26,433.4,433.6]]]},{"c":[[435.79,"«Voi lo sapevate» disse Larsa.",[435.79,436.06,436.22,436.96,437.2]],[438.14," «Fuori.",[438.14]],[438.74," Davanti ai corpi.",[438.74,439.18,439.3]],[440.12," Avete detto ricerca come se lo sapeste.»",[440.12,440.32,440.62,441.04,441.28,441.42,441.54]]]},{"c":[[443.37,"«Ho detto ricerca perché è la parola giusta.",[443.37,443.58,443.9,444.83,445.38,445.42,445.52,445.86]],[447.04," A Draklor tutto si chiama ricerca.»",[447.04,447.18,448.14,449.13,449.34,449.72]],[450.8," Balthier guardò il fuoco.",[450.8,452.03,452.5,452.64]],[453.91," «Un uomo legato a una sedia è ricerca.",[453.91,454.12,454.43,454.9,455.02,455.26,455.9,456.06]],[457.23," Una città bruciata è ricerca.",[457.23,457.5,457.78,458.54,458.74]],[460.06," Una ragazza a cui si dice, con molta gentilezza, che non sentirà dolore, è ricerca.",[460.06,460.06,460.54,460.68,460.76,460.94,461.37,461.64,461.94,463,463.28,463.5,463.94,464.9,465.04]],[466.16," È una parola molto comoda.",[466.16,466.3,466.46,466.78,467.05]],[467.96," Copre tutto, come un telo sopra un cadavere.»",[467.96,468.36,468.98,469.33,469.54,469.86,470.22,470.36]]]},{"c":[[472.03,"«Chi dirige Draklor?»",[472.03,472.3,473.2]],[474.25," chiese Vaan.",[474.25,475.48]]]},{"c":[[476.3,"Larsa esitò.",[476.3,476.86]],[478.07," «Il dottor Cidolfus Bunansa.",[478.07,478.29,478.86,479.97]],[480.94," È il più grande scienziato dell'Impero.",[480.94,481.08,481.22,481.34,481.68,482.82]],[483.97," Mio fratello lo stima molto.»",[483.97,484.24,484.68,484.82,485.12]]]},{"c":[[487.13,"«Cid» disse Balthier.",[487.13,487.54,488.15]],[489.13," Lo disse piano, guardando il fuoco.",[489.13,489.34,489.56,490.07,490.74,490.84]],[491.77," «Dicono che parli con i fantasmi.»",[491.77,492.24,492.38,492.76,492.92,493.1]]]},{"c":[[494.71,"«Lo conoscete?»",[494.71,494.92]],[496.11," chiese Larsa.",[496.11,496.6]]]},{"c":[[498.11,"«Lo conoscono tutti, ad Archades.»",[498.11,498.32,498.82,499.71,500.28]],[502.58," Balthier si alzò, si scosse la polvere dai pantaloni, e si allontanò dal fuoco di qualche passo, nel buio, a guardare la pianura.",[502.58,502.58,502.82,503.89,504.1,504.5,504.66,505.08,505.3,506.48,506.62,506.76,507.26,507.5,507.9,508.06,508.46,509.27,509.66,510.58,510.72,511.14,511.26]],[512.5," «È famoso.»",[512.5,512.73]]]},{"c":[[514.66,"Fran non lo seguì.",[514.66,515.17,515.44,515.6]],[516.43," Ma lo guardò andare, e lo guardò per molto tempo.",[516.43,516.64,516.76,517.06,517.96,518.1,518.22,518.56,518.74,519.08]]]},{"c":[[522.48,"Larsa rimase in silenzio.",[522.48,522.88,523.2,523.34]],[524.57," Poi si voltò di scatto verso Penelo.",[524.57,524.84,525,525.32,525.44,525.76,526.08]]],"st":1},{"c":[[527.34,"«Signorina Penelo» disse.",[527.34,528.17,529.13]]]},{"c":[[530.61,"Penelo alzò la testa.",[530.61,531.46,531.8,532.46]]]},{"c":[[533.19,"«La pietra.",[533.19,533.45]],[534.13," Quella che vi ho dato a Bhujerba.",[534.13,534.6,534.74,534.86,534.9,535.06,535.17]],[536.05," Ce l'avete ancora?»",[536.05,536.17,536.52]]]},{"c":[[538.53,"«Sì.»",[538.53]],[540.52," Penelo se la tirò fuori da sotto il vestito, dove la teneva appesa a un laccio di cuoio, e la mostrò sul palmo.",[540.52,540.52,540.72,540.82,541.06,541.34,541.48,541.72,541.84,542.8,543.14,543.3,543.64,544.08,544.22,544.28,544.62,544.77,545.72,545.86,545.94,546.24,546.46]],[547.19," Era piccola, scura, più o meno della stessa forma dei due pezzi che Fran teneva in mano.",[547.19,547.46,548.24,549.24,549.38,549.5,549.66,549.84,550.16,550.42,550.62,550.74,551.14,551.26,551.48,551.86,552]],[552.94," Brillava appena alla luce del fuoco, un riflesso viola, lontano.",[552.94,553.38,553.76,554.02,554.26,554.46,555.37,555.58,556.44,557.26]],[558.47," «Me la porto sempre dietro.",[558.47,558.68,558.78,559.18,559.58]],[560.76," Porta fortuna.»",[560.76,561.05]]]},{"c":[[563.18,"Larsa si alzò, attraversò il cerchio del fuoco, e gliela prese di mano.",[563.18,563.97,564.34,565.18,565.76,565.96,566.34,566.56,567.51,567.66,567.9,568.16,568.3]]]},{"c":[[569.49,"Non lo fece in modo brusco.",[569.49,569.82,569.92,570.24,570.4,570.67]],[571.78," Ma lo fece in fretta, con la mano che si chiudeva sulla pietra prima ancora che Penelo decidesse se ridargliela, e Penelo restò con il palmo vuoto in aria.",[571.78,571.78,571.88,572.12,572.24,573.02,573.3,573.42,573.6,573.74,573.88,574.24,574.47,575.25,575.66,575.94,576.1,576.63,577.49,577.7,578.86,579,579.34,579.7,579.88,580.02,580.32,580.93,581.14]],[582.3," Il laccio le tirò sul collo; se lo sfilò e liberò la pietra, poi lo rimise sotto il colletto.",[582.3,582.3,583.13,583.34,583.58,583.92,585.25,585.46,585.65,586.06,586.2,586.56,586.73,587.63,587.9,588.04,588.44,588.78,588.92]]]},{"c":[[591.07,"«Perdonatemi» disse Larsa.",[591.07,592.27,592.72]],[593.61," Teneva la pietra stretta nel pugno, contro il petto.",[593.61,594.08,594.24,594.54,594.96,595.12,595.85,596.32,596.48]],[597.31," «Perdonatemi.",[597.31]],[598.4," Non avrei mai dovuto darvela.",[598.4,598.68,598.98,599.18,599.67]],[600.49," Non sapevo.",[600.49,600.81]],[601.78," Credevo che fosse una protezione, una cosa per difendersi, e invece è…»",[601.78,602.63,602.9,603.22,603.38,604.69,604.96,605.28,605.55,606.94,607.08,607.6]],[608.45," Guardò Mjrn.",[608.45,609.46]],[610.14," «È la stessa cosa.",[610.14,610.28,610.4,610.78]],[611.72," Potrebbe fare la stessa cosa.",[611.72,612.32,612.62,612.76,613.22]],[614.22," A voi.",[614.22,614.43]],[615.47," Se io avessi saputo…»",[615.47,615.68,615.82,616.19]]]},{"c":[[618.98,"«Larsa.»",[618.98]],[619.63," Penelo abbassò la mano.",[619.63,620.13,620.66,620.78]],[621.57," «Ci ha salvati.»",[621.57,621.78,621.84]]]},{"c":[[623.48,"Larsa la guardò.",[623.48,623.88,624]]]},{"c":[[625.55,"«Sul Leviatano» disse lei.",[625.55,625.73,626.3,626.67]],[627.65," «Ha fermato la magia di Ghis.",[627.65,627.86,628.24,628.4,628.66,628.78]],[629.95," Io l'avevo in tasca e l'ho sentita diventare calda.",[629.95,630.09,630.52,630.66,631.38,631.45,631.66,632.08,632.7]],[634," Se non c'era la pietra, adesso non saremmo qui.",[634,634,634.15,634.36,634.46,635.37,635.84,635.99,636.33]],[637.19," Né io, né Vaan, né la principessa.»",[637.19,637.49,637.89,638.18,638.77,638.98,639.1]],[640.12," Fece una pausa.",[640.12,640.46,640.6]],[641.31," «Allora non può essere solo una cosa cattiva.",[641.31,641.78,642,642.2,642.64,643.09,643.36,643.58]],[644.39," No?»",[644.39]]]},{"c":[[645.86,"Larsa non rispose.",[645.86,646.43,646.7]],[647.78," Guardava la pietra nel pugno chiuso.",[647.78,648.14,648.28,648.68,648.9,649.23]]]},{"c":[[650.24,"«Penelo ha ragione» disse Ashe.",[650.24,651.25,651.46,652.38,653.42]]]},{"c":[[654.25,"Si voltarono tutti verso di lei.",[654.25,654.46,655.1,655.42,655.74,655.88]],[656.83," La principessa si era avvicinata al fuoco.",[656.83,657.04,657.58,657.78,657.88,658.4,658.52]],[659.61," Aveva il frammento d'Aurora alla cintura, avvolto nel panno, e lo toccò con le dita, senza guardarlo.",[659.61,659.98,660.1,660.62,661.02,661.2,662.06,662.44,662.62,663.58,663.72,663.86,664.24,664.48,664.6,665.42,665.7]]]},{"c":[[667.63,"«Una cosa pericolosa non è malvagia perché esiste» disse.",[667.63,667.9,668.25,669.59,669.89,670.16,671.01,671.61,672.3]],[673.26," «Una spada è pericolosa.",[673.26,673.56,674.25,674.49]],[675.65," Il fuoco è pericoloso.",[675.65,675.94,676.53,676.77]],[678.03," La magilite che illumina le vostre città è pericolosa, se la si fa scoppiare.»",[678.03,678.19,678.82,679,679.46,679.6,680.08,680.74,680.95,682.29,682.5,682.6,682.72,682.84]],[683.91," Guardò Larsa.",[683.91,684.44]],[685.9," «Conta chi la tiene.",[685.9,685.9,686.08,686.24]],[687.27," Conta cosa ne fa.",[687.27,687.68,687.94,688.08]],[688.77," Questa pietra, nelle mani di Penelo, ha fermato un Giudice.",[688.77,689.25,689.72,690.12,690.4,690.52,691.23,691.44,691.76,691.88]],[692.86," Nelle mani di quelli là dentro ha legato una ragazza a una sedia.",[692.86,693.34,693.58,693.72,694,694.18,694.61,694.82,695.2,695.36,695.86,696,696.18]],[697.08," È la stessa pietra.»",[697.08,697.22,697.32,697.62]]]},{"c":[[699.58,"Larsa la fissò a lungo.",[699.58,700.37,700.58,700.96,701.1]]]},{"c":[[703.15,"«E il vostro frammento, altezza?»",[703.15,703.3,703.44,703.76,704.36]],[705.13," chiese, piano.",[705.13,705.8]],[706.31," «Nelle mani di chi sta?»",[706.31,706.83,707.24,707.36,707.48]]]},{"c":[[708.26,"Ashe non rispose.",[708.26,709.3,709.44]],[710.26," Non subito.",[710.26,710.59]],[711.45," La mano le restò sul panno, ferma.",[711.45,711.66,711.92,712.1,712.38,712.56,713.46]]]},{"c":[[714.96,"«È quello che sto cercando di capire» disse.",[714.96,715.1,715.32,715.46,715.62,716.02,716.14,716.56]]]},{"c":[[718.96,"Vaan aveva seguito lo scambio con la fronte aggrottata.",[718.96,718.96,719.36,719.78,719.94,720.34,720.5,720.62,720.98]],[722.35," Non sembrava convinto.",[722.35,722.62,723.12]],[724.41," Guardò la pietra di Larsa, poi i pezzi della pietra di Mjrn nella mano di Fran, poi il frammento alla cintura di Ashe.",[724.41,724.88,725,725.36,725.48,726.28,726.54,726.68,727.04,727.24,727.58,727.76,728.13,728.54,728.78,728.92,729.9,730.18,730.38,730.92,731.02,731.44,731.62]]]},{"c":[[733.48,"«Speriamo che tu abbia ragione» disse alla fine.",[733.48,734.08,734.24,734.36,734.6,735.06,735.26,735.42]],[736.51," «Perché a me sembrano tutte uguali.»",[736.51,736.98,737.1,737.18,737.64,738.25]]]},{"c":[[741.67,"Più tardi, quando gli altri dormivano o fingevano di dormire, Penelo andò a sedersi accanto a Larsa, che non dormiva.",[741.67,742.01,742.61,743.08,743.26,743.56,744.27,744.42,744.88,745.07,746.26,746.68,746.96,747.1,747.56,748,748.15,748.99,749.26,749.43]],[750.72," Il principe stava seduto un po' fuori dal cerchio della luce, con la pietra ancora nel pugno, e guardava la miniera.",[750.72,750.72,751.16,751.44,751.9,752.08,752.34,752.6,752.8,753.18,753.44,754.19,754.46,754.62,754.94,755.24,755.48,756.38,756.52,756.98,757.1]]],"st":1},{"c":[[758.97,"Penelo non disse niente per un po'.",[758.97,759.78,760.06,760.38,760.82,761.02,761.37]],[761.85," Poi gli diede una gomitata, leggera.",[761.85,762.25,762.52,762.78,763.17,764.21]]]},{"c":[[765.81,"«Me la rendi, un giorno?»",[765.81,766.02,766.2,766.91,767.12]]]},{"c":[[768.74,"Larsa si voltò.",[768.74,769.19,769.4]],[770.62," «Cosa?»",[770.62]]]},{"c":[[771.85,"«La pietra.",[771.85,772.06]],[773.43," Quando non sarà più pericolosa.",[773.43,773.9,774.16,774.4,774.6]],[775.91," O quando sarai sicuro.»",[775.91,776.06,776.36,776.71]]]},{"c":[[778.21,"«Non so se sarà mai sicura.»",[778.21,778.61,779.17,779.38,779.64,779.91]]]},{"c":[[781.29,"«Allora tienila tu.»",[781.29,781.76,782.18]],[783.19," Penelo si strinse le ginocchia.",[783.19,784.03,784.24,784.56,784.72]],[785.7," «Basta che la tieni.",[785.7,786.1,786.26,786.42]],[787.44," È stato il primo regalo che mi ha fatto qualcuno che non conoscevo.",[787.44,787.58,787.8,787.96,788.2,788.6,788.72,788.82,788.88,789.1,789.52,789.66,789.82]],[790.91," Il primo dopo…",[790.91,791.12,791.4]],[791.98," dopo tanto tempo.",[791.98,792.32,792.72]],[793.9," A Rabanastre nessuno mi regala niente.",[793.9,793.9,794.88,795.42,795.58,795.99]],[796.95," Nessuno di loro, dico.»",[796.95,797.48,797.6,798]],[798.89," Indicò con il mento, vagamente, il nord, l'Impero, i soldati delle ronde.",[798.89,799.36,799.56,799.72,800.3,800.97,801.18,801.61,802.38,802.52,803.02,803.22]],[803.91," «Tu sì.»",[803.91,804.23]]]},{"c":[[806.44,"Larsa la guardò.",[806.44,806.72,806.84]],[807.67," Non disse niente.",[807.67,807.94,808.18]]]},{"c":[[809.57,"«Sai perché sono venuta?»",[809.57,809.84,810.14,810.43]],[811.22," disse Penelo.",[811.22,811.63]],[812.23," «Non ve l'ho mai detto.",[812.23,812.5,812.59,812.72,812.84]],[813.48," Vaan pensa che sono venuta per lui.",[813.48,814,814.34,814.52,814.72,815.04,815.24]],[815.99," Per tenerlo d'occhio.",[815.99,816.26,816.83]],[817.39," È vero, un po'.",[817.39,817.54,817.86,817.98]],[818.39," Ma non è per quello.»",[818.39,818.6,818.7,818.82,818.98]],[820.08," Fece una pausa.",[820.08,820.08,820.22]],[821.06," «I miei fratelli.",[821.06,821.2,821.42]],[822.41," Ne avevo due.",[822.41,822.62,822.9]],[823.49," Più grandi.",[823.49,823.76]],[824.79," Mi hanno insegnato a tirare di bastone quando avevo otto anni, perché dicevano che una ragazza della Città Bassa deve sapersi difendere.",[824.79,825,825.12,825.58,825.68,825.92,826.06,826.5,826.78,827.08,827.28,827.73,828.2,828.68,828.82,828.96,829.36,829.54,829.92,830.26,830.44,830.88]],[832.14," Sono morti nella guerra.",[832.14,832.14,832.46,832.64]],[833.42," Tutti e due.»",[833.42,833.65,833.8]],[834.55," Lo disse senza piangere, guardando la miniera.",[834.55,834.76,835,835.28,836.26,836.62,836.74]],[837.6," «E io ho pensato che se c'è un modo per non farne morire degli altri, di fratelli, voglio esserci.",[837.6,837.74,837.86,837.96,838.32,838.46,838.62,838.78,838.86,839.06,839.26,839.4,839.72,840.04,840.28,840.64,840.78,841.68,841.82]],[843.41," Anche se non so fare niente.",[843.41,843.41,843.62,843.76,843.9,844.16]],[845.06," Anche solo per portare le focacce.»",[845.06,845.36,845.64,845.82,846.26,846.38]]]},{"c":[[848.62,"Larsa rimase in silenzio a lungo.",[848.62,849.27,849.74,849.9,850.34,850.48]]]},{"c":[[852.03,"«Io ho un fratello» disse alla fine.",[852.03,852.33,852.54,852.64,853.6,853.96,854.22]]]},{"c":[[856.03,"«Lo so.»",[856.03,856.33]]]},{"c":[[857.59,"«Ne avevo tre, una volta.»",[857.59,857.8,858.64,859.23,859.5]],[860.33," Il principe guardava il pugno chiuso.",[860.33,860.54,860.98,861.52,861.66,862.07]],[862.93," «Adesso ne ho uno.»",[862.93,863.41,863.62,863.88]]]},{"c":[[865.07,"Penelo si voltò a guardarlo.",[865.07,865.54,865.7,866.02,866.12]],[867.7," Larsa non aggiunse altro, e lei non gli chiese niente.",[867.7,867.7,867.88,868.24,869.56,869.75,870.43,870.7,870.82,871.07]],[872.16," Restarono seduti così, uno accanto all'altra, fino a quando il fuoco non fu ridotto a un mucchio di braci; e quando Penelo, alla fine, si alzò per andare a dormire, Larsa aprì il pugno,",[872.16,872.82,873.22,874.45,875.02,875.82,876.72,877.1,877.24,877.97,878.18,878.58,878.87,879.08,879.94,880.08,880.24,880.62,880.84,882.2,882.34,882.67,883.34,883.68,884.53,884.76,885.1,885.28,885.56,885.73,886.68,887.48,887.82,888]],[889," guardò la pietra, e se la mise in tasca, nella tasca del petto, dove si tengono le cose che non si vogliono perdere.",[889,889.24,889.34,890.36,890.5,890.62,890.72,890.92,891.08,891.76,892.1,892.4,892.58,893.34,893.56,893.72,894.04,894.18,894.44,894.62,894.78,894.94,895.32]]]}]