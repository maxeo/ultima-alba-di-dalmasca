[{"h":1,"c":[[2.1,"Capitolo sessantaduesimo: Il segreto di Draklor.",[2.1,3.23,5.35,5.58,6.29,6.47]]]},{"c":[[10.46,"Mjrn si svegliò all'aperto, sotto le stelle, sullo spiazzo davanti alla miniera, dove gli altri l'avevano portata perché nessuno di loro voleva passare una notte in più sotto quelle travi.",[10.46,10.95,11.16,11.8,12.62,13.02,13.2,14.14,14.34,14.76,15.1,15.22,16.06,16.34,16.5,16.79,17.27,17.8,18.08,18.58,18.7,18.92,19.3,19.74,19.94,20.24,20.36,20.48,20.74,21]],[22.1," Avevano spostato i corpi.",[22.1,22.5,22.98,23.08]],[24.28," Basch e Balthier li avevano allineati dietro una delle baracche e li avevano coperti con dei teli trovati accanto all'argano, e Larsa aveva chiesto di poter restare un momento solo con loro,",[24.28,24.73,24.87,25.97,26.18,26.56,27.1,27.48,27.68,27.88,29.16,29.3,29.4,29.76,30.22,30.4,30.58,30.76,31.18,31.56,32.61,32.73,33.3,33.7,34.06,34.2,34.5,34.86,34.98,35.64,35.98,36.2]],[37.39," e nessuno gli aveva chiesto perché.",[37.39,37.39,38.13,38.4,38.62,38.98]],[41.22," Quando era tornato al fuoco aveva gli occhi asciutti e la faccia molto composta, la faccia di un ragazzo a cui hanno insegnato che un principe non piange davanti ai sudditi,",[41.22,41.22,41.4,41.82,41.94,42.75,43.16,43.28,43.46,44.39,44.54,44.64,44.92,45.2,46.43,46.64,46.9,47,47.08,47.51,47.66,47.76,47.96,48.91,49.18,49.34,49.78,50.02,50.34,50.76,50.88]],[52.1," e che non sa ancora se quelli che ha davanti siano sudditi o no.",[52.1,52.1,52.22,52.38,52.58,52.99,53.2,53.5,53.6,53.72,54.04,54.36,54.84,54.98]]]},{"c":[[56.57,"Il fuoco era piccolo, fatto con le assi di una cassa.",[56.57,56.78,57.08,57.22,58.12,58.3,58.48,58.58,58.8,58.88,59.02]],[60.06," Mjrn si mise a sedere adagio, con la schiena contro un sasso, avvolta nel mantello di Fran.",[60.06,60.89,61.1,61.33,61.48,62.02,62.57,62.84,62.96,63.26,63.52,63.8,64.48,65.02,65.18,65.56,65.68]],[66.37," Guardò le facce intorno a sé una per una.",[66.37,66.84,66.96,67.26,67.62,67.74,67.92,68.16,68.38]],[70.19," Poi guardò la sorella, che le sedeva accanto, e non distolse più gli occhi.",[70.19,70.19,70.66,70.78,71.52,71.8,71.94,72.26,73.3,73.44,73.56,74.04,74.2,74.36]]]},{"c":[[76.02,"«Sei vera» disse.",[76.02,76.42,77.09]]]},{"c":[[78.71,"«Sì.»",[78.71]]]},{"c":[[80.33,"«Ti credevo morta.",[80.33,80.54,81.14]],[81.92," A Eruyt dicono che sei morta.»",[81.92,81.98,82.32,82.72,82.86,83.22]],[84.6," Mjrn ci pensò.",[84.6,85.71,86.08]],[87.05," «No.",[87.05]],[87.48," Non lo dicono.",[87.48,87.76,87.93]],[88.63," Non dicono niente.",[88.63,88.9,89.29]],[90.52," È peggio.»",[90.52,90.85]]]},{"c":[[92.88,"Fran non rispose.",[92.88,93.08,93.23]],[94.99," Le passò una ciotola d'acqua, e Mjrn bevve.",[94.99,95.2,95.52,95.7,96.53,97.23,97.33,97.7]]]},{"c":[[101.01,"Raccontò quello che ricordava, e non era molto.",[101.01,101.86,102.33,102.5,103.59,103.73,103.83,104.01]],[105.09," Lo raccontò con la voce di una ragazza giovane, che salta da una cosa all'altra e torna indietro, che si interrompe per dire che aveva freddo, o che si ricordava l'odore.",[105.09,105.09,105.55,105.71,105.79,106.05,106.17,106.29,106.71,107.59,107.87,108.19,108.31,108.47,108.73,109.25,109.39,109.73,110.55,110.83,110.97,111.49,111.69,111.91,112.13,112.44,113.37,113.51,113.63,113.79,114.28]],[115.4," Penelo la ascoltava con la bocca aperta.",[115.4,115.69,115.81,116.31,116.45,116.57,116.84]],[117.56," Vaan la ascoltava con le ginocchia strette fra le braccia.",[117.56,118.03,118.27,119.05,119.33,119.45,119.83,120.21,120.35,120.49]],[121.46," Ashe ascoltava in piedi, un poco discosta, come chi assiste a un processo.",[121.46,122.01,122.55,122.69,123.47,123.55,123.75,124.75,125.05,125.19,125.65,125.75,125.83]]],"st":1},{"c":[[127.97,"Aveva visto i soldati, disse Mjrn.",[127.97,128.37,128.59,128.94,129.63,130.48]],[131.17," Molte lune prima.",[131.17,131.51,131.69]],[132.73," Uomini con il ferro addosso, che camminavano ai margini della giungla, che passavano per i sentieri vecchi, che si fermavano a guardare gli alberi come se li stessero misurando.",[132.73,133.17,133.41,133.57,134,135.06,135.33,135.87,136.05,136.53,136.73,137.61,137.89,138.41,138.57,138.65,138.99,139.81,140.09,140.21,140.69,140.81,141.19,141.33,141.71,141.91,142.07,142.21,142.72]],[144.39," All'inizio erano pochi.",[144.39,145.15,145.6]],[146.44," Poi di più.",[146.44,146.71,146.87]],[147.69," Lei lo aveva detto a Jote, e Jote aveva detto che le cose degli Huma erano degli Huma, e che il Bosco li avrebbe respinti come aveva sempre fatto.",[147.69,147.97,148.15,148.41,148.72,148.89,149.56,149.68,150.13,150.53,151.13,151.41,151.51,151.83,152.13,152.37,152.77,153.37,153.84,153.99,154.09,154.19,154.82,155.07,155.35,155.87,156.05,156.35,156.63]],[157.97," Lo aveva detto alle sorelle sui rami, e le sorelle sui rami avevano detto lo stesso.",[157.97,157.97,158.25,158.49,158.69,159.13,159.41,160.22,160.37,160.51,160.88,161.15,161.66,162.19,162.47,162.67]],[164.02," Nessuno si preoccupava.",[164.02,164.58,164.79]]]},{"c":[[167.22,"«Ma io mi preoccupavo» disse Mjrn.",[167.22,167.48,167.7,168.14,169.28,170.09]],[170.73," «Non so perché.",[170.73,170.93,171.13]],[172.26," Il Bosco era inquieto.",[172.26,172.47,172.81,173.19]],[174.38," Io lo sentivo.",[174.38,174.59,174.84]],[175.86," Il Bosco diceva una cosa e Jote ne sentiva un'altra, o faceva finta.»",[175.86,176.1,176.9,177.37,177.53,177.88,177.97,178.29,178.45,179.13,179.8,179.96,180.6]],[181.42," Si strinse nel mantello.",[181.42,181.63,182.03,182.23]],[185.41," «Allora una notte sono andata.",[185.41,186.07,186.35,186.63,186.82]],[187.68," Volevo solo vedere cosa cercavano.",[187.68,188.15,188.41,188.81,189.22]],[190.58," Li ho seguiti fuori dalla giungla, fino alla pianura, e poi fin qui.",[190.58,190.79,190.93,191.33,191.59,191.81,192.67,193.01,193.15,194.06,194.21,194.43,194.69]],[195.14," Volevo solo vedere.»",[195.14,195.61,195.81]]]},{"c":[[197.78,"«E hai visto» disse Balthier.",[197.78,197.93,198.11,198.45,199.15]]]},{"c":[[200.28,"«Mi hanno vista loro.»",[200.28,200.49,200.61,200.91]],[201.53," Mjrn abbassò gli occhi.",[201.53,202.15,202.55,202.69]],[203.28," «Prima che io vedessi qualcosa.»",[203.28,203.69,203.85,203.99,204.37]]]},{"c":[[205.5,"Balthier si voltò verso Fran con un mezzo sorriso.",[205.5,206.64,206.85,207.15,207.39,207.71,207.91,208.05,208.4]],[209.83," «Una ragazza che lascia il villaggio di notte senza dirlo a nessuno, per andare a vedere cosa fanno gli Huma.",[209.83,209.83,210.35,210.51,210.81,210.89,211.31,211.45,211.85,212.11,212.43,212.51,213.17,213.45,213.67,213.77,214.03,214.31,214.63,215.15]],[215.84," Mi ricorda qualcuno.»",[215.84,216.05,216.49]]]},{"c":[[218.45,"Fran non rispose.",[218.45,219.25,219.53]],[220.66," Non lo guardò nemmeno.",[220.66,220.93,221.05,221.34]],[222.63," Ma Mjrn, che non conosceva Balthier e non sapeva come prendere le sue frasi, guardò prima l'uno e poi l'altra, e capì qualcosa che nessuno le aveva detto, e per un istante sorrise.",[222.63,222.9,223.45,223.73,223.89,224.65,225.32,225.47,225.63,226.05,226.25,226.67,226.83,226.98,227.93,228.27,228.93,229.47,229.63,230.09,231,231.15,231.41,231.87,232.11,232.61,232.75,233.01,233.76,233.91,234.09,234.21,234.8]]]},{"c":[[236.91,"Poi il sorriso le passò.",[236.91,237.36,237.57,237.95,238.05]]]},{"c":[[239.48,"«Mi hanno portata giù» disse.",[239.48,239.69,239.93,240.45,241.13]],[242.01," «Nelle gallerie.",[242.01,242.23]],[243.21," C'erano i soldati e c'erano gli altri, quelli con le vesti lunghe.",[243.21,243.95,244.18,244.98,245.06,245.49,245.65,246.3,246.77,246.97,247.11,247.45]],[247.97," Parlavano fra loro come se io non ci fossi.",[247.97,248.63,248.81,249.07,249.33,249.49,249.65,249.79,249.98]],[251.17," Uno scriveva su un quaderno.",[251.17,251.17,251.76,251.97,252.11]],[253.24," Mi hanno messa in una stanza con una sedia di ferro, e mi hanno legata alla sedia, e poi hanno portato una pietra.»",[253.24,253.45,253.57,253.93,254.05,254.21,254.59,254.79,254.97,255.23,255.37,256.29,256.43,256.53,256.65,257.01,257.23,258.17,258.34,258.71,259.11,259.51,259.67]],[260.6," Si fermò.",[260.6,260.81]],[261.56," «Era piccola.",[261.56,261.83]],[262.91," Scura.",[262.91]],[264.07," Come quella che avevo in mano.»",[264.07,264.07,264.31,264.45,264.71,264.85]]]},{"c":[[266.63,"Nessuno disse niente.",[266.63,267.17,267.42]],[268.26," Il fuoco crepitò.",[268.26,268.47,268.89]]]},{"c":[[269.84,"«L'hanno messa su un tavolo accanto a me.",[269.84,270.65,270.91,271.03,271.13,271.43,271.79,271.91]],[272.48," Uno di loro, il più vecchio, mi ha spiegato cosa sarebbe successo.",[272.48,272.75,272.91,273.4,273.61,273.75,274.56,274.77,274.83,275.49,275.83,276.29]],[277.28," Lo ha fatto con molta gentilezza.",[277.28,277.49,277.59,277.79,277.99,278.29]],[279.73," Ha detto che la pietra conteneva il Mystes, molto Mystes, e che il Mystes sarebbe uscito dalla pietra e sarebbe entrato in me.",[279.73,279.73,279.95,280.09,280.19,280.55,281.07,281.41,282.43,283.15,284.03,284.17,284.29,284.51,285.17,285.76,286.23,286.64,287.63,287.77,288.15,289.04,289.28]],[290.24," Ha detto che noi viere siamo…",[290.24,290.45,291.04,291.31,291.59,291.93]],[292.96," adatte.",[292.96]],[294.05," È la parola che ha usato.",[294.05,294.19,294.31,294.73,294.91,295.09]],[296.06," Adatte.",[296.06]],[297.39," Perché il Mystes noi lo sentiamo meglio degli Huma, e quindi lo prendiamo meglio.»",[297.39,297.39,297.53,297.95,298.21,298.37,298.77,299.05,299.74,300.29,300.43,300.65,300.81,301.19]],[302.15," Mjrn deglutì.",[302.15,302.79]],[304.02," «Ha detto che non avrei sentito dolore.",[304.02,304.23,304.49,304.65,304.77,305.03,305.45]],[306.36," Poi ha fatto un cenno, e la pietra si è accesa.»",[306.36,306.63,306.79,307.03,307.19,308.05,308.19,308.31,308.66,308.87,309.88]]]},{"c":[[310.85,"«E poi?»",[310.85,311.1]],[311.84," chiese Penelo, piano.",[311.84,312.58,313.47]]]},{"c":[[315.33,"«E poi niente.",[315.33,315.52,316.26]],[317.48," Una luce.",[317.48,317.77]],[318.61," Tanta luce.",[318.61,319.21]],[320.37," Viola.",[320.37]],[321.43," E poi niente.»",[321.43,321.68,322.48]],[323.54," Mjrn guardò il fuoco.",[323.54,324.25,324.63,324.75]],[325.72," «Non mi ricordo niente dopo.",[325.72,325.99,326.13,326.58,327.11]],[327.75," Non mi ricordo di voi.",[327.75,328.03,328.17,328.59,328.81]],[329.64," Non mi ricordo di…",[329.64,329.91,330.07,330.53]],[334.43," di quello che ho detto.",[334.43,334.43,334.67,334.81,334.93]],[335.98," Mi hanno detto che ho detto delle cose.»",[335.98,336.19,336.35,336.63,336.83,336.99,337.31,337.71]],[338.66," Si voltò verso Ashe, e la guardò per la prima volta davvero, con gli occhi suoi.",[338.66,338.87,339.17,339.75,340.21,340.35,340.45,340.75,340.93,341.05,341.25,341.55,342.2,342.47,342.61,342.87]],[343.65," «A te.",[343.65,343.79]],[344.3," Ho detto delle cose a te?»",[344.3,344.51,344.77,345.01,345.38,345.53]]]},{"c":[[347.42,"Ashe restò ferma un momento.",[347.42,347.67,347.98,348.29,348.41]]]},{"c":[[350.72,"«Niente che io non mi sia già detta da sola» rispose.",[350.72,351.19,351.37,351.55,351.73,351.89,352.07,352.25,352.57,352.75,353.61]]]},{"c":[[357.15,"Fran si alzò.",[357.15,357.15,357.43]],[358.27," Andò fino al bordo della luce del fuoco, dove sul terreno, accanto alla borsa di Basch, c'erano i due pezzi della pietra spaccata che lei aveva raccolto nella sala.",[358.27,358.61,358.79,358.93,359.21,359.45,359.71,359.89,360.71,361.05,361.29,361.75,362.15,362.33,362.63,362.85,363.42,364.09,364.21,364.39,364.79,364.99,365.43,366.04,366.31,366.51,366.79,367.19,367.43]],[368.22," Li prese.",[368.22,368.49]],[369.73," Li tenne nella mano aperta e li guardò, e poi si voltò verso Larsa.",[369.73,369.73,370.07,370.25,370.46,370.97,371.11,371.23,372.38,372.54,373.2,373.41,373.73,374.07]]],"st":1},{"c":[[375.98,"«Non è del Re Dinasta» disse.",[375.98,376.31,376.45,376.71,376.87,377.45]]]},{"c":[[378.71,"Larsa non rispose subito.",[378.71,379.11,379.27,379.68]],[380.55," Aveva già capito.",[380.55,380.95,381.1]],[382," Lo avevano capito tutti, in realtà, ma c'era una differenza fra capire una cosa e sentirla dire, e la viera la disse.",[382,382.21,382.57,382.93,383.29,383.45,384.1,384.26,384.59,384.77,385.47,385.65,386.01,386.21,386.91,387.05,387.57,388.21,388.35,388.41,388.65,388.81]]]},{"c":[[390.75,"«È fatta dagli uomini» disse Fran.",[390.75,390.89,391.19,391.43,391.99,392.79]],[393.43," «Come quella che ha bevuto la magia del Giudice, sul Leviatano.",[393.43,393.77,394.07,394.21,394.31,394.65,394.81,395.17,395.38,396.1,396.37]],[397.39," Viene dallo stesso posto.»",[397.39,397.71,398.03,398.35]]]},{"c":[[399.81,"«Negalite artificiale» disse Larsa.",[399.81,400.41,401.17,402.03]],[402.82," La voce gli uscì più sottile di quanto volesse.",[402.82,403.03,403.27,403.39,403.59,403.79,404.23,404.35,404.63]],[405.58," «Draklor la produce.",[405.58,406.53,406.73]],[407.72," Lo so.",[407.72,407.96]],[408.64," Lo sapevo.",[408.64,408.85]],[409.48," Ne avevo letto i rapporti.",[409.48,409.69,409.93,410.15,410.23]],[411.49," Si parlava di applicazioni, di energia, di navi più veloci.",[411.49,411.49,411.87,412.03,413.2,413.45,414.65,414.81,415.07,415.24]],[416.24," Non si parlava di…»",[416.24,416.51,416.65,417.6]],[418.26," Guardò Mjrn.",[418.26,419.22]],[419.86," «Non si parlava di sedie di ferro.»",[419.86,420.13,420.27,420.68,421.13,421.53,421.77]]]},{"c":[[423.41,"«I rapporti non ne parlano mai» disse Balthier.",[423.41,423.55,424.05,424.19,424.29,425.02,425.33,426.07]]]},{"c":[[427.27,"Larsa si voltò verso di lui.",[427.27,427.67,427.87,428.17,428.49,428.65]],[430.04," Balthier stava seduto a un passo dal fuoco, con un gomito sul ginocchio e la faccia mezza in ombra, e non aveva il tono di chi fa una battuta.",[430.04,430.53,430.89,431.27,431.35,431.45,431.71,431.97,432.72,432.99,433.13,433.37,433.59,434.05,434.17,434.27,434.55,434.83,434.99,435.79,435.93,436.07,436.35,436.49,436.77,436.89,436.99,437.15,437.35]]]},{"c":[[439.52,"«Voi lo sapevate» disse Larsa.",[439.52,439.79,439.99,440.59,440.93]],[441.83," «Fuori.",[441.83]],[442.38," Davanti ai corpi.",[442.38,442.91,443.03]],[443.67," Avete detto ricerca come se lo sapeste.»",[443.67,444.07,444.35,444.77,445.01,445.15,445.27]]]},{"c":[[447.1,"«Ho detto ricerca perché è la parola giusta.",[447.1,447.31,447.61,448.58,449.13,449.17,449.27,449.6]],[450.77," A Draklor tutto si chiama ricerca.»",[450.77,450.91,451.89,452.86,453.07,453.49]],[454.55," Balthier guardò il fuoco.",[454.55,455.76,456.23,456.37]],[457.64," «Un uomo legato a una sedia è ricerca.",[457.64,457.85,458.16,458.65,458.79,459.01,459.61,459.77]],[460.96," Una città bruciata è ricerca.",[460.96,461.23,461.51,462.25,462.47]],[463.79," Una ragazza a cui si dice, con molta gentilezza, che non sentirà dolore, è ricerca.",[463.79,463.79,464.27,464.41,464.49,464.65,465.1,465.37,465.67,466.75,467.03,467.23,467.68,468.59,468.77]],[469.88," È una parola molto comoda.",[469.88,470.03,470.19,470.51,470.8]],[471.69," Copre tutto, come un telo sopra un cadavere.»",[471.69,472.09,472.73,473.07,473.27,473.59,473.95,474.09]]]},{"c":[[475.74,"«Chi dirige Draklor?»",[475.74,476.01,476.93]],[478," chiese Vaan.",[478,479.22]]]},{"c":[[480.03,"Larsa esitò.",[480.03,480.61]],[481.8," «Il dottor Cidolfus Bunansa.",[481.8,482.02,482.59,483.71]],[484.69," È il più grande scienziato dell'Impero.",[484.69,484.83,484.95,485.09,485.41,486.55]],[487.7," Mio fratello lo stima molto.»",[487.7,487.97,488.41,488.57,488.85]]]},{"c":[[490.86,"«Cid» disse Balthier.",[490.86,491.27,491.88]],[492.86," Lo disse piano, guardando il fuoco.",[492.86,493.07,493.29,493.81,494.47,494.59]],[495.5," «Dicono che parli con i fantasmi.»",[495.5,495.97,496.13,496.51,496.67,496.83]]]},{"c":[[498.44,"«Lo conoscete?»",[498.44,498.65]],[499.84," chiese Larsa.",[499.84,500.33]]]},{"c":[[501.84,"«Lo conoscono tutti, ad Archades.»",[501.84,502.05,502.55,503.44,504]],[506.28," Balthier si alzò, si scosse la polvere dai pantaloni, e si allontanò dal fuoco di qualche passo, nel buio, a guardare la pianura.",[506.28,506.28,506.57,507.62,507.83,508.23,508.39,508.83,509.03,510.23,510.37,510.49,510.99,511.23,511.63,511.79,512.21,513.03,513.37,514.31,514.45,514.87,515.01]],[516.25," «È famoso.»",[516.25,516.48]]]},{"c":[[518.39,"Fran non lo seguì.",[518.39,518.89,519.17,519.33]],[520.16," Ma lo guardò andare, e lo guardò per molto tempo.",[520.16,520.37,520.49,520.79,521.69,521.83,521.95,522.31,522.47,522.81]]]},{"c":[[526.23,"Larsa rimase in silenzio.",[526.23,526.63,526.95,527.09]],[528.27," Poi si voltò di scatto verso Penelo.",[528.27,528.55,528.75,529.05,529.17,529.51,529.83]]],"st":1},{"c":[[531.09,"«Signorina Penelo» disse.",[531.09,531.92,532.81]]]},{"c":[[534.36,"Penelo alzò la testa.",[534.36,535.19,535.53,535.76]]]},{"c":[[536.94,"«La pietra.",[536.94,537.16]],[537.86," Quella che vi ho dato a Bhujerba.",[537.86,538.33,538.47,538.59,538.63,538.79,538.9]],[539.8," Ce l'avete ancora?»",[539.8,539.92,540.27]]]},{"c":[[542.28,"«Sì.»",[542.28]],[544.27," Penelo se la tirò fuori da sotto il vestito, dove la teneva appesa a un laccio di cuoio, e la mostrò sul palmo.",[544.27,544.27,544.45,544.55,544.83,545.09,545.23,545.47,545.59,546.53,546.87,547.05,547.37,547.75,547.81,547.99,548.35,548.52,549.45,549.59,549.67,549.99,550.21]],[550.94," Era piccola, scura, più o meno della stessa forma dei due pezzi che Fran teneva in mano.",[550.94,551.21,551.99,552.84,553.11,553.25,553.39,553.59,553.89,554.17,554.35,554.49,554.87,555.01,555.23,555.59,555.69]],[556.68," Brillava appena alla luce del fuoco, un riflesso viola, lontano.",[556.68,557.13,557.55,557.75,558.01,558.21,559.12,559.33,560.19,561.01]],[562.22," «Me la porto sempre dietro.",[562.22,562.43,562.53,562.93,563.32]],[564.51," Porta fortuna.»",[564.51,564.8]]]},{"c":[[566.9,"Larsa si alzò, attraversò il cerchio del fuoco, e gliela prese di mano.",[566.9,567.72,568.09,568.93,569.5,569.71,570.09,570.29,571.26,571.41,571.65,571.91,572.05]]]},{"c":[[573.24,"Non lo fece in modo brusco.",[573.24,573.51,573.67,574.01,574.13,574.42]],[575.53," Ma lo fece in fretta, con la mano che si chiudeva sulla pietra prima ancora che Penelo decidesse se ridargliela, e Penelo restò con il palmo vuoto in aria.",[575.53,575.53,575.63,575.85,575.99,576.77,577.05,577.15,577.35,577.49,577.63,577.97,578.2,579.15,579.41,579.67,579.85,580.31,581.22,581.43,582.59,582.73,583.07,583.43,583.59,583.75,584.09,584.68,584.89]],[586.01," Il laccio le tirò sul collo; se lo sfilò e liberò la pietra, poi lo rimise sotto il colletto.",[586.01,586.01,586.84,587.05,587.33,587.67,589,589.21,589.38,589.81,589.95,590.31,590.48,591.36,591.63,591.79,592.19,592.53,592.65]]]},{"c":[[594.82,"«Perdonatemi» disse Larsa.",[594.82,596,596.45]],[597.36," Teneva la pietra stretta nel pugno, contro il petto.",[597.36,597.83,597.95,598.29,598.69,598.87,599.58,600.05,600.23]],[601.06," «Perdonatemi.",[601.06]],[602.15," Non avrei mai dovuto darvela.",[602.15,602.43,602.73,602.91,603.39]],[604.24," Non sapevo.",[604.24,604.54]],[606.38," Credevo che fosse una protezione, una cosa per difendersi, e invece è…»",[606.38,606.38,606.65,606.95,607.13,608.44,608.71,609.01,609.3,610.66,610.81,611.63]],[612.22," Guardò Mjrn.",[612.22,613.22]],[613.88," «È la stessa cosa.",[613.88,614.03,614.13,614.51]],[615.47," Potrebbe fare la stessa cosa.",[615.47,616.07,616.35,616.51,616.95]],[617.93," A voi.",[617.93,618.15]],[619.22," Se io avessi saputo…»",[619.22,619.43,619.57,619.92]]]},{"c":[[621.87,"«Larsa.»",[621.87]],[623.36," Penelo abbassò la mano.",[623.36,623.86,624.39,624.55]],[625.3," «Ci ha salvati.»",[625.3,625.51,625.59]]]},{"c":[[627.23,"Larsa la guardò.",[627.23,627.63,627.75]]]},{"c":[[629.27,"«Sul Leviatano» disse lei.",[629.27,629.49,630.13,630.39]],[631.38," «Ha fermato la magia di Ghis.",[631.38,631.59,631.99,632.15,632.41,632.53]],[633.68," Io l'avevo in tasca e l'ho sentita diventare calda.",[633.68,633.82,634.25,634.4,635.11,635.18,635.39,635.83,636.43]],[637.75," Se non c'era la pietra, adesso non saremmo qui.",[637.75,637.75,637.9,638.09,638.21,639.12,639.59,639.73,640.06]],[640.98," Né io, né Vaan, né la principessa.»",[640.98,641.22,641.64,641.93,642.51,642.71,642.87]],[643.87," Fece una pausa.",[643.87,644.21,644.35]],[645.08," «Allora non può essere solo una cosa cattiva.",[645.08,645.55,645.75,645.95,646.39,646.84,647.11,647.31]],[648.12," No?»",[648.12]]]},{"c":[[649.59,"Larsa non rispose.",[649.59,650.15,650.43]],[651.33," Guardava la pietra nel pugno chiuso.",[651.33,651.89,652.01,652.41,652.63,652.95]]]},{"c":[[654.48,"«Penelo ha ragione» disse Ashe.",[654.48,655,655.21,656.17,657.19]]]},{"c":[[658,"Si voltarono tutti verso di lei.",[658,658.21,658.87,659.17,659.47,659.63]],[660.56," La principessa si era avvicinata al fuoco.",[660.56,660.77,661.33,661.51,661.63,662.15,662.27]],[663.71," Aveva il frammento d'Aurora alla cintura, avvolto nel panno, e lo toccò con le dita, senza guardarlo.",[663.71,663.71,663.83,664.36,664.77,664.93,665.63,666.17,666.35,667.33,667.47,667.59,667.97,668.23,668.35,669.02,669.43]]]},{"c":[[671.63,"«Una cosa pericolosa non è malvagia perché esiste» disse.",[671.63,671.91,672.21,672.87,673.05,673.19,674.3,674.77,675.21]],[676.18," «Una spada è pericolosa.",[676.18,676.45,676.81,676.95]],[678.26," Il fuoco è pericoloso.",[678.26,678.47,678.79,678.91]],[680.12," La magilite che illumina le vostre città è pericolosa, se la si fa scoppiare.»",[680.12,680.27,680.87,681.03,681.41,681.51,681.79,682.11,682.25,683.56,683.77,683.89,684.01,684.13]],[685.38," Guardò Larsa.",[685.38,687.63]],[689.51," «Conta chi la tiene.",[689.51,689.51,689.69,689.81]],[690.67," Conta cosa ne fa.",[690.67,691.07,691.33,691.47]],[692.2," Questa pietra, nelle mani di Penelo, ha fermato un Giudice.",[692.2,692.74,693.21,693.49,693.77,693.9,694.37,694.57,694.91,695.04]],[695.95," Nelle mani di quelli là dentro ha legato una ragazza a una sedia.",[695.95,696.35,696.63,696.73,696.99,697.17,697.57,697.71,698.07,698.27,698.76,698.91,699.14]],[699.95," È la stessa pietra.»",[699.95,700.09,700.21,700.58]]]},{"c":[[702.71,"Larsa la fissò a lungo.",[702.71,703.52,703.73,704.09,704.25]]]},{"c":[[706.31,"«E il vostro frammento, altezza?»",[706.31,706.45,706.57,706.91,707.51]],[708.26," chiese, piano.",[708.26,708.95]],[709.56," «Nelle mani di chi sta?»",[709.56,710.17,710.37,710.49,710.63]]]},{"c":[[711.4,"Ashe non rispose.",[711.4,712.43,712.57]],[713.39," Non subito.",[713.39,713.74]],[714.58," La mano le restò sul panno, ferma.",[714.58,714.79,715.07,715.23,715.51,715.71,716.57]]]},{"c":[[718.09,"«È quello che sto cercando di capire» disse.",[718.09,718.23,718.47,718.59,718.75,719.15,719.27,719.69]]]},{"c":[[722.11,"Vaan aveva seguito lo scambio con la fronte aggrottata.",[722.11,722.11,722.51,722.93,723.11,723.49,723.65,723.77,724.13]],[725.5," Non sembrava convinto.",[725.5,725.77,726.27]],[727.54," Guardò la pietra di Larsa, poi i pezzi della pietra di Mjrn nella mano di Fran, poi il frammento alla cintura di Ashe.",[727.54,728.01,728.15,728.51,728.61,729.39,729.71,729.85,730.19,730.39,730.73,730.94,731.35,731.69,731.93,732.07,733.03,733.34,733.55,734.05,734.17,734.59,734.77]]]},{"c":[[736.63,"«Speriamo che tu abbia ragione» disse alla fine.",[736.63,737.23,737.37,737.49,737.73,738.13,738.39,738.57]],[739.66," «Perché a me sembrano tutte uguali.»",[739.66,740.13,740.25,740.33,740.77,741.42]]]},{"c":[[744.77,"Più tardi, quando gli altri dormivano o fingevano di dormire, Penelo andò a sedersi accanto a Larsa, che non dormiva.",[744.77,745.14,745.76,746.23,746.41,746.71,747.3,747.37,748.03,748.25,749.34,749.81,750.13,750.27,750.69,751.46,751.57,752.12,752.39,752.58]],[753.87," Il principe stava seduto un po' fuori dal cerchio della luce, con la pietra ancora nel pugno, e guardava la miniera.",[753.87,753.87,754.21,754.57,755.03,755.21,755.35,755.75,755.95,756.33,756.59,757.36,757.63,757.77,758.09,758.39,758.61,759.52,759.67,760.11,760.25]]],"st":1},{"c":[[762.12,"Penelo non disse niente per un po'.",[762.12,762.94,763.21,763.51,763.95,764.15,764.62]],[764.98," Poi gli diede una gomitata, leggera.",[764.98,765.36,765.63,765.93,766.15,767.36]]]},{"c":[[768.94,"«Me la rendi, un giorno?»",[768.94,769.15,769.33,770.04,770.25]]]},{"c":[[771.88,"Larsa si voltò.",[771.88,772.3,772.51]],[773.75," «Cosa?»",[773.75]]]},{"c":[[774.98,"«La pietra.",[774.98,775.68]],[776.6," Quando non sarà più pericolosa.",[776.6,777.07,777.31,777.53,777.73]],[779.05," O quando sarai sicuro.»",[779.05,779.19,779.51,779.86]]]},{"c":[[781.38,"«Non so se sarà mai sicura.»",[781.38,781.78,782.32,782.53,782.77,783.52]]]},{"c":[[784.44,"«Allora tienila tu.»",[784.44,784.91,785.66]],[786.34," Penelo si strinse le ginocchia.",[786.34,787.14,787.35,787.67,787.85]],[788.83," «Basta che la tieni.",[788.83,789.23,789.41,789.53]],[790.57," È stato il primo regalo che mi ha fatto qualcuno che non conoscevo.",[790.57,790.71,790.95,791.09,791.33,791.73,791.85,791.95,792.03,792.23,792.65,792.81,792.97]],[794.04," Il primo dopo…",[794.04,794.25,794.55]],[795.13," dopo tanto tempo.",[795.13,795.47,795.85]],[797.03," A Rabanastre nessuno mi regala niente.",[797.03,797.03,798.01,798.55,798.73,799.12]],[800.08," Nessuno di loro, dico.»",[800.08,800.61,800.75,801.13]],[802.02," Indicò con il mento, vagamente, il nord, l'Impero, i soldati delle ronde.",[802.02,802.49,802.71,802.87,803.43,804.12,804.35,804.78,805.52,805.67,806.15,806.35]],[807.04," «Tu sì.»",[807.04,807.38]]]},{"c":[[809.44,"Larsa la guardò.",[809.44,809.97,810.05]],[810.8," Non disse niente.",[810.8,811.07,811.31]]]},{"c":[[812.7,"«Sai perché sono venuta?»",[812.7,812.97,813.27,813.58]],[814.33," disse Penelo.",[814.33,814.78]],[815.36," «Non ve l'ho mai detto.",[815.36,815.63,815.72,815.85,815.97]],[816.63," Vaan pensa che sono venuta per lui.",[816.63,817.15,817.49,817.65,817.87,818.19,818.39]],[819.12," Per tenerlo d'occhio.",[819.12,819.39,819.97]],[820.55," È vero, un po'.",[820.55,820.69,821.01,821.13]],[821.52," Ma non è per quello.»",[821.52,821.73,821.85,821.95,822.11]],[823.21," Fece una pausa.",[823.21,823.21,823.35]],[824.21," «I miei fratelli.",[824.21,824.35,824.57]],[825.54," Ne avevo due.",[825.54,825.75,826.06]],[826.62," Più grandi.",[826.62,826.89]],[827.92," Mi hanno insegnato a tirare di bastone quando avevo otto anni, perché dicevano che una ragazza della Città Bassa deve sapersi difendere.",[827.92,828.13,828.25,828.71,828.81,829.07,829.19,829.65,829.93,830.21,830.43,830.88,831.35,831.83,831.95,832.09,832.51,832.69,833.09,833.41,833.57,834.03]],[835.27," Sono morti nella guerra.",[835.27,835.27,835.59,835.77]],[836.35," Tutti e due.»",[836.35,836.78,836.93]],[837.7," Lo disse senza piangere, guardando la miniera.",[837.7,837.91,838.15,838.43,839.41,839.77,839.89]],[840.75," «E io ho pensato che se c'è un modo per non farne morire degli altri, di fratelli, voglio esserci.",[840.75,840.89,841.01,841.07,841.45,841.59,841.75,841.91,842.01,842.21,842.39,842.53,842.87,843.19,843.41,843.77,843.95,844.81,844.97]],[846.54," Anche se non so fare niente.",[846.54,846.54,846.75,846.91,847.05,847.3]],[848.11," Anche solo per portare le focacce.»",[848.11,848.49,848.77,848.97,849.39,849.51]]]},{"c":[[851.76,"Larsa rimase in silenzio a lungo.",[851.76,852.42,852.89,853.03,853.47,853.61]]]},{"c":[[855.16,"«Io ho un fratello» disse alla fine.",[855.16,855.48,855.69,855.77,856.71,857.11,857.35]]]},{"c":[[859.18,"«Lo so.»",[859.18,859.46]]]},{"c":[[860.72,"«Ne avevo tre, una volta.»",[860.72,860.93,861.8,862.36,862.64]],[863.46," Il principe guardava il pugno chiuso.",[863.46,863.67,864.11,864.65,864.81,865.22]],[866.06," «Adesso ne ho uno.»",[866.06,866.56,866.77,867.01]]]},{"c":[[868.2,"Penelo si voltò a guardarlo.",[868.2,868.67,868.85,869.15,869.27]],[870.83," Larsa non aggiunse altro, e lei non gli chiese niente.",[870.83,870.83,871.01,871.39,872.71,872.88,873.56,873.83,873.95,874.22]],[875.26," Restarono seduti così, uno accanto all'altra, fino a quando il fuoco non fu ridotto a un mucchio di braci; e quando Penelo, alla fine, si alzò per andare a dormire, Larsa aprì il pugno,",[875.26,875.93,876.37,877.6,878.18,878.96,879.85,880.25,880.39,881.12,881.33,881.73,882.02,882.23,883.07,883.21,883.37,883.77,883.97,885.33,885.47,885.84,886.45,886.79,887.66,887.89,888.23,888.43,888.73,888.86,889.89,890.63,890.97,891.14]],[892.39," guardò la pietra, e se la mise in tasca, nella tasca del petto, dove si tengono le cose che non si vogliono perdere.",[892.39,892.39,892.49,893.52,893.67,893.77,893.85,894.07,894.21,894.83,895.23,895.53,895.73,896.37,896.71,896.83,897.17,897.31,897.57,897.75,897.91,898.07,898.45]]]}]