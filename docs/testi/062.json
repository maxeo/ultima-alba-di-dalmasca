[{"h":1,"c":[[2.12,"Capitolo sessantaduesimo: Il segreto di Draklor.",[2.12,3.23,5.35,5.58,6.29,6.49]]]},{"c":[[10.46,"Mjrn si svegliò all'aperto, sotto le stelle, sullo spiazzo davanti alla miniera, dove gli altri l'avevano portata perché nessuno di loro voleva passare una notte in più sotto quelle travi.",[10.46,10.95,11.16,11.8,12.62,13.02,13.16,13.94,14.34,14.76,15.1,15.22,15.98,16.32,16.5,16.79,17.27,17.8,18.1,18.58,18.72,18.92,19.3,19.74,19.94,20.24,20.36,20.48,20.74,21]],[22.5," Avevano spostato i corpi.",[22.5,22.5,22.98,23.08]],[24.82," Basch e Balthier li avevano allineati dietro una delle baracche e li avevano coperti con dei teli trovati accanto all'argano, e Larsa aveva chiesto di poter restare un momento solo con loro,",[24.82,24.82,24.94,25.97,26.18,26.56,27.1,27.48,27.7,27.88,29.16,29.3,29.42,29.74,30.22,30.4,30.56,30.76,31.18,31.56,32.61,32.73,33.3,33.7,34.06,34.2,34.5,34.86,34.96,35.64,35.98,36.2]],[37.39," e nessuno gli aveva chiesto perché.",[37.39,37.39,38.13,38.4,38.62,38.98]],[41.22," Quando era tornato al fuoco aveva gli occhi asciutti e la faccia molto composta, la faccia di un ragazzo a cui hanno insegnato che un principe non piange davanti ai sudditi,",[41.22,41.22,41.4,41.82,41.94,42.75,43.16,43.28,43.46,44.39,44.54,44.64,44.92,45.2,46.43,46.64,46.9,47,47.08,47.51,47.66,47.76,47.96,48.91,49.18,49.34,49.78,50.02,50.34,50.76,50.88]],[52.1," e che non sa ancora se quelli che ha davanti siano sudditi o no.",[52.1,52.1,52.22,52.38,52.58,52.99,53.2,53.5,53.6,53.72,54.04,54.36,54.84,54.98]]]},{"c":[[56.57,"Il fuoco era piccolo, fatto con le assi di una cassa.",[56.57,56.78,57.08,57.22,58.12,58.3,58.48,58.58,58.8,58.88,59.02]],[60.06," Mjrn si mise a sedere adagio, con la schiena contro un sasso, avvolta nel mantello di Fran.",[60.06,60.89,61.1,61.33,61.48,62.02,62.57,62.84,62.96,63.26,63.52,63.8,64.48,65.02,65.18,65.56,65.68]],[66.37," Guardò le facce intorno a sé una per una.",[66.37,66.84,66.96,67.26,67.62,67.74,67.92,68.16,68.36]],[70.19," Poi guardò la sorella, che le sedeva accanto, e non distolse più gli occhi.",[70.19,70.19,70.66,70.8,71.52,71.8,71.94,72.26,73.3,73.44,73.56,74.04,74.2,74.36]]]},{"c":[[76.02,"«Sei vera» disse.",[76.02,76.42,77.09]]]},{"c":[[78.73,"«Sì.»",[78.73]]]},{"c":[[80.33,"«Ti credevo morta.",[80.33,80.54,81.16]],[81.92," A Eruyt dicono che sei morta.»",[81.92,81.99,82.34,82.72,82.86,83.22]],[84.6," Mjrn ci pensò.",[84.6,85.71,86.08]],[87.03," «No.",[87.03]],[87.58," Non lo dicono.",[87.58,87.76,87.93]],[88.6," Non dicono niente.",[88.6,88.88,89.29]],[90.52," È peggio.»",[90.52,90.83]]]},{"c":[[92.82,"Fran non rispose.",[92.82,93.05,93.23]],[94.99," Le passò una ciotola d'acqua, e Mjrn bevve.",[94.99,95.2,95.52,95.7,96.51,97.2,97.29,97.65]]]},{"c":[[101.01,"Raccontò quello che ricordava, e non era molto.",[101.01,101.86,102.33,102.5,103.56,103.71,103.83,104.01]],[104.96," Lo raccontò con la voce di una ragazza giovane, che salta da una cosa all'altra e torna indietro, che si interrompe per dire che aveva freddo, o che si ricordava l'odore.",[104.96,105.09,105.55,105.69,105.79,106.05,106.17,106.29,106.71,107.59,107.87,108.19,108.31,108.47,108.73,109.25,109.39,109.71,110.55,110.83,110.97,111.49,111.69,111.91,112.13,112.42,113.37,113.51,113.63,113.79,114.27]],[115.4," Penelo la ascoltava con la bocca aperta.",[115.4,115.7,115.81,116.31,116.45,116.57,116.84]],[117.56," Vaan la ascoltava con le ginocchia strette fra le braccia.",[117.56,118.03,118.27,119.05,119.33,119.45,119.83,120.21,120.35,120.49]],[121.44," Ashe ascoltava in piedi, un poco discosta, come chi assiste a un processo.",[121.44,121.99,122.55,122.69,123.49,123.55,123.75,124.81,125.05,125.19,125.65,125.75,125.83]]],"st":1},{"c":[[127.97,"Aveva visto i soldati, disse Mjrn.",[127.97,128.37,128.59,128.74,129.77,130.6]],[131.27," Molte lune prima.",[131.27,131.51,131.69]],[132.73," Uomini con il ferro addosso, che camminavano ai margini della giungla, che passavano per i sentieri vecchi, che si fermavano a guardare gli alberi come se li stessero misurando.",[132.73,133.17,133.41,133.57,134,135.06,135.33,135.87,136.05,136.53,136.73,137.65,137.89,138.41,138.57,138.69,138.99,139.81,140.09,140.21,140.69,140.81,141.17,141.33,141.71,141.91,142.07,142.19,142.72]],[144.39," All'inizio erano pochi.",[144.39,145.15,145.6]],[146.44," Poi di più.",[146.44,146.71,146.87]],[147.69," Lei lo aveva detto a Jote, e Jote aveva detto che le cose degli Huma erano degli Huma, e che il Bosco li avrebbe respinti come aveva sempre fatto.",[147.69,147.97,148.15,148.43,148.72,148.9,149.6,149.71,150.13,150.53,151.13,151.41,151.51,151.83,152.15,152.41,152.77,153.37,153.84,153.99,154.09,154.19,154.82,155.07,155.35,155.87,156.07,156.35,156.63]],[157.97," Lo aveva detto alle sorelle sui rami, e le sorelle sui rami avevano detto lo stesso.",[157.97,157.97,158.25,158.49,158.69,159.13,159.41,160.22,160.37,160.51,160.88,161.15,161.66,162.19,162.49,162.67]],[164.02," Nessuno si preoccupava.",[164.02,164.58,164.79]]]},{"c":[[167.44,"«Ma io mi preoccupavo» disse Mjrn.",[167.44,167.65,167.81,168.73,169.53,170.13]],[170.61," «Non so perché.",[170.61,170.9,171.11]],[171.88," Il Bosco era inquieto.",[171.88,172.09,172.41,172.55]],[173.44," Io lo sentivo.",[173.44,173.65,173.77]],[174.72," Il Bosco diceva una cosa e Jote ne sentiva un'altra, o faceva finta.»",[174.72,174.93,175.27,175.65,175.79,176.6,176.7,177.09,177.27,177.96,178.64,178.79,179.21]],[180.02," Si strinse nel mantello.",[180.02,180.23,180.61,180.79]],[182," «Allora una notte sono andata.",[182,182.66,182.93,183.21,183.4]],[184.24," Volevo solo vedere cosa cercavano.",[184.24,184.71,185.01,185.41,185.81]],[187.21," Li ho seguiti fuori dalla giungla, fino alla pianura, e poi fin qui.",[187.21,187.39,187.53,187.93,188.19,188.39,189.27,189.61,189.73,190.64,190.79,191.03,191.27]],[191.72," Volevo solo vedere.»",[191.72,192.19,192.39]]]},{"c":[[194.38,"«E hai visto» disse Balthier.",[194.38,194.53,194.67,195.15,195.82]]]},{"c":[[196.88,"«Mi hanno vista loro.»",[196.88,197.09,197.21,197.49]],[198.11," Mjrn abbassò gli occhi.",[198.11,198.73,199.13,199.29]],[199.87," «Prima che io vedessi qualcosa.»",[199.87,200.27,200.43,200.59,201.45]]]},{"c":[[202.34,"Balthier si voltò verso Fran con un mezzo sorriso.",[202.34,203.22,203.43,203.73,204.01,204.23,204.45,204.61,204.97]],[206.41," «Una ragazza che lascia il villaggio di notte senza dirlo a nessuno, per andare a vedere cosa fanno gli Huma.",[206.41,206.41,206.93,207.09,207.39,207.49,207.89,208.03,208.43,208.69,209.01,209.09,209.75,210.03,210.25,210.37,210.61,210.91,211.23,211.74]],[212.42," Mi ricorda qualcuno.»",[212.42,212.63,213.81]]]},{"c":[[215.07,"Fran non rispose.",[215.07,215.84,216.11]],[217.35," Non lo guardò nemmeno.",[217.35,217.53,217.63,217.95]],[219.19," Ma Mjrn, che non conosceva Balthier e non sapeva come prendere le sue frasi, guardò prima l'uno e poi l'altra, e capì qualcosa che nessuno le aveva detto, e per un istante sorrise.",[219.19,219.47,220.03,220.31,220.47,221.24,221.92,222.07,222.21,222.65,222.85,223.27,223.39,223.56,224.4,224.87,225.52,226.04,226.23,226.68,227.58,227.73,228.01,228.49,228.69,229.19,229.33,229.59,230.34,230.49,230.67,230.8,231.4]]]},{"c":[[233.5,"Poi il sorriso le passò.",[233.5,233.94,234.15,234.53,234.63]]]},{"c":[[236.06,"«Mi hanno portata giù» disse.",[236.06,236.27,236.51,237.03,237.72]],[238.61," «Nelle gallerie.",[238.61,238.83]],[239.81," C'erano i soldati e c'erano gli altri, quelli con le vesti lunghe.",[239.81,240.54,240.78,241.56,241.64,242.07,242.25,243.13,243.35,243.57,243.69,244.03]],[244.57," Parlavano fra loro come se io non ci fossi.",[244.57,245.21,245.41,245.67,245.91,246.07,246.25,246.39,246.56]],[247.52," Uno scriveva su un quaderno.",[247.52,247.75,248.34,248.55,248.69]],[249.82," Mi hanno messa in una stanza con una sedia di ferro, e mi hanno legata alla sedia, e poi hanno portato una pietra.»",[249.82,250.03,250.17,250.53,250.63,250.83,251.17,251.37,251.59,251.83,251.97,252.84,252.99,253.11,253.25,253.61,253.82,254.72,254.91,255.28,255.69,256.11,256.27]],[257.18," Si fermò.",[257.18,257.39]],[258.29," «Era piccola.",[258.29,258.41]],[259.49," Scura.",[259.49]],[260.65," Come quella che avevo in mano.»",[260.65,260.65,260.89,261.03,261.31,261.43]]]},{"c":[[263.21,"Nessuno disse niente.",[263.21,263.75,264]],[264.86," Il fuoco crepitò.",[264.86,265.07,265.45]]]},{"c":[[266.41,"«L'hanno messa su un tavolo accanto a me.",[266.41,267.23,267.49,267.65,267.71,268.01,268.37,268.49]],[269.08," Uno di loro, il più vecchio, mi ha spiegato cosa sarebbe successo.",[269.08,269.35,269.49,269.99,270.19,270.33,271.14,271.35,271.43,272.07,272.41,272.89]],[273.86," Lo ha fatto con molta gentilezza.",[273.86,274.07,274.17,274.39,274.59,274.89]],[276.31," Ha detto che la pietra conteneva il Mystes, molto Mystes, e che il Mystes sarebbe uscito dalla pietra e sarebbe entrato in me.",[276.31,276.31,276.53,276.67,276.77,277.13,277.65,277.99,279.01,279.74,280.63,280.77,280.87,281.1,281.77,282.34,282.81,283.22,284.21,284.35,284.73,285.66,285.87]],[286.84," Ha detto che noi viere siamo…",[286.84,287.05,287.64,287.91,288.17,288.53]],[289.54," adatte.",[289.54]],[290.63," È la parola che ha usato.",[290.63,290.77,290.89,291.31,291.49,291.67]],[292.66," Adatte.",[292.66]],[293.72," Perché il Mystes noi lo sentiamo meglio degli Huma, e quindi lo prendiamo meglio.»",[293.72,293.97,294.12,294.56,294.8,294.96,295.36,295.62,296.31,296.86,297,297.24,297.38,297.76]],[298.74," Mjrn deglutì.",[298.74,299.38]],[300.59," «Ha detto che non avrei sentito dolore.",[300.59,300.8,301.08,301.24,301.36,301.6,302.04]],[302.95," Poi ha fatto un cenno, e la pietra si è accesa.»",[302.95,303.22,303.38,303.62,303.76,304.63,304.78,304.9,305.24,305.44,305.69]]]},{"c":[[307.56,"«E poi?»",[307.56,307.71]],[308.49," chiese Penelo, piano.",[308.49,309.01,309.72]]]},{"c":[[311.02,"«E poi niente.",[311.02,311.16,311.45]],[312.29," Una luce.",[312.29,312.58]],[313.38," Tanta luce.",[313.38,313.9]],[314.96," Viola.",[314.96]],[315.81," E poi niente.»",[315.81,315.97,316.35]],[316.89," Mjrn guardò il fuoco.",[316.89,317.24,317.78,317.9]],[318.83," «Non mi ricordo niente dopo.",[318.83,319.1,319.2,319.52,319.98]],[320.56," Non mi ricordo di voi.",[320.56,320.84,320.96,321.3,321.49]],[321.99," Non mi ricordo di…",[321.99,322.26,322.38,322.82]],[325.96," di quello che ho detto.",[325.96,325.96,326.2,326.34,326.46]],[327.51," Mi hanno detto che ho detto delle cose.»",[327.51,327.72,327.88,328.16,328.36,328.54,328.84,329.26]],[330.19," Si voltò verso Ashe, e la guardò per la prima volta davvero, con gli occhi suoi.",[330.19,330.4,330.72,331.28,331.74,331.88,331.98,332.28,332.46,332.58,332.78,333.08,333.73,334,334.14,334.4]],[335.18," «A te.",[335.18,335.32]],[335.85," Ho detto delle cose a te?»",[335.85,336.06,336.3,336.56,336.9,337.05]]]},{"c":[[338.97,"Ashe restò ferma un momento.",[338.97,339.21,339.51,339.82,339.94]]]},{"c":[[342.25,"«Niente che io non mi sia già detta da sola» rispose.",[342.25,342.72,342.92,343.08,343.28,343.42,343.62,343.8,344.12,344.3,345.2]]]},{"c":[[348.37,"Fran si alzò.",[348.37,348.69,348.97]],[349.87," Andò fino al bordo della luce del fuoco, dove sul terreno, accanto alla borsa di Basch, c'erano i due pezzi della pietra spaccata che lei aveva raccolto nella sala.",[349.87,350.13,350.33,350.47,350.75,350.99,351.25,351.47,352.25,352.59,352.83,353.29,353.69,353.87,354.17,354.39,354.96,355.63,355.75,355.93,356.33,356.53,356.97,357.58,357.85,358.05,358.33,358.75,358.97]],[359.76," Li prese.",[359.76,360.01]],[361.19," Li tenne nella mano aperta e li guardò, e poi si voltò verso Larsa.",[361.19,361.27,361.61,361.81,362,362.47,362.61,362.75,363.93,364.08,364.74,364.95,365.27,365.64]]],"st":1},{"c":[[367.54,"«Non è del Re Dinasta» disse.",[367.54,367.87,368.01,368.27,368.46,369.11]]]},{"c":[[370.25,"Larsa non rispose subito.",[370.25,370.65,370.81,371.22]],[372.09," Aveva già capito.",[372.09,372.49,372.62]],[373.54," Lo avevano capito tutti, in realtà, ma c'era una differenza fra capire una cosa e sentirla dire, e la viera la disse.",[373.54,373.75,374.11,374.47,374.83,374.95,375.64,375.8,376.13,376.29,377.01,377.19,377.53,377.75,378.44,378.59,379.11,379.73,379.87,379.97,380.19,380.35]]]},{"c":[[382.29,"«È fatta dagli uomini» disse Fran.",[382.29,382.43,382.73,382.95,383.51,384.32]],[384.97," «Come quella che ha bevuto la magia del Giudice, sul Leviatano.",[384.97,385.31,385.61,385.75,385.85,386.19,386.35,386.71,386.91,387.66,387.93]],[388.93," Viene dallo stesso posto.»",[388.93,389.23,389.53,390.43]]]},{"c":[[391.35,"«Negalite artificiale» disse Larsa.",[391.35,391.95,393.21,393.79]],[394.36," La voce gli uscì più sottile di quanto volesse.",[394.36,394.57,394.81,394.95,395.15,395.33,395.77,395.89,396.17]],[397.14," «Draklor la produce.",[397.14,398.11,398.29]],[399.26," Lo so.",[399.26,399.5]],[400.18," Lo sapevo.",[400.18,400.39]],[401.02," Ne avevo letto i rapporti.",[401.02,401.23,401.47,401.69,401.77]],[403.01," Si parlava di applicazioni, di energia, di navi più veloci.",[403.01,403.01,403.39,403.57,404.74,404.99,406.14,406.35,406.61,406.8]],[407.78," Non si parlava di…»",[407.78,408.05,408.19,409.1]],[409.78," Guardò Mjrn.",[409.78,410.74]],[411.38," «Non si parlava di sedie di ferro.»",[411.38,411.65,411.81,412.24,412.65,413.06,413.33]]]},{"c":[[414.94,"«I rapporti non ne parlano mai» disse Balthier.",[414.94,415.09,415.59,415.73,415.83,416.22,416.99,417.71]]]},{"c":[[418.85,"Larsa si voltò verso di lui.",[418.85,419.21,419.41,419.71,420.03,420.19]],[421.58," Balthier stava seduto a un passo dal fuoco, con un gomito sul ginocchio e la faccia mezza in ombra, e non aveva il tono di chi fa una battuta.",[421.58,422.07,422.43,422.81,422.91,423.01,423.25,423.51,424.25,424.53,424.67,424.93,425.13,425.59,425.71,425.81,426.09,426.37,426.53,427.33,427.47,427.61,427.89,428.03,428.31,428.43,428.53,428.69,428.89]]]},{"c":[[431.04,"«Voi lo sapevate» disse Larsa.",[431.04,431.31,431.49,432.09,432.49]],[433.37," «Fuori.",[433.37]],[433.91," Davanti ai corpi.",[433.91,434.45,434.57]],[435.21," Avete detto ricerca come se lo sapeste.»",[435.21,435.61,435.89,436.31,436.55,436.69,436.81]]]},{"c":[[438.64,"«Ho detto ricerca perché è la parola giusta.",[438.64,438.85,439.15,440.12,440.67,440.71,440.81,441.14]],[442.33," A Draklor tutto si chiama ricerca.»",[442.33,442.46,443.43,444.4,444.61,445.05]],[446.1," Balthier guardò il fuoco.",[446.1,447.3,447.77,447.91]],[449.18," «Un uomo legato a una sedia è ricerca.",[449.18,449.39,449.7,450.19,450.33,450.55,451.15,451.33]],[452.5," Una città bruciata è ricerca.",[452.5,452.77,453.05,453.81,454.01]],[455.33," Una ragazza a cui si dice, con molta gentilezza, che non sentirà dolore, è ricerca.",[455.33,455.33,455.81,455.95,456.03,456.21,456.64,456.91,457.23,458.3,458.57,458.77,459.22,460.15,460.31]],[461.43," È una parola molto comoda.",[461.43,461.57,461.73,462.05,462.34]],[463.23," Copre tutto, come un telo sopra un cadavere.»",[463.23,463.63,464.27,464.61,464.81,465.13,465.49,465.63]]]},{"c":[[467.28,"«Chi dirige Draklor?»",[467.28,467.55,468.47]],[469.54," chiese Vaan.",[469.54,470.75]]]},{"c":[[471.57,"Larsa esitò.",[471.57,472.15]],[473.34," «Il dottor Cidolfus Bunansa.",[473.34,473.56,474.13,475.25]],[476.23," È il più grande scienziato dell'Impero.",[476.23,476.37,476.49,476.61,476.95,478.09]],[479.24," Mio fratello lo stima molto.»",[479.24,479.51,479.95,480.13,480.35]]]},{"c":[[482.4,"«Cid» disse Balthier.",[482.4,482.83,483.43]],[484.4," Lo disse piano, guardando il fuoco.",[484.4,484.61,484.83,485.36,486.03,486.13]],[487.04," «Dicono che parli con i fantasmi.»",[487.04,487.51,487.67,488.05,488.23,488.37]]]},{"c":[[490,"«Lo conoscete?»",[490,490.21]],[491.38," chiese Larsa.",[491.38,491.87]]]},{"c":[[493.4,"«Lo conoscono tutti, ad Archades.»",[493.4,493.61,494.09,494.98,495.56]],[497.87," Balthier si alzò, si scosse la polvere dai pantaloni, e si allontanò dal fuoco di qualche passo, nel buio, a guardare la pianura.",[497.87,497.87,498.11,499.16,499.37,499.79,499.93,500.37,500.57,501.77,501.91,502.03,502.53,502.77,503.17,503.33,503.73,504.58,504.93,505.85,505.99,506.41,506.55]],[507.79," «È famoso.»",[507.79,508]]]},{"c":[[509.93,"Fran non lo seguì.",[509.93,510.46,510.73,510.87]],[511.7," Ma lo guardò andare, e lo guardò per molto tempo.",[511.7,511.91,512.03,512.33,513.23,513.37,513.49,513.83,514.01,514.35]]]},{"c":[[517.75,"Larsa rimase in silenzio.",[517.75,518.16,518.48,518.62]],[519.85," Poi si voltò di scatto verso Penelo.",[519.85,520.12,520.28,520.6,520.72,521.06,521.36]]],"st":1},{"c":[[522.63,"«Signorina Penelo» disse.",[522.63,523.47,524.38]]]},{"c":[[525.89,"Penelo alzò la testa.",[525.89,526.74,527.08,527.3]]]},{"c":[[528.47,"«La pietra.",[528.47,528.71]],[529.41," Quella che vi ho dato a Bhujerba.",[529.41,529.88,530.02,530.12,530.18,530.34,530.45]],[531.33," Ce l'avete ancora?»",[531.33,531.45,531.8]]]},{"c":[[533.83,"«Sì.»",[533.83]],[535.82," Penelo se la tirò fuori da sotto il vestito, dove la teneva appesa a un laccio di cuoio, e la mostrò sul palmo.",[535.82,535.82,536,536.1,536.36,536.62,536.76,537,537.12,538.08,538.42,538.56,538.92,539.28,539.34,539.54,539.9,540.06,540.98,541.12,541.22,541.52,541.72]],[542.47," Era piccola, scura, più o meno della stessa forma dei due pezzi che Fran teneva in mano.",[542.47,542.74,543.54,544.54,544.66,544.78,544.94,545.14,545.44,545.7,545.9,546.02,546.42,546.54,546.76,547.14,547.26]],[548.21," Brillava appena alla luce del fuoco, un riflesso viola, lontano.",[548.21,548.66,549.04,549.3,549.54,549.74,550.65,550.86,551.74,552.57]],[553.75," «Me la porto sempre dietro.",[553.75,553.96,554.06,554.46,554.86]],[556.06," Porta fortuna.»",[556.06,556.33]]]},{"c":[[558.44,"Larsa si alzò, attraversò il cerchio del fuoco, e gliela prese di mano.",[558.44,559.25,559.64,560.48,561.04,561.24,561.62,561.84,562.84,562.98,563.18,563.44,563.58]]]},{"c":[[564.76,"Non lo fece in modo brusco.",[564.76,565.04,565.2,565.54,565.66,565.95]],[567.06," Ma lo fece in fretta, con la mano che si chiudeva sulla pietra prima ancora che Penelo decidesse se ridargliela, e Penelo restò con il palmo vuoto in aria.",[567.06,567.06,567.16,567.4,567.52,568.31,568.58,568.7,568.9,569.02,569.16,569.52,569.75,570.54,570.94,571.2,571.38,571.92,572.77,572.98,574.13,574.28,574.62,574.98,575.16,575.3,575.62,576.21,576.42]],[577.6," Il laccio le tirò sul collo; se lo sfilò e liberò la pietra, poi lo rimise sotto il colletto.",[577.6,577.6,578.37,578.58,578.86,579.2,580.53,580.74,580.94,581.34,581.48,581.84,582.01,582.9,583.18,583.32,583.74,584.06,584.2]]]},{"c":[[586.37,"«Perdonatemi» disse Larsa.",[586.37,587.54,588]],[588.89," Teneva la pietra stretta nel pugno, contro il petto.",[588.89,589.36,589.48,589.82,590.24,590.4,591.13,591.6,591.76]],[592.61," «Perdonatemi.",[592.61]],[593.69," Non avrei mai dovuto darvela.",[593.69,593.96,594.26,594.46,594.93]],[595.78," Non sapevo.",[595.78,596.09]],[597.93," Credevo che fosse una protezione, una cosa per difendersi, e invece è…»",[597.93,597.93,598.2,598.48,598.66,599.97,600.24,600.56,600.87,602.22,602.36,602.98]],[603.75," Guardò Mjrn.",[603.75,604.44]],[604.89," «È la stessa cosa.",[604.89,605.45,605.66,606.06]],[607," Potrebbe fare la stessa cosa.",[607,607.6,607.88,608.04,608.46]],[609.51," A voi.",[609.51,609.71]],[610.75," Se io avessi saputo…»",[610.75,610.96,611.1,611.49]]]},{"c":[[613.41,"«Larsa.»",[613.41]],[614.91," Penelo abbassò la mano.",[614.91,615.41,615.94,616.06]],[616.83," «Ci ha salvati.»",[616.83,617.04,617.11]]]},{"c":[[618.29,"Larsa la guardò.",[618.29,619.14,619.28]]]},{"c":[[620.83,"«Sul Leviatano» disse lei.",[620.83,621.01,621.58,621.95]],[622.93," «Ha fermato la magia di Ghis.",[622.93,623.14,623.52,623.68,623.94,624.06]],[625.21," Io l'avevo in tasca e l'ho sentita diventare calda.",[625.21,625.36,625.8,625.94,626.63,626.71,626.94,627.36,627.98]],[629.28," Se non c'era la pietra, adesso non saremmo qui.",[629.28,629.28,629.43,629.62,629.74,630.65,631.12,631.27,631.61]],[632.45," Né io, né Vaan, né la principessa.»",[632.45,632.77,633.17,633.46,634.05,634.26,634.38]],[635.4," Fece una pausa.",[635.4,635.74,635.89]],[636.59," «Allora non può essere solo una cosa cattiva.",[636.59,637.06,637.28,637.48,637.94,638.37,638.64,638.84]],[639.65," No?»",[639.65]]]},{"c":[[641.12,"Larsa non rispose.",[641.12,641.69,641.96]],[642.82," Guardava la pietra nel pugno chiuso.",[642.82,643.42,643.56,643.96,644.18,644.51]]]},{"c":[[645.96,"«Penelo ha ragione» disse Ashe.",[645.96,646.51,646.73,647.65,648.7]]]},{"c":[[649.53,"Si voltarono tutti verso di lei.",[649.53,649.74,650.38,650.7,651.02,651.16]],[652.11," La principessa si era avvicinata al fuoco.",[652.11,652.32,652.86,653.06,653.16,653.68,653.8]],[654.88," Aveva il frammento d'Aurora alla cintura, avvolto nel panno, e lo toccò con le dita, senza guardarlo.",[654.88,655.24,655.38,655.9,656.3,656.48,657.34,657.72,657.89,658.86,659,659.14,659.52,659.76,659.88,660.56,660.96]]]},{"c":[[662.9,"«Una cosa pericolosa non è malvagia perché esiste» disse.",[662.9,663.18,663.53,664.87,665.18,665.44,666.29,666.89,667.58]],[668.52," «Una spada è pericolosa.",[668.52,668.82,669.53,669.77]],[670.93," Il fuoco è pericoloso.",[670.93,671.22,671.82,672.05]],[673.31," La magilite che illumina le vostre città è pericolosa, se la si fa scoppiare.»",[673.31,673.47,674.1,674.28,674.74,674.9,675.36,676.01,676.23,677.57,677.78,677.88,678,678.12]],[679.19," Guardò Larsa.",[679.19,679.72]],[681.18," «Conta chi la tiene.",[681.18,681.18,681.36,681.48]],[682.56," Conta cosa ne fa.",[682.56,682.96,683.22,683.36]],[684.05," Questa pietra, nelle mani di Penelo, ha fermato un Giudice.",[684.05,684.53,685,685.4,685.68,685.78,686.49,686.7,687.04,687.18]],[688.18," Nelle mani di quelli là dentro ha legato una ragazza a una sedia.",[688.18,688.58,688.86,689,689.28,689.46,689.86,690.06,690.48,690.64,691.15,691.3,691.46]],[692.36," È la stessa pietra.»",[692.36,692.5,692.62,692.9]]]},{"c":[[694.86,"Larsa la fissò a lungo.",[694.86,695.65,695.86,696.24,696.38]]]},{"c":[[698.44,"«E il vostro frammento, altezza?»",[698.44,698.58,698.72,699.04,699.7]],[700.46," chiese, piano.",[700.46,701.2]],[701.66," «Nelle mani di chi sta?»",[701.66,702.13,702.5,702.64,702.82]]]},{"c":[[703.54,"Ashe non rispose.",[703.54,704.5,704.7]],[705.55," Non subito.",[705.55,705.85]],[706.73," La mano le restò sul panno, ferma.",[706.73,706.94,707.2,707.36,707.64,707.84,708.56]]]},{"c":[[710.22,"«È quello che sto cercando di capire» disse.",[710.22,710.36,710.6,710.74,710.9,711.3,711.42,711.84]]]},{"c":[[714.24,"Vaan aveva seguito lo scambio con la fronte aggrottata.",[714.24,714.24,714.64,715.06,715.24,715.62,715.78,715.9,716.28]],[717.63," Non sembrava convinto.",[717.63,717.9,718.42]],[719.67," Guardò la pietra di Larsa, poi i pezzi della pietra di Mjrn nella mano di Fran, poi il frammento alla cintura di Ashe.",[719.67,720.14,720.28,720.64,720.76,721.52,721.84,721.98,722.32,722.52,722.86,723.05,723.42,723.82,724.06,724.22,725.14,725.47,725.68,726.2,726.3,726.72,726.9]]]},{"c":[[728.76,"«Speriamo che tu abbia ragione» disse alla fine.",[728.76,729.36,729.52,729.64,729.88,730.28,730.56,730.72]],[731.79," «Perché a me sembrano tutte uguali.»",[731.79,732.26,732.38,732.46,732.92,733.59]]]},{"c":[[736.92,"Più tardi, quando gli altri dormivano o fingevano di dormire, Penelo andò a sedersi accanto a Larsa, che non dormiva.",[736.92,737.29,737.9,738.37,738.55,738.85,739.44,739.51,740.17,740.36,741.48,741.95,742.25,742.39,742.83,743.19,743.43,744.25,744.53,744.72]],[746.01," Il principe stava seduto un po' fuori dal cerchio della luce, con la pietra ancora nel pugno, e guardava la miniera.",[746.01,746.01,746.35,746.71,747.17,747.35,747.49,747.89,748.09,748.47,748.73,749.5,749.77,749.91,750.23,750.51,750.75,751.66,751.81,752.25,752.39]]],"st":1},{"c":[[754.24,"Penelo non disse niente per un po'.",[754.24,755.08,755.35,755.65,756.09,756.29,756.43]],[757.12," Poi gli diede una gomitata, leggera.",[757.12,757.48,757.75,758.03,758.31,759.56]]]},{"c":[[761.08,"«Me la rendi, un giorno?»",[761.08,761.29,761.47,762.22,762.43]]]},{"c":[[764.02,"Larsa si voltò.",[764.02,764.44,764.65]],[765.91," «Cosa?»",[765.91]]]},{"c":[[767.12,"«La pietra.",[767.12,767.34]],[768.7," Quando non sarà più pericolosa.",[768.7,769.18,769.45,769.67,769.87]],[771.21," O quando sarai sicuro.»",[771.21,771.35,771.65,772]]]},{"c":[[773.5,"«Non so se sarà mai sicura.»",[773.5,773.86,774.48,774.69,774.91,775.18]]]},{"c":[[776.56,"«Allora tienila tu.»",[776.56,777.03,777.46]],[778.48," Penelo si strinse le ginocchia.",[778.48,779.32,779.53,779.83,779.97]],[780.99," «Basta che la tieni.",[780.99,781.39,781.55,781.67]],[782.76," È stato il primo regalo che mi ha fatto qualcuno che non conoscevo.",[782.76,782.91,783.09,783.23,783.49,783.87,783.99,784.09,784.19,784.37,784.81,784.95,785.11]],[786.18," Il primo dopo…",[786.18,786.39,786.69]],[787.27," dopo tanto tempo.",[787.27,787.61,787.99]],[789.17," A Rabanastre nessuno mi regala niente.",[789.17,789.17,790.18,790.71,790.87,791.28]],[792.22," Nessuno di loro, dico.»",[792.22,792.75,792.89,793.27]],[794.18," Indicò con il mento, vagamente, il nord, l'Impero, i soldati delle ronde.",[794.18,794.65,794.85,794.99,795.59,796.26,796.47,796.9,797.66,797.81,798.29,798.5]],[799.18," «Tu sì.»",[799.18,799.5]]]},{"c":[[801.71,"Larsa la guardò.",[801.71,801.99,802.11]],[802.96," Non disse niente.",[802.96,803.23,803.47]]]},{"c":[[804.84,"«Sai perché sono venuta?»",[804.84,805.11,805.43,805.72]],[806.47," disse Penelo.",[806.47,806.92]],[807.5," «Non ve l'ho mai detto.",[807.5,807.77,807.86,807.99,808.11]],[808.77," Vaan pensa che sono venuta per lui.",[808.77,809.29,809.63,809.79,810.01,810.33,810.53]],[811.24," Per tenerlo d'occhio.",[811.24,811.51,812.1]],[812.69," È vero, un po'.",[812.69,812.83,813.13,813.27]],[813.66," Ma non è per quello.»",[813.66,813.87,813.99,814.09,814.25]],[815.35," Fece una pausa.",[815.35,815.35,815.49]],[816.35," «I miei fratelli.",[816.35,816.49,816.71]],[817.7," Ne avevo due.",[817.7,817.91,818.18]],[818.74," Più grandi.",[818.74,819.02]],[820.06," Mi hanno insegnato a tirare di bastone quando avevo otto anni, perché dicevano che una ragazza della Città Bassa deve sapersi difendere.",[820.06,820.27,820.41,820.85,820.95,821.19,821.33,821.77,822.07,822.35,822.57,823,823.47,823.97,824.09,824.23,824.65,824.83,825.23,825.55,825.71,826.17]],[827.41," Sono morti nella guerra.",[827.41,827.41,827.75,827.91]],[828.49," Tutti e due.»",[828.49,828.93,829.07]],[829.84," Lo disse senza piangere, guardando la miniera.",[829.84,830.05,830.29,830.57,831.25,831.91,832.03]],[832.88," «E io ho pensato che se c'è un modo per non farne morire degli altri, di fratelli, voglio esserci.",[832.88,833.03,833.15,833.25,833.59,833.73,833.89,834.05,834.15,834.33,834.55,834.67,835.01,835.31,835.55,835.91,836.09,836.69,837.11]],[838.68," Anche se non so fare niente.",[838.68,838.68,838.89,839.05,839.19,839.44]],[840.23," Anche solo per portare le focacce.»",[840.23,840.63,840.91,841.11,841.53,841.68]]]},{"c":[[843.88,"Larsa rimase in silenzio a lungo.",[843.88,844.56,845.03,845.17,845.63,845.77]]]},{"c":[[847.28,"«Io ho un fratello» disse alla fine.",[847.28,847.62,847.83,847.93,848.83,849.23,849.49]]]},{"c":[[851.32,"«Lo so.»",[851.32,851.62]]]},{"c":[[852.86,"«Ne avevo tre, una volta.»",[852.86,853.07,853.94,854.51,854.79]],[855.6," Il principe guardava il pugno chiuso.",[855.6,855.81,856.27,856.79,856.93,857.36]],[858.2," «Adesso ne ho uno.»",[858.2,858.7,858.91,859.18]]]},{"c":[[860.34,"Penelo si voltò a guardarlo.",[860.34,860.81,860.99,861.29,861.41]],[862.97," Larsa non aggiunse altro, e lei non gli chiese niente.",[862.97,862.97,863.15,863.53,864.85,865.01,865.7,865.97,866.09,866.35]],[867.45," Restarono seduti così, uno accanto all'altra, fino a quando il fuoco non fu ridotto a un mucchio di braci; e quando Penelo, alla fine, si alzò per andare a dormire, Larsa aprì il pugno,",[867.45,868.11,868.51,869.74,870.32,871.14,872.09,872.35,872.49,873.26,873.47,873.87,874.14,874.36,875.21,875.35,875.51,875.91,876.14,877.47,877.61,877.98,878.63,878.95,879.87,880.03,880.37,880.55,880.85,881,882.02,882.75,883.09,883.26]],[884.17," guardò la pietra, e se la mise in tasca, nella tasca del petto, dove si tengono le cose che non si vogliono perdere.",[884.17,884.53,884.63,885.64,885.79,885.89,885.99,886.21,886.35,887.07,887.37,887.67,887.83,888.49,888.83,889.01,889.31,889.45,889.71,889.89,890.05,890.21,890.61]]]}]