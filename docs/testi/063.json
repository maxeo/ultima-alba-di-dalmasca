[{"h":1,"c":[[1.99,"Capitolo sessantatreesimo: La menzogna più gentile.",[1.99,3.11,4.67,4.75,5.42,5.79]]]},{"c":[[9.78,"Riportarono Mjrn a Eruyt in quattro giorni.",[9.78,11.01,11.46,11.61,12.39,12.6,12.92]],[13.96," Per i primi due camminò poco e dormì molto, sul chocobo, legata alla sella con una cinghia che Basch aveva ricavato dal suo stesso cinturone, e il chocobo,",[13.96,13.96,14.06,14.28,14.42,14.88,15.71,15.86,16.16,16.89,17.19,17.91,18.38,18.52,18.8,18.98,19.16,19.52,19.68,19.96,20.3,20.76,20.92,21.08,21.34,22.8,22.94,23.21]],[24.16," che fino a quel momento aveva tollerato soltanto Fran, la portò con un'attenzione così delicata che Penelo disse che sembrava una balia.",[24.16,24.16,24.36,24.46,24.56,24.96,25.28,25.74,26.18,26.95,27.16,27.48,27.62,28.18,28.52,29.04,29.18,29.5,30.23,30.64,31.24,31.47]],[32.45," Il terzo giorno Mjrn scese e volle camminare.",[32.45,32.66,32.92,33.61,34.07,34.49,34.64,34.84]],[36.16," Il quarto giorno parlava senza smettere.",[36.16,36.16,36.46,36.86,37.36,37.76]]]},{"c":[[40.13,"Parlava di tutto.",[40.13,40.66,40.8]],[41.74," Chiedeva a Vaan cosa fosse Rabanastre, e quanto fosse grande, e se fosse vero che gli Huma dormivano in case di pietra che non crescevano.",[41.74,42.1,42.15,42.34,42.62,42.98,44.38,44.55,45.05,45.51,46.7,46.84,47,47.42,47.79,48.06,48.21,48.42,48.98,49.12,49.34,49.5,50.07,50.34,50.61]],[51.98," Chiedeva a Penelo che sapore avesse il miele dei moguri, che lei non aveva mai assaggiato perché a Eruyt non lo si comprava, e Penelo le promise che glielo avrebbe fatto assaggiare al ritorno.",[51.98,52.34,52.46,52.78,52.92,53.24,53.54,53.64,53.82,53.98,54.84,55.12,55.3,55.46,55.76,55.96,56.58,57.01,57.08,57.44,57.62,57.74,57.88,58.91,59.06,59.52,59.66,59.96,60.16,60.36,60.6,60.86,61.38,61.52]],[62.76," Chiedeva a Larsa delle aeronavi.",[62.76,63.18,63.25,63.6,63.82]],[64.7," Chiedeva a Basch della sua cicatrice, e Basch le disse che era una storia lunga, e lei disse che aveva tempo, e lui non gliela raccontò lo stesso.",[64.7,65.3,65.36,65.68,65.94,66.25,67.5,67.58,67.98,68.14,68.84,69.12,69.28,69.42,69.81,70.86,71,71.2,72.1,72.38,72.72,73.8,73.94,74.12,74.3,74.54,75.06,75.23]],[76.52," A Balthier non chiedeva niente: lo guardava, e quando lui se ne accorgeva, distoglieva gli occhi e sorrideva, e Balthier, che di solito sapeva benissimo cosa fare quando una donna lo guardava così,",[76.52,76.57,76.94,77.14,77.5,78.38,78.52,79.36,79.5,79.72,79.96,80.14,80.35,81.06,81.86,82,82.32,82.53,83.95,84.07,85,85.28,85.4,85.72,86.1,86.66,86.92,87.26,87.56,87.76,88.02,88.14,88.54]],[89.62," per una volta non lo sapeva affatto, perché era evidente che la ragazza non guardava lui ma la sorella che gli camminava accanto.",[89.62,89.62,89.8,90.13,90.4,90.54,90.9,91.75,92.22,92.5,93.32,93.6,93.72,94.1,94.28,94.74,95.49,95.7,95.82,96.18,96.32,96.42,96.95]]]},{"c":[[98.86,"Fran non parlava.",[98.86,99.38,99.67]],[101.22," Camminava davanti, come sempre, e quando Mjrn le si affiancava rispondeva con le sue sillabe brevi, e Mjrn ne sembrava contenta lo stesso,",[101.22,101.22,101.76,102.1,103.23,103.38,103.81,104.1,104.28,104.42,105.04,105.66,105.84,105.96,106.12,106.58,107.34,107.41,107.72,107.88,108.44,109.02,109.14]],[110.26," come se anche le sillabe brevi fossero una risposta che a Eruyt non avrebbe mai avuto.",[110.26,110.26,110.42,110.64,110.78,111.14,111.48,111.86,112,112.48,112.73,112.92,113.84,114.12,114.48,114.81]]]},{"c":[[116.84,"Ashe le guardava dall'ultima fila.",[116.84,117.81,118.02,118.46,119.02]],[119.92," Una sera, accanto al fuoco, disse a Basch, senza girarsi: «Fran sa già cosa le dirà.»",[119.92,120.2,120.76,121.24,121.36,122.2,123.16,123.27,123.86,124.39,125.64,125.79,126,126.14,126.42,126.58]]]},{"c":[[128.45,"«A chi?»",[128.45,128.6]]]},{"c":[[129.25,"«Alla ragazza.",[129.25,130.13]],[131.1," Quando arriveremo.»",[131.1,131.32]],[132.46," Ashe non distolse lo sguardo dal fuoco.",[132.46,132.92,133.16,133.74,133.9,134.26,134.47]],[135.31," «Lo vedo da come cammina.",[135.31,135.52,135.78,135.9,136.21]],[136.99," Da Henne non ha più rallentato.",[136.99,137.21,137.76,138.04,138.16,138.32]],[139.47," Neppure quando Mjrn le parla del mondo fuori.»",[139.47,140,140.52,140.86,141.02,141.36,141.54,141.97]]]},{"c":[[143.96,"Basch non chiese come lo sapesse.",[143.96,144.3,144.48,144.86,145.08,145.2]],[146.39," Lo sapeva anche lui.",[146.39,146.6,147,147.22]]]},{"c":[[150.98,"Eruyt li accolse come la prima volta, cioè non li accolse affatto.",[150.98,151.64,151.85,152.33,152.59,152.77,153.09,154.11,154.67,154.95,155.09,155.62]],[156.83," La sentinella sul ramo sopra il banco dei moguri li guardò arrivare con lo stesso disprezzo tranquillo, ma quando vide Mjrn fra loro, viva,",[156.83,156.83,157.44,157.87,158.48,158.89,159.03,159.37,159.6,160.55,160.67,161.11,161.79,162.07,162.26,162.83,163.52,164.88,165.09,165.37,165.75,166.13,166.35,167.21]],[168.07," con il barattolo di miele che Penelo le aveva appena comprato al banco, si raddrizzò di colpo, e per un istante sul suo viso passò qualcosa che non era disprezzo.",[168.07,168.23,168.37,168.81,168.93,169.73,170.01,170.41,170.57,170.83,171.09,171.55,171.67,172.64,172.77,173.33,173.47,174.63,174.77,174.95,175.07,175.69,175.97,176.13,176.65,177.05,177.49,177.65,177.77,177.97]],[179.45," Poi sparì fra le foglie, e qualche minuto dopo, mentre la compagnia saliva per le passerelle, si sentì per tutto il villaggio un fischio lungo, di tre note, ripetuto da un albero all'altro,",[179.45,179.45,179.83,180.03,180.15,181.16,181.31,181.69,182.11,182.78,183.25,183.45,183.99,184.31,184.59,184.71,185.84,186.05,186.41,186.65,187.01,187.17,187.65,187.85,188.43,189.18,189.39,189.63,190.69,191.29,191.43,191.59,192.32]],[193.29," che annunciava qualcosa a qualcuno.",[193.29,193.29,193.79,194.36,194.51]]],"st":1},{"c":[[196.97,"Le viere uscirono sulle soglie.",[196.97,197.08,197.34,197.77,198.03]],[198.6," Questa volta non si voltarono dall'altra parte.",[198.6,199.07,199.53,199.81,199.97,200.47,200.97]]]},{"c":[[202.37,"Jote li aspettava sulla piattaforma più alta, davanti al grande tronco, ferma come l'avevano lasciata, e come se in tutti quei giorni non si fosse mai mossa.",[202.37,202.63,202.77,203.37,203.59,204.15,204.37,205.13,205.67,205.81,206.2,207.19,207.59,207.82,208.27,209.64,209.79,210.05,210.23,210.39,210.63,210.91,211.35,211.49,211.65,212,212.34]],[213.85," Dietro di lei c'erano altre due viere, con gli archi a tracolla.",[213.85,213.85,213.97,214.16,214.55,214.85,215.01,215.63,215.91,216.07,216.35,216.49]],[217.46," Quando Mjrn comparve in cima alla passerella, Jote non fece un passo.",[217.46,217.96,218.29,218.83,219.01,219.21,219.55,220.39,220.73,220.91,221.19,221.31]],[222.2," Ma chiuse gli occhi per il tempo di un respiro, e li riaprì.",[222.2,222.41,222.71,222.87,223.07,223.25,223.39,223.63,223.77,223.83,224.74,224.89,225.06]]]},{"c":[[227,"Le tre sorelle si guardarono.",[227,227.21,227.37,227.75,227.89]]]},{"c":[[229.31,"Non erano mai state tutte e tre insieme su quella piattaforma: Mjrn era nata molto dopo che Fran se n'era andata.",[229.31,229.59,229.89,230.17,230.51,230.79,230.93,230.99,231.39,231.59,231.77,232.91,233.33,233.49,233.71,233.91,234.21,234.39,234.64,234.76,235.01]],[236.66," Vaan guardò le tre facce, una accanto all'altra, la più vecchia, quella di mezzo, la più giovane, e pensò a una cosa stupida e precisa: pensò a tre ciotole della stessa misura,",[236.66,236.66,237.13,237.27,237.6,238.53,238.81,239.48,240.24,240.45,240.69,241.44,241.91,242.15,243,243.21,243.37,244.3,244.48,244.92,245.07,245.25,245.84,246.42,246.59,248,248.47,248.61,248.87,249.47,249.84,250.38]],[251.71," fatte dallo stesso vasaio, che uno trova in tre case diverse e solo mettendole in fila capisce che venivano dallo stesso forno.",[251.71,251.71,251.93,252.24,252.95,253.23,253.47,253.83,253.93,254.11,254.37,255.42,255.57,255.87,256.39,256.55,256.81,257.35,257.51,257.91,258.15,258.55]]]},{"c":[[260.54,"«Il Bosco mi ha detto cosa avete fatto» disse Jote.",[260.54,260.75,261.11,261.27,261.37,261.77,262.11,262.49,263.37,264.06]],[264.62," Non guardava Fran.",[264.62,264.89,265.59]],[266.25," Guardava Vaan.",[266.25,267.14]],[267.58," «Mi ha detto delle gallerie.",[267.58,267.79,267.89,268.23,268.57]],[269.27," Della pietra.",[269.27,269.8]],[270.31," Della bestia.»",[270.31,270.8]],[271.61," Fece una pausa.",[271.61,271.95,272.17]],[273.31," «Mi ha detto che una figlia del Bosco tornava a casa, e che a riportarla erano gli Huma.»",[273.31,273.31,273.43,273.73,273.91,274.11,274.47,274.65,275.09,275.67,275.81,276.49,276.63,276.75,276.85,277.79,278.2,278.61]]]},{"c":[[281.02,"Vaan non sapeva cosa rispondere.",[281.02,281.29,281.49,281.91,282.17]],[283.45," Disse: «Non c'è di che.»",[283.45,284.5,284.86,285.11,285.23]]]},{"c":[[285.91,"Jote fece un cenno.",[285.91,286.81,287.13,287.31]],[288.25," Una delle due viere dietro di lei venne avanti e porse al ragazzo qualcosa sul palmo aperto.",[288.25,288.53,288.77,288.97,289.37,289.79,289.91,290.11,290.43,291.23,291.39,291.79,291.95,292.41,292.95,293.19,293.52]],[294.87," Era una goccia di pietra verde, grande come un'unghia, liscia e trasparente, con dentro una luce piccola che si muoveva come una bolla d'aria in un'ampolla d'olio.",[294.87,294.87,295.09,295.45,295.59,295.99,296.88,297.35,297.77,298.6,299.09,299.29,300.62,300.89,301.19,301.41,301.71,302.5,302.77,302.97,303.41,303.67,303.89,304.23,304.56,304.83,306.05]],[306.73," Era appesa a un filo di fibra intrecciata.",[306.73,306.73,307.17,307.31,307.37,307.69,307.81,308.17]]]},{"c":[[310.22,"«La Lacrima di Lente» disse Jote.",[310.22,310.43,310.81,310.95,311.23,312.02]],[312.66," «Il Bosco la dà a chi ha il suo permesso.",[312.66,312.91,313.8,314.14,314.37,314.51,314.61,314.75,314.89,315.07]],[316.41," È antica.",[316.41,316.6]],[317.48," Più antica delle case di Eruyt.»",[317.48,317.9,319.47,319.69,320.03,320.43]],[321.42," Guardò la pietra nella mano di Vaan.",[321.42,321.89,322.04,322.51,322.73,322.97,323.43]],[324.35," «La barriera che vi ha respinti non l'abbiamo fatta noi.",[324.35,324.35,324.69,324.79,324.89,324.97,326.02,326.17,326.59,326.91]],[327.72," La giungla si chiude da sola davanti a chi non riconosce.",[327.72,327.93,328.25,328.39,328.63,328.77,329.01,329.37,329.47,329.57,329.71]],[330.58," Ma riconosce questa.",[330.58,330.79,331.25]],[332.38," Con la Lacrima, Golmore vi lascerà passare.",[332.38,332.65,332.77,333.24,333.71,333.85,334.15]],[335.75," Verso il vostro monte, verso le vostre guerre.",[335.75,335.75,335.93,336.37,337.29,337.69,337.89,338.31]],[339.41," Fuori di qui.»",[339.41,339.81,339.95]]]},{"c":[[342.38,"L'ultima frase la disse senza cattiveria, ma la disse.",[342.38,342.8,343.14,343.28,344.34,344.83,346.23,346.44,346.54]]]},{"c":[[347.69,"Vaan prese la Lacrima.",[347.69,348.62,349.02,349.16]],[350.21," Era tiepida.",[350.21,350.48]],[352.17," La guardò, la soppesò, e poi la porse a Penelo.",[352.17,352.38,353.35,353.56,354.96,355.1,355.33,355.49,355.88,356.1]]]},{"c":[[357.46,"«Tienila tu» disse.",[357.46,358.01,358.56]],[359.83," «Io perdo tutto.»",[359.83,360.04,360.36]]]},{"c":[[361.08,"Penelo la prese.",[361.08,361.94,362.06]],[363.24," Si sfilò dal collo il laccio di cuoio rimasto vuoto da quando Larsa le aveva ripreso la pietra, ci infilò la goccia verde e se lo rimise,",[363.24,363.24,363.52,363.7,364.02,364.14,364.44,364.54,364.82,365.18,365.5,365.62,365.92,366.18,366.28,366.58,366.98,367.14,368.01,368.14,368.52,368.64,368.92,369.84,369.98,370.08,370.18]],[371.22," e la Lacrima le cadde sul petto nel posto esatto dove prima stava l'altra.",[371.22,371.22,371.36,372.21,372.42,372.74,373.08,373.85,374.12,374.57,375.4,375.78,376.5,376.88]]]},{"c":[[378.83,"Penelo arrossì.",[378.83,379.3]],[380.15," Jote li guardò senza capire, e decise evidentemente che le usanze degli Huma non erano affar suo.",[380.15,380.64,380.78,381.1,381.37,382.34,382.48,382.88,383.58,383.74,383.84,384.18,384.62,384.97,385.24,385.54,385.78]]]},{"c":[[389.27,"Fu Mjrn a non lasciare che finisse lì.",[389.27,389.63,390.36,390.5,390.62,390.96,391.08,391.47]]],"st":1},{"c":[[392.69,"«E basta?»",[392.69,393.16]],[393.8," disse.",[393.8]]]},{"c":[[395.16,"Tutti si voltarono.",[395.16,395.56,395.73]],[397," La ragazza aveva fatto un passo avanti, fra Fran e Jote, e aveva le mani strette a pugno lungo i fianchi, e la voce le tremava appena,",[397,397,397.6,398,398.26,398.42,398.79,399.71,399.98,400.28,400.47,401.25,401.4,401.66,401.78,402.04,402.58,402.72,403.02,403.32,403.44,404.66,404.8,404.92,405.49,405.7,406.19]],[407.15," come quella di chi ha preparato un discorso per quattro giorni e adesso lo dice male.",[407.15,407.38,407.68,407.82,407.98,408.14,408.62,408.74,409.24,409.46,409.85,411,411.14,411.52,411.68,411.9]]]},{"c":[[413.63,"«Gli diamo una pietra e li mandiamo via.",[413.63,413.9,414.16,414.32,415.16,415.3,415.4,415.75]],[416.38," E poi torniamo a fare quello che facevamo.",[416.38,416.61,417.14,417.74,417.88,418.02,418.3,418.46]],[419.8," A stare sui rami.",[419.8,419.94,420.18,420.44]],[421.58," A sentire il Bosco e a dire che le cose degli Huma sono degli Huma.»",[421.58,421.72,422.14,422.36,422.78,422.92,423.02,423.33,423.6,423.72,423.98,424.34,424.63,424.92,425.29]],[425.58," Mjrn guardò Jote.",[425.58,425.87,427.09]],[427.9," «Io sono stata là fuori.",[427.9,427.9,428.08,428.28,428.42]],[429.43," Ho visto cosa fanno.",[429.43,429.64,429.86,430.1]],[431.3," Hanno preso una di noi e l'hanno legata a una sedia per vedere cosa succedeva.",[431.3,431.5,431.84,432.06,432.21,433,433.05,433.36,433.74,433.86,433.96,434.34,434.5,434.74,435.06]],[436.41," Domani ne prenderanno un'altra.",[436.41,437.05,437.26,438.3]],[438.96," Fra un anno verranno con il ferro fino a queste case.",[438.96,438.96,439.14,439.68,440.28,440.5,440.7,441.1,441.42,441.54,441.86]],[442.86," E noi staremo sui rami a dire che non ci riguarda.»",[442.86,443,443.16,443.63,443.9,444.22,444.36,444.54,444.74,444.94,445.1]]]},{"c":[[447.05,"«Non ci riguarda» disse Jote.",[447.05,447.32,447.58,448.58,449.62]]]},{"c":[[450.45,"«Ci riguarda!»",[450.45,451.04]],[452.08," Mjrn alzò la voce, e la piattaforma, dove forse nessuno aveva alzato la voce da cent'anni, la restituì dagli alberi intorno.",[452.08,452.6,452.94,453.08,453.56,453.7,453.8,454.78,455.18,455.63,456.18,456.58,456.94,457.06,457.36,457.57,458.41,458.62,459.2,459.46,459.82]],[460.77," «Il mondo sta cambiando.",[460.77,460.98,461.26,461.46]],[463.1," Lo sento.",[463.1,463.1]],[464.23," Lo sentivo prima di partire, e tu dicevi che sentivo male.",[464.23,464.54,465.08,465.38,465.58,466.98,467.17,467.49,467.96,468.12,468.66]],[469.43," Non sentivo male.",[469.43,469.78,470.4]],[471.53," Il Bosco ha paura.",[471.53,471.74,472.08,472.22]],[473.42," Il Bosco ha paura, Jote, e tu fai finta di non sentirlo, perché se lo senti devi fare qualcosa.»",[473.42,473.42,474.17,474.42,475.67,476.68,476.82,476.94,477.16,477.46,477.6,477.8,478.85,479.32,479.52,479.78,480.44,480.78,481.02]]]},{"c":[[483.26,"Jote non si mosse.",[483.26,483.66,483.8,483.98]]]},{"c":[[485.31,"«Il mondo fuori è degli Huma» disse.",[485.31,485.52,485.82,486.29,486.39,486.86,487.24]],[488.19," «Il Bosco è delle viere.",[488.19,488.52,489.52,489.66,489.9]],[490.84," È l'ordine.»",[490.84,491.06]]]},{"c":[[492.61,"«Allora io voglio vedere il mondo.»",[492.61,493.85,494.51,494.99,495.95,496.2]],[499.47," Mjrn lo disse tutto d'un fiato, e dopo averlo detto sembrò spaventata di averlo detto.",[499.47,499.47,499.68,499.9,500.3,500.54,501.9,502.04,502.26,502.56,502.82,503.21,504.25,504.46,504.78]],[506.33," «Voglio vedere le loro città.",[506.33,506.8,507.11,507.32,507.62]],[508.31," Le case di pietra.",[508.31,508.52,508.74,508.91]],[509.55," Le navi.",[509.55,509.9]],[510.89," Voglio sapere com'è.",[510.89,511.36,512.1]],[512.59," Voglio scegliere io.»",[512.59,513.06,513.61]],[514.45," Si voltò.",[514.45,514.7]],[516.07," «Come lei.»",[516.07,516.07]]]},{"c":[[517.9,"Guardava Fran.",[517.9,518.58]]]},{"c":[[520.22,"Tutti guardavano Fran.",[520.22,520.62,521.26]]]},{"c":[[522.39,"«Tu te ne sei andata» disse Mjrn.",[522.39,522.83,523.04,523.14,523.34,523.89,524.37]],[524.75," «Cinquant'anni fa.",[524.75,525.9]],[526.13," Tutti lo sanno, anche se non lo dice nessuno.",[526.13,526.54,526.72,527.27,527.68,527.82,527.92,528.04,528.24]],[529.01," Te ne sei andata e hai visto il mondo.",[529.01,529.22,529.32,529.5,530.27,530.42,530.52,530.74,530.86]],[531.67," Hai volato.",[531.67,531.94]],[532.67," Hai…»",[532.67]],[534.16," indicò vagamente Balthier, gli altri, la compagnia intera «…hai loro.",[534.16,534.16,535.13,535.99,536.26,537.09,537.3,538.17,538.88,539.16]],[539.49," Perché io no?",[539.49,539.99,540.2]],[540.55," Perché io devo restare qui?»",[540.55,541.05,541.26,541.5,541.88]]]},{"c":[[543.86,"Fran la guardò a lungo.",[543.86,544.2,544.34,544.68,544.82]],[545.96," Il suo viso era immobile come sempre, ma Balthier, che le stava due passi dietro, vide le sue orecchie, e le sue orecchie stavano ferme in un modo in cui non stavano mai,",[545.96,545.96,546.24,546.9,547.18,547.58,547.78,548.89,549.11,550,550.28,550.4,550.78,550.89,551.3,552.28,552.42,552.56,552.7,553.63,553.78,553.88,554.04,554.44,554.8,555.18,555.3,555.42,555.7,555.86,555.96,556.12,556.5]],[557.74," come se lei le tenesse ferme con uno sforzo.",[557.74,557.74,557.94,558.18,558.36,558.8,559.2,559.38,559.65]]]},{"c":[[562.56,"«Resta» disse Fran.",[562.56,562.96,563.24]]]},{"c":[[564.15,"Mjrn sbatté le palpebre.",[564.15,565.06,565.38,565.5]]]},{"c":[[567.15,"«Resta nel Bosco» disse Fran.",[567.15,567.56,567.82,568.22,568.38]],[569.24," «Lontano dagli Huma.",[569.24,569.68,570.31]],[570.82," Vivi con il Bosco.",[570.82,571.16,571.3,571.4]],[572.38," È il tuo posto.»",[572.38,572.52,572.64,572.75]]]},{"c":[[574.07,"«Ma tu…»",[574.07,574.93]]]},{"c":[[575.79,"«Io me ne sono andata.»",[575.79,576.45,576.66,576.76,576.92]],[579.46," La voce di Fran era piana, uguale, senza crepe.",[579.46,579.46,579.72,579.84,580.09,580.38,581.35,582.46,582.92]],[584.12," «E ho avuto il mondo.",[584.12,584.26,584.4,584.66,584.82]],[585.74," È vero.",[585.74,585.94]],[586.42," Ho avuto il cielo e le città e loro.»",[586.42,586.6,586.82,586.96,587.68,587.82,588,588.91,589.06]],[589.9," Non indicò nessuno.",[589.9,590.18,590.61]],[591.63," «E ho perso la casa.",[591.63,591.78,591.88,592.2,592.34]],[593.27," Ho perso le sorelle.",[593.27,593.48,593.86,593.98]],[594.76," Ho perso il Bosco.",[594.76,594.88,595.2,595.3]],[596.52," Non lo sento più.",[596.52,596.52,596.64,596.98]],[598.05," Mi parla e io non lo sento.",[598.05,598.34,599.44,599.59,599.8,599.98,600.3]],[601.35," Quando cammino nella giungla, adesso, è una giungla come un'altra.",[601.35,601.82,602.3,602.54,603.19,604.22,604.36,604.54,604.92,605.34]],[606.07," Alberi.",[606.07]],[606.93," Foglie.",[606.93]],[607.87," Niente.»",[607.87]],[608.96," Fece una pausa.",[608.96,609.3,609.56]],[610.51," «È questo che vuoi?»",[610.51,610.66,610.98,611.16]]]},{"c":[[612.95,"«Io…»",[612.95]]]},{"c":[[614.55,"«Lo vuoi davvero?»",[614.55,614.76,614.94]]]},{"c":[[616.78,"Mjrn aprì la bocca.",[616.78,617,617.2,617.32]],[618.1," Cercò qualcosa da dire, e non lo trovò, e allora disse l'unica cosa che le venne, la cosa che aveva detto nella sala della miniera, aprendo gli occhi.",[618.1,618.5,618.86,619,619.68,619.82,619.96,620.13,621.18,621.32,621.6,621.89,622.24,622.56,622.7,622.82,623.59,623.8,624.02,624.16,624.42,624.7,625,625.28,625.48,625.96,626.42,626.56]]]},{"c":[[628.63,"«Sorella…»",[628.63]]]},{"c":[[630.23,"«No.»",[630.23]]]},{"c":[[632.3,"Fran lo disse piano.",[632.3,632.67,632.88,633.08]],[634.07," Mjrn si fermò.",[634.07,634.87,635.08]]]},{"c":[[636.35,"«Non chiamarmi così» disse Fran.",[636.35,636.62,637.2,637.82,638.16]],[639.23," «Io ho lasciato il Bosco.",[639.23,639.44,639.58,639.94,640.04]],[641.01," Ho lasciato la sua legge.",[641.01,641.22,641.64,641.76,641.94]],[642.81," Per la legge, non sono più una viera.",[642.81,643.08,643.24,644,644.28,644.6,644.88,645.16]],[646.19," Non sono più tua sorella.»",[646.19,646.46,646.78,647.07,647.34]],[648.58," Indicò Jote con un piccolo gesto della testa, senza distogliere gli occhi da Mjrn.",[648.58,649.12,649.52,649.7,649.82,650.16,650.54,650.74,651.34,651.66,652.18,652.32,652.5,652.83]],[653.48," «Hai una sorella sola.",[653.48,653.68,653.84,654.18]],[655," È lei.",[655,655.14]],[655.8," Dimenticami.»",[655.8]]]},{"c":[[657.85,"Per un momento nessuno si mosse.",[657.85,658.12,658.24,659,659.54,659.74]],[660.92," Penelo si era portata le mani alla bocca.",[660.92,661.28,661.44,661.54,661.98,662.12,662.36,662.46]],[663.07," Vaan guardava Fran come se non l'avesse mai vista.",[663.07,663.56,663.98,664.36,664.7,664.86,665,665.34,665.46]],[666.52," Larsa aveva abbassato gli occhi.",[666.52,666.86,667.16,667.64,667.84]]]},{"c":[[669.74,"Mjrn non disse niente.",[669.74,670.71,670.98,671.22]],[672.37," Il viso le si contrasse; poi le lacrime arrivarono tutte insieme.",[672.37,672.58,672.92,672.98,673.18,674.35,675.05,675.26,675.68,676.28,676.48]],[677.76," Si voltò e corse lungo la passerella, giù per le scale scavate nella corteccia, verso le case più basse, finché sparì fra le foglie.",[677.76,677.76,678.75,678.9,679.26,679.54,679.66,680.71,680.98,681.12,681.24,681.46,681.86,682.1,682.96,683.36,683.48,683.68,683.86,684.72,685.48,685.88,686.08,686.22]],[686.82," Si sentì per un poco il suo pianto.",[686.82,687,687.4,687.6,687.74,688.45,688.66,688.84]],[689.59," Poi neanche quello.",[689.59,689.86,690.18]]]},{"c":[[692.62,"Fran non la richiamò.",[692.62,692.79,692.91,693.12]],[694.07," Non si mosse.",[694.07,694.34,694.51]],[695.5," Non disse un'altra parola.",[695.5,695.78,696.09,696.52]],[697.68," Rimase ferma in mezzo alla piattaforma, con le mani aperte lungo i fianchi, e guardò il punto dove la ragazza era scomparsa.",[697.68,698.1,698.5,698.64,698.92,699.09,700.18,700.38,700.48,700.68,701.08,701.36,701.42,702.41,702.56,702.94,703.04,703.32,703.58,703.72,704.16,704.39]]]},{"c":[[708.21,"Jote fece un cenno alle due viere con gli archi.",[708.21,708.47,708.75,708.91,709.15,709.29,709.43,709.63,709.79,709.93]],[710.58," Le due viere si allontanarono.",[710.58,710.79,710.95,711.19,711.33]],[712.72," Poi, senza che nessuno glielo chiedesse, anche gli altri si ritirarono verso il fondo della piattaforma, verso la passerella, ad aspettare: Ashe per prima, poi Basch, poi i tre ragazzi,",[712.72,713.61,714.01,714.19,714.53,714.79,715.83,716.05,716.21,716.53,716.71,717.29,717.49,717.61,717.85,718.03,718.97,719.21,719.37,720.4,720.61,721.59,722.03,722.21,722.95,723.3,723.87,724.02,724.07,724.32]],[725.51," che si mossero insieme senza parlarsi.",[725.51,725.51,725.67,726.15,726.61,727.05]],[727.96," Balthier rimase, ma più indietro, dove non poteva sentire se non voleva sentire.",[727.96,728.88,729.82,730.03,730.31,731.37,731.67,731.83,732.32,733.24,733.45,733.59,733.92]],[735.04," Vaan, che era rimasto per ultimo, si fermò accanto a lui.",[735.04,735.68,735.95,736.11,736.49,736.73,737.56,737.77,738.13,738.63,738.77]]],"st":1},{"c":[[740.21,"Sulla piattaforma più alta di Eruyt restarono le due sorelle più grandi.",[740.21,740.61,741.25,741.41,741.69,741.96,742.64,743.31,743.43,743.61,744.03,744.2]]]},{"c":[[745.78,"«Mi dispiace» disse Jote.",[745.78,745.99,746.53,747.42]],[748.13," «Che sia toccato a te.»",[748.13,748.41,748.61,749.05,749.19]]]},{"c":[[750.39,"«Non ti dispiacere.»",[750.39,750.67,750.81]],[751.84," Fran guardava ancora le foglie.",[751.84,752.25,752.85,753.11,753.25]],[754.06," «Dovevo essere io.",[754.06,754.53,754.88]],[755.79," Tu sei la legge.",[755.79,755.79,755.97,756.11]],[757.04," Se lo dici tu, è una regola.",[757.04,757.25,757.37,757.61,758.28,758.43,758.59]],[759.66," Se lo dico io, è la verità.»",[759.66,759.87,759.97,760.2,760.83,760.97,761.07]],[761.83," Fece una pausa.",[761.83,762.17,762.31]],[762.98," «Lei crede a me.",[762.98,763.25,763.57,763.67]],[764.1," Per questo.»",[764.1,764.37]]]},{"c":[[766.07,"Jote la guardò.",[766.07,766.47,766.72]],[767.67," Rimasero in silenzio a lungo.",[767.67,768.27,768.41,768.79,768.91]],[769.76," Il vento passava fra i rami del grande albero, e le foglie si muovevano, e la luce dorata cadeva sulla piattaforma a chiazze, e le chiazze si spostavano.",[769.76,769.97,770.33,770.75,770.91,771.05,771.25,771.43,771.71,772.61,772.75,772.85,773.21,773.41,774.49,774.63,774.71,774.95,775.39,775.81,776.03,776.66,776.72,777.55,777.69,777.81,778.25,778.48]]]},{"c":[[780.99,"«Jote» disse Fran.",[780.99,781.39,781.71]]]},{"c":[[782.98,"Era la prima volta che la chiamava per nome da quando era tornata.",[782.98,783.25,783.39,783.61,784.3,784.57,784.67,785.01,785.25,785.47,785.65,785.93,786.12]],[787.14," Jote non rispose, ma qualcosa nel suo modo di stare cambiò, come se si fosse preparata a ricevere un colpo.",[787.14,787.73,787.91,788.8,789.01,789.39,789.59,789.73,789.95,790.13,790.52,791.43,791.77,791.93,792.07,792.31,793.05,793.19,793.61,793.76]]]},{"c":[[795.73,"«Ascoltalo» disse Fran.",[795.73,796.49,796.63]],[797.6," «Per me.",[797.6,797.87]],[798.32," Una volta.»",[798.32,798.59]]]},{"c":[[799.73,"«Ascoltare cosa?»",[799.73,800.39]]]},{"c":[[802.31,"Fran esitò.",[802.31,802.87]],[803.93," Vaan, che la guardava da lontano, non l'aveva mai vista esitare.",[803.93,804.77,805.05,805.17,805.55,805.67,806.5,806.69,807.09,807.31,807.7]],[808.65," Fran non esitava.",[808.65,809.18,809.48]],[810.51," Fran decideva, e faceva, e diceva le cose in tre parole, e se le tre parole non bastavano non ne aggiungeva una quarta.",[810.51,810.77,811.63,811.84,812.75,812.89,813.25,813.37,813.65,813.83,813.95,814.81,814.95,815.11,815.25,815.39,815.73,815.95,816.77,817.05,817.19,817.71,817.87]],[818.89," Adesso stava ferma davanti alla sorella con la bocca socchiusa, e la frase non le veniva fuori.",[818.89,819.47,819.87,820.23,820.57,820.73,821.15,821.33,821.45,821.69,822.47,822.61,822.73,823.15,823.43,823.57,823.89]]]},{"c":[[825.38,"«Il Bosco» disse alla fine.",[825.38,825.59,825.97,826.21,826.37]],[827.44," «Mi odia?»",[827.44,827.65]]]},{"c":[[828.46,"Jote la guardò a lungo.",[828.46,829.27,829.37,830.13,830.27]],[830.96," Poi chiuse gli occhi e alzò le braccia, come la prima volta, con i palmi rivolti alle chiome.",[830.96,831.23,831.53,831.67,832.23,832.37,832.59,832.69,833.29,833.55,833.69,833.91,834.59,834.79,834.87,835.17,835.59,835.71]]]},{"c":[[837.52,"Il vento venne.",[837.52,837.73,838.03]],[838.98," Le foglie si sollevarono e cominciarono a girarle attorno, lente.",[838.98,839.19,839.51,839.69,840.88,841.03,841.61,841.75,842.27,843.21]],[844.04," La luce si fece più intensa.",[844.04,844.25,844.47,844.59,844.77,844.91]],[845.83," I capelli bianchi le si alzarono dalle spalle.",[845.83,845.97,846.23,846.65,846.79,846.91,847.35,847.57]],[848.93," Fran stava a tre passi e la guardava, e non respirava.",[848.93,848.93,849.27,849.41,849.75,850.75,850.89,851.09,852.85,852.99,853.35]]]},{"c":[[855.43,"Durò poco.",[855.43,855.77]],[856.56," Il vento cadde.",[856.56,856.77,857.09]],[857.94," Le foglie si posarono sul legno, una alla volta.",[857.94,858.15,858.43,858.57,859.05,859.23,859.94,860.21,860.47]],[861.05," Jote abbassò le braccia e aprì gli occhi.",[861.05,861.51,861.87,861.99,862.59,862.73,863.01,863.11]]]},{"c":[[865.1,"«No» disse.",[865.1,865.59]],[866.48," «Non ti odia.»",[866.48,866.75,867.09]],[867.75," Fece una pausa.",[867.75,868.09,868.29]],[868.82," «Gli manchi.",[868.82,869.09]],[869.7," Ti cerca.",[869.7,869.91]],[870.63," Vuole che torni.»",[870.63,871.03,871.26]]]},{"c":[[872.57,"Fran rimase immobile.",[872.57,872.94,873.41]],[874.46," Poi le si mosse l'angolo della bocca.",[874.46,874.73,874.96,875.17,875.46,875.87,876.07]],[877.27," Non era un sorriso vero; era il principio di un sorriso, piccolo, storto, che non arrivò mai agli occhi.",[877.27,877.27,877.55,877.73,878.17,878.89,879.17,879.31,879.75,879.93,880.16,881.08,882.48,883.25,883.53,883.69,884.03,884.29,884.51]]]},{"c":[[885.92,"«Che bella bugia» disse.",[885.92,886.19,886.49,887]]]},{"c":[[888.05,"Jote non la smentì.",[888.05,888.89,889.09,889.26]]]},{"c":[[890.89,"Fran si voltò per andarsene.",[890.89,891.23,891.39,891.69,891.85]],[892.71," Fece due passi verso la passerella.",[892.71,893.05,893.23,893.57,893.81,893.95]],[894.75," Jote parlò alle sue spalle.",[894.75,895.07,895.45,895.59,895.73]]]},{"c":[[897.29,"«Stai attenta» disse.",[897.29,897.66,898.43]],[899.26," «Il Bosco è geloso.",[899.26,899.49,899.9,900.12]],[900.85," Degli Huma che ti hanno portata via.»",[900.85,901.24,901.55,901.67,901.77,901.89,902.25]]]},{"c":[[903.51,"Fran si fermò.",[903.51,904.08,904.33]],[905.38," Non si girò del tutto; voltò appena la testa, quanto bastava perché Jote le vedesse il profilo.",[905.38,905.65,905.83,906.13,906.4,907.25,907.65,908.03,908.31,908.78,909.25,909.73,910.16,910.45,910.59,910.99,911.13]]]},{"c":[[912.83,"«Ormai» disse «sono come loro.»",[912.83,913.23,914.49,914.87,915.25]]]},{"c":[[917.15,"Poi, più piano, una parola sola, in una lingua che nessuno degli altri capì e che non era la lingua comune, né il viera antico che Larsa aveva studiato, ma qualcosa di più semplice e di più vecchio,",[917.15,917.15,917.49,918.24,918.51,918.97,919.98,920.19,920.37,920.69,920.85,921.31,921.55,921.97,922.55,922.69,922.81,922.96,923.23,923.43,923.82,924.84,925.05,925.19,925.43,925.87,926.05,926.35,926.73,927.8,928.01,928.45,928.63,928.87,929.73,929.87,930.01,930.21]],[931.57," una parola che si dice sulla soglia di casa, la sera, quando si esce.",[931.57,931.57,931.89,932.07,932.21,932.45,932.71,933.03,933.17,933.96,934.19,934.79,935.11,935.37]],[935.89," Jote la ascoltò.",[935.89,936.41,936.67]],[937.51," Non rispose.",[937.51,937.79]]]},{"c":[[939.59,"Fran attraversò la piattaforma.",[939.59,940.1,940.83,940.95]],[942.23," Passò accanto a Balthier senza guardarlo, e lui si mise al suo fianco, alla distanza di sempre.",[942.23,942.63,943.01,943.07,943.53,943.87,945.02,945.17,945.38,945.59,945.81,945.95,946.12,947.03,947.19,947.61,947.73]],[948.65," Vaan li seguì.",[948.65,949.26,949.47]],[950.47," Scesero insieme per la passerella, verso gli altri, verso il villaggio, verso la giungla.",[950.47,950.89,951.23,951.43,951.57,952.38,952.79,952.95,953.64,954.05,954.17,955.14,955.55,955.73]]]},{"c":[[957.37,"Jote rimase sola sulla piattaforma più alta di Eruyt.",[957.37,957.77,958.21,958.51,958.79,959.37,959.53,959.85,960.27]],[961.32," Non li richiamò.",[961.32,961.6,961.81]],[962.88," Non si mosse finché non furono spariti fra gli alberi.",[962.88,963.15,963.33,963.69,963.99,964.17,964.51,964.97,965.17,965.31]],[966.33," E quando furono spariti, si sedette sul ramo basso dietro di sé, quello dove una volta una ragazza con un arco veniva a sedersi per ore, dicendo che il Bosco le raccontava le storie; e restò lì,",[966.33,966.33,966.57,966.91,968.06,968.27,968.67,968.87,969.11,969.45,969.81,969.96,970.52,970.99,971.21,971.41,971.67,971.85,972.35,972.53,972.65,972.95,973.27,973.39,973.81,973.97,974.74,975.27,975.43,975.55,975.91,976.03,976.49,976.63,977.5,977.65,977.95]],[978.81," con le mani in grembo, fino a sera.",[978.81,978.81,978.95,979.27,979.48,980.43,980.77,980.89]]]},{"c":[[985.45,"La barriera era dove l'avevano lasciata, fra le due radici grandi come mura di città, con la sua rete di fili azzurri che si muovevano piano e il suo ronzio che si sentiva nei denti.",[985.45,985.66,986.64,986.92,987.19,987.74,988.73,989,989.16,989.32,989.79,990.42,990.76,991.04,991.27,992.08,992.2,992.32,992.52,992.86,993.03,993.37,994.07,994.34,994.52,995.06,995.91,996.06,996.24,996.59,997.28,997.56,997.76,998.24,998.54]],[1000.25," Penelo si avvicinò con la Lacrima al collo, un po' incerta, come chi entra in una stanza dove non è sicuro di essere stato invitato.",[1000.25,1000.58,1000.74,1001.18,1001.32,1001.42,1001.76,1001.96,1002.73,1002.94,1003.12,1003.86,1004.2,1004.36,1004.66,1004.78,1004.94,1005.34,1005.54,1005.7,1005.82,1006.2,1006.32,1006.56,1006.84]]],"st":1},{"c":[[1008.97,"La luce si spense.",[1008.97,1009.18,1009.48,1009.69]],[1011.78," Non si dissolse e non si aprì: si spense, come si spegne una lampada, tutta in una volta, e dove c'era la rete adesso c'era la strada di pietra antica, verde di muschio, che continuava verso est,",[1011.78,1011.78,1012.02,1013.01,1013.16,1013.32,1013.5,1014.21,1014.51,1015.32,1015.66,1015.87,1016.34,1016.52,1017.44,1017.84,1017.98,1018.12,1019.13,1019.28,1019.83,1020.37,1020.68,1021.33,1022.18,1022.74,1022.93,1023.4,1023.6,1024.19,1025.19,1025.6,1025.76,1026.72,1027,1027.56,1028.06]],[1029.3," nel cuore di Golmore, verso le montagne e la neve e il monte sacro.",[1029.3,1029.3,1029.58,1029.7,1030.45,1030.86,1031,1031.6,1031.74,1031.82,1032.13,1032.28,1032.34,1032.69]]]},{"c":[[1034.54,"Nessuno disse niente per un po'.",[1034.54,1035.08,1035.32,1035.68,1035.86,1036.29]],[1036.82," Poi Vaan, che camminava accanto a Fran, si schiarì la gola.",[1036.82,1037.15,1037.58,1037.84,1038.3,1038.7,1038.8,1039.43,1039.64,1039.96,1040.1]]]},{"c":[[1042.08,"«Fran.»",[1042.08]]]},{"c":[[1043.3,"Lei non si voltò.",[1043.3,1043.58,1043.76,1044.02]]]},{"c":[[1045.99,"«Mi dispiace» disse lui.",[1045.99,1046.28,1046.95,1047.4]],[1048.37," «Per prima.",[1048.37,1048.64]],[1049.4," Per lassù.",[1049.4,1049.8]],[1050.52," Per tua sorella.»",[1050.52,1050.8,1051.28]],[1052.24," Esitò.",[1052.24]],[1052.95," «E per la domanda.",[1052.95,1053.1,1053.26,1053.4]],[1054.2," Quella degli anni.",[1054.2,1054.58,1054.82]],[1055.61," Mi dispiace anche per quella.»",[1055.61,1055.84,1056.44,1056.68,1057.49]]]},{"c":[[1059.02,"Fran camminò per un tratto senza rispondere.",[1059.02,1059.36,1059.74,1059.9,1060.02,1060.36,1060.6]],[1061.92," Poi, senza girarsi, gli mise una mano sulla testa, una volta, sui capelli in disordine, e la tolse.",[1061.92,1062.54,1062.98,1063.87,1064.14,1064.36,1064.52,1064.7,1065.02,1065.63,1065.9,1066.56,1066.84,1067.16,1067.32,1068.24,1068.38,1068.58]]]},{"c":[[1070.84,"Vaan non disse più niente fino a sera, e quella sera, accanto al fuoco, fu lui a passare a Fran la parte più grande.",[1070.84,1071.46,1071.74,1072.06,1072.28,1072.64,1072.88,1073,1073.89,1074.04,1074.42,1075,1075.54,1075.71,1076.61,1076.82,1077.12,1077.26,1077.64,1077.71,1077.99,1078.2,1078.48,1078.68]]]}]