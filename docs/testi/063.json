[{"h":1,"c":[[1.99,"Capitolo sessantatreesimo: La menzogna più gentile.",[1.99,2.83,4.5,4.73,5.42,5.79]]]},{"c":[[9.74,"Riportarono Mjrn a Eruyt in quattro giorni.",[9.74,11.03,11.5,11.64,12.39,12.6,12.92]],[13.96," Per i primi due camminò poco e dormì molto, sul chocobo, legata alla sella con una cinghia che Basch aveva ricavato dal suo stesso cinturone, e il chocobo,",[13.96,13.96,14.06,14.26,14.42,14.88,15.71,15.86,16.16,16.89,17.19,17.91,18.38,18.52,18.8,18.98,19.16,19.52,19.68,19.96,20.3,20.76,20.92,21.08,21.34,22.8,22.94,23.21]],[24.16," che fino a quel momento aveva tollerato soltanto Fran, la portò con un'attenzione così delicata che Penelo disse che sembrava una balia.",[24.16,24.16,24.36,24.46,24.56,24.96,25.28,25.74,26.18,26.95,27.16,27.48,27.62,28.2,28.52,29.04,29.18,29.5,30.23,30.64,31.24,31.47]],[32.45," Il terzo giorno Mjrn scese e volle camminare.",[32.45,32.66,32.9,33.6,34.07,34.51,34.66,34.84]],[36.16," Il quarto giorno parlava senza smettere.",[36.16,36.16,36.48,36.84,37.36,37.78]]]},{"c":[[40.66,"Parlava di tutto.",[40.66,40.66,40.82]],[41.5," Chiedeva a Vaan cosa fosse Rabanastre, e quanto fosse grande, e se fosse vero che gli Huma dormivano in case di pietra che non crescevano.",[41.5,42.04,42.11,42.38,42.64,42.98,44.41,44.56,45.05,45.47,46.71,46.86,47,47.48,47.82,48,48.18,48.42,48.98,49.12,49.34,49.5,50.09,50.36,50.63]],[52.34," Chiedeva a Penelo che sapore avesse il miele dei moguri, che lei non aveva mai assaggiato perché a Eruyt non lo si comprava, e Penelo le promise che glielo avrebbe fatto assaggiare al ritorno.",[52.34,52.34,52.46,52.76,52.92,53.24,53.56,53.64,53.82,53.98,54.84,55.12,55.3,55.46,55.78,55.96,56.58,57.01,57.08,57.44,57.62,57.74,57.88,58.93,59.08,59.52,59.66,59.98,60.16,60.34,60.6,60.86,61.38,61.52]],[62.76," Chiedeva a Larsa delle aeronavi.",[62.76,63.22,63.36,63.6,63.82]],[64.7," Chiedeva a Basch della sua cicatrice, e Basch le disse che era una storia lunga, e lei disse che aveva tempo, e lui non gliela raccontò lo stesso.",[64.7,65.3,65.36,65.66,65.94,66.23,67.5,67.57,67.94,68.12,68.84,69.12,69.28,69.42,69.83,70.86,71,71.22,72.1,72.38,72.72,73.8,73.94,74.12,74.3,74.56,75.06,75.25]],[76.5," A Balthier non chiedeva niente: lo guardava, e quando lui se ne accorgeva, distoglieva gli occhi e sorrideva, e Balthier, che di solito sapeva benissimo cosa fare quando una donna lo guardava così,",[76.5,76.55,76.94,77.14,77.48,78.38,78.52,79.36,79.5,79.72,79.96,80.16,80.35,81.06,81.86,82,82.32,82.53,83.95,84.07,85,85.28,85.4,85.72,86.12,86.66,86.92,87.26,87.56,87.76,88.02,88.14,88.56]],[89.64," per una volta non lo sapeva affatto, perché era evidente che la ragazza non guardava lui ma la sorella che gli camminava accanto.",[89.64,89.64,89.8,90.13,90.4,90.54,90.9,91.75,92.22,92.5,93.32,93.6,93.72,94.1,94.28,94.74,95.49,95.7,95.82,96.16,96.32,96.42,96.92]]]},{"c":[[98.86,"Fran non parlava.",[98.86,99.38,99.67]],[100.76," Camminava davanti, come sempre, e quando Mjrn le si affiancava rispondeva con le sue sillabe brevi, e Mjrn ne sembrava contenta lo stesso,",[100.76,101.22,101.96,102.12,103.22,103.36,103.79,104.08,104.28,104.4,105.04,105.66,105.82,105.96,106.12,106.58,107.34,107.41,107.72,107.88,108.44,109.02,109.14]],[110.07," come se anche le sillabe brevi fossero una risposta che a Eruyt non avrebbe mai avuto.",[110.07,110.26,110.4,110.64,110.78,111.16,111.48,111.86,112,112.48,112.73,112.92,113.84,114.12,114.48,114.81]]]},{"c":[[116.84,"Ashe le guardava dall'ultima fila.",[116.84,117.81,118.02,118.46,119.02]],[119.94," Una sera, accanto al fuoco, disse a Basch, senza girarsi: «Fran sa già cosa le dirà.»",[119.94,120.22,120.96,121.24,121.36,122.2,123.16,123.29,123.94,124.37,125.62,125.79,126,126.14,126.42,126.58]]]},{"c":[[128.49,"«A chi?»",[128.49,128.64]]]},{"c":[[129.28,"«Alla ragazza.",[129.28,130.13]],[130.9," Quando arriveremo.»",[130.9,131.32]],[132.46," Ashe non distolse lo sguardo dal fuoco.",[132.46,132.92,133.13,133.7,133.88,134.26,134.47]],[135.31," «Lo vedo da come cammina.",[135.31,135.52,135.78,135.9,136.21]],[136.99," Da Henne non ha più rallentato.",[136.99,137.21,137.76,138.04,138.16,138.32]],[139.47," Neppure quando Mjrn le parla del mondo fuori.»",[139.47,140,140.5,140.84,141.04,141.36,141.54,142]]]},{"c":[[143.94,"Basch non chiese come lo sapesse.",[143.94,144.34,144.5,144.86,145.08,145.2]],[146.39," Lo sapeva anche lui.",[146.39,146.6,147,147.2]]]},{"c":[[150.97,"Eruyt li accolse come la prima volta, cioè non li accolse affatto.",[150.97,151.64,151.85,152.33,152.59,152.77,153.09,154.11,154.67,154.95,155.09,155.62]],[156.83," La sentinella sul ramo sopra il banco dei moguri li guardò arrivare con lo stesso disprezzo tranquillo, ma quando vide Mjrn fra loro, viva,",[156.83,156.83,157.44,157.85,158.48,158.89,159.03,159.37,159.6,160.59,160.67,161.11,161.79,162.07,162.26,162.83,163.52,164.88,165.09,165.37,165.75,166.13,166.35,167.23]],[168.23," con il barattolo di miele che Penelo le aveva appena comprato al banco, si raddrizzò di colpo, e per un istante sul suo viso passò qualcosa che non era disprezzo.",[168.23,168.23,168.37,168.81,168.93,169.73,170.01,170.41,170.57,170.83,171.09,171.55,171.69,172.64,172.85,173.33,173.47,174.63,174.77,174.95,175.05,175.69,175.97,176.13,176.65,177.05,177.49,177.65,177.77,177.97]],[179.45," Poi sparì fra le foglie, e qualche minuto dopo, mentre la compagnia saliva per le passerelle, si sentì per tutto il villaggio un fischio lungo, di tre note, ripetuto da un albero all'altro,",[179.45,179.45,179.83,180.03,180.15,181.16,181.31,181.69,182.11,182.78,183.25,183.45,183.99,184.31,184.59,184.71,185.84,186.05,186.41,186.67,187.01,187.17,187.65,187.83,188.43,189.18,189.39,189.65,190.69,191.29,191.43,191.59,192.32]],[193.29," che annunciava qualcosa a qualcuno.",[193.29,193.29,193.79,194.36,194.51]]],"st":1},{"c":[[196.97,"Le viere uscirono sulle soglie.",[196.97,197.08,197.34,197.77,198.03]],[198.62," Questa volta non si voltarono dall'altra parte.",[198.62,199.09,199.53,199.81,199.97,200.47,200.97]]]},{"c":[[202.37,"Jote li aspettava sulla piattaforma più alta, davanti al grande tronco, ferma come l'avevano lasciata, e come se in tutti quei giorni non si fosse mai mossa.",[202.37,202.77,202.89,203.37,203.59,204.15,204.35,205.13,205.67,205.81,206.18,207.25,207.59,207.82,208.27,209.64,209.79,210.03,210.23,210.39,210.63,210.91,211.35,211.49,211.65,212,212.34]],[213.51," Dietro di lei c'erano altre due viere, con gli archi a tracolla.",[213.51,213.85,213.95,214.15,214.55,214.85,215.01,215.66,215.93,216.07,216.35,216.45]],[217.55," Quando Mjrn comparve in cima alla passerella, Jote non fece un passo.",[217.55,217.98,218.27,218.83,219.03,219.21,219.55,220.39,220.73,220.91,221.19,221.31]],[222.18," Ma chiuse gli occhi per il tempo di un respiro, e li riaprì.",[222.18,222.39,222.71,222.87,223.09,223.25,223.39,223.63,223.77,223.83,224.72,224.87,225.01]]]},{"c":[[227,"Le tre sorelle si guardarono.",[227,227.21,227.37,227.75,227.89]]]},{"c":[[229.34,"Non erano mai state tutte e tre insieme su quella piattaforma: Mjrn era nata molto dopo che Fran se n'era andata.",[229.34,229.61,229.89,230.17,230.51,230.79,230.93,230.99,231.39,231.59,231.77,232.91,233.33,233.49,233.71,233.91,234.21,234.39,234.64,234.76,235.01]],[236.68," Vaan guardò le tre facce, una accanto all'altra, la più vecchia, quella di mezzo, la più giovane, e pensò a una cosa stupida e precisa: pensò a tre ciotole della stessa misura,",[236.68,236.68,237.15,237.27,237.6,238.53,238.81,239.48,240.24,240.45,240.69,241.44,241.91,242.15,243,243.21,243.37,244.3,244.5,244.92,245.07,245.25,245.84,246.42,246.59,247.98,248.47,248.61,248.87,249.47,249.83,250.38]],[251.71," fatte dallo stesso vasaio, che uno trova in tre case diverse e solo mettendole in fila capisce che venivano dallo stesso forno.",[251.71,251.71,251.93,252.24,252.95,253.23,253.47,253.83,253.93,254.11,254.37,255.42,255.57,255.87,256.39,256.53,256.81,257.35,257.51,257.91,258.15,258.53]]]},{"c":[[260.54,"«Il Bosco mi ha detto cosa avete fatto» disse Jote.",[260.54,260.75,261.11,261.27,261.37,261.77,262.11,262.49,263.35,264.05]],[264.62," Non guardava Fran.",[264.62,264.89,265.59]],[266.25," Guardava Vaan.",[266.25,267.14]],[267.58," «Mi ha detto delle gallerie.",[267.58,267.79,267.89,268.23,268.57]],[269.27," Della pietra.",[269.27,269.8]],[270.31," Della bestia.»",[270.31,270.78]],[271.61," Fece una pausa.",[271.61,271.95,272.17]],[273.31," «Mi ha detto che una figlia del Bosco tornava a casa, e che a riportarla erano gli Huma.»",[273.31,273.31,273.43,273.73,273.93,274.11,274.47,274.65,275.09,275.67,275.81,276.49,276.63,276.75,276.85,277.81,278.17,278.39]]]},{"c":[[281.04,"Vaan non sapeva cosa rispondere.",[281.04,281.31,281.51,281.91,282.17]],[283.45," Disse: «Non c'è di che.»",[283.45,284.5,284.86,285.11,285.23]]]},{"c":[[285.91,"Jote fece un cenno.",[285.91,286.81,287.13,287.31]],[288.25," Una delle due viere dietro di lei venne avanti e porse al ragazzo qualcosa sul palmo aperto.",[288.25,288.53,288.77,288.97,289.37,289.79,289.91,290.11,290.43,291.23,291.39,291.79,291.95,292.41,292.95,293.19,293.52]],[294.87," Era una goccia di pietra verde, grande come un'unghia, liscia e trasparente, con dentro una luce piccola che si muoveva come una bolla d'aria in un'ampolla d'olio.",[294.87,294.87,295.09,295.45,295.59,295.99,296.86,297.33,297.75,298.6,299.09,299.29,300.6,300.87,301.19,301.41,301.71,302.5,302.77,302.97,303.41,303.67,303.87,304.22,304.57,304.84,306.06]],[306.73," Era appesa a un filo di fibra intrecciata.",[306.73,306.73,307.17,307.29,307.37,307.69,307.83,308.17]]]},{"c":[[310.22,"«La Lacrima di Lente» disse Jote.",[310.22,310.43,310.81,310.95,311.23,312.02]],[312.66," «Il Bosco la dà a chi ha il suo permesso.",[312.66,312.93,313.8,314.14,314.37,314.51,314.61,314.75,314.89,315.07]],[316.41," È antica.",[316.41,316.6]],[317.52," Più antica delle case di Eruyt.»",[317.52,317.88,319.47,319.69,320.04,320.44]],[321.44," Guardò la pietra nella mano di Vaan.",[321.44,321.91,322.05,322.51,322.73,322.97,323.44]],[324.37," «La barriera che vi ha respinti non l'abbiamo fatta noi.",[324.37,324.37,324.69,324.79,324.89,324.97,326,326.16,326.59,326.91]],[327.72," La giungla si chiude da sola davanti a chi non riconosce.",[327.72,327.93,328.25,328.39,328.63,328.75,329.03,329.37,329.47,329.57,329.71]],[330.58," Ma riconosce questa.",[330.58,330.79,331.25]],[332.38," Con la Lacrima, Golmore vi lascerà passare.",[332.38,332.65,332.77,333.24,333.71,333.85,334.15]],[335.41," Verso il vostro monte, verso le vostre guerre.",[335.41,335.81,335.93,336.37,337.37,337.77,337.89,338.31]],[339.41," Fuori di qui.»",[339.41,339.81,339.95]]]},{"c":[[342.36,"L'ultima frase la disse senza cattiveria, ma la disse.",[342.36,342.8,343.14,343.28,344.32,344.83,346.23,346.44,346.54]]]},{"c":[[347.69,"Vaan prese la Lacrima.",[347.69,348.62,349.02,349.16]],[350.26," Era tiepida.",[350.26,350.48]],[352.15," La guardò, la soppesò, e poi la porse a Penelo.",[352.15,352.36,353.35,353.56,354.96,355.1,355.36,355.56,355.88,356.02]]]},{"c":[[357.58,"«Tienila tu» disse.",[357.58,358.03,358.58]],[359.83," «Io perdo tutto.»",[359.83,360.04,360.36]]]},{"c":[[361.47,"Penelo la prese.",[361.47,361.94,362.08]],[363.22," Si sfilò dal collo il laccio di cuoio rimasto vuoto da quando Larsa le aveva ripreso la pietra, ci infilò la goccia verde e se lo rimise,",[363.22,363.22,363.54,363.7,364.02,364.14,364.44,364.54,364.82,365.18,365.5,365.62,365.92,366.18,366.28,366.58,366.98,367.14,368.01,368.14,368.52,368.64,368.92,369.84,369.98,370.08,370.2]],[371.22," e la Lacrima le cadde sul petto nel posto esatto dove prima stava l'altra.",[371.22,371.22,371.36,372.23,372.44,372.74,373.1,373.85,374.12,374.57,375.38,375.76,376.5,376.88]]]},{"c":[[378.83,"Penelo arrossì.",[378.83,379.3]],[380.15," Jote li guardò senza capire, e decise evidentemente che le usanze degli Huma non erano affar suo.",[380.15,380.64,380.78,381.1,381.37,382.36,382.5,382.86,383.58,383.74,383.84,384.18,384.62,384.97,385.24,385.51,385.79]]]},{"c":[[389.52,"Fu Mjrn a non lasciare che finisse lì.",[389.52,389.8,390.36,390.5,390.62,390.96,391.08,391.47]]],"st":1},{"c":[[392.69,"«E basta?»",[392.69,392.88]],[393.82," disse.",[393.82]]]},{"c":[[395.1,"Tutti si voltarono.",[395.1,395.5,395.71]],[397," La ragazza aveva fatto un passo avanti, fra Fran e Jote, e aveva le mani strette a pugno lungo i fianchi, e la voce le tremava appena,",[397,397,397.6,398,398.26,398.42,398.79,399.73,400.11,400.62,400.75,401.25,401.4,401.66,401.78,402.04,402.58,402.72,403.02,403.3,403.4,404.66,404.8,404.94,405.49,405.7,406.19]],[407.38," come quella di chi ha preparato un discorso per quattro giorni e adesso lo dice male.",[407.38,407.38,407.68,407.82,407.98,408.16,408.62,408.74,409.24,409.46,409.85,411,411.14,411.52,411.68,411.92]]]},{"c":[[413.61,"«Gli diamo una pietra e li mandiamo via.",[413.61,413.88,414.16,414.32,415.16,415.3,415.4,415.75]],[416.38," E poi torniamo a fare quello che facevamo.",[416.38,416.61,417.14,417.74,417.88,418.02,418.3,418.46]],[419.8," A stare sui rami.",[419.8,419.94,420.18,420.44]],[421.56," A sentire il Bosco e a dire che le cose degli Huma sono degli Huma.»",[421.56,421.7,422.14,422.36,422.78,422.92,423.02,423.33,423.6,423.72,424,424.36,424.64,424.93,425.28]],[425.57," Mjrn guardò Jote.",[425.57,425.85,427.09]],[427.92," «Io sono stata là fuori.",[427.92,427.92,428.08,428.28,428.42]],[429.43," Ho visto cosa fanno.",[429.43,429.64,429.86,430.1]],[431.1," Hanno preso una di noi e l'hanno legata a una sedia per vedere cosa succedeva.",[431.1,431.5,431.82,432.06,432.21,433,433.05,433.36,433.74,433.84,433.96,434.34,434.48,434.74,435.06]],[436.41," Domani ne prenderanno un'altra.",[436.41,437.05,437.26,438.3]],[438.96," Fra un anno verranno con il ferro fino a queste case.",[438.96,438.96,439.14,439.7,440.3,440.5,440.7,441.1,441.42,441.56,441.88]],[442.84," E noi staremo sui rami a dire che non ci riguarda.»",[442.84,442.98,443.16,443.61,443.88,444.19,444.34,444.54,444.74,444.94,445.26]]]},{"c":[[447.06,"«Non ci riguarda» disse Jote.",[447.06,447.34,447.72,448.58,449.63]]]},{"c":[[450.47,"«Ci riguarda!»",[450.47,451.18]],[452.13," Mjrn alzò la voce, e la piattaforma, dove forse nessuno aveva alzato la voce da cent'anni, la restituì dagli alberi intorno.",[452.13,452.6,452.94,453.08,453.56,453.7,453.8,454.8,455.18,455.63,456.18,456.58,456.94,457.06,457.36,457.58,458.48,458.62,459.2,459.46,459.82]],[460.77," «Il mondo sta cambiando.",[460.77,460.98,461.26,461.46]],[463.1," Lo sento.",[463.1,463.1]],[464.23," Lo sentivo prima di partire, e tu dicevi che sentivo male.",[464.23,464.54,465.08,465.38,465.58,466.98,467.17,467.49,467.96,468.12,468.66]],[469.43," Non sentivo male.",[469.43,469.78,470.42]],[471.53," Il Bosco ha paura.",[471.53,471.74,472.08,472.22]],[473.42," Il Bosco ha paura, Jote, e tu fai finta di non sentirlo, perché se lo senti devi fare qualcosa.»",[473.42,473.42,474.19,474.48,475.7,476.68,476.82,476.94,477.16,477.46,477.6,477.8,478.85,479.32,479.52,479.76,480.44,480.78,481.02]]]},{"c":[[483.24,"Jote non si mosse.",[483.24,483.64,483.8,483.98]]]},{"c":[[485.31,"«Il mondo fuori è degli Huma» disse.",[485.31,485.52,485.82,486.29,486.39,486.86,487.24]],[488.21," «Il Bosco è delle viere.",[488.21,488.5,489.52,489.66,489.9]],[490.84," È l'ordine.»",[490.84,491.05]]]},{"c":[[492.59,"«Allora io voglio vedere il mondo.»",[492.59,493.87,494.51,494.99,495.95,496.2]],[498.49," Mjrn lo disse tutto d'un fiato, e dopo averlo detto sembrò spaventata di averlo detto.",[498.49,499.45,499.66,499.9,500.31,500.56,501.9,502.04,502.26,502.58,502.82,503.21,504.25,504.46,504.78]],[506.33," «Voglio vedere le loro città.",[506.33,506.8,507.12,507.32,507.62]],[508.31," Le case di pietra.",[508.31,508.52,508.74,508.91]],[509.55," Le navi.",[509.55,509.9]],[510.89," Voglio sapere com'è.",[510.89,511.36,512.11]],[512.61," Voglio scegliere io.»",[512.61,513.08,513.59]],[514.45," Si voltò.",[514.45,514.7]],[516.09," «Come lei.»",[516.09,516.09]]]},{"c":[[517.9,"Guardava Fran.",[517.9,518.6]]]},{"c":[[520.22,"Tutti guardavano Fran.",[520.22,520.62,521.28]]]},{"c":[[522.39,"«Tu te ne sei andata» disse Mjrn.",[522.39,522.83,523.04,523.14,523.34,523.89,524.37]],[524.75," «Cinquant'anni fa.",[524.75,525.9]],[526.13," Tutti lo sanno, anche se non lo dice nessuno.",[526.13,526.54,526.7,527.27,527.68,527.82,527.94,528.04,528.24]],[529.01," Te ne sei andata e hai visto il mondo.",[529.01,529.22,529.32,529.48,530.27,530.42,530.52,530.74,530.86]],[531.67," Hai volato.",[531.67,531.94]],[532.67," Hai…»",[532.67]],[534.2," indicò vagamente Balthier, gli altri, la compagnia intera «…hai loro.",[534.2,534.2,535.31,536.31,536.58,537.65,537.86,538.45,539.59,539.9]],[540.73," Perché io no?",[540.73,541.2,541.4]],[541.52," Perché io devo restare qui?»",[541.52,541.89,542.01,542.25,542.35]]]},{"c":[[542.86,"Fran la guardò a lungo.",[542.86,543.25,543.46,543.8,543.94]],[545.04," Il suo viso era immobile come sempre, ma Balthier, che le stava due passi dietro, vide le sue orecchie, e le sue orecchie stavano ferme in un modo in cui non stavano mai,",[545.04,545.04,545.32,545.97,546.24,546.64,546.86,547.93,548.16,549.07,549.34,549.46,549.86,549.94,550.34,551.34,551.48,551.64,551.78,552.7,552.84,552.96,553.1,553.52,553.86,554.24,554.38,554.48,554.76,554.92,555.04,555.18,555.59]],[556.82," come se lei le tenesse ferme con uno sforzo.",[556.82,556.82,557,557.26,557.42,557.86,558.26,558.44,558.73]]]},{"c":[[561.54,"«Resta» disse Fran.",[561.54,561.94,562.3]]]},{"c":[[563.16,"Mjrn sbatté le palpebre.",[563.16,564.02,564.46,564.58]]]},{"c":[[566.24,"«Resta nel Bosco» disse Fran.",[566.24,566.64,566.86,567.26,567.46]],[568.34," «Lontano dagli Huma.",[568.34,568.76,569.39]],[569.9," Vivi con il Bosco.",[569.9,570.24,570.38,570.48]],[571.44," È il tuo posto.»",[571.44,571.58,571.7,571.86]]]},{"c":[[573.15,"«Ma tu…»",[573.15,573.41]]]},{"c":[[574.87,"«Io me ne sono andata.»",[574.87,575.53,575.74,575.82,576]],[578.54," La voce di Fran era piana, uguale, senza crepe.",[578.54,578.54,578.8,578.92,579.26,579.46,580.43,581.51,582]],[583.2," «E ho avuto il mondo.",[583.2,583.34,583.48,583.74,583.9]],[584.84," È vero.",[584.84,585.02]],[585.49," Ho avuto il cielo e le città e loro.»",[585.49,585.7,585.9,586.02,586.75,586.9,587.08,588,588.14]],[589," Non indicò nessuno.",[589,589.28,589.69]],[590.7," «E ho perso la casa.",[590.7,590.84,590.96,591.28,591.42]],[592.37," Ho perso le sorelle.",[592.37,592.58,592.92,593.04]],[593.73," Ho perso il Bosco.",[593.73,593.94,594.28,594.38]],[595.6," Non lo sento più.",[595.6,595.6,595.72,596.04]],[597.11," Mi parla e io non lo sento.",[597.11,597.42,598.51,598.67,598.88,599.06,599.39]],[600.43," Quando cammino nella giungla, adesso, è una giungla come un'altra.",[600.43,600.9,601.38,601.62,602.27,603.3,603.44,603.62,604,604.42]],[605.15," Alberi.",[605.15]],[605.99," Foglie.",[605.99]],[606.95," Niente.»",[606.95]],[608.02," Fece una pausa.",[608.02,608.36,608.63]],[609.58," «È questo che vuoi?»",[609.58,609.72,610.06,610.24]]]},{"c":[[612.01,"«Io…»",[612.01]]]},{"c":[[613.65,"«Lo vuoi davvero?»",[613.65,613.86,614.02]]]},{"c":[[615.86,"Mjrn aprì la bocca.",[615.86,616.08,616.28,616.38]],[617.15," Cercò qualcosa da dire, e non lo trovò, e allora disse l'unica cosa che le venne, la cosa che aveva detto nella sala della miniera, aprendo gli occhi.",[617.15,617.56,617.92,618.08,618.75,618.9,619.04,619.18,620.24,620.38,620.68,620.97,621.32,621.62,621.76,621.88,622.67,622.88,623.1,623.24,623.5,623.78,624.06,624.36,624.56,625.04,625.48,625.64]]]},{"c":[[627.69,"«Sorella…»",[627.69]]]},{"c":[[629.27,"«No.»",[629.27]]]},{"c":[[631.38,"Fran lo disse piano.",[631.38,631.73,631.94,632.16]],[633.15," Mjrn si fermò.",[633.15,633.95,634.16]]]},{"c":[[635.43,"«Non chiamarmi così» disse Fran.",[635.43,635.7,636.28,636.9,637.24]],[638.31," «Io ho lasciato il Bosco.",[638.31,638.52,638.64,639.02,639.12]],[640.07," Ho lasciato la sua legge.",[640.07,640.28,640.72,640.84,641.01]],[641.87," Per la legge, non sono più una viera.",[641.87,642.14,642.32,643.07,643.34,643.68,643.97,644.24]],[645.25," Non sono più tua sorella.»",[645.25,645.52,645.86,646.14,646.42]],[647.7," Indicò Jote con un piccolo gesto della testa, senza distogliere gli occhi da Mjrn.",[647.7,648.24,648.6,648.78,648.9,649.24,649.6,649.82,650.34,650.74,651.26,651.4,651.58,651.9]],[652.54," «Hai una sorella sola.",[652.54,652.74,652.9,653.24]],[654.08," È lei.",[654.08,654.22]],[654.88," Dimenticami.»",[654.88]]]},{"c":[[656.93,"Per un momento nessuno si mosse.",[656.93,657.2,657.32,658.07,658.6,658.8]],[659.96," Penelo si era portata le mani alla bocca.",[659.96,660.34,660.5,660.62,661.06,661.18,661.42,661.54]],[662.14," Vaan guardava Fran come se non l'avesse mai vista.",[662.14,662.62,663.04,663.44,663.78,663.92,664.06,664.4,664.52]],[665.6," Larsa aveva abbassato gli occhi.",[665.6,665.94,666.24,666.7,666.92]]]},{"c":[[669.02,"Mjrn non disse niente.",[669.02,669.76,670.04,670.28]],[671.45," Il viso le si contrasse; poi le lacrime arrivarono tutte insieme.",[671.45,671.66,671.98,672.06,672.26,673.4,674.13,674.34,674.74,675.34,675.54]],[676.82," Si voltò e corse lungo la passerella, giù per le scale scavate nella corteccia, verso le case più basse, finché sparì fra le foglie.",[676.82,676.82,677.84,677.98,678.34,678.62,678.74,679.76,680.04,680.18,680.36,680.54,680.92,681.18,682.01,682.42,682.56,682.76,682.96,683.63,684.56,684.96,685.14,685.28]],[685.87," Si sentì per un poco il suo pianto.",[685.87,686.08,686.46,686.68,686.78,687.53,687.74,687.9]],[688.64," Poi neanche quello.",[688.64,688.92,689.26]]]},{"c":[[691.59,"Fran non la richiamò.",[691.59,691.86,692.06,692.24]],[693.14," Non si mosse.",[693.14,693.42,693.6]],[694.59," Non disse un'altra parola.",[694.59,694.86,695.16,695.59]],[696.63," Rimase ferma in mezzo alla piattaforma, con le mani aperte lungo i fianchi, e guardò il punto dove la ragazza era scomparsa.",[696.63,697.18,697.58,697.76,698,698.17,699.17,699.44,699.56,699.74,700.16,700.42,700.5,701.5,701.64,702,702.12,702.4,702.64,702.78,703.24,703.48]]]},{"c":[[707.13,"Jote fece un cenno alle due viere con gli archi.",[707.13,707.53,707.83,707.97,708.19,708.37,708.49,708.71,708.85,709.01]],[709.64," Le due viere si allontanarono.",[709.64,709.85,710.01,710.25,710.41]],[711.8," Poi, senza che nessuno glielo chiedesse, anche gli altri si ritirarono verso il fondo della piattaforma, verso la passerella, ad aspettare: Ashe per prima, poi Basch, poi i tre ragazzi,",[711.8,712.69,713.09,713.25,713.61,713.87,714.91,715.13,715.29,715.59,715.77,716.35,716.55,716.69,716.93,717.11,718.09,718.29,718.43,719.59,719.69,720.66,721.09,721.27,722.03,722.38,722.97,723.09,723.13,723.39]],[724.59," che si mossero insieme senza parlarsi.",[724.59,724.59,724.75,725.23,725.71,726.11]],[727.02," Balthier rimase, ma più indietro, dove non poteva sentire se non voleva sentire.",[727.02,727.94,728.9,729.11,729.37,730.49,730.75,730.91,731.38,732.3,732.51,732.67,732.99]],[734.1," Vaan, che era rimasto per ultimo, si fermò accanto a lui.",[734.1,734.74,735.01,735.19,735.57,735.79,736.64,736.85,737.21,737.69,737.84]]],"st":1},{"c":[[739.26,"Sulla piattaforma più alta di Eruyt restarono le due sorelle più grandi.",[739.26,739.67,740.31,740.47,740.75,741.03,741.73,742.39,742.51,742.69,743.11,743.28]]]},{"c":[[744.84,"«Mi dispiace» disse Jote.",[744.84,745.05,745.61,746.49]],[747.2," «Che sia toccato a te.»",[747.2,747.47,747.67,748.13,748.27]]]},{"c":[[749.48,"«Non ti dispiacere.»",[749.48,749.75,749.87]],[750.99," Fran guardava ancora le foglie.",[750.99,751.33,751.93,752.17,752.33]],[753.12," «Dovevo essere io.",[753.12,753.59,753.94]],[754.87," Tu sei la legge.",[754.87,754.87,755.05,755.19]],[756.12," Se lo dici tu, è una regola.",[756.12,756.33,756.45,756.69,757.35,757.49,757.67]],[758.74," Se lo dico io, è la verità.»",[758.74,758.95,759.05,759.28,759.88,760.03,760.13]],[760.91," Fece una pausa.",[760.91,761.25,761.39]],[762.06," «Lei crede a me.",[762.06,762.33,762.65,762.73]],[763.18," Per questo.»",[763.18,763.45]]]},{"c":[[765.14,"Jote la guardò.",[765.14,765.55,765.8]],[766.75," Rimasero in silenzio a lungo.",[766.75,767.35,767.47,767.85,767.99]],[768.82," Il vento passava fra i rami del grande albero, e le foglie si muovevano, e la luce dorata cadeva sulla piattaforma a chiazze, e le chiazze si spostavano.",[768.82,769.03,769.41,769.81,769.99,770.13,770.33,770.49,770.77,771.66,771.81,771.91,772.29,772.47,773.55,773.69,773.79,774.03,774.47,774.89,775.11,775.72,775.77,776.63,776.77,776.87,777.33,777.54]]]},{"c":[[780.07,"«Jote» disse Fran.",[780.07,780.47,780.79]]]},{"c":[[782.03,"Era la prima volta che la chiamava per nome da quando era tornata.",[782.03,782.31,782.45,782.67,783.36,783.63,783.75,784.09,784.31,784.53,784.71,784.99,785.18]],[786.2," Jote non rispose, ma qualcosa nel suo modo di stare cambiò, come se si fosse preparata a ricevere un colpo.",[786.2,786.79,786.97,787.88,788.09,788.47,788.65,788.81,789.03,789.21,789.6,790.51,790.85,790.99,791.15,791.39,792.13,792.27,792.67,792.88]]]},{"c":[[794.79,"«Ascoltalo» disse Fran.",[794.79,795.45,795.71]],[796.65," «Per me.",[796.65,796.93]],[797.38," Una volta.»",[797.38,797.65]]]},{"c":[[798.81,"«Ascoltare cosa?»",[798.81,799.51]]]},{"c":[[801.51,"Fran esitò.",[801.51,801.99]],[803.02," Vaan, che la guardava da lontano, non l'aveva mai vista esitare.",[803.02,803.86,804.13,804.25,804.63,804.75,805.58,805.77,806.17,806.37,806.77]],[807.71," Fran non esitava.",[807.71,808.25,808.56]],[809.89," Fran decideva, e faceva, e diceva le cose in tre parole, e se le tre parole non bastavano non ne aggiungeva una quarta.",[809.89,809.89,810.71,810.88,811.83,811.97,812.33,812.45,812.71,812.87,813.01,813.88,814.03,814.17,814.31,814.47,814.81,815.01,815.86,816.13,816.27,816.79,816.95]],[818.52," Adesso stava ferma davanti alla sorella con la bocca socchiusa, e la frase non le veniva fuori.",[818.52,818.52,818.93,819.31,819.65,819.81,820.21,820.41,820.53,820.89,821.55,821.69,821.79,822.24,822.51,822.65,822.97]]]},{"c":[[824.46,"«Il Bosco» disse alla fine.",[824.46,824.67,825.03,825.29,825.47]],[826.56," «Mi odia?»",[826.56,826.77]]]},{"c":[[827.54,"Jote la guardò a lungo.",[827.54,828.31,828.45,829.21,829.35]],[830.03," Poi chiuse gli occhi e alzò le braccia, come la prima volta, con i palmi rivolti alle chiome.",[830.03,830.31,830.59,830.73,831.31,831.45,831.65,831.75,832.29,832.63,832.77,832.97,833.58,833.85,833.95,834.23,834.65,834.77]]]},{"c":[[836.6,"Il vento venne.",[836.6,836.81,837.11]],[838.06," Le foglie si sollevarono e cominciarono a girarle attorno, lente.",[838.06,838.27,838.57,838.77,839.97,840.11,840.67,840.81,841.36,842.31]],[843.12," La luce si fece più intensa.",[843.12,843.33,843.53,843.65,843.85,843.99]],[844.88," I capelli bianchi le si alzarono dalle spalle.",[844.88,845.03,845.31,845.71,845.87,845.99,846.43,846.65]],[847.68," Fran stava a tre passi e la guardava, e non respirava.",[847.68,847.95,848.35,848.49,848.81,849.81,849.95,850.19,851.9,852.05,852.38]]]},{"c":[[854.53,"Durò poco.",[854.53,854.81]],[855.64," Il vento cadde.",[855.64,855.85,856.15]],[857.02," Le foglie si posarono sul legno, una alla volta.",[857.02,857.23,857.51,857.65,858.11,858.29,859.05,859.27,859.49]],[860.1," Jote abbassò le braccia e aprì gli occhi.",[860.1,860.59,860.95,861.05,861.64,861.79,862.05,862.19]]]},{"c":[[864.16,"«No» disse.",[864.16,864.64]],[865.56," «Non ti odia.»",[865.56,865.83,866.17]],[866.83," Fece una pausa.",[866.83,867.17,867.35]],[867.89," «Gli manchi.",[867.89,868.17]],[868.76," Ti cerca.",[868.76,868.97]],[869.71," Vuole che torni.»",[869.71,870.11,870.33]]]},{"c":[[871.63,"Fran rimase immobile.",[871.63,872,872.47]],[873.53," Poi le si mosse l'angolo della bocca.",[873.53,873.81,874.02,874.23,874.53,874.95,875.15]],[876.36," Non era un sorriso vero; era il principio di un sorriso, piccolo, storto, che non arrivò mai agli occhi.",[876.36,876.36,876.63,876.81,877.25,877.98,878.25,878.37,878.81,879.01,879.22,880.13,881.56,882.34,882.61,882.77,883.11,883.35,883.59]]]},{"c":[[884.98,"«Che bella bugia» disse.",[884.98,885.25,885.57,886.07]]]},{"c":[[887.12,"Jote non la smentì.",[887.12,887.97,888.15,888.32]]]},{"c":[[889.97,"Fran si voltò per andarsene.",[889.97,890.31,890.45,890.75,890.93]],[891.79," Fece due passi verso la passerella.",[891.79,892.13,892.29,892.65,892.89,893.01]],[893.81," Jote parlò alle sue spalle.",[893.81,894.13,894.51,894.67,894.79]]]},{"c":[[896.37,"«Stai attenta» disse.",[896.37,896.74,897.5]],[898.32," «Il Bosco è geloso.",[898.32,898.57,898.99,899.2]],[899.9," Degli Huma che ti hanno portata via.»",[899.9,900.26,900.55,900.73,900.85,900.97,901.34]]]},{"c":[[902.57,"Fran si fermò.",[902.57,903.16,903.4]],[904.44," Non si girò del tutto; voltò appena la testa, quanto bastava perché Jote le vedesse il profilo.",[904.44,904.71,904.89,905.21,905.47,906.33,906.73,907.09,907.38,907.84,908.31,908.79,909.25,909.55,909.67,910.07,910.21]]]},{"c":[[911.9,"«Ormai» disse «sono come loro.»",[911.9,912.31,913.57,913.95,914.33]]]},{"c":[[916.22,"Poi, più piano, una parola sola, in una lingua che nessuno degli altri capì e che non era la lingua comune, né il viera antico che Larsa aveva studiato, ma qualcosa di più semplice e di più vecchio,",[916.22,916.22,916.57,917.3,917.57,918.03,919.06,919.27,919.43,919.75,919.93,920.39,920.63,921.03,921.61,921.75,921.87,922.03,922.29,922.49,922.9,923.9,924.11,924.27,924.51,924.95,925.12,925.41,925.81,926.86,927.07,927.53,927.71,927.95,928.81,928.95,929.09,929.29]],[930.65," una parola che si dice sulla soglia di casa, la sera, quando si esce.",[930.65,930.65,930.97,931.13,931.29,931.51,931.77,932.09,932.25,933.02,933.27,933.91,934.19,934.43]],[935.02," Jote la ascoltò.",[935.02,935.61,935.77]],[936.69," Non rispose.",[936.69,936.85]]]},{"c":[[938.91,"Fran attraversò la piattaforma.",[938.91,939.25,939.89,940.01]],[941.39," Passò accanto a Balthier senza guardarlo, e lui si mise al suo fianco, alla distanza di sempre.",[941.39,941.71,942.07,942.13,942.61,942.93,944.09,944.23,944.44,944.65,944.87,945.01,945.2,945.91,946.25,946.67,946.79]],[947.72," Vaan li seguì.",[947.72,948.34,948.55]],[949.97," Scesero insieme per la passerella, verso gli altri, verso il villaggio, verso la giungla.",[949.97,949.97,950.29,950.51,950.63,951.47,951.87,952.03,952.73,953.13,953.25,954.23,954.63,954.81]]]},{"c":[[956.45,"Jote rimase sola sulla piattaforma più alta di Eruyt.",[956.45,956.85,957.29,957.57,957.85,958.45,958.61,958.91,959.33]],[960.39," Non li richiamò.",[960.39,960.67,960.87]],[961.96," Non si mosse finché non furono spariti fra gli alberi.",[961.96,962.23,962.41,962.77,963.05,963.23,963.59,964.05,964.23,964.37]],[965.39," E quando furono spariti, si sedette sul ramo basso dietro di sé, quello dove una volta una ragazza con un arco veniva a sedersi per ore, dicendo che il Bosco le raccontava le storie; e restò lì,",[965.39,965.39,965.65,965.99,967.12,967.33,967.73,967.93,968.21,968.53,968.87,969.02,969.58,970.05,970.29,970.49,970.73,970.93,971.43,971.61,971.73,972.03,972.35,972.45,972.87,973.05,973.82,974.35,974.49,974.61,974.97,975.09,975.55,975.69,976.57,976.71,976.99]],[977.87," con le mani in grembo, fino a sera.",[977.87,977.87,978.07,978.35,978.56,979.49,979.85,979.99]]]},{"c":[[984.51,"La barriera era dove l'avevano lasciata, fra le due radici grandi come mura di città, con la sua rete di fili azzurri che si muovevano piano e il suo ronzio che si sentiva nei denti.",[984.51,984.72,985.73,986,986.27,986.82,987.81,988.08,988.22,988.39,988.86,989.5,989.84,990.12,990.36,991,991.28,991.4,991.6,991.94,992.11,992.45,993.14,993.42,993.58,994.12,995.01,995.16,995.3,995.65,996.37,996.64,996.82,997.32,998.18]],[999.66," Penelo si avvicinò con la Lacrima al collo, un po' incerta, come chi entra in una stanza dove non è sicuro di essere stato invitato.",[999.66,999.66,999.8,1000.24,1000.4,1000.5,1000.84,1001.01,1001.79,1002,1002.22,1002.92,1003.26,1003.44,1003.72,1003.84,1004.02,1004.4,1004.62,1004.76,1004.9,1005.26,1005.38,1005.64,1005.92]]],"st":1},{"c":[[1008.03,"La luce si spense.",[1008.03,1008.24,1008.54,1008.75]],[1010.86," Non si dissolse e non si aprì: si spense, come si spegne una lampada, tutta in una volta, e dove c'era la rete adesso c'era la strada di pietra antica, verde di muschio, che continuava verso est,",[1010.86,1010.86,1011.1,1012.1,1012.24,1012.4,1012.58,1013.27,1013.57,1014.4,1014.74,1014.95,1015.42,1015.6,1016.51,1016.92,1017.06,1017.2,1018.22,1018.36,1018.91,1019.47,1019.76,1020.43,1021.25,1021.8,1022.01,1022.48,1022.67,1023.25,1024.26,1024.66,1024.84,1025.8,1026.08,1026.64,1027.14]],[1028.36," nel cuore di Golmore, verso le montagne e la neve e il monte sacro.",[1028.36,1028.36,1028.64,1028.78,1029.52,1029.92,1030.08,1030.67,1030.82,1030.88,1031.21,1031.36,1031.4,1031.76]]]},{"c":[[1033.61,"Nessuno disse niente per un po'.",[1033.61,1034.14,1034.4,1034.76,1034.96,1035.43]],[1035.88," Poi Vaan, che camminava accanto a Fran, si schiarì la gola.",[1035.88,1036.21,1036.64,1036.9,1037.38,1037.78,1037.86,1038.49,1038.7,1039.04,1039.18]]]},{"c":[[1041.02,"«Fran.»",[1041.02]]]},{"c":[[1042.38,"Lei non si voltò.",[1042.38,1042.66,1042.84,1043.1]]]},{"c":[[1044.89,"«Mi dispiace» disse lui.",[1044.89,1045.1,1046.04,1046.48]],[1047.42," «Per prima.",[1047.42,1047.7]],[1048.56," Per lassù.",[1048.56,1048.86]],[1049.64," Per tua sorella.»",[1049.64,1049.86,1050.06]],[1051.32," Esitò.",[1051.32]],[1052.04," «E per la domanda.",[1052.04,1052.18,1052.34,1052.46]],[1053.28," Quella degli anni.",[1053.28,1053.64,1053.88]],[1054.67," Mi dispiace anche per quella.»",[1054.67,1054.92,1055.52,1055.74,1055.96]]]},{"c":[[1058.12,"Fran camminò per un tratto senza rispondere.",[1058.12,1058.46,1058.82,1058.98,1059.1,1059.42,1059.68]],[1060.98," Poi, senza girarsi, gli mise una mano sulla testa, una volta, sui capelli in disordine, e la tolse.",[1060.98,1061.62,1062.06,1062.98,1063.26,1063.44,1063.6,1063.78,1064.13,1064.7,1064.98,1065.61,1065.88,1066.24,1066.4,1067.32,1067.46,1067.65]]]},{"c":[[1069.9,"Vaan non disse più niente fino a sera, e quella sera, accanto al fuoco, fu lui a passare a Fran la parte più grande.",[1069.9,1070.54,1070.82,1071.14,1071.36,1071.72,1071.95,1072.1,1072.97,1073.12,1073.5,1074.08,1074.62,1074.78,1075.67,1075.9,1076.21,1076.36,1076.72,1076.79,1077.08,1077.28,1077.56,1077.76]]]}]