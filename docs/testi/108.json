[{"h":1,"c":[[1.48,"Capitolo centoottesimo: L'ultimo desiderio.",[1.48,2.47,4.07,4.93]]]},{"c":[[8.07,"Gli anelli rallentavano.",[8.07,8.35,9.21]],[11.11," Dalla cima della torre lo si vedeva bene: i grandi cerchi di luce che giravano attorno alle torri di Bahamut, quelli che fino a un momento prima avevano girato con la regolarità di una macina,",[11.11,11.11,11.45,11.77,12.48,12.69,12.83,13.19,14.03,14.17,14.51,14.89,15.01,15.29,15.47,16.01,16.45,16.63,16.97,17.29,18.08,18.55,18.71,18.99,19.11,19.19,19.51,20.18,20.71,21.15,21.33,21.49,22.07,22.25,22.46]],[24.09," adesso andavano a scatti, come una ruota di carro con un raggio rotto, e a ogni scatto la luce si faceva più fioca.",[24.09,24.09,24.59,24.73,25.61,25.95,26.17,26.49,26.61,26.96,27.23,27.39,27.72,28.53,28.67,28.79,28.93,29.37,29.53,29.8,30.01,30.35,30.61]],[31.81," Sotto i loro piedi la piattaforma si inclinò, poi tornò dritta, poi si inclinò di nuovo, un poco di più.",[31.81,31.81,31.91,32.09,33.08,33.29,33.88,34.09,35.2,35.47,35.88,36.94,37.22,37.43,37.75,37.85,38.72,38.93,39.13,39.29]]]},{"c":[[40.7,"«Sta perdendo quota» disse Balthier.",[40.7,40.97,41.39,42.32,42.88]],[43.76," «Lo sento nelle ginocchia.»",[43.76,43.97,44.27,44.49]]]},{"c":[[46.36,"«Quanto?»",[46.36]]]},{"c":[[48.58,"«Abbastanza.»",[48.58]],[50.4," Si girò verso la passerella.",[50.4,50.61,50.89,51.17,51.31]],[52.45," «Giù.",[52.45]],[53," Tutti.",[53]],[53.79," Alla nave.»",[53.79,54.13]]]},{"c":[[55.5,"Scesero di corsa, nel vento, lungo la passerella senza parapetto.",[55.5,56.03,56.17,57.05,57.48,58.34,58.75,58.87,59.33,59.73]],[61.25," Il metallo tremava sotto di loro; appena dietro Penelo un tratto si staccò e cadde girando verso il deserto.",[61.25,61.25,61.63,61.99,62.25,62.39,63.2,63.67,64.03,64.39,64.57,64.89,65.05,65.84,65.99,66.35,66.73,66.99,67.12]],[68.16," Lei non si voltò.",[68.16,68.43,68.61,68.77]],[69.36," Rientrarono nella sala di comando dalla vetrata spaccata.",[69.36,70.15,70.39,70.63,70.77,71.19,71.41,71.81]]]},{"c":[[73.78,"Larsa era dove l'avevano lasciato.",[73.78,74.19,74.47,74.72,75.23]],[76.41," Era seduto per terra, ai piedi del trono vuoto, e teneva sulle ginocchia la testa di Gabranth.",[76.41,76.69,77.07,77.31,77.98,78.19,78.55,78.73,79,80.23,80.37,80.67,80.91,81.39,81.51,81.89,82]]]},{"c":[[84.08,"Il Giudice era disteso sulla schiena.",[84.08,84.29,85.03,85.45,85.99,86.25]],[88.31," L'elmo spaccato gli copriva ancora metà del viso, la destra; la sinistra era scoperta, pallida, con il sangue che gli era colato dalla fronte e si era seccato sulla guancia.",[88.31,88.55,89.13,89.31,89.71,90.07,90.35,90.59,91.28,91.5,92.48,92.69,93.13,93.31,94.23,95.15,95.33,95.49,95.89,96.01,96.15,96.27,96.65,97,97.84,97.99,98.13,98.3,98.83,99.09]],[100.1," Respirava.",[100.1]],[101.57," Ogni respiro gli usciva con un rumore lungo e bagnato, come quello dell'acqua in un tubo intasato, e fra un respiro e l'altro passava troppo tempo.",[101.57,101.98,102.95,103.23,103.55,103.73,103.87,104.27,104.67,104.76,105.79,106.13,106.46,106.95,107.15,107.31,107.61,108.73,108.87,109.03,109.17,109.67,109.8,110.56,111.09,111.5]],[113.03," Larsa gli teneva una mano sulla fronte, dove l'aveva tenuta lui poco prima, e non la toglieva.",[113.03,113.03,113.21,113.53,113.69,113.89,114.16,114.81,115.07,115.47,115.85,116.13,116.39,117.11,117.25,117.39,117.51]]]},{"c":[[119.6,"Quando vide Basch, il ragazzo alzò la faccia.",[119.6,120.07,120.6,121.26,121.47,121.95,122.25,122.37]],[123.47," Aveva gli occhi asciutti e la bocca che tremava.",[123.47,123.87,124.01,124.23,124.98,125.13,125.27,125.57,125.78]]]},{"c":[[127.85,"«Non riesco a farlo alzare» disse.",[127.85,128.13,128.47,128.59,128.81,129.15]],[129.6," «Gliel'ho chiesto.",[129.6,130.24]],[131.25," Non si alza.»",[131.25,131.53,131.83]]]},{"c":[[132.68,"Basch si inginocchiò.",[132.68,133.74,133.95]],[135.89," Guardò il fratello, la mezza faccia, il petto, l'armatura sfondata sul fianco dove il colpo di Vayne lo aveva preso.",[135.89,135.89,136.01,137.18,137.39,137.68,138.62,138.94,139.44,140.33,140.93,141.13,141.51,141.73,141.87,142.19,142.4,142.94,143.15,143.63]],[144.29," Non disse niente.",[144.29,144.57,144.88]],[146.01," Non c'era niente che un soldato con vent'anni di campi di battaglia avesse bisogno di dire, guardando una ferita così.",[146.01,146.1,146.23,146.69,146.89,147.03,147.55,147.76,148.33,148.47,148.81,148.91,149.88,150.35,150.73,150.85,151.55,152.21,152.39,152.79]]]},{"c":[[154.62,"«Lo portiamo alla nave» disse.",[154.62,154.83,155.33,155.65,156.03]]]},{"c":[[159.56,"Lo portarono in due, Basch e Vaan, con Larsa che camminava accanto tenendogli la mano che penzolava.",[159.56,159.56,160.25,160.5,160.98,161.77,161.93,162.56,162.99,163.69,163.96,164.71,165.43,166.16,166.3,166.54,166.72]],[168.03," Pesava come un cavallo, con l'armatura.",[168.03,168.5,168.8,168.94,169.81,170.24]],[171.55," Nessuno propose di togliergliela.",[171.55,172.08,172.58,172.76]],[176.95," Attraversarono i corridoi della fortezza, che adesso erano vuoti, con le lampade bianche che si accendevano e si spegnevano a intervalli e il pavimento che si inclinava sempre di più;",[176.95,177.82,177.92,178.44,178.74,179.59,179.86,180.26,180.72,181.38,181.66,181.8,182.2,182.64,182.78,182.92,183.72,183.86,184.04,184.68,184.8,185.77,185.92,186.04,186.58,186.8,186.96,187.46,187.9,188.1]],[189.14," da qualche parte, nel ventre di Bahamut, si sentivano crolli lunghi, di ferro che si piega, e una volta, lontanissima, una voce che gridava qualcosa a proposito di un'armeria.",[189.14,189.14,189.47,190.16,190.44,190.8,190.94,192.19,192.4,192.92,193.35,194.13,194.34,194.68,194.8,195.01,196.35,196.5,196.72,197.58,198.84,199.12,199.46,199.64,200.08,200.59,200.74,201.32,201.57]],[202.69," Nessuno ci fece caso.",[202.69,203.22,203.4,203.74]]],"st":1},{"c":[[205.83,"La piattaforma d'attracco era ancora lì.",[205.83,206.04,206.91,207.63,207.9,208.29]],[209.15," Le guardie disarmate erano scappate.",[209.15,209.36,209.88,210.75,211.2]],[212.57," La Strahl aspettava fra il fumo con la sua cicatrice sul fianco, ammaccata e sporca, e quando Vaan la vide gli venne voglia di piangere senza nessuna ragione.",[212.57,212.75,213.28,213.94,214.12,214.28,214.6,214.8,214.94,215.14,215.76,216.03,216.9,217.56,217.77,218.81,218.96,219.33,219.58,219.76,220.28,220.56,220.84,221.18,221.34,221.94,222.33,222.86]]]},{"c":[[225.02,"Misero Gabranth sul pavimento della cabina, fra le casse, su un mantello.",[225.02,225.41,225.92,226.2,226.7,226.94,228.04,228.32,228.5,229.32,229.46,229.58]],[230.51," Larsa si sedette accanto a lui.",[230.51,231.33,231.54,232.02,232.42,232.54]],[232.99," Basch si inginocchiò dall'altra parte.",[232.99,233.75,233.96,234.52,234.97]]]},{"c":[[236.88,"Balthier si buttò ai comandi.",[236.88,237.26,237.46,237.84,238]],[239.16," Abbassò le leve, girò le chiavi, premette i pulsanti, nell'ordine in cui li premeva sempre, con le mani che sapevano da sole cosa fare.",[239.16,239.56,239.7,240.44,240.64,240.78,241.64,241.96,242.14,242.83,243.7,243.88,244,244.14,244.52,245.46,245.54,245.66,245.94,246.06,246.52,246.68,247,247.28]]]},{"c":[[248.99,"La Strahl non rispose.",[248.99,249.11,249.45,249.63]]]},{"c":[[250.78,"Balthier ripeté tutto da capo.",[250.78,252.11,252.58,252.88,253.12]],[254.11," Niente.",[254.11]],[255.49," La spia della pietra celeste, accanto alla manetta, restava spenta.",[255.49,255.7,255.98,256.22,256.63,257.16,257.62,257.78,258.88,259.67]],[261.09," Dai motori veniva un ronzio debole, intermittente, che si alzava e si spegneva, come il respiro di Gabranth sul pavimento.",[261.09,261.09,261.79,262.26,262.4,262.83,263.68,264.85,265.12,265.26,265.64,265.74,265.84,266.74,267.08,267.22,267.54,267.66,268.15,268.42]]]},{"c":[[270.54,"«Fran.»",[270.54]]]},{"c":[[272.12,"Fran aveva già gli occhi chiusi.",[272.12,272.7,273.1,273.26,273.4,273.71]]]},{"c":[[274.9,"«Siamo attaccati» disse.",[274.9,275.44,276.1]],[277.03," «La piattaforma.",[277.03,277.29]],[278.69," Quando siamo scesi ci ha presi.",[278.69,279.16,279.54,279.94,280.25,280.55]],[281.31," I suoi condotti bevono dalla nostra pietra per tenersi su.",[281.31,281.46,281.8,282.4,282.84,283.06,283.4,283.84,284.1,284.63]],[285.7," La fortezza muore, e succhia tutto quello che trova.»",[285.7,285.7,286.3,287.18,287.32,287.62,287.92,288.24,288.44]],[289.36," Aprì gli occhi.",[289.36,289.7,289.86]],[290.81," «Finché siamo attaccati, non ci lascia andare.»",[290.81,291.28,291.56,292.41,292.68,292.86,293.27]]]},{"c":[[294.98,"Balthier guardò fuori dal vetro.",[294.98,295.75,296.22,296.48,296.66]],[298.04," Sulla piattaforma, a una ventina di passi, c'era un pilone di metallo con una grata, e dalla grata uscivano due cavi spessi che correvano sul pavimento fino alla carena della Strahl.",[298.04,298.04,298.9,299.04,299.16,299.48,299.66,300.28,300.78,300.88,301.18,301.28,301.76,301.92,302.1,303.12,303.26,303.42,303.76,304.26,304.52,304.99,305.56,305.84,306.38,306.6,307.56,307.9,308.08,308.64,309.1]],[309.66," Li aveva visti atterrando.",[309.66,309.66,309.94,310.28]],[311.34," Aveva pensato che fossero di servizio.",[311.34,311.74,312.26,312.44,312.86,313]]]},{"c":[[315.31,"«I morsetti di alimentazione» disse.",[315.31,315.46,315.88,316,316.82]],[317.79," «Dal pilone.",[317.79,318.06]],[318.82," Bisogna staccarli a mano, e da dentro il pilone, dove c'è il quadro.",[318.82,319.36,319.92,320.06,320.8,320.94,321.06,321.38,321.56,322.34,322.82,323.06,323.16]],[324.31," E poi bisogna...»",[324.31,324.46,325.16]],[326.01," Si fermò.",[326.01,326.22]],[327.24," Guardò il quadro degli strumenti, poi Fran, poi il pilone.",[327.24,327.64,327.78,328.14,328.36,329.2,329.7,330.81,331.23,331.44]],[332.8," «Poi bisogna che qualcuno resti al quadro, per tenere chiuso il flusso finché la nave non si stacca.",[332.8,332.8,333.16,333.3,333.72,334.04,334.18,335.09,335.36,335.68,336.02,336.17,336.91,337.38,337.54,338.03,338.3,338.53]],[339.35," Altrimenti riprende appena togli la mano.»",[339.35,339.98,340.48,340.82,341.1,341.22]]]},{"c":[[344.04,"Ci fu un silenzio breve.",[344.04,344.04,344.22,344.36,344.84]]]},{"c":[[346.24,"«Andiamo noi» disse Fran.",[346.24,346.78,347.04,347.42]]]},{"c":[[348.88,"«Vado io» disse Balthier.",[348.88,349.53,350.5,351.21]]]},{"c":[[352.36,"«Andiamo noi.»",[352.36,352.99]]]},{"c":[[353.56,"Balthier la guardò.",[353.56,355.11,355.32]],[356.71," Poi si alzò dal sedile di pilotaggio e si voltò verso la cabina, verso Vaan, che stava in piedi vicino al portello con la spada di Reddas ancora in mano e la faccia di chi ha già capito.",[356.71,356.71,356.92,357.22,357.38,357.74,357.86,359.06,359.2,359.32,359.6,359.82,359.96,360.66,361.32,361.85,362.12,362.36,362.48,362.7,363.06,363.18,364.09,364.36,364.48,364.78,364.92,365.32,365.63,365.84,366.63,366.78,366.9,367.2,367.32,367.44,367.56,367.69]]]},{"c":[[369.8,"«Siediti» disse Balthier.",[369.8,370.78,371.48]]]},{"c":[[372.6,"«Cosa?»",[372.6]]]},{"c":[[374.36,"«Siediti qui.»",[374.36,374.9]],[375.75," Indicò il sedile.",[375.75,376.22,376.4]],[377.19," «Hai preso la barra sopra le colonne di Ridorana.",[377.19,377.46,377.8,377.9,378.22,378.5,378.64,379.02,379.16]],[379.83," Hai volato dritto.",[379.83,380.1,380.42]],[381.56," Sai come si accende, mi hai visto farlo cento volte.",[381.56,381.84,382.04,382.22,383.01,383.22,383.32,383.58,383.88,384.22]],[385.36," Quando la spia diventa grigia e azzurra, vuol dire che siamo liberi.",[385.36,385.36,385.58,385.92,386.39,387.25,387.5,388.64,388.98,389.61,389.88,390.33]],[391.25," Allora tiri indietro questa, piano, con la metà della forza che pensi, e poi con la metà di quella.",[391.25,391.72,392.06,392.52,393.4,394.13,394.4,394.52,394.84,395.1,395.5,395.78,396.63,396.78,396.98,397.16,397.26,397.48,397.58]],[399.02," E vai.»",[399.02,399.17]]]},{"c":[[401.01,"«Io non...»",[401.01,401.35]]]},{"c":[[403.35,"«Tu sì.»",[403.35,404.15]]]},{"c":[[405.72,"«E voi?»",[405.72,405.87]]]},{"c":[[407.19,"«Noi abbiamo una cosa da fare.»",[407.19,407.46,407.92,408.12,408.34,408.5]],[408.94," Balthier si sistemò un polsino.",[408.94,409.83,410.04,410.5,410.66]],[411.63," Lo fece lentamente, e poi fece l'altro.",[411.63,411.84,412.1,413.04,413.18,413.4,413.84]],[414.49," «Penelo, tu siedi accanto a lui.",[414.49,415.38,415.48,415.84,416.18,416.3]],[417.09," Quelli sono gli strumenti di Fran, lei ti dice cosa guardare.",[417.09,417.4,417.72,417.92,418.36,418.46,419.35,419.62,419.76,420,420.28]],[421.29," Te lo dico io: guarda quello rotondo e se l'ago va nel rosso grida.»",[421.29,421.5,421.64,421.91,422.59,423.06,423.32,424.13,424.28,424.43,424.74,424.94,425.22,425.94]]]},{"c":[[427.65,"Penelo annuì.",[427.65,428.12]],[429.18," Aveva la faccia bianca.",[429.18,429.58,429.68,429.95]],[430.99," Si sedette nel posto di Fran senza dire niente.",[430.99,431.2,431.58,431.74,432.04,432.12,432.32,432.64,432.86]]]},{"c":[[434.17,"Vaan non si mosse.",[434.17,435.05,435.33,435.72]]]},{"c":[[437,"«Balthier.»",[437]]]},{"c":[[439.06,"«Siediti, Vaan.»",[439.06,440.44]]]},{"c":[[441.23,"«Ti aspetto.",[441.23,441.44]],[442.62," Stacchi i cavi, torni, e partiamo.",[442.62,443.08,443.22,443.8,444.75,444.9]],[445.95," Ti aspetto.»",[445.95,446.16]]]},{"c":[[447.66,"Balthier lo guardò un momento.",[447.66,448.2,448.38,448.66,448.76]],[449.49," Poi infilò la mano nella tasca della giacca e ne tirò fuori il piccolo disco d'ottone con la rotella, quello con cui Vaan aveva fatto parlare Larsa, e glielo mise in mano.",[449.49,449.76,450.1,450.22,450.42,450.7,451.04,451.26,451.69,451.84,451.96,452.2,452.52,452.68,453.02,453.36,453.84,454.02,454.12,454.91,455.38,455.56,455.72,455.94,456.26,456.5,456.8,457.02,458,458.24,458.49,458.7]]]},{"c":[[461.08,"«Tieni.»",[461.08]]]},{"c":[[464.8,"«Perché?»",[464.8]]]},{"c":[[464.98,"«Perché non si sa mai quando serve un'altra voce.»",[464.98,465.16,465.34,465.48,465.69,465.96,466.2,466.49,466.9]],[467.57," Gli chiuse le dita sopra il disco.",[467.57,468.08,468.4,468.54,468.76,469.04,469.16]],[469.64," «Restituiscimelo, poi.",[469.64,470.71]],[471.61," Ci sono affezionato.»",[471.61,471.82,472.08]]]},{"c":[[474.25,"«Poi quando?»",[474.25,475.35]]]},{"c":[[476.99,"«Poi.»",[476.99]]]},{"c":[[478.74,"Fran era già al portello.",[478.74,479.37,479.64,479.86,480.06]],[481.48," Si voltò a guardare la cabina, una volta sola, e i suoi occhi rossi si fermarono su ciascuno di loro, uno dopo l'altro, per il tempo di un battito,",[481.48,481.48,481.78,481.9,482.2,482.32,483.15,483.42,483.74,484.72,484.86,484.98,485.16,485.46,486.21,486.42,486.96,487.1,487.48,487.62,488.31,488.58,488.99,489.61,489.88,490.02,490.34,490.5,490.64]],[492.04," come si contano le persone prima di chiudere una porta.",[492.04,492.04,492.22,492.62,492.76,493.46,493.86,494,494.34,494.48]],[495.53," Su Penelo si fermarono di più.",[495.53,495.74,496.25,496.46,497.02,497.14]],[497.73," Poi uscì.",[497.73,498.32]]]},{"c":[[500.08,"Balthier la seguì.",[500.08,500.52,500.64]],[501.76," Sulla soglia si fermò, mezzo dentro e mezzo fuori, con il vento che gli muoveva i capelli.",[501.76,502.16,502.5,502.66,503.66,503.9,504.26,504.4,504.64,505.41,505.68,505.84,506.14,506.28,506.42,506.84,506.94]]]},{"c":[[509.63,"«Ah, Vaan.»",[509.63,510.36]]]},{"c":[[511.82,"«Cosa?»",[511.82]]]},{"c":[[513.57,"«Non grattarla atterrando.",[513.57,513.84,514.42]],[515.51," È appena stata pulita.»",[515.51,515.66,516.02,516.37]]]},{"c":[[517.83,"Poi se ne andò.",[517.83,518.1,518.26,518.36]]]},{"c":[[522.13,"Vaan si sedette.",[522.13,522.69,522.9]],[524.08," Non decise di farlo.",[524.08,524.28,524.68,524.84]],[525.85," Si trovò seduto, con le mani sulla barra, e la barra era fredda e non vibrava.",[525.85,526.06,526.4,526.95,527.22,527.34,527.6,527.89,528.65,528.8,528.9,529.2,529.36,530.2,530.34,530.5]],[531.45," Accanto a lui Penelo guardava lo strumento rotondo.",[531.45,531.98,532.08,532.31,532.78,533.18,533.34,533.8]],[534.78," Dal vetro si vedevano Balthier e Fran attraversare la piattaforma di corsa nel fumo, arrivare al pilone, aprire una grata, sparire dentro.",[534.78,535,535.65,535.86,536.41,536.96,537.1,537.96,538.82,538.98,539.58,539.68,540,540.28,541.02,541.52,541.7,542.58,542.84,543.06,543.96,544.36]]],"st":1},{"c":[[546.41,"Dietro di lui, sul pavimento della cabina, Gabranth aprì l'occhio che l'elmo spaccato lasciava scoperto.",[546.41,546.88,547.07,547.81,548.08,548.58,548.91,549.84,551.08,551.32,551.74,551.91,552.2,552.8,553.22]],[554.38," Cercò qualcosa nella penombra, girando appena la testa.",[554.38,554.78,555.22,555.48,556.35,556.88,557.2,557.46]],[558.12," Trovò Larsa.",[558.12,558.56]],[559.23," Lo guardò.",[559.23,559.44]],[560.98," Poi trovò Basch, inginocchiato dall'altra parte, e lo guardò più a lungo.",[560.98,560.98,561.4,561.84,562.6,563.13,563.94,564.08,564.18,564.54,564.82,565.46]]]},{"c":[[566.88,"«Basch.»",[566.88]]]},{"c":[[568.88,"«Sono qui.»",[568.88,569.23]]]},{"c":[[570.35,"«Il ragazzo.»",[570.35,572.07]],[572.93," La voce gli usciva bassa e rotta, a pezzi, ogni parola un respiro.",[572.93,573.14,573.36,573.54,573.92,574.32,574.44,575.25,575.4,575.76,575.96,576.3,576.49]],[577.43," «Il ragazzo.",[577.43,577.76]],[578.59," Proteggilo.»",[578.59]]]},{"c":[[580.68,"Basch non rispose subito.",[580.68,581.35,581.62,582.08]]]},{"c":[[583.58,"«È l'ultimo» disse Gabranth.",[583.58,583.66,584.24,584.66]],[585.33," «L'ultimo Solidor.",[585.33,585.92]],[586.83," Se muore...",[586.83,587.12]],[587.91," le grandi case di Archades...",[587.91,588.12,588.42,588.74,588.97]],[589.88," si sbranano.",[589.88,590.11]],[591.03," Le legioni...",[591.03,591.24]],[592.03," ognuna con il suo generale.",[592.03,592.5,592.68,592.8,592.94]],[593.79," Guerra.",[593.79]],[594.38," Dappertutto.",[594.38]],[595.26," Per anni.»",[595.26,595.54]],[596.84," Prese fiato, e il fiato gli fece male.",[596.84,596.84,598,598.14,598.28,598.48,598.6,598.86]],[599.81," «Lui no.",[599.81,600.09]],[600.73," Lui è...",[600.73,601.08]],[601.69," diverso.",[601.69]],[602.61," Lui farà la pace.",[602.61,602.88,603.16,603.3]],[603.93," Con voi.",[603.93,604.23]],[604.64," Con Dalmasca.",[604.64,604.94]],[605.73," Con tutti.",[605.73,606]],[606.67," Lo so.",[606.67,606.93]],[607.53," Lo conosco.»",[607.53,607.81]]]},{"c":[[609.75,"Larsa gli strinse la mano.",[609.75,610.61,610.88,611.24,611.42]]]},{"c":[[612.47,"«Proteggilo» disse Gabranth.",[612.47,613.6,614.15]],[615.05," «Al mio posto.",[615.05,615.26,615.36]],[616.02," Non ti chiedo...",[616.02,616.3,616.44]],[617.21," non ti chiedo altro.",[617.21,617.48,617.62,617.88]],[618.59," Non ti ho mai chiesto niente.",[618.59,618.86,618.96,619.04,619.18,619.5]],[620.5," Questo sì.»",[620.5,620.65]]]},{"c":[[622.19,"Basch guardò il fratello.",[622.19,622.88,623.32,623.42]],[624.38," Poi guardò Larsa, il ragazzo seduto per terra con il sangue sulla tempia e la mano di un Giudice nella sua.",[624.38,624.66,625.33,625.89,626.1,626.56,626.94,627.16,627.59,627.86,628.06,628.4,628.69,629.44,629.58,629.7,629.92,630.08,630.2,630.64,630.9]],[631.86," Aveva servito Raminas.",[631.86,632.26,632.87]],[633.8," Aveva servito Ashe.",[633.8,634.18,634.7]],[635.79," Aveva combattuto Archadia per tutta la vita, da quando i soldati di Archadia gli avevano bruciato la casa.",[635.79,636.18,637.06,637.76,638.04,638.32,638.4,639.27,639.48,639.72,639.82,640.2,640.33,640.84,641.04,641.36,641.76,641.9]],[643.13," Adesso suo fratello gli chiedeva di proteggere l'erede di Archadia.",[643.13,643.93,644.2,644.62,644.76,645.14,645.26,645.91,646.3,646.44]]]},{"c":[[648.26,"Non ci pensò a lungo.",[648.26,648.54,648.68,649.06,649.2]],[649.9," Capì che non c'era niente da pensare.",[649.9,650.24,650.38,650.54,650.76,651.18,651.37]],[652.6," Il mondo che aveva conosciuto, quello in cui Dalmasca e Archadia stavano da due parti e lui da una,",[652.6,652.6,652.86,653.02,653.3,654.66,654.94,655.06,655.2,655.8,655.86,656.38,656.82,657,657.22,658.2,658.34,658.77,658.99]],[659.95," era finito su una torre spezzata in fondo al mare e su una piattaforma battuta dal vento in cima a una fortezza.",[659.95,660.16,660.52,660.7,660.88,661.2,661.78,661.98,662.22,662.38,663.51,663.66,663.86,664.06,664.74,665.24,665.46,665.86,666.06,666.28,666.42,666.56]],[668.17," Ce n'era un altro, adesso.",[668.17,668.32,668.62,668.78,669.12]],[670.06," In quello, la pace di Dalmasca passava per quel ragazzo.",[670.06,670.22,670.89,671.1,671.44,671.58,672.17,672.7,672.92,673.17]]]},{"c":[[674.98,"Prese la mano del fratello.",[674.98,675.38,675.52,675.7,675.86]],[676.75," La manopola era fredda.",[676.75,676.96,677.5,677.67]]]},{"c":[[679.11,"«Lo proteggo» disse.",[679.11,679.32,679.86]],[680.81," «Te lo prometto.",[680.81,681.02,681.14]],[681.85," Per Archadia.",[681.85,682.18]],[683.08," E per Dalmasca.»",[683.08,683.22,683.42]]]},{"c":[[684.53,"Gabranth chiuse l'occhio.",[684.53,685.65,686.5]],[687.5," Il suo viso, la metà che si vedeva, si distese, e la piega dura attorno alla bocca, quella che Basch non aveva, si allentò un poco.",[687.5,687.5,687.8,688.45,688.66,688.88,689.02,689.16,689.89,690.1,690.98,691.12,691.32,692.12,692.46,692.92,693.2,694.03,694.5,694.74,695.14,695.38,696.37,696.5,696.94,697.06]]]},{"c":[[701.2,"La spia della pietra celeste si accese.",[701.2,701.2,701.54,701.76,702.14,703.47,703.89]],[704.81," Grigia, poi azzurra, poi pulsò, lenta, più lenta del cuore di un uomo.",[704.81,705.66,705.97,707.05,707.51,708.5,709.02,709.26,709.56,709.72,710.06,710.2,710.3]]],"st":1},{"c":[[712.26,"«Vaan!»",[712.26]],[713.06," gridò Penelo.",[713.06,713.51]],[714.36," «Vaan, la spia!»",[714.36,714.92,715.14]]]},{"c":[[716.63,"I motori ripresero.",[716.63,716.81,717.62]],[719.33," Non con il ruggito di sempre: con quel ronzio basso e largo, che sembrava venire dalla pietra stessa, lo stesso che avevano sentito nella nebbia di Ridorana.",[719.33,719.33,719.61,719.76,720.28,720.47,721.55,721.82,722.21,722.86,723.27,723.51,724.23,724.5,724.94,725.36,725.63,726.15,727.35,727.56,727.94,728.14,728.76,729.58,729.98,730.38,730.56]],[731.59," La nave tremò.",[731.59,731.8,732.2]],[734.33," Fuori, dal pilone, i due cavi si staccarono dalla carena e caddero sul pavimento della piattaforma come serpenti tagliati.",[734.33,734.33,734.69,735.7,735.84,735.98,736.24,736.4,736.88,737.14,738.22,738.36,738.78,738.96,739.46,739.7,740.42,740.76,741.4]]]},{"c":[[743.47,"Vaan guardò il pilone.",[743.47,744.09,744.56,744.69]],[745.32," Dalla grata non usciva nessuno.",[745.32,745.75,746.37,746.64,747.11]]]},{"c":[[748.06,"«Vaan» disse Penelo.",[748.06,748.6,749.39]]]},{"c":[[750.35,"«Aspetta.»",[750.35]]]},{"c":[[752.17,"«Vaan.",[752.17]],[753.21," La piattaforma si inclina.»",[753.21,753.42,754.08,754.24]]]},{"c":[[755.37,"Si inclinava.",[755.37,756.89]],[758.35," Lo si vedeva dal vetro: l'orizzonte storto, il fumo che scivolava di lato.",[758.35,758.35,758.47,758.79,758.95,759.46,760.48,761.3,761.51,761.81,761.95,762.43,762.59]],[763.36," La Strahl cominciò a scivolare anche lei, piano, sulle lastre, verso il bordo.",[763.36,763.48,763.83,764.27,764.41,764.79,765.08,765.76,766.49,766.89,767.33,767.63,767.77]]]},{"c":[[769.82,"«Aspetta» disse Vaan.",[769.82,770.49,771.3]],[771.96," «Escono.",[771.96]],[772.94," Adesso escono.»",[772.94,773.7]]]},{"c":[[775.08,"Dal dispositivo delle comunicazioni venne un gracchio.",[775.08,775.35,776.11,776.29,777.05,777.45,777.59]]]},{"c":[[779.36,"«Ragazzo.»",[779.36]],[780.24," Era la voce di Balthier.",[780.24,780.51,780.65,780.87,781.11]],[782.08," Era lontana e piena di rumori, e calma.",[782.08,782.35,782.88,783.03,783.37,783.47,784.23,784.47]],[785.26," «Ti vedo dalla grata.",[785.26,785.57,785.91,786.19]],[787.65," Stai scivolando.",[787.65,787.65]],[788.79," Parti.»",[788.79]]]},{"c":[[791.01,"«Esci!",[791.01]],[792.13," Esci, che ti aspetto!»",[792.13,792.72,792.99,793.11]]]},{"c":[[794.63,"«Non posso uscire.",[794.63,794.91,795.21]],[796.62," Se tolgo la mano dal quadro la fortezza ti riprende.",[796.62,796.83,797.15,797.29,797.51,797.69,798.7,798.91,799.41,799.61]],[800.8," Te l'ho spiegato, mi pare.",[800.8,800.94,801.15,802,802.21]],[803.06," Ascolti mai quando parlo?»",[803.06,803.59,803.85,804.21]],[805.3," Un rumore di ferro, una pausa.",[805.3,805.51,805.79,806.02,806.51,806.88]],[807.76," «Parti, Vaan.",[807.76,808.7]],[809.45," È un ordine.",[809.45,809.45,809.62]],[810.43," L'unico che ti do da capitano, e guarda che ne approfitto.»",[810.43,811.25,811.41,811.51,811.67,811.83,813.02,813.17,813.61,813.73,813.85]]]},{"c":[[816.06,"«No!»",[816.06]]]},{"c":[[817.59,"«Fran dice che sei uno stupido.»",[817.59,817.93,818.17,818.35,818.55,818.77]]]},{"c":[[820.26,"Si sentì, lontana, la voce di Fran.",[820.26,820.55,821.58,822.6,822.81,823.07,823.19]],[824.09," Disse una parola sola.",[824.09,824.49,824.73,825.05]],[825.89," Non era stupido.",[825.89,826.17,826.46]]]},{"c":[[828.13,"«Vai» disse.",[828.13,828.87]]]},{"c":[[830.75,"Vaan mise le mani sulla barra.",[830.75,830.75,831.09,831.25,831.47,831.76]],[832.6," Le mani gli tremavano, e la barra tremava, e la nave scivolava verso il bordo.",[832.6,832.81,833.07,833.21,834.35,834.49,834.57,834.85,835.69,835.83,835.95,836.21,836.71,836.99,837.13]],[838.19," Tirò.",[838.19]],[838.93," Tirò troppo.",[838.93,839.28]],[840.59," La Strahl si impennò di colpo con un'allegria che nessuno condivise, e Penelo gridò, e Vaan pensò a una voce sopra un viale di colonne spezzate che gli diceva non tirare, chiedi,",[840.59,840.8,841.44,841.75,842.15,842.27,842.67,842.86,843.51,843.69,844.15,845.71,845.85,846.26,846.95,847.09,847.64,848.05,848.19,848.47,848.81,849.15,849.33,849.57,849.73,850.13,850.71,850.87,851.01,852.1,852.52,853.28]],[854.19," e lasciò andare di metà.",[854.19,854.19,854.53,854.83,854.97]],[856.13," Poi della metà della metà.",[856.13,856.41,856.65,856.95,857.23]],[858.26," La nave si raddrizzò.",[858.26,858.47,858.82,859.03]],[860.08," Il bordo della piattaforma passò sotto di loro.",[860.08,860.29,860.59,860.85,861.55,861.95,862.29,862.43]],[863.39," E poi sotto di loro non ci fu più niente, se non aria e fumo e, molto più in basso, il deserto.",[863.39,863.39,863.59,863.89,864.03,864.48,864.75,864.89,865.03,865.19,866.22,866.43,866.59,866.93,867.09,867.9,868.05,868.27,868.41,868.59,869.34,869.68]]]},{"c":[[871.84,"La Strahl si staccò da Bahamut.",[871.84,872.19,873.26,873.56,874.03,874.41]]]},{"c":[[875.76,"Vaan non si voltò a guardare indietro.",[875.76,876.52,877.1,877.3,877.66,877.78,878.18]],[879.09," Non poteva: aveva le mani sulla barra e gli occhi avanti e la nave che chiedeva.",[879.09,879.37,880.39,880.8,880.96,881.3,881.6,882,882.1,882.18,882.37,883.36,883.5,883.64,883.94,884.16]],[885.49," Fu Penelo a voltarsi, e a guardare dal vetro laterale la fortezza che si allontanava, immensa, inclinata, con gli anelli che giravano a scatti e il fumo che le usciva da cento ferite.",[885.49,885.49,885.96,886.1,887.27,887.42,887.54,887.86,888,888.32,888.8,888.96,889.48,889.62,889.76,890.95,891.84,892.92,893.12,893.26,893.58,893.76,894.26,894.38,895.15,895.3,895.46,895.76,895.92,896.04,896.38,896.65,897.06]],[898.12," Cercò il pilone sulla piattaforma d'attracco.",[898.12,898.5,898.62,898.96,899.22,900.1]],[900.83," Era troppo lontano.",[900.83,901.1,901.4]],[902.26," Non lo trovò.",[902.26,902.54,902.7]]]},{"c":[[906.27,"Sul pavimento della cabina, fra le casse, Gabranth riaprì l'occhio un'ultima volta.",[906.27,906.55,907.01,907.3,908.01,908.3,908.51,909.24,910.42,910.8,911.24,911.75]]],"st":1},{"c":[[913.26,"La nave volava dritta, adesso.",[913.26,913.47,913.75,914.14,914.96]],[916.19," Il ronzio della pietra celeste riempiva la cabina, basso, regolare, e dal vetro entrava una luce chiara, di cielo libero.",[916.19,916.19,916.65,916.91,917.39,918.15,918.75,918.87,919.85,920.57,921.52,921.67,921.81,922.21,922.71,922.89,923.13,923.98,924.19,924.5]],[925.64," Larsa gli teneva la mano.",[925.64,926.53,926.81,927.15,927.29]],[927.99," Basch gli teneva l'altra.",[927.99,928.88,929.15,929.55]]]},{"c":[[931.27,"Gabranth guardò il fratello.",[931.27,931.88,932.35,932.47]],[933.58," Le sue labbra si mossero, e Basch si chinò fino quasi a toccarle con l'orecchio.",[933.58,933.79,933.95,934.27,934.46,935.64,935.73,936.18,936.39,936.81,937.15,937.52,937.67,938.13,938.31]]]},{"c":[[940.5,"«Sulla torre» disse Gabranth.",[940.5,940.91,941.21,942.13]],[943.6," «In cima.",[943.6,943.81]],[944.81," Quando crollava.",[944.81,945.35]],[946.5," Mi hanno trascinato via.",[946.5,946.71,946.85,947.51]],[948.44," Ho visto...",[948.44,948.67]],[949.74," ho visto che tornavi indietro.",[949.74,949.95,950.35,950.61,951.01]],[951.74," Al pilastro.",[951.74,952.15]],[953.02," A cercare.»",[953.02,953.46]]]},{"c":[[955.73,"Basch chiuse gli occhi.",[955.73,956.22,956.69,956.83]]]},{"c":[[958.46,"«Sì» disse.",[958.46,958.83]],[959.61," «Ti ho cercato.",[959.61,959.75,959.89]],[960.8," Non c'eri.»",[960.8,961.52]]]},{"c":[[962.48,"«Non l'hai detto a nessuno.»",[962.48,962.66,962.91,963.13,963.23]]]},{"c":[[964.7,"«No.",[964.7]],[965.5," Lo dico adesso.",[965.5,965.71,966.03]],[967.26," A te.»",[967.26,967.42]]]},{"c":[[967.75,"Gabranth respirò.",[967.75,969.1]],[969.99," Il rumore bagnato era quasi sparito.",[969.99,970.07,970.37,970.79,970.99,971.32]],[972.79," Il respiro si era fatto piccolo e leggero, come quello di un bambino che dorme.",[972.79,972.79,974.36,974.57,974.71,974.97,975.45,975.62,976.61,976.95,977.25,977.39,977.49,977.93,978.93]]]},{"c":[[980.19,"«Basch» disse.",[980.19,980.67]],[982.03," Poi, dopo un poco: «La mamma ti chiamava sempre per primo.»",[982.03,982.97,983.31,983.47,984.94,985.15,985.45,985.59,985.97,986.27,986.49]]]},{"c":[[987.62,"«Lo so.»",[987.62,987.83]]]},{"c":[[989.44,"«Mi dava fastidio.»",[989.44,989.65,989.89]]]},{"c":[[991.38,"«Lo so.»",[991.38,991.68]]]},{"c":[[993.6,"«Adesso no.»",[993.6,994.14]]]},{"c":[[995.22,"Non disse altro.",[995.22,995.49,995.73]],[996.85," Il suo respiro, che si era fatto piccolo, si fece più piccolo ancora, e poi non ci fu più.",[996.85,996.85,997.06,997.74,998.01,998.15,998.27,998.53,999.4,999.61,999.89,1000.09,1000.51,1001.26,1001.48,1001.94,1002.21,1002.42,1002.65]],[1003.51," Non ci fu un rantolo, né un movimento.",[1003.51,1003.8,1004.01,1004.21,1004.48,1005.24,1005.48,1005.69]],[1006.96," La mano nella mano di Basch non si strinse e non si aprì.",[1006.96,1007.17,1007.49,1007.73,1007.99,1008.2,1008.72,1009.02,1009.27,1010.09,1010.39,1010.67,1010.93]],[1012," Restò com'era.",[1012,1012.75]],[1013.64," Larsa, dall'altra parte, se ne accorse un istante dopo Basch, e non disse niente, e non lasciò la mano.",[1013.64,1014.14,1015.02,1015.61,1015.73,1015.81,1016.19,1016.37,1016.83,1017.46,1018.25,1018.39,1018.55,1018.86,1019.83,1019.97,1020.11,1020.41,1020.55]]]},{"c":[[1022.42,"Basch rimase in ginocchio.",[1022.42,1023.1,1023.57,1023.71]],[1025.42," Guardò la mezza faccia di suo fratello, che era la sua faccia, con gli occhi chiusi, nella luce chiara del cielo che entrava dal vetro.",[1025.42,1025.89,1025.99,1026.26,1026.57,1026.69,1026.83,1027.55,1027.83,1027.97,1028.11,1028.3,1029.05,1029.33,1029.47,1029.76,1030.42,1030.83,1031.13,1031.47,1031.67,1032.21,1032.49,1032.91,1033.16]],[1035.05," Poi, con cura, gli tolse quello che restava dell'elmo.",[1035.05,1035.05,1035.37,1036.01,1036.29,1036.67,1036.95,1037.07,1037.6]],[1038.2," Lo fece lentamente, con due mani, come si toglie una cosa che pesa da troppo tempo, e lo posò sul pavimento della cabina accanto a lui.",[1038.2,1038.41,1038.65,1039.69,1039.97,1040.17,1040.73,1041.07,1041.23,1041.51,1041.67,1041.91,1042.07,1042.39,1042.51,1042.79,1044.01,1044.15,1044.27,1044.61,1044.83,1045.33,1045.56,1046.03,1046.43,1046.53]]]},{"c":[[1048.15,"Noah fon Ronsenburg aveva i capelli biondi come quelli del fratello, corti, appiccicati di sudore sulla fronte.",[1048.15,1048.63,1049,1050.2,1050.61,1050.69,1051.06,1051.53,1051.83,1052.09,1052.27,1053.18,1053.69,1054.29,1054.43,1054.79,1055.08]],[1056.42," Aveva una cicatrice vecchia sopra l'orecchio che Basch non conosceva.",[1056.42,1056.83,1057.03,1057.59,1058.11,1058.42,1058.97,1059.21,1059.59,1059.85]],[1061.17," Sembrava molto più giovane, senza l'elmo.",[1061.17,1061.63,1061.93,1062.13,1062.93,1063.36]]]},{"c":[[1065.59,"Basch gli passò una mano sui capelli.",[1065.59,1065.93,1066.13,1066.45,1066.61,1066.83,1067.07]],[1067.91," Una volta.",[1067.91,1068.19]]]},{"c":[[1070.77,"Poi gli slacciò il pettorale, perché non lo stringesse più, e sotto il bordo, nella tasca interna contro il petto, le dita trovarono una cosa piccola e leggera.",[1070.77,1070.77,1070.94,1071.35,1071.47,1072.26,1072.73,1072.91,1073.07,1073.57,1074.07,1074.21,1074.43,1074.57,1075.01,1075.41,1075.73,1076.27,1076.55,1076.75,1077.48,1077.69,1077.91,1078.43,1078.61,1078.83,1079.55,1079.73]],[1081.09," Era una pastiglia bianca avvolta in una carta sottile, sgualcita dal metallo, intatta.",[1081.09,1081.09,1081.29,1081.98,1082.79,1083.33,1083.45,1083.63,1084.07,1085.05,1085.71,1086.03,1087.12]],[1087.88," Sapeva di miele e di menta.",[1087.88,1088.35,1088.49,1089.11,1089.25,1089.42]],[1090.06," Basch la tenne sul palmo senza capire.",[1090.06,1090.7,1090.91,1091.25,1091.51,1091.91,1092.36]]]},{"c":[[1094.19,"Larsa la vide e smise di respirare.",[1094.19,1094.59,1094.73,1095.51,1095.65,1096.01,1096.19]],[1097.79," Era quella che gli aveva dato lui, in un giardino di Archades, davanti a un lago di cigni, perché il Giudice aveva la voce rauca e il medico di corte ne dava a lui per la gola.",[1097.79,1097.79,1098.11,1098.27,1098.39,1098.65,1098.89,1099.76,1099.97,1100.07,1100.47,1100.69,1101.6,1102.13,1102.23,1102.29,1102.51,1102.69,1103.43,1103.65,1103.85,1104.64,1105.05,1105.15,1105.42,1105.85,1105.99,1106.09,1106.43,1106.55,1106.93,1107.09,1107.29,1107.41,1107.49,1107.67,1107.81]],[1108.69," Gabranth non l'aveva mai mangiata.",[1108.69,1109.43,1109.65,1110.07,1110.25]],[1111," L'aveva portata addosso per tutto quel tempo, contro il petto, sotto l'armatura nera.",[1111,1111.57,1112.05,1112.55,1112.83,1113.13,1113.38,1114.31,1114.57,1114.75,1115.65,1116,1116.63]]]},{"c":[[1118.89,"Larsa non disse niente.",[1118.89,1119.29,1119.45,1119.66]],[1120.27," Basch gliela porse.",[1120.27,1120.77,1121.13]],[1121.96," Il ragazzo scosse la testa, piano, e Basch la rimise dov'era, nella tasca del fratello, e richiuse il pettorale sopra.",[1121.96,1122.17,1122.57,1122.89,1123.05,1123.67,1124.38,1124.45,1124.79,1124.93,1125.45,1125.97,1126.27,1126.61,1126.77,1127.55,1127.69,1128.07,1128.21,1128.69]]]},{"c":[[1130.51,"Nessuno nella cabina parlò.",[1130.51,1131.05,1131.29,1131.66]],[1132.64," Penelo, al posto di Fran, teneva gli occhi sullo strumento rotondo e le lacrime le cadevano sulle mani.",[1132.64,1133.27,1133.41,1133.73,1133.83,1134.79,1135.09,1135.21,1135.45,1135.75,1136.25,1137.22,1137.37,1137.49,1137.95,1138.11,1138.57,1138.89]],[1139.68," Vaan teneva la barra e guardava avanti.",[1139.68,1140.46,1140.93,1141.03,1141.35,1141.45,1141.85]],[1142.88," Ashe, seduta nel sedile di passaggio, si era voltata e guardava il cavaliere inginocchiato e il ragazzo seduto per terra e il Giudice disteso fra loro senza elmo,",[1142.88,1143.69,1144.15,1144.31,1144.63,1144.75,1145.99,1146.13,1146.57,1147.59,1147.73,1148.07,1148.19,1148.65,1150.18,1150.33,1150.47,1151.38,1151.85,1152.07,1152.85,1152.99,1153.13,1153.75,1154.29,1154.49,1154.75,1155.23]],[1156.41," e teneva la mano sinistra chiusa a pugno in grembo.",[1156.41,1156.41,1156.71,1156.83,1157.05,1157.57,1158.13,1158.27,1158.8,1159.04]]]},{"c":[[1162.01,"Larsa fu il primo a muoversi.",[1162.01,1162.41,1162.59,1162.73,1162.95,1163.09]],[1165.19," Si sfilò dalla giubba un fazzoletto e lo bagnò con l'acqua della borraccia di Basch, e cominciò a pulire il sangue secco dalla guancia di Gabranth, piano, con attenzione,",[1165.19,1165.19,1165.57,1165.8,1166.07,1166.23,1166.92,1167.07,1167.19,1167.47,1167.64,1167.99,1168.17,1168.59,1168.83,1169.44,1169.59,1169.99,1170.07,1170.37,1170.53,1170.87,1171.23,1171.41,1171.77,1171.94,1172.63,1173.12,1173.39]],[1174.77," come si fa con un ferito che si può ancora svegliare.",[1174.77,1174.77,1174.93,1175.11,1175.35,1175.6,1176.43,1176.71,1176.89,1177.09,1177.37]]]},{"c":[[1179.55,"Basch lo lasciò fare.",[1179.55,1180.04,1180.25,1180.55]],[1181.27," Poi gli posò una mano sulla spalla.",[1181.27,1181.67,1181.95,1182.25,1182.45,1182.71,1182.95]],[1183.69," Larsa non si voltò.",[1183.69,1184.31,1184.59,1184.73]]]},{"c":[[1186.25,"«Altezza» disse Basch.",[1186.25,1186.81,1187.72]]]},{"c":[[1188.62,"Larsa alzò gli occhi su di lui, poi continuò a pulire.",[1188.62,1189.53,1189.81,1189.93,1190.13,1190.27,1190.39,1191.11,1191.23,1191.79,1191.89]]]}]