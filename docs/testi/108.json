[{"h":1,"c":[[1.48,"Capitolo centoottesimo: L'ultimo desiderio.",[1.48,2.47,4.07,4.93]]]},{"c":[[8.07,"Gli anelli rallentavano.",[8.07,8.35,9.21]],[11.11," Dalla cima della torre lo si vedeva bene: i grandi cerchi di luce che giravano attorno alle torri di Bahamut, quelli che fino a un momento prima avevano girato con la regolarità di una macina,",[11.11,11.11,11.45,11.77,12.48,12.69,12.83,13.19,14.03,14.17,14.51,14.89,15.01,15.29,15.47,16.01,16.45,16.63,16.97,17.29,18.08,18.55,18.71,18.99,19.11,19.19,19.51,20.18,20.71,21.15,21.33,21.49,22.07,22.25,22.46]],[24.09," adesso andavano a scatti, come una ruota di carro con un raggio rotto, e a ogni scatto la luce si faceva più fioca.",[24.09,24.09,24.59,24.73,25.61,25.95,26.17,26.49,26.61,26.96,27.23,27.39,27.72,28.53,28.67,28.79,28.93,29.37,29.53,29.8,30.01,30.35,30.61]],[31.81," Sotto i loro piedi la piattaforma si inclinò, poi tornò dritta, poi si inclinò di nuovo, un poco di più.",[31.81,31.81,31.91,32.09,33.08,33.29,33.88,34.09,35.2,35.47,35.88,36.94,37.22,37.43,37.75,37.85,38.72,38.93,39.13,39.29]]]},{"c":[[40.7,"«Sta perdendo quota» disse Balthier.",[40.7,40.97,41.39,42.32,42.88]],[43.76," «Lo sento nelle ginocchia.»",[43.76,43.97,44.27,44.49]]]},{"c":[[46.36,"«Quanto?»",[46.36]]]},{"c":[[48.58,"«Abbastanza.»",[48.58]],[50.4," Si girò verso la passerella.",[50.4,50.61,50.89,51.17,51.31]],[52.45," «Giù.",[52.45]],[53," Tutti.",[53]],[53.79," Alla nave.»",[53.79,54.13]]]},{"c":[[55.5,"Scesero di corsa, nel vento, lungo la passerella senza parapetto.",[55.5,56.03,56.17,57.05,57.48,58.34,58.75,58.87,59.33,59.73]],[61.25," Il metallo tremava sotto di loro; appena dietro Penelo un tratto si staccò e cadde girando verso il deserto.",[61.25,61.25,61.63,61.99,62.25,62.39,63.2,63.67,64.03,64.39,64.57,64.89,65.05,65.84,65.99,66.35,66.73,66.99,67.12]],[68.16," Lei non si voltò.",[68.16,68.43,68.61,68.77]],[69.36," Rientrarono nella sala di comando dalla vetrata spaccata.",[69.36,70.15,70.39,70.63,70.77,71.19,71.41,71.81]]]},{"c":[[73.78,"Larsa era dove l'avevano lasciato.",[73.78,74.19,74.47,74.72,75.23]],[76.41," Era seduto per terra, ai piedi del trono vuoto, e teneva sulle ginocchia la testa di Gabranth.",[76.41,76.69,77.07,77.31,77.98,78.19,78.55,78.73,79,80.23,80.37,80.67,80.91,81.39,81.51,81.89,82]]]},{"c":[[84.08,"Il Giudice era disteso sulla schiena.",[84.08,84.29,85.03,85.45,85.99,86.25]],[88.31," L'elmo spaccato gli copriva ancora metà del viso, la destra; la sinistra era scoperta, pallida, con il sangue che gli era colato dalla fronte e si era seccato sulla guancia.",[88.31,88.55,89.13,89.31,89.71,90.07,90.35,90.59,91.28,91.5,92.48,92.69,93.13,93.31,94.23,95.15,95.33,95.49,95.89,96.01,96.15,96.27,96.65,97,97.84,97.99,98.13,98.3,98.83,99.09]],[100.1," Respirava.",[100.1]],[101.57," Ogni respiro gli usciva con un rumore lungo e bagnato, come quello dell'acqua in un tubo intasato, e fra un respiro e l'altro passava troppo tempo.",[101.57,101.98,102.95,103.23,103.55,103.73,103.87,104.27,104.67,104.76,105.79,106.13,106.46,106.95,107.15,107.31,107.61,108.73,108.87,109.03,109.17,109.67,109.8,110.56,111.09,111.5]],[113.03," Larsa gli teneva una mano sulla fronte, dove l'aveva tenuta lui poco prima, e non la toglieva.",[113.03,113.03,113.21,113.53,113.69,113.89,114.16,114.81,115.07,115.47,115.85,116.13,116.39,117.11,117.25,117.39,117.51]]]},{"c":[[119.6,"Quando vide Basch, il ragazzo alzò la faccia.",[119.6,120.07,120.6,121.26,121.47,121.95,122.25,122.37]],[123.47," Aveva gli occhi asciutti e la bocca che tremava.",[123.47,123.87,124.01,124.23,124.98,125.13,125.27,125.57,125.78]]]},{"c":[[127.85,"«Non riesco a farlo alzare» disse.",[127.85,128.13,128.47,128.59,128.81,129.15]],[129.59," «Gliel'ho chiesto.",[129.59,130.22]],[131.25," Non si alza.»",[131.25,131.53,131.81]]]},{"c":[[132.67,"Basch si inginocchiò.",[132.67,133.74,133.95]],[135.89," Guardò il fratello, la mezza faccia, il petto, l'armatura sfondata sul fianco dove il colpo di Vayne lo aveva preso.",[135.89,135.89,136.01,137.18,137.39,137.68,138.62,138.94,139.44,140.33,140.93,141.13,141.51,141.73,141.87,142.19,142.4,142.94,143.15,143.63]],[144.29," Non disse niente.",[144.29,144.57,144.88]],[146.01," Non c'era niente che un soldato con vent'anni di campi di battaglia avesse bisogno di dire, guardando una ferita così.",[146.01,146.1,146.23,146.69,146.89,147.03,147.53,147.75,148.33,148.47,148.81,148.91,149.88,150.35,150.73,150.85,151.55,152.21,152.39,152.79]]]},{"c":[[154.62,"«Lo portiamo alla nave» disse.",[154.62,154.83,155.33,155.65,156.04]]]},{"c":[[159.71,"Lo portarono in due, Basch e Vaan, con Larsa che camminava accanto tenendogli la mano che penzolava.",[159.71,159.71,160.21,160.39,160.81,161.5,161.64,162.19,162.42,162.79,162.99,163.53,164.01,164.57,164.71,164.93,165.13]],[166.2," Pesava come un cavallo, con l'armatura.",[166.2,166.67,166.93,167.05,167.79,168.16]],[169.25," Nessuno propose di togliergliela.",[169.25,169.79,170.2,170.41]],[171.74," Attraversarono i corridoi della fortezza, che adesso erano vuoti, con le lampade bianche che si accendevano e si spegnevano a intervalli e il pavimento che si inclinava sempre di più;",[171.74,172.61,172.71,173.23,173.53,174.38,174.65,175.05,175.5,176.17,176.45,176.59,176.99,177.41,177.57,177.71,178.5,178.65,178.83,179.47,179.61,180.56,180.71,180.83,181.37,181.59,181.73,182.23,182.69,182.89]],[183.91," da qualche parte, nel ventre di Bahamut, si sentivano crolli lunghi, di ferro che si piega, e una volta, lontanissima, una voce che gridava qualcosa a proposito di un'armeria.",[183.91,183.91,184.25,184.94,185.21,185.59,185.74,186.98,187.19,187.71,188.14,188.92,189.13,189.45,189.59,189.81,191.14,191.29,191.5,192.37,193.63,193.91,194.25,194.43,194.85,195.38,195.53,196.09,196.34]],[197.47," Nessuno ci fece caso.",[197.47,198.01,198.19,198.53]]],"st":1},{"c":[[200.6,"La piattaforma d'attracco era ancora lì.",[200.6,200.81,201.69,202.41,202.69,203.08]],[203.94," Le guardie disarmate erano scappate.",[203.94,204.15,204.67,205.54,205.97]],[207.35," La Strahl aspettava fra il fumo con la sua cicatrice sul fianco, ammaccata e sporca, e quando Vaan la vide gli venne voglia di piangere senza nessuna ragione.",[207.35,207.47,208.06,208.73,208.91,209.07,209.39,209.59,209.73,209.93,210.53,210.8,211.69,212.35,212.54,213.6,213.75,214.11,214.35,214.51,215.07,215.35,215.63,215.97,216.13,216.73,217.09,217.63]]]},{"c":[[219.74,"Misero Gabranth sul pavimento della cabina, fra le casse, su un mantello.",[219.74,220.16,220.72,220.99,221.49,221.71,222.81,223.09,223.29,224.09,224.25,224.37]],[225.31," Larsa si sedette accanto a lui.",[225.31,226.1,226.31,226.79,227.19,227.31]],[228.17," Basch si inginocchiò dall'altra parte.",[228.17,228.56,228.77,229.32,229.76]]]},{"c":[[231.52,"Balthier si buttò ai comandi.",[231.52,232.05,232.23,232.61,232.77]],[233.95," Abbassò le leve, girò le chiavi, premette i pulsanti, nell'ordine in cui li premeva sempre, con le mani che sapevano da sole cosa fare.",[233.95,234.35,234.47,235.23,235.43,235.53,236.45,236.75,236.91,237.6,238.47,238.67,238.79,238.93,239.31,240.25,240.31,240.45,240.73,240.83,241.31,241.45,241.77,242.07]]]},{"c":[[243.69,"La Strahl non rispose.",[243.69,243.83,244.23,244.41]]]},{"c":[[245.55,"Balthier ripeté tutto da capo.",[245.55,246.84,247.31,247.67,247.91]],[248.9," Niente.",[248.9]],[250.28," La spia della pietra celeste, accanto alla manetta, restava spenta.",[250.28,250.49,250.77,251.01,251.4,251.93,252.41,252.57,253.68,254.46]],[255.86," Dai motori veniva un ronzio debole, intermittente, che si alzava e si spegneva, come il respiro di Gabranth sul pavimento.",[255.86,255.86,256.58,257.05,257.17,257.6,258.44,259.64,259.91,260.03,260.43,260.53,260.63,261.51,261.85,262.01,262.33,262.45,262.94,263.21]]]},{"c":[[265.33,"«Fran.»",[265.33]]]},{"c":[[266.93,"Fran aveva già gli occhi chiusi.",[266.93,267.47,267.87,268.05,268.19,268.5]]]},{"c":[[269.69,"«Siamo attaccati» disse.",[269.69,270.22,270.89]],[271.82," «La piattaforma.",[271.82,272.23]],[273.46," Quando siamo scesi ci ha presi.",[273.46,273.93,274.31,274.71,275.02,275.33]],[276.11," I suoi condotti bevono dalla nostra pietra per tenersi su.",[276.11,276.25,276.57,277.17,277.63,277.85,278.19,278.62,278.89,279.42]],[280.49," La fortezza muore, e succhia tutto quello che trova.»",[280.49,280.49,281.09,281.94,282.09,282.41,282.69,283.03,283.23]],[284.17," Aprì gli occhi.",[284.17,284.49,284.65]],[285.6," «Finché siamo attaccati, non ci lascia andare.»",[285.6,286.07,286.34,287.2,287.47,287.65,288.04]]]},{"c":[[289.77,"Balthier guardò fuori dal vetro.",[289.77,290.54,291.01,291.27,291.45]],[292.81," Sulla piattaforma, a una ventina di passi, c'era un pilone di metallo con una grata, e dalla grata uscivano due cavi spessi che correvano sul pavimento fino alla carena della Strahl.",[292.81,292.81,293.67,293.81,293.93,294.27,294.43,295.06,295.57,295.67,295.95,296.07,296.55,296.71,296.89,297.91,298.05,298.21,298.55,299.03,299.29,299.76,300.36,300.63,301.17,301.39,302.35,302.69,302.87,303.43,303.89]],[304.45," Li aveva visti atterrando.",[304.45,304.45,304.73,305.05]],[306.13," Aveva pensato che fossero di servizio.",[306.13,306.53,307.05,307.21,307.63,307.77]]]},{"c":[[310.09,"«I morsetti di alimentazione» disse.",[310.09,310.23,310.65,310.79,311.59]],[312.58," «Dal pilone.",[312.58,312.85]],[313.61," Bisogna staccarli a mano, e da dentro il pilone, dove c'è il quadro.",[313.61,314.15,314.71,314.85,315.59,315.73,315.85,316.15,316.35,317.11,317.59,317.83,317.95]],[319.11," E poi bisogna...»",[319.11,319.25,319.45]],[320.78," Si fermò.",[320.78,321.01]],[321.96," Guardò il quadro degli strumenti, poi Fran, poi il pilone.",[321.96,322.43,322.57,322.93,323.14,323.98,324.61,325.58,326.02,326.23]],[327.57," «Poi bisogna che qualcuno resti al quadro, per tenere chiuso il flusso finché la nave non si stacca.",[327.57,327.57,327.93,328.07,328.49,328.83,329,329.88,330.15,330.45,330.83,330.96,331.7,332.17,332.33,332.8,333.07,333.32]],[334.14," Altrimenti riprende appena togli la mano.»",[334.14,334.77,335.27,335.59,335.87,336.01]]]},{"c":[[338.62,"Ci fu un silenzio breve.",[338.62,338.83,339.01,339.15,339.63]]]},{"c":[[341.21,"«Andiamo noi» disse Fran.",[341.21,341.57,341.81,342.07]]]},{"c":[[343.67,"«Vado io» disse Balthier.",[343.67,344.34,345.23,345.96]]]},{"c":[[347.13,"«Andiamo noi.»",[347.13,347.75]]]},{"c":[[348.34,"Balthier la guardò.",[348.34,349.9,350.11]],[351.5," Poi si alzò dal sedile di pilotaggio e si voltò verso la cabina, verso Vaan, che stava in piedi vicino al portello con la spada di Reddas ancora in mano e la faccia di chi ha già capito.",[351.5,351.5,351.71,352.01,352.17,352.53,352.65,353.83,353.97,354.11,354.39,354.61,354.73,355.45,356.11,356.64,356.91,357.15,357.29,357.49,357.85,357.97,358.88,359.15,359.27,359.57,359.71,360.09,360.42,360.63,361.43,361.57,361.67,361.99,362.11,362.23,362.33,362.46]]]},{"c":[[364.59,"«Siediti» disse Balthier.",[364.59,365.55,366.28]]]},{"c":[[367.45,"«Cosa?»",[367.45]]]},{"c":[[369.13,"«Siediti qui.»",[369.13,369.67]],[370.59," Indicò il sedile.",[370.59,371.01,371.19]],[371.98," «Hai preso la barra sopra le colonne di Ridorana.",[371.98,372.25,372.57,372.69,373.01,373.29,373.43,373.81,373.93]],[374.69," Hai volato dritto.",[374.69,374.89,375.21]],[376.36," Sai come si accende, mi hai visto farlo cento volte.",[376.36,376.63,376.83,376.99,377.89,378.01,378.11,378.37,378.65,379.01]],[380.17," Quando la spia diventa grigia e azzurra, vuol dire che siamo liberi.",[380.17,380.17,380.37,380.71,381.18,382.05,382.27,383.41,383.75,384.4,384.67,385.1]],[386.06," Allora tiri indietro questa, piano, con la metà della forza che pensi, e poi con la metà di quella.",[386.06,386.53,386.85,387.3,388.21,388.9,389.17,389.31,389.61,389.89,390.29,390.55,391.41,391.55,391.77,391.95,392.05,392.27,392.37]],[393.79," E vai.»",[393.79,393.96]]]},{"c":[[395.8,"«Io non...»",[395.8,397.14]]]},{"c":[[398,"«Tu sì.»",[398,399.11]]]},{"c":[[400.49,"«E voi?»",[400.49,400.64]]]},{"c":[[402.08,"«Noi abbiamo una cosa da fare.»",[402.08,402.35,402.71,402.89,403.13,403.27]],[403.73," Balthier si sistemò un polsino.",[403.73,404.65,404.83,405.27,405.44]],[406.42," Lo fece lentamente, e poi fece l'altro.",[406.42,406.63,406.89,407.83,407.97,408.17,408.63]],[409.31," «Penelo, tu siedi accanto a lui.",[409.31,410.04,410.25,410.61,410.95,411.09]],[411.88," Quelli sono gli strumenti di Fran, lei ti dice cosa guardare.",[411.88,412.19,412.51,412.69,413.15,413.25,414.12,414.39,414.55,414.79,415.05]],[416.08," Te lo dico io: guarda quello rotondo e se l'ago va nel rosso grida.»",[416.08,416.29,416.41,416.68,417.36,417.83,418.11,418.93,419.07,419.22,419.53,419.73,420.01,420.73]]]},{"c":[[422.42,"Penelo annuì.",[422.42,422.89]],[423.97," Aveva la faccia bianca.",[423.97,424.37,424.47,424.73]],[425.78," Si sedette nel posto di Fran senza dire niente.",[425.78,425.99,426.37,426.53,426.81,426.91,427.09,427.41,427.63]]]},{"c":[[428.95,"Vaan non si mosse.",[428.95,429.84,430.12,430.47]]]},{"c":[[431.77,"«Balthier.»",[431.77]]]},{"c":[[433.85,"«Siediti, Vaan.»",[433.85,435.23]]]},{"c":[[436.02,"«Ti aspetto.",[436.02,436.23]],[437.31," Stacchi i cavi, torni, e partiamo.",[437.31,437.87,438.01,438.55,439.53,439.67]],[440.72," Ti aspetto.»",[440.72,440.95]]]},{"c":[[442.44,"Balthier lo guardò un momento.",[442.44,442.97,443.15,443.43,443.55]],[444.25," Poi infilò la mano nella tasca della giacca e ne tirò fuori il piccolo disco d'ottone con la rotella, quello con cui Vaan aveva fatto parlare Larsa, e glielo mise in mano.",[444.25,444.53,444.89,445.01,445.21,445.49,445.83,446.03,446.49,446.63,446.73,446.99,447.31,447.47,447.79,448.13,448.61,448.81,448.93,449.7,450.17,450.35,450.51,450.73,451.05,451.27,452.07,452.65,452.79,453.01,453.28,453.49]]]},{"c":[[455.95,"«Tieni.»",[455.95]]]},{"c":[[456.6,"«Perché?»",[456.6]]]},{"c":[[459.43,"«Perché non si sa mai quando serve un'altra voce.»",[459.43,459.9,460.12,460.28,460.49,460.76,461,461.3,461.72]],[462.59," Gli chiuse le dita sopra il disco.",[462.59,462.86,463.2,463.32,463.54,463.84,463.96]],[464.43," «Restituiscimelo, poi.",[464.43,465.5]],[466.41," Ci sono affezionato.»",[466.41,466.62,466.88]]]},{"c":[[469,"«Poi quando?»",[469,470.13]]]},{"c":[[471.81,"«Poi.»",[471.81]]]},{"c":[[472.19,"Fran era già al portello.",[472.19,472.71,474.42,474.64,474.86]],[476.28," Si voltò a guardare la cabina, una volta sola, e i suoi occhi rossi si fermarono su ciascuno di loro, uno dopo l'altro, per il tempo di un battito,",[476.28,476.28,476.58,476.64,476.98,477.1,477.93,478.2,478.54,479.5,479.64,479.74,479.96,480.26,480.99,481.2,481.76,481.88,482.28,482.4,483.18,483.36,483.78,484.41,484.68,484.8,485.14,485.28,485.42]],[486.84," come si contano le persone prima di chiudere una porta.",[486.84,486.84,487,487.4,487.54,488.22,488.62,488.8,489.14,489.28]],[490.31," Su Penelo si fermarono di più.",[490.31,490.52,491.03,491.24,491.84,491.94]],[492.5," Poi uscì.",[492.5,493.1]]]},{"c":[[494.86,"Balthier la seguì.",[494.86,495.3,495.42]],[496.54," Sulla soglia si fermò, mezzo dentro e mezzo fuori, con il vento che gli muoveva i capelli.",[496.54,496.94,497.28,497.44,498.3,498.7,499.06,499.2,499.44,500.19,500.46,500.62,500.92,501.08,501.22,501.64,501.74]]]},{"c":[[505.17,"«Ah, Vaan.»",[505.17,505.65]]]},{"c":[[506.62,"«Cosa?»",[506.62]]]},{"c":[[508.37,"«Non grattarla atterrando.",[508.37,508.64,509.38]],[510.31," È appena stata pulita.»",[510.31,510.46,510.82,511.15]]]},{"c":[[512.61,"Poi se ne andò.",[512.61,512.88,513.04,513.16]]]},{"c":[[516.93,"Vaan si sedette.",[516.93,517.47,517.68]],[518.78," Non decise di farlo.",[518.78,519.06,519.46,519.62]],[520.63," Si trovò seduto, con le mani sulla barra, e la barra era fredda e non vibrava.",[520.63,520.84,521.18,521.92,522,522.12,522.38,522.68,523.44,523.58,523.68,523.98,524.14,524.98,525.12,525.3]],[526.23," Accanto a lui Penelo guardava lo strumento rotondo.",[526.23,526.76,526.86,527.09,527.56,527.96,528.12,528.58]],[529.57," Dal vetro si vedevano Balthier e Fran attraversare la piattaforma di corsa nel fumo, arrivare al pilone, aprire una grata, sparire dentro.",[529.57,529.77,530.45,530.66,531.2,531.74,531.88,532.74,533.6,533.76,534.36,534.46,534.78,535.06,535.84,536.3,536.48,537.36,537.62,537.84,538.76,539.14]]],"st":1},{"c":[[541.19,"Dietro di lui, sul pavimento della cabina, Gabranth aprì l'occhio che l'elmo spaccato lasciava scoperto.",[541.19,541.66,541.85,542.59,542.86,543.36,543.69,544.62,545.86,546.11,546.54,546.7,546.98,547.58,548]],[549.15," Cercò qualcosa nella penombra, girando appena la testa.",[549.15,549.56,550,550.28,551.13,551.66,551.98,552.24]],[552.88," Trovò Larsa.",[552.88,553.49]],[554.1," Lo guardò.",[554.1,554.22]],[555.75," Poi trovò Basch, inginocchiato dall'altra parte, e lo guardò più a lungo.",[555.75,555.75,556.39,557.02,557.56,557.94,558.72,558.86,558.98,559.32,559.58,559.72]]]},{"c":[[561.6,"«Basch.»",[561.6]]]},{"c":[[563.64,"«Sono qui.»",[563.64,564.02]]]},{"c":[[566.53,"«Il ragazzo.»",[566.53,566.83]],[567.71," La voce gli usciva bassa e rotta, a pezzi, ogni parola un respiro.",[567.71,567.92,568.16,568.32,568.7,569.1,569.22,570.01,570.16,570.62,570.76,571.2,571.25]],[572.21," «Il ragazzo.",[572.21,572.52]],[573.46," Proteggilo.»",[573.46]]]},{"c":[[575.48,"Basch non rispose subito.",[575.48,576.14,576.42,576.86]]]},{"c":[[578.36,"«È l'ultimo» disse Gabranth.",[578.36,578.45,579.14,579.53]],[580.15," «L'ultimo Solidor.",[580.15,580.7]],[581.61," Se muore...",[581.61,581.89]],[582.69," le grandi case di Archades...",[582.69,582.9,583.22,583.52,583.77]],[584.79," si sbranano.",[584.79,584.99]],[585.79," Le legioni...",[585.79,586]],[586.81," ognuna con il suo generale.",[586.81,587.28,587.46,587.58,587.74]],[588.57," Guerra.",[588.57]],[589.17," Dappertutto.",[589.17]],[590.05," Per anni.»",[590.05,590.32]],[591.62," Prese fiato, e il fiato gli fece male.",[591.62,591.62,592.77,592.92,593.06,593.28,593.4,593.64]],[594.59," «Lui no.",[594.59,594.87]],[595.5," Lui è...",[595.5,595.86]],[596.47," diverso.",[596.47]],[597.38," Lui farà la pace.",[597.38,597.66,597.94,598.08]],[598.71," Con voi.",[598.71,599]],[599.43," Con Dalmasca.",[599.43,599.72]],[600.5," Con tutti.",[600.5,600.78]],[601.45," Lo so.",[601.45,601.69]],[602.31," Lo conosco.»",[602.31,602.59]]]},{"c":[[604.54,"Larsa gli strinse la mano.",[604.54,605.38,605.66,606.02,606.2]]]},{"c":[[607.25,"«Proteggilo» disse Gabranth.",[607.25,608.38,608.93]],[609.83," «Al mio posto.",[609.83,610.04,610.13]],[610.83," Non ti chiedo...",[610.83,611.1,611.22]],[611.99," non ti chiedo altro.",[611.99,612.26,612.4,612.66]],[613.37," Non ti ho mai chiesto niente.",[613.37,613.64,613.74,613.82,613.96,614.3]],[615.28," Questo sì.»",[615.28,616.34]]]},{"c":[[617.34,"Basch guardò il fratello.",[617.34,617.68,618.1,618.2]],[619.17," Poi guardò Larsa, il ragazzo seduto per terra con il sangue sulla tempia e la mano di un Giudice nella sua.",[619.17,619.44,620.11,620.67,620.88,621.34,621.72,621.94,622.54,622.68,622.84,623.2,623.47,624.22,624.36,624.48,624.72,624.86,624.98,625.42,625.69]],[626.63," Aveva servito Raminas.",[626.63,627.04,627.64]],[628.56," Aveva servito Ashe.",[628.56,628.96,629.48]],[630.58," Aveva combattuto Archadia per tutta la vita, da quando i soldati di Archadia gli avevano bruciato la casa.",[630.58,630.96,631.84,632.55,632.82,633.08,633.2,634.05,634.26,634.5,634.6,634.98,635.11,635.62,635.82,636.14,636.54,636.68]],[637.91," Adesso suo fratello gli chiedeva di proteggere l'erede di Archadia.",[637.91,638.71,638.98,639.4,639.54,639.92,640.04,640.69,641.08,641.22]]]},{"c":[[643.05,"Non ci pensò a lungo.",[643.05,643.32,643.46,643.84,643.98]],[644.68," Capì che non c'era niente da pensare.",[644.68,645.02,645.16,645.32,645.54,645.96,646.14]],[647.38," Il mondo che aveva conosciuto, quello in cui Dalmasca e Archadia stavano da due parti e lui da una,",[647.38,647.38,647.64,647.8,648.08,649.42,649.72,649.84,649.98,650.58,650.64,651.16,651.6,651.78,652.01,652.98,653.12,653.55,653.76]],[654.74," era finito su una torre spezzata in fondo al mare e su una piattaforma battuta dal vento in cima a una fortezza.",[654.74,654.94,655.3,655.5,655.66,655.98,656.58,656.76,657,657.16,658.3,658.45,658.66,658.84,659.52,660.02,660.24,660.64,660.84,661.06,661.2,661.36]],[662.97," Ce n'era un altro, adesso.",[662.97,663.11,663.4,663.56,663.9]],[664.79," In quello, la pace di Dalmasca passava per quel ragazzo.",[664.79,665,665.67,665.88,666.22,666.36,666.95,667.48,667.7,667.95]]]},{"c":[[669.75,"Prese la mano del fratello.",[669.75,670.16,670.3,670.48,670.64]],[671.53," La manopola era fredda.",[671.53,671.74,672.28,672.45]]]},{"c":[[673.89,"«Lo proteggo» disse.",[673.89,674.1,674.64]],[675.59," «Te lo prometto.",[675.59,675.8,675.92]],[676.63," Per Archadia.",[676.63,676.96]],[677.86," E per Dalmasca.»",[677.86,678,678.2]]]},{"c":[[679.31,"Gabranth chiuse l'occhio.",[679.31,680.43,681.28]],[682.28," Il suo viso, la metà che si vedeva, si distese, e la piega dura attorno alla bocca, quella che Basch non aveva, si allentò un poco.",[682.28,682.28,682.58,683.23,683.44,683.66,683.8,683.95,684.67,684.88,685.75,685.9,686.1,686.9,687.24,687.72,687.96,688.81,689.28,689.53,689.96,690.15,691.15,691.28,691.72,691.84]]]},{"c":[[695.99,"La spia della pietra celeste si accese.",[695.99,695.99,696.33,696.55,696.93,698.26,698.64]],[699.6," Grigia, poi azzurra, poi pulsò, lenta, più lenta del cuore di un uomo.",[699.6,700.38,700.75,701.84,702.31,703.19,703.75,704.03,704.33,704.51,704.85,704.99,705.09]]],"st":1},{"c":[[707.01,"«Vaan!»",[707.01]],[707.85," gridò Penelo.",[707.85,708.28]],[709.07," «Vaan, la spia!»",[709.07,709.6,709.93]]]},{"c":[[711.4,"I motori ripresero.",[711.4,711.58,712.41]],[714.13," Non con il ruggito di sempre: con quel ronzio basso e largo, che sembrava venire dalla pietra stessa, lo stesso che avevano sentito nella nebbia di Ridorana.",[714.13,714.13,714.39,714.54,715.05,715.24,716.36,716.63,716.98,717.64,718.05,718.26,719.01,719.29,719.73,720.13,720.41,720.94,722.14,722.35,722.73,722.93,723.54,724.37,724.77,725.17,725.33]],[726.38," La nave tremò.",[726.38,726.59,726.97]],[728.17," Fuori, dal pilone, i due cavi si staccarono dalla carena e caddero sul pavimento della piattaforma come serpenti tagliati.",[728.17,729.13,729.48,730.49,730.63,730.75,731.05,731.17,731.67,731.92,732.99,733.13,733.55,733.75,734.25,734.47,735.21,735.55,736.15]]]},{"c":[[738.27,"Vaan guardò il pilone.",[738.27,738.86,739.33,739.48]],[740.19," Dalla grata non usciva nessuno.",[740.19,740.55,741.13,741.41,741.84]]]},{"c":[[742.82,"«Vaan» disse Penelo.",[742.82,743.39,743.69]]]},{"c":[[745.12,"«Aspetta.»",[745.12]]]},{"c":[[746.95,"«Vaan.",[746.95]],[748," La piattaforma si inclina.»",[748,748.21,748.87,749.03]]]},{"c":[[751.47,"Si inclinava.",[751.47,751.68]],[753.12," Lo si vedeva dal vetro: l'orizzonte storto, il fumo che scivolava di lato.",[753.12,753.12,753.26,753.58,753.74,754.24,755.25,756.12,756.28,756.58,756.74,757.22,757.36]],[757.77," La Strahl cominciò a scivolare anche lei, piano, sulle lastre, verso il bordo.",[757.77,757.98,758.6,759.06,759.18,759.58,759.85,760.64,761.28,761.68,762.1,762.4,762.58]]]},{"c":[[764.59,"«Aspetta» disse Vaan.",[764.59,765.5,766.21]],[766.77," «Escono.",[766.77]],[767.78," Adesso escono.»",[767.78,768.51]]]},{"c":[[769.85,"Dal dispositivo delle comunicazioni venne un gracchio.",[769.85,770.12,770.88,771.08,771.84,772.24,772.38]]]},{"c":[[774.14,"«Ragazzo.»",[774.14]],[775.02," Era la voce di Balthier.",[775.02,775.3,775.42,775.66,775.9]],[776.85," Era lontana e piena di rumori, e calma.",[776.85,777.12,777.65,777.8,778.14,778.27,779.01,779.25]],[780.05," «Ti vedo dalla grata.",[780.05,780.36,780.7,780.98]],[782.44," Stai scivolando.",[782.44,782.44]],[783.58," Parti.»",[783.58]]]},{"c":[[785.78,"«Esci!",[785.78]],[786.9," Esci, che ti aspetto!»",[786.9,787.5,787.78,787.88]]]},{"c":[[789.4,"«Non posso uscire.",[789.4,789.68,789.98]],[791.43," Se tolgo la mano dal quadro la fortezza ti riprende.",[791.43,791.64,791.94,792.08,792.28,792.48,793.49,793.7,794.18,794.4]],[795.59," Te l'ho spiegato, mi pare.",[795.59,795.72,795.92,796.75,796.96]],[797.88," Ascolti mai quando parlo?»",[797.88,798.42,798.64,798.98]],[800.07," Un rumore di ferro, una pausa.",[800.07,800.28,800.58,800.8,801.28,801.65]],[802.56," «Parti, Vaan.",[802.56,803.49]],[804.24," È un ordine.",[804.24,804.24,804.4]],[805.22," L'unico che ti do da capitano, e guarda che ne approfitto.»",[805.22,806.04,806.2,806.3,806.44,806.6,807.82,807.96,808.4,808.52,808.62]]]},{"c":[[810.87,"«No!»",[810.87]]]},{"c":[[812.38,"«Fran dice che sei uno stupido.»",[812.38,812.72,812.96,813.14,813.34,813.55]]]},{"c":[[815.05,"Si sentì, lontana, la voce di Fran.",[815.05,815.32,816.37,817.39,817.6,817.86,818]],[818.88," Disse una parola sola.",[818.88,819.28,819.52,819.84]],[820.67," Non era stupido.",[820.67,820.95,821.22]]]},{"c":[[822.93,"«Vai» disse.",[822.93,823.62]]]},{"c":[[825.54,"Vaan mise le mani sulla barra.",[825.54,825.54,825.88,826,826.24,826.54]],[827.37," Le mani gli tremavano, e la barra tremava, e la nave scivolava verso il bordo.",[827.37,827.58,827.86,827.98,829.12,829.26,829.36,829.64,830.48,830.62,830.72,830.98,831.5,831.78,831.92]],[833.02," Tirò.",[833.02]],[833.74," Tirò troppo.",[833.74,834.09]],[835.4," La Strahl si impennò di colpo con un'allegria che nessuno condivise, e Penelo gridò, e Vaan pensò a una voce sopra un viale di colonne spezzate che gli diceva non tirare, chiedi,",[835.4,835.62,836.29,836.5,836.94,837.06,837.46,837.66,838.32,838.48,838.94,840.53,840.61,841.08,842.03,842.12,842.44,842.84,842.96,843.26,843.6,843.93,844.14,844.36,844.52,844.9,845.48,845.66,845.78,846.88,847.29,847.91]],[848.98," e lasciò andare di metà.",[848.98,848.98,849.32,849.62,849.76]],[850.88," Poi della metà della metà.",[850.88,851.16,851.44,851.74,852]],[853.05," La nave si raddrizzò.",[853.05,853.26,853.57,853.78]],[854.85," Il bordo della piattaforma passò sotto di loro.",[854.85,855.06,855.38,855.64,856.34,856.72,857.06,857.22]],[858.18," E poi sotto di loro non ci fu più niente, se non aria e fumo e, molto più in basso, il deserto.",[858.18,858.18,858.38,858.68,858.82,859.26,859.54,859.68,859.82,859.96,861.01,861.22,861.38,861.7,861.88,862.7,862.84,863.06,863.2,863.36,864.13,865.45]]]},{"c":[[866.65,"La Strahl si staccò da Bahamut.",[866.65,867,868.05,868.33,868.81,869.2]]]},{"c":[[870.55,"Vaan non si voltò a guardare indietro.",[870.55,871.32,871.9,872.1,872.44,872.58,872.98]],[873.88," Non poteva: aveva le mani sulla barra e gli occhi avanti e la nave che chiedeva.",[873.88,874.16,875.18,875.58,875.76,876.1,876.39,876.8,876.88,876.98,877.15,878.15,878.3,878.44,878.74,878.94]],[880.29," Fu Penelo a voltarsi, e a guardare dal vetro laterale la fortezza che si allontanava, immensa, inclinata, con gli anelli che giravano a scatti e il fumo che le usciva da cento ferite.",[880.29,880.29,880.77,880.92,882.06,882.2,882.3,882.64,882.8,883.1,883.6,883.76,884.26,884.42,884.56,885.75,886.64,887.64,887.92,888.06,888.36,888.54,889.04,889.18,889.94,890.08,890.24,890.56,890.72,890.84,891.18,891.44,891.84]],[892.91," Cercò il pilone sulla piattaforma d'attracco.",[892.91,893.3,893.42,893.76,894,894.89]],[895.63," Era troppo lontano.",[895.63,895.9,896.18]],[897.07," Non lo trovò.",[897.07,897.34,897.5]]]},{"c":[[901.06,"Sul pavimento della cabina, fra le casse, Gabranth riaprì l'occhio un'ultima volta.",[901.06,901.33,901.79,902.08,902.8,903.07,903.27,904.01,905.2,905.59,906.04,906.55]]],"st":1},{"c":[[908.04,"La nave volava dritta, adesso.",[908.04,908.25,908.53,908.92,909.76]],[910.99," Il ronzio della pietra celeste riempiva la cabina, basso, regolare, e dal vetro entrava una luce chiara, di cielo libero.",[910.99,910.99,911.45,911.71,912.18,912.93,913.53,913.65,914.63,915.25,916.31,916.45,916.59,916.99,917.51,917.67,917.93,918.8,919.01,919.28]],[920.45," Larsa gli teneva la mano.",[920.45,921.34,921.61,921.93,922.07]],[922.77," Basch gli teneva l'altra.",[922.77,923.65,923.93,924.32]]]},{"c":[[926.15,"Gabranth guardò il fratello.",[926.15,926.68,927.15,927.27]],[928.38," Le sue labbra si mossero, e Basch si chinò fino quasi a toccarle con l'orecchio.",[928.38,928.59,928.73,929.05,929.25,930.45,930.53,930.96,931.17,931.61,931.95,932.33,932.47,932.91,933.09]]]},{"c":[[935.29,"«Sulla torre» disse Gabranth.",[935.29,935.69,935.99,936.93]],[938.43," «In cima.",[938.43,938.59]],[939.56," Quando crollava.",[939.56,940.15]],[941.28," Mi hanno trascinato via.",[941.28,941.49,941.65,942.3]],[943.25," Ho visto...",[943.25,943.45]],[944.56," ho visto che tornavi indietro.",[944.56,944.77,945.13,945.39,945.79]],[946.53," Al pilastro.",[946.53,946.91]],[947.81," A cercare.»",[947.81,948.24]]]},{"c":[[950.51,"Basch chiuse gli occhi.",[950.51,951,951.47,951.61]]]},{"c":[[953.14,"«Sì» disse.",[953.14,953.59]],[954.32," «Ti ho cercato.",[954.32,954.53,954.7]],[955.6," Non c'eri.»",[955.6,956.31]]]},{"c":[[957.25,"«Non l'hai detto a nessuno.»",[957.25,957.45,957.71,957.91,958.03]]]},{"c":[[959.48,"«No.",[959.48]],[960.3," Lo dico adesso.",[960.3,960.51,960.82]],[962.07," A te.»",[962.07,962.22]]]},{"c":[[962.55,"Gabranth respirò.",[962.55,963.89]],[964.64," Il rumore bagnato era quasi sparito.",[964.64,964.85,965.15,965.59,965.77,966.12]],[967.59," Il respiro si era fatto piccolo e leggero, come quello di un bambino che dorme.",[967.59,967.59,969.14,969.35,969.49,969.77,970.23,970.39,971.39,971.73,972.03,972.17,972.27,972.71,973.47]]]},{"c":[[974.97,"«Basch» disse.",[974.97,975.45]],[976.84," Poi, dopo un poco: «La mamma ti chiamava sempre per primo.»",[976.84,977.75,978.09,978.25,979.72,979.93,980.23,980.37,980.75,981.05,981.25]]]},{"c":[[982.42,"«Lo so.»",[982.42,982.64]]]},{"c":[[984.22,"«Mi dava fastidio.»",[984.22,984.43,984.69]]]},{"c":[[986.18,"«Lo so.»",[986.18,986.46]]]},{"c":[[988.4,"«Adesso no.»",[988.4,988.92]]]},{"c":[[990,"Non disse altro.",[990,990.27,990.51]],[991.65," Il suo respiro, che si era fatto piccolo, si fece più piccolo ancora, e poi non ci fu più.",[991.65,991.65,991.84,992.51,992.79,992.93,993.05,993.31,994.18,994.39,994.69,994.87,995.29,996.07,996.27,996.74,997.01,997.21,997.44]],[998.32," Non ci fu un rantolo, né un movimento.",[998.32,998.6,998.81,998.99,999.27,1000.04,1000.26,1000.47]],[1001.76," La mano nella mano di Basch non si strinse e non si aprì.",[1001.76,1001.97,1002.27,1002.51,1002.77,1002.98,1003.51,1003.8,1004.06,1004.88,1005.18,1005.46,1005.71]],[1006.79," Restò com'era.",[1006.79,1007.54]],[1008.45," Larsa, dall'altra parte, se ne accorse un istante dopo Basch, e non disse niente, e non lasciò la mano.",[1008.45,1008.93,1009.81,1010.39,1010.51,1010.59,1010.97,1011.17,1011.63,1012.26,1013.05,1013.19,1013.33,1013.64,1014.61,1014.75,1014.89,1015.19,1015.33]]]},{"c":[[1017.2,"Basch rimase in ginocchio.",[1017.2,1017.88,1018.35,1018.49]],[1020.2," Guardò la mezza faccia di suo fratello, che era la sua faccia, con gli occhi chiusi, nella luce chiara del cielo che entrava dal vetro.",[1020.2,1020.67,1020.77,1021.04,1021.35,1021.47,1021.61,1022.34,1022.61,1022.77,1022.89,1023.08,1023.83,1024.11,1024.25,1024.54,1025.2,1025.61,1025.91,1026.25,1026.45,1026.99,1027.27,1027.69,1027.94]],[1029.79," Poi, con cura, gli tolse quello che restava dell'elmo.",[1029.79,1029.79,1030.15,1030.79,1031.07,1031.47,1031.73,1031.85,1032.38]],[1032.98," Lo fece lentamente, con due mani, come si toglie una cosa che pesa da troppo tempo, e lo posò sul pavimento della cabina accanto a lui.",[1032.98,1033.19,1033.45,1034.47,1034.75,1034.97,1035.53,1035.87,1036.01,1036.31,1036.45,1036.69,1036.87,1037.19,1037.29,1037.59,1038.81,1038.95,1039.05,1039.39,1039.61,1040.11,1040.35,1040.81,1041.21,1041.31]]]},{"c":[[1042.95,"Noah fon Ronsenburg aveva i capelli biondi come quelli del fratello, corti, appiccicati di sudore sulla fronte.",[1042.95,1043.43,1043.79,1044.99,1045.39,1045.47,1045.86,1046.33,1046.63,1046.87,1047.05,1047.96,1048.47,1049.09,1049.21,1049.57,1049.88]],[1051.2," Aveva una cicatrice vecchia sopra l'orecchio che Basch non conosceva.",[1051.2,1051.61,1051.81,1052.39,1052.89,1053.21,1053.77,1054,1054.37,1054.63]],[1055.99," Sembrava molto più giovane, senza l'elmo.",[1055.99,1056.39,1056.71,1056.91,1057.73,1058.15]]]},{"c":[[1060.37,"Basch gli passò una mano sui capelli.",[1060.37,1060.71,1060.91,1061.23,1061.39,1061.61,1061.85]],[1062.69," Una volta.",[1062.69,1062.97]]]},{"c":[[1065.55,"Poi gli slacciò il pettorale, perché non lo stringesse più, e sotto il bordo, nella tasca interna contro il petto, le dita trovarono una cosa piccola e leggera.",[1065.55,1065.55,1065.73,1066.15,1066.27,1067.04,1067.51,1067.69,1067.85,1068.38,1068.85,1068.99,1069.21,1069.35,1069.81,1070.21,1070.53,1071.07,1071.33,1071.53,1072.26,1072.47,1072.71,1073.23,1073.39,1073.61,1074.33,1074.51]],[1075.87," Era una pastiglia bianca avvolta in una carta sottile, sgualcita dal metallo, intatta.",[1075.87,1075.87,1076.07,1076.76,1077.57,1078.11,1078.25,1078.41,1078.86,1079.85,1080.51,1080.79,1081.89]],[1082.66," Sapeva di miele e di menta.",[1082.66,1083.13,1083.29,1083.88,1084.03,1084.23]],[1084.85," Basch la tenne sul palmo senza capire.",[1084.85,1085.48,1085.69,1086.03,1086.29,1086.69,1087.14]]]},{"c":[[1088.96,"Larsa la vide e smise di respirare.",[1088.96,1089.37,1089.51,1090.33,1090.47,1090.79,1090.97]],[1092.57," Era quella che gli aveva dato lui, in un giardino di Archades, davanti a un lago di cigni, perché il Giudice aveva la voce rauca e il medico di corte ne dava a lui per la gola.",[1092.57,1092.57,1092.89,1093.05,1093.17,1093.43,1093.69,1094.54,1094.75,1094.85,1095.27,1095.51,1096.49,1096.91,1097.01,1097.09,1097.29,1097.56,1098.23,1098.45,1098.63,1099.42,1099.83,1099.93,1100.2,1100.63,1100.77,1100.87,1101.21,1101.35,1101.73,1101.89,1102.07,1102.19,1102.27,1102.45,1102.63]],[1103.49," Gabranth non l'aveva mai mangiata.",[1103.49,1104.21,1104.43,1104.85,1105.05]],[1105.79," L'aveva portata addosso per tutto quel tempo, contro il petto, sotto l'armatura nera.",[1105.79,1106.35,1106.85,1107.38,1107.65,1107.91,1108.16,1109.05,1109.35,1109.53,1110.53,1110.84,1111.41]]]},{"c":[[1113.66,"Larsa non disse niente.",[1113.66,1114.07,1114.23,1114.48]],[1115.12," Basch gliela porse.",[1115.12,1115.65,1115.92]],[1116.74," Il ragazzo scosse la testa, piano, e Basch la rimise dov'era, nella tasca del fratello, e richiuse il pettorale sopra.",[1116.74,1116.95,1117.35,1117.69,1117.85,1118.37,1119.18,1119.26,1119.61,1119.71,1120.18,1120.64,1121.05,1121.39,1121.55,1122.37,1122.51,1122.85,1123.01,1123.47]]]},{"c":[[1125.31,"Nessuno nella cabina parlò.",[1125.31,1125.85,1126.07,1126.51]],[1127.44," Penelo, al posto di Fran, teneva gli occhi sullo strumento rotondo e le lacrime le cadevano sulle mani.",[1127.44,1127.96,1128.17,1128.51,1128.63,1129.4,1129.87,1130.01,1130.25,1130.53,1131.05,1132.03,1132.17,1132.29,1132.73,1132.89,1133.35,1133.75]],[1134.49," Vaan teneva la barra e guardava avanti.",[1134.49,1135.24,1135.71,1135.81,1136.15,1136.23,1136.63]],[1138.46," Ashe, seduta nel sedile di passaggio, si era voltata e guardava il cavaliere inginocchiato e il ragazzo seduto per terra e il Giudice disteso fra loro senza elmo,",[1138.46,1138.46,1138.93,1139.09,1139.41,1139.53,1140.72,1140.93,1141.36,1142.37,1142.51,1142.87,1142.97,1143.43,1144.99,1145.13,1145.27,1146.18,1146.65,1146.87,1147.63,1147.77,1147.89,1148.53,1149.07,1149.27,1149.55,1150.03]],[1151.17," e teneva la mano sinistra chiusa a pugno in grembo.",[1151.17,1151.17,1151.49,1151.61,1151.85,1152.37,1152.88,1153.03,1153.58,1153.84]]]},{"c":[[1156.79,"Larsa fu il primo a muoversi.",[1156.79,1157.19,1157.37,1157.51,1157.73,1157.87]],[1159.97," Si sfilò dalla giubba un fazzoletto e lo bagnò con l'acqua della borraccia di Basch, e cominciò a pulire il sangue secco dalla guancia di Gabranth, piano, con attenzione,",[1159.97,1159.97,1160.35,1160.59,1160.87,1161.01,1161.7,1161.85,1161.95,1162.25,1162.42,1162.77,1162.95,1163.37,1163.61,1164.22,1164.37,1164.77,1164.85,1165.15,1165.33,1165.65,1166.01,1166.19,1166.55,1166.72,1167.4,1167.89,1168.17]],[1169.57," come si fa con un ferito che si può ancora svegliare.",[1169.57,1169.57,1169.73,1169.89,1170.15,1170.4,1171.23,1171.51,1171.67,1171.87,1172.15]]]},{"c":[[1174.33,"Basch lo lasciò fare.",[1174.33,1174.84,1175.05,1175.33]],[1176.07," Poi gli posò una mano sulla spalla.",[1176.07,1176.45,1176.73,1177.03,1177.23,1177.49,1177.73]],[1178.47," Larsa non si voltò.",[1178.47,1179.09,1179.37,1179.53]]]},{"c":[[1180.99,"«Altezza» disse Basch.",[1180.99,1181.51,1182.44]]]},{"c":[[1183.38,"Larsa alzò gli occhi su di lui, poi continuò a pulire.",[1183.38,1184.31,1184.61,1184.71,1184.93,1185.05,1185.17,1185.91,1186.03,1186.55,1186.67]]]}]